  <types>
    <dataTypes />
    <pous>
      <pou name="FB_Encoder_Scale" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="RawPos">
              <type>
                <UDINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position brute (sortie FB_Encoder_Abs, déjà gelée sur doute)</xhtml>
              </documentation>
            </variable>
            <variable name="HomingRefRaw">
              <type>
                <UDINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Référence brute figée au dernier homing (ST_Encoder_Calib)</xhtml>
              </documentation>
            </variable>
            <variable name="CableM_PerRev">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="2" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Câble déroulé par tour (périmètre tambour confirmé 2026-07-02, réglable site)</xhtml>
              </documentation>
            </variable>
            <variable name="PointsPerRev">
              <type>
                <UDINT />
              </type>
              <initialValue>
                <simpleValue value="8192" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Résolution codeur confirmée (Partie10 §3.3)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="CablePosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position câble en mètres, signée (+ enroulé, − sous l'eau)</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="RawDiff">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Écart signé RawPos - HomingRefRaw (§3.1)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   📏 FB_Encoder_Scale — Mise à l'échelle points → mètres (1 par treuil)
   ───────────────────────────────────────────────────────────────
   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md §2/§3.1
                   DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
   🎯 Formule : CablePosM = (RawPos - HomingRefRaw) × (CableM_PerRev / PointsPerRev)
   🧮 Arithmétique signée sûre : conversion en DINT avant la soustraction.
   ═══════════════════════════════════════════════════════════════
=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Scale) ===</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Scale) ===

// 🧮 Écart signé sûr : conversion DINT AVANT soustraction (§3.1) — jamais l'inverse
RawDiff := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(HomingRefRaw);

// 📏 Formule fixe points → mètres (Partie10 §2)
IF PointsPerRev &gt; 0 THEN
    CablePosM := DINT_TO_REAL(RawDiff) * (CableM_PerRev / UDINT_TO_REAL(PointsPerRev));
ELSE
    CablePosM := 0.0;   // Garde division par zéro (PointsPerRev mal configuré)
END_IF;
</xhtml>
          </ST>
        </body>
