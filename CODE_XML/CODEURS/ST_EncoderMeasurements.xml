      <dataType name="ST_EncoderMeasurement">
        <baseType>
          <struct>
            <variable name="RawPos">
              <type>
                <UDINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position brute codeur — gelée si EncoderAvailable=FALSE</xhtml>
              </documentation>
            </variable>
            <variable name="EncoderAvailable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = bus/esclave opérationnel</xhtml>
              </documentation>
            </variable>
            <variable name="CablePosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position câble (m, signée, + enroulé)</xhtml>
              </documentation>
            </variable>
            <variable name="CablePosMSafe">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position câble (m) — mesure instantanée réelle validée par EncoderIncoherent</xhtml>
              </documentation>
            </variable>
            <variable name="EncoderIncoherent">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = incohérence redémarrage ou hors bornes → refuse SEMI_AUTO</xhtml>
              </documentation>
            </variable>
            <variable name="Speed_Mps">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Vitesse absolue (m/s) — 0.0 si SpeedValid=FALSE</xhtml>
              </documentation>
            </variable>
            <variable name="SignedSpeed_Mps">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Vitesse signée (m/s, + montée) — 0.0 si SpeedValid=FALSE</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedValid">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE si ≥ 6 éch. couvrant 50 ms</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
