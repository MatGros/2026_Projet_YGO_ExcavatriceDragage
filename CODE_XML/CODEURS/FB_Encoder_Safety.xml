                <REAL />
              </type>
              <initialValue>
                <simpleValue value="-99" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Bornage physique dur (Partie10 §3.6)</xhtml>
              </documentation>
            </variable>
            <variable name="PositionMaxM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="99" />
              </initialValue>
            </variable>
            <variable name="BypassGlobal">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🌐 Force ErrorId=0, ignore bornage (mise en service)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Busy">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Done">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Error">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="ErrorId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">bit0: "Position câble hors plage" - position hors plage physique ; bit1: "Incohérence position boot" - incohérence redémarrage (miroir HomingSuspect)</xhtml>
              </documentation>
            </variable>
            <variable name="State">
              <type>
                <derived name="E_State" />
              </type>
            </variable>
            <variable name="StateAtError">
              <type>
                <derived name="E_State" />
              </type>
            </variable>
            <variable name="CablePosMSafe">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">CablePosM gelée sur dernière valeur plausible si hors plage</xhtml>
              </documentation>
            </variable>
            <variable name="EncoderIncoherent">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">= Error — consommé par FB_Modes (refuse SEMI_AUTO)</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="ResetEdge">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="ErrorEdge">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="LastPlausibleCablePosM">
              <type>
                <REAL />
              </type>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🛡️ FB_Encoder_Safety — Bornage physique &amp; relais incohérence redémarrage
   ───────────────────────────────────────────────────────────────
   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md §3.6/§3.7
                   DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
   🎯 Rôle :
      - Bornage absolu [-99.00 ; +99.00] m (CablePosMSafe gelée sur dernière valeur plausible).
      - Relais de HomingSuspect (ErrorId bit1).
      - Expose EncoderIncoherent (= Error) consommé par FB_Modes.
   ═══════════════════════════════════════════════════════════════
=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Safety) ===</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Safety) ===

// 🛑 1. GATE — expose la dernière valeur plausible connue même désactivé
IF NOT Enable THEN
    Ready := FALSE; Busy := FALSE; Done := FALSE;
    State := E_State.DISABLED;
    CablePosMSafe := LastPlausibleCablePosM;
    EncoderIncoherent := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
State := E_State.READY;

// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);

// 🌐 BYPASS GLOBAL : force ErrorId = 0, ignore bornage et incohérence
IF BypassGlobal THEN
    ErrorId := 16#0000;
END_IF;

// 🔍 3. BORNAGE PHYSIQUE ABSOLU (§3.6) — bit0
IF NOT BypassGlobal AND ((CablePosM &lt; PositionMinM) OR (CablePosM &gt; PositionMaxM)) THEN
    ErrorId := ErrorId OR 16#0001;
ELSE
    ErrorId := ErrorId AND 16#FFFE; (* Auto-clearing dès que la position revient dans la plage valide *)
END_IF;

// 🔍 4. RELAIS INCOHÉRENCE REDÉMARRAGE (§3.7, calculée par FB_Encoder_Homing) — bit1
// Pas d'acquittement ici : la levée se fait via BtnConfirmCoherence/nouveau Home côté
// FB_Encoder_Homing (source), ce FB ne fait QUE relayer l'information pour FB_Modes.
IF NOT BypassGlobal THEN
    IF HomingSuspect THEN
        ErrorId := ErrorId OR 16#0002;
    ELSE
        ErrorId := ErrorId AND 16#FFFD;
    END_IF;
END_IF;

// 🧊 5. GELER SUR DOUTE (§6) — CablePosMSafe ne suit PAS CablePosM si hors plage
IF (ErrorId AND 16#0001) = 16#0000 THEN
    LastPlausibleCablePosM := CablePosM;
END_IF;
CablePosMSafe := LastPlausibleCablePosM;

// 📤 6. SORTIES ÉTAT
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;

EncoderIncoherent := Error;
Busy := FALSE;
Done := FALSE;
</xhtml>
          </ST>
        </body>
