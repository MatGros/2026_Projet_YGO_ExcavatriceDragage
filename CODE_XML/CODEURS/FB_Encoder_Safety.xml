    <pous>
      <pou name="FB_Encoder_Safety" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Active le bloc</xhtml>
              </documentation>
            </variable>
            <variable name="Reset">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Acquittement défaut (front)</xhtml>
              </documentation>
            </variable>
            <variable name="PowerContactorEngaged">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ligne puissance enclenchée</xhtml>
              </documentation>
            </variable>
            <variable name="Mode">
              <type>
                <derived name="E_Mode" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Mode d'exploitation</xhtml>
              </documentation>
            </variable>
            <variable name="CablePosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position calculée (FB_Encoder_Scale)</xhtml>
              </documentation>
            </variable>
            <variable name="HomingSuspect">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Alerte incohérence redémarrage (FB_Encoder_Homing)</xhtml>
              </documentation>
            </variable>
            <variable name="PositionMinM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="-99" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Bornage physique bas</xhtml>
              </documentation>
            </variable>
            <variable name="PositionMaxM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="99" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Bornage physique haut</xhtml>
              </documentation>
            </variable>
            <variable name="BypassGlobal">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Mise en service : neutralise le défaut de bornage</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Busy">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Done">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Error">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="ErrorId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">bit0: Position hors bornes [-99..+99]m ; bit1: Incohérence boot (HomingSuspect)</xhtml>
              </documentation>
            </variable>
            <variable name="State">
              <type>
                <derived name="E_State" />
              </type>
            </variable>
            <variable name="StateAtError">
              <type>
                <derived name="E_State" />
              </type>
            </variable>
            <variable name="CablePosMSafe">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position câble instantanée (non figée)</xhtml>
              </documentation>
            </variable>
            <variable name="EncoderIncoherent">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">= Error — consommé par FB_Modes et IHM</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="ResetEdge">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="ErrorEdge">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🛡️ FB_Encoder_Safety — Bornage physique &amp; surveillance cohérence
   ───────────────────────────────────────────────────────────────
   📄 Doc : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md §3.6/§3.7
   🎯 Rôle :
      - Surveillance bornage absolu [-99.00 ; +99.00] m
      - Relais de HomingSuspect (ErrorId bit1)
      - Expose EncoderIncoherent (= Error) et transmet CablePosMSafe
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

// 🛑 1. GATE
IF NOT Enable THEN
    Ready := FALSE; Busy := FALSE; Done := FALSE;
    State := E_State.DISABLED;
    CablePosMSafe := CablePosM;
    EncoderIncoherent := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
State := E_State.READY;

// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);

// 🌐 3. BYPASS GLOBAL
IF BypassGlobal THEN
    ErrorId := 16#0000;
END_IF;

// 🔍 4. SURVEILLANCE BORNAGE PHYSIQUE ABSOLU (bit0)
IF NOT BypassGlobal AND ((CablePosM &lt; PositionMinM) OR (CablePosM &gt; PositionMaxM)) THEN
    ErrorId := ErrorId OR 16#0001;
ELSE
    ErrorId := ErrorId AND 16#FFFE; (* Auto-clearing dès retour dans la plage *)
END_IF;

// 🔍 5. RELAIS INCOHÉRENCE REDÉMARRAGE (bit1)
IF NOT BypassGlobal THEN
    IF HomingSuspect THEN
        ErrorId := ErrorId OR 16#0002;
    ELSE
        ErrorId := ErrorId AND 16#FFFD;
    END_IF;
END_IF;

// 📏 6. TRANSMISSION DE LA MESURE (Toujours réelle, non figée)
CablePosMSafe := CablePosM;

// 📤 7. SORTIES ÉTAT &amp; SÉCURITÉ
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;

EncoderIncoherent := Error;
Busy := FALSE;
Done := FALSE;
</xhtml>
          </ST>
        </body>
