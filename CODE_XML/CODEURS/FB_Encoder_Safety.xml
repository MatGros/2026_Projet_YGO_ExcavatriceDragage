              </documentation>
            </variable>
            <variable name="CablePosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sortie FB_Encoder_Scale DE CE TREUIL</xhtml>
