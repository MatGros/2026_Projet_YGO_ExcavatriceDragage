  <types>
    <dataTypes />
    <pous>
      <pou name="FB_CycleTime" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="DefaultValueS">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.004" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== REGLAGES DE SECOURS ===
--&gt; [CFG] Valeur de secours par defaut (ex: 4ms = 0.004s)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="CycleTimeS">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MESURE ET DIAGNOSTIC ===
&lt;-- [DIAG] Temps ecoule reel calcule (secondes)</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="TimeCurrent">
              <type>
                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== HORLOGE ET MEMOIRE TEMPORELLE ===
. [LOC] Temps systeme actuel</xhtml>
              </documentation>
            </variable>
            <variable name="TimeLast">
              <type>
                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Empreinte de temps du cycle precedent</xhtml>
              </documentation>
            </variable>
            <variable name="DeltaTimeMs">
              <type>
                <UDINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Ecart brut calcule (ms)</xhtml>
              </documentation>
            </variable>
            <variable name="InitDone">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Drapeau d'initialisation du premier cycle</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   ⚙️ FB_CycleTime — Mesure du temps de cycle réel de la tâche
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Calcul du dt réel entre deux exécutions successives
   ⚙️ Calcul : Delta horloge système TIME() converti en secondes
   📄 Doc métier : DOC/AF/AF_Partie-03_Contrats_Composants_v2.3.md
   =======================================================================</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

{region "§1 Acquisition temps"}
// 1. ACQUISITION DU TEMPS SYSTÈME
TimeCurrent := TIME();
{endregion}

{region "§2 Initialisation"}
// 2. INITIALISATION UNIQUE AU PREMIER CYCLE
IF NOT InitDone THEN
    TimeLast := TimeCurrent;
    InitDone := TRUE;
    CycleTimeS := DefaultValueS;
    RETURN;
END_IF;
{endregion}

{region "§3 Calcul delta"}
// 3. CALCUL DU DELTA EN MILLISECONDES
DeltaTimeMs := TIME_TO_UDINT(TimeCurrent - TimeLast);
{endregion}

{region "§4 Conversion et secours"}
// 4. CONVERSION ET CHARGE DE SECOURS
IF DeltaTimeMs &gt; 0 THEN
    CycleTimeS := UDINT_TO_REAL(DeltaTimeMs) / 1000.0;
ELSE
    CycleTimeS := DefaultValueS;
END_IF;
{endregion}

{region "§5 Archivage"}
// 5. ARCHIVAGE POUR LE PROCHAIN CYCLE
TimeLast := TimeCurrent;
{endregion}
</xhtml>
          </ST>
        </body>
