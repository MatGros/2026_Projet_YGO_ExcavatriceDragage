    <pous>
      <pou name="FB_ContactorProtector" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Autorisation (FALSE =&gt; Cmd=FALSE, Ready=FALSE)</xhtml>
              </documentation>
            </variable>
            <variable name="Request">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Demande de commande contacteur (niveau)</xhtml>
              </documentation>
            </variable>
            <variable name="Cfg_MinInterval">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#500ms" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Intervalle mini entre deux activations</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [STAT] Garde active</xhtml>
              </documentation>
            </variable>
            <variable name="Allowed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [STAT] TRUE = nouvelle activation possible (hors intervalle)</xhtml>
              </documentation>
            </variable>
            <variable name="Cmd">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [ACT]  Commande filtree a cabler au contacteur</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="ReqRise">
              <type>
                <derived name="R_TRIG" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Front montant Request</xhtml>
              </documentation>
            </variable>
            <variable name="ReqFall">
              <type>
                <derived name="F_TRIG" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Front descendant Request</xhtml>
              </documentation>
            </variable>
            <variable name="TonInterval">
              <type>
                <derived name="TON" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Tempo intervalle mini (armee a la retombee)</xhtml>
              </documentation>
            </variable>
            <variable name="InhibitActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Intervalle en cours -&gt; nouvelle activation bloquee</xhtml>
              </documentation>
            </variable>
            <variable name="ActivationLatched">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Activation autorisee en cours (passe toute la duree de Request)</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🛡️ FB_ContactorProtector — Garde anti-chatter avant sortie contacteur
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : à placer juste avant une sortie contacteur puissance (comme un
      interlock). Une activation autorisée passe intégralement ; à sa retombée,
      aucune nouvelle activation avant Cfg_MinInterval. Empêche le cyclage
      rapide destructif quelle que soit la source (bug logique, spam, bypass).
   🔒 Sécurité positive : Enable=FALSE =&gt; Cmd=FALSE. Ne force jamais une sortie.
   📄 Doc métier : DOC/STDS/CODE_QUALITY_STANDARDS.md §2quinquies
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

IF NOT Enable THEN
    Cmd := FALSE;
    Ready := FALSE;
    Allowed := FALSE;
    InhibitActive := FALSE;
    ActivationLatched := FALSE;
    TonInterval(IN := FALSE);
ELSE
    Ready := TRUE;
    ReqRise(CLK := Request);
    ReqFall(CLK := Request);

    // Intervalle : arme a la retombee d'une activation, tient Cfg_MinInterval
    IF ReqFall.Q THEN
        InhibitActive := TRUE;
    END_IF;
    TonInterval(IN := InhibitActive, PT := Cfg_MinInterval);
    IF TonInterval.Q THEN
        InhibitActive := FALSE;
    END_IF;

    // Nouvelle activation autorisee seulement hors intervalle ; ensuite elle passe
    // integralement (non decoupee) tant que Request est maintenu.
    IF ReqRise.Q AND NOT InhibitActive THEN
        ActivationLatched := TRUE;
    END_IF;
    IF NOT Request THEN
        ActivationLatched := FALSE;
    END_IF;

    Allowed := NOT InhibitActive;
    Cmd := ActivationLatched;
END_IF;
</xhtml>
          </ST>
        </body>
