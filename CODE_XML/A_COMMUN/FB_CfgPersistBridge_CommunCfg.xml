    <pous>
      <pou name="FB_CfgPersistBridge_CommunCfg" pouType="functionBlock">
        <interface>
          <inputVars />
          <outputVars>
            <variable name="JustRestored">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
          <inOutVars>
            <variable name="Hmi">
              <type>
                <derived name="ST_CommunCfg" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🖥️ ex. GVL_IHM.Commun.Cfg</xhtml>
              </documentation>
            </variable>
            <variable name="Persist">
              <type>
                <derived name="ST_CommunCfg" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">💾 ex. GVL_PERSISTENT._CommunCfgPersist</xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🌉 FB_CfgPersistBridge_CommunCfg — Pont persistance générique pour ST_CommunCfg
   ───────────────────────────────────────────────────────────────
   🎯 Voir FB_CfgPersistBridge_SyncCfg.st (Lot 3a) pour la logique de référence — identique,
   seul le type ST_CommunCfg change.
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

JustRestored := FALSE;
IF NOT Hmi.Initialized THEN
    Hmi := Persist;
    Hmi.Initialized := TRUE;
    JustRestored := TRUE;
ELSE
    Persist := Hmi;
END_IF;
</xhtml>
          </ST>
        </body>
        <addData>
