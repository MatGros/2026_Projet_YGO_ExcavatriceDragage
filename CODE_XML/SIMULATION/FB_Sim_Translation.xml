              <type>
                <derived name="FB_CycleTime" />
              </type>
            </variable>
            <variable name="PositionProgress">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">0=Trémie ... 5=Maintenance</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedPctBounded">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="PositionIncrement">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="Initialized">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
            </variable>
            <variable name="CST_PositionAtTremie">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
            </variable>
            <variable name="CST_PositionAtPV">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="1" />
              </initialValue>
            </variable>
            <variable name="CST_PositionAtP2">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="2" />
              </initialValue>
            </variable>
            <variable name="CST_PositionAtP1">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="3" />
              </initialValue>
            </variable>
            <variable name="CST_PositionAtMaintenance">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="5" />
              </initialValue>
            </variable>
            <variable name="CST_PositionSegmentCount">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="5" />
              </initialValue>
            </variable>
            <variable name="CST_MinFullTravelTimeS">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.1" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Protection division : modèle sans dynamique sous ce seuil</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🧪 FB_Sim_Translation — Progression capteurs simulés M3
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Produit les cinq capteurs de position M3 par progression continue
      de Trémie vers Maintenance. Le modèle ne publie que les six mots valides
      de FB_Translation_PositionDecoder : 11111 → 01111 → 00111 → 00011 →
      00001 → 00000.
   🔒 Le modèle est une source d'entrée confinée derrière HwIn ; il ne pilote
      aucune sortie réelle. Un override manuel valide est appliqué par
      FB_SimBench, pas par ce FB.
   📄 Docs : DOC/AF/AF_Partie-13_Fonction_Simulation_v2.3.md
             DOC/AF/AF_Partie-11_Fonction_Translation_v2.2.md
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

// === IMPLEMENTATION ===

IF NOT Enable THEN
    // Prochain démarrage déterministe sur P2, comme l'ancien modèle de banc.
    PositionProgress := CST_PositionAtP2;
    Initialized := FALSE;
    PosTremie := FALSE;
    PosPV := FALSE;
    PosP2 := FALSE;
    PosP1 := FALSE;
    PosMaintenance := FALSE;
    RETURN;
END_IF;

IF NOT Initialized THEN
    PositionProgress := CST_PositionAtP2;
    Initialized := TRUE;
END_IF;

instCycleTime(DefaultValueS := 0.010);
SpeedPctBounded := LIMIT(0.0, ABS(SpeedRefPct), 100.0);

// Une vitesse à 100 % parcourt les cinq segments uniformes pendant FullTravelTimeS.
// Direction sémantique : +1 réduit la progression vers Trémie ; -1 l'augmente vers Maintenance.
IF FullTravelTimeS &gt;= CST_MinFullTravelTimeS THEN
    PositionIncrement := (SpeedPctBounded / 100.0)
                         * (CST_PositionSegmentCount / FullTravelTimeS)
                         * instCycleTime.CycleTimeS;
ELSE
    PositionIncrement := 0.0;
END_IF;

IF Direction = 1 THEN
    PositionProgress := MAX(CST_PositionAtTremie, PositionProgress - PositionIncrement);
ELSIF Direction = -1 THEN
    PositionProgress := MIN(CST_PositionAtMaintenance, PositionProgress + PositionIncrement);
END_IF;

// Réinitialisation explicite : aucune valeur transitoire héritée d'une zone précédente.
PosTremie := FALSE;
PosPV := FALSE;
PosP2 := FALSE;
PosP1 := FALSE;
PosMaintenance := FALSE;

// Chaque intervalle correspond à un seul mot thermomètre valide.
IF PositionProgress &lt;= CST_PositionAtTremie THEN
    PosTremie := TRUE;
    PosPV := TRUE;
    PosP2 := TRUE;
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt;= CST_PositionAtPV THEN
    PosPV := TRUE;
    PosP2 := TRUE;
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt;= CST_PositionAtP2 THEN
    PosP2 := TRUE;
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt;= CST_PositionAtP1 THEN
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt; CST_PositionAtMaintenance THEN
    PosMaintenance := TRUE;
END_IF;
</xhtml>
          </ST>
        </body>
