              </type>
              <initialValue>
                <simpleValue value="8" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Temps complet Trémie→Maintenance à 100 %, simulation seulement</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
