    <pous>
      <pou name="FB_Sim_SuspendedLoad" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="BrakeMechanicallyOpen">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="CartAcceleration_Mps2">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="Length_M">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="1.5" />
              </initialValue>
            </variable>
            <variable name="Damping">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.35" />
              </initialValue>
            </variable>
            <variable name="ReactionGain_Mps2">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.2" />
              </initialValue>
            </variable>
            <variable name="CycleTime_S">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.01" />
              </initialValue>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Angle_Rad">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="AngularVelocity_RadPerS">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="VelocityReaction_Mps">
              <type>
                <REAL />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="AngularAccel_RadPerS2">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="CST_Gravity_Mps2">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="9.81" />
              </initialValue>
            </variable>
            <variable name="CST_MinLength_M">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.1" />
              </initialValue>
            </variable>
            <variable name="CST_MaxAngle_Rad">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.6" />
              </initialValue>
            </variable>
            <variable name="CST_MaxAngularVelocity_RadPerS">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="4" />
              </initialValue>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">DOC: DOC/AF/AF_Partie-13_Fonction_Simulation_v2.5.md
   Pendule reduit : reaction sur chariot sans injection DI directe.</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

IF NOT Enable THEN
    Ready := FALSE;
    Angle_Rad := 0.0;
    AngularVelocity_RadPerS := 0.0;
    VelocityReaction_Mps := 0.0;
    RETURN;
END_IF;

VelocityReaction_Mps := 0.0;
IF Length_M &gt; CST_MinLength_M THEN
    AngularAccel_RadPerS2 := -(CST_Gravity_Mps2 / Length_M) * Angle_Rad
        - MAX(0.0, Damping) * AngularVelocity_RadPerS
        - CartAcceleration_Mps2 / Length_M;
    AngularVelocity_RadPerS := LIMIT(-CST_MaxAngularVelocity_RadPerS,
        AngularVelocity_RadPerS + AngularAccel_RadPerS2 * CycleTime_S, CST_MaxAngularVelocity_RadPerS);
    Angle_Rad := LIMIT(-CST_MaxAngle_Rad, Angle_Rad + AngularVelocity_RadPerS * CycleTime_S,
        CST_MaxAngle_Rad);
    IF BrakeMechanicallyOpen THEN
        VelocityReaction_Mps := ReactionGain_Mps2 * Angle_Rad * CycleTime_S;
    END_IF;
END_IF;
Ready := TRUE;
</xhtml>
          </ST>
        </body>
