        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

IF NOT Enable THEN
    Ready := FALSE;
    Torque_Nm := 0.0;
    RETURN;
END_IF;

Torque_Nm := 2.0 * MaxTorque_Nm
    / (Slip_Ratio / SlipAtMaxTorque_Ratio + SlipAtMaxTorque_Ratio / Slip_Ratio)
    * VoltageRatio2;

Ready := TRUE;
</xhtml>
          </ST>
        </body>
