          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>cce43b3e-95fc-50e1-8d52-471f9c714033</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="FB_Sim_KlossTorque" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== CONTRAT LIGHT ===
--&gt; [CMD] Autorisation generale FB</xhtml>
              </documentation>
            </variable>
            <variable name="MaxTorque_Nm">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== CALCUL ===
--&gt; [CFG] Cmax decrochage</xhtml>
              </documentation>
            </variable>
            <variable name="Slip_Ratio">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Glissement (jamais 0.0 -- protege par l'appelant)</xhtml>
              </documentation>
            </variable>
            <variable name="SlipAtMaxTorque_Ratio">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] gmax au point de fonctionnement courant</xhtml>
              </documentation>
            </variable>
            <variable name="VoltageRatio2">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="1" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] (U_act/U_nom)^2</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [STAT] FB pret</xhtml>
              </documentation>
            </variable>
            <variable name="Torque_Nm">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] Couple electromagnetique resultant</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🧪 FB_Sim_KlossTorque — Couple electromagnetique, formule de Kloss
   ───────────────────────────────────────────────────────────────
   🎯 Role : Calcul factorise du couple moteur asynchrone (Kloss), reutilise
   par le regime etabli et le test de decrochage a glissement bloque.
   📄 Doc metier : DOC/WFLOW/CONTRACTS/PLAN_T317_SIMBENCH_TREUIL_ELECTRIQUE.md
   🧩 Dependances : aucune (calcul pur)
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

IF NOT Enable THEN
    Ready := FALSE;
    Torque_Nm := 0.0;
    RETURN;
END_IF;

Torque_Nm := 2.0 * MaxTorque_Nm
    / (Slip_Ratio / SlipAtMaxTorque_Ratio + SlipAtMaxTorque_Ratio / Slip_Ratio)
    * VoltageRatio2;

Ready := TRUE;
</xhtml>
          </ST>
        </body>
