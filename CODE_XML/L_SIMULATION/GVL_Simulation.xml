    <data name="http://www.3s-software.com/plcopenxml/globalvars" handleUnknown="implementation">
      <globalVars name="GVL_Simulation">
        <variable name="SimulationModeActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🔑 Bit maître — rien n'est simulé si FALSE (machine réelle)</xhtml>
          </documentation>
        </variable>
        <variable name="SimulationBypassActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🎭 Master Bypass Essais Banc — arme les bypass Meca (Safety/Process) en mode MAINT
(inopérant sur machine réelle). Arme aussi les limites banc TopLimitSwitch,
TopLimitSoftware et CableLimitSwitch, exclusivement sous le triple gate
SimulationModeActive AND SimWinchActive AND SimulationBypassActive.
Défaut TRUE : pré-arme le bypass banc dès le boot (n'agit que si SimulationModeActive AND SimWinchActive).
Permet de travailler en banc sans faux blocage Meca au homing sans mouvement.</xhtml>
          </documentation>
        </variable>
        <variable name="SimWinchActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🌐 Activation par domaine (simulé si SimulationModeActive AND Sim&lt;Domaine&gt;Active)
M1+M2 : codeurs, contacteurs, freins, thermiques, capteur haut, câble tendu</xhtml>
          </documentation>
        </variable>
        <variable name="SimTopPositionActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Stimulus explicite du capteur haut commun pour qualifier le référencement benne.
TRUE = capteur haut actif; FALSE = position libre. Inopérant hors simulation.</xhtml>
          </documentation>
        </variable>
        <variable name="SimTranslationActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">M3 : AC600, fréquence, 5 capteurs et frein</xhtml>
          </documentation>
        </variable>
        <variable name="SimOperatorActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Joystick : bus CANopen, axes RawX/RawY et homme-mort brut</xhtml>
          </documentation>
        </variable>
        <variable name="SimSafetyActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">AU, contacteur puissance, phases, thermiques, Kobold et auxiliaires communs</xhtml>
          </documentation>
        </variable>
        <variable name="SimM3SensorsWordOverrideActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">↔️ STIMULI TRANSLATION M3 — override manuel du mot capteurs, sinon modèle dynamique.
Bit4=Trémie, bit3=PV, bit2=PVP2, bit1=P1, bit0=Maintenance ; 16#07 = position P2 (00111).
TRUE = SimM3SensorsWord remplace le modèle ; réserver aux injections ciblées</xhtml>
          </documentation>
        </variable>
        <variable name="SimM3SensorsWord">
          <type>
            <BYTE />
          </type>
          <initialValue>
            <simpleValue value="16#07" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Mot manuel valide nominal : P2</xhtml>
          </documentation>
        </variable>
        <variable name="SimM3SensorIntermittenceActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Episode capteur dynamique : FALSE conserve le profil nominal. TRUE publie des
pertes/reprises deterministes apres un franchissement mecanique, pour qualifier
le decodeur et les fins de course sans ecrire directement dans le metier.</xhtml>
          </documentation>
        </variable>
        <variable name="SimM3SensorStabilizationS">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="1" />
          </initialValue>
        </variable>
        <variable name="SimM3SensorElectricalDelayS">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.01" />
          </initialValue>
        </variable>
        <variable name="SimM3SensorIntermittencePeriodS">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.12" />
          </initialValue>
        </variable>
        <variable name="SimM3SensorHysteresis_M">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.02" />
          </initialValue>
        </variable>
        <variable name="SimM3SensorLoadAngleTriggerRad">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.01" />
          </initialValue>
        </variable>
        <variable name="SimM3SensorScenarioSeed">
          <type>
            <UDINT />
          </type>
          <initialValue>
            <simpleValue value="3001" />
          </initialValue>
        </variable>
        <variable name="SimJoystickLeft_Rev_TREMIE_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🕹️ STIMULI OPÉRATEUR — les boutons directionnels imposent 0/5000/10000 ; combinaison = neutre.
Translation M3 Arrière vers Trémie (RawX=0, RawY=5000)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRight_Fwd_MAINT_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation M3 Avant vers Maintenance (RawX=10000, RawY=5000)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickFwd_Up_Close_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Treuils Ascending M1/M2 / Fermeture Benne M2 (RawX=5000, RawY=10000)</xhtml>
