  <addData>
    <data name="http://www.3s-software.com/plcopenxml/globalvars" handleUnknown="implementation">
      <globalVars name="GVL_Simulation">
        <variable name="SimulationModeActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🔑 Bit maître — rien n'est simulé si FALSE (machine réelle)</xhtml>
          </documentation>
        </variable>
        <variable name="SimulationBypassActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="TRUE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🎭 Master Bypass Essais Banc — arme les bypass Meca (Safety/Process) en mode MAINT
(inopérant sur machine réelle). ❗ N'arme PLUS les limites réelles (TopLimitSwitch /
TopLimitSoftware / LimitLegal) : la protection de montée/descente reste active au banc.
Défaut TRUE : pré-arme le bypass banc dès le boot (n'agit que si SimulationModeActive AND SimWinchActive).
Permet de travailler en banc sans faux blocage Meca au homing sans mouvement.</xhtml>
          </documentation>
        </variable>
        <variable name="SimWinchActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🌐 Activation par domaine (simulé si SimulationModeActive AND Sim&lt;Domaine&gt;Active)
M1+M2 : codeurs, contacteurs, freins, thermiques, capteur haut, câble tendu</xhtml>
          </documentation>
        </variable>
        <variable name="SimTranslationActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">M3 : AC600, fréquence, 5 capteurs et frein</xhtml>
          </documentation>
        </variable>
        <variable name="SimOperatorActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Joystick : bus CANopen, axes RawX/RawY et homme-mort brut</xhtml>
          </documentation>
        </variable>
        <variable name="SimSafetyActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">AU, contacteur puissance, phases, thermiques, Kobold et auxiliaires communs</xhtml>
          </documentation>
        </variable>
        <variable name="SimM3SensorsWordOverrideActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">↔️ STIMULI TRANSLATION M3 — override manuel du mot capteurs, sinon modèle dynamique.
Bit4=Trémie, bit3=PV, bit2=PVP2, bit1=P1, bit0=Maintenance ; 16#07 = position P2 (00111).
TRUE = SimM3SensorsWord remplace le modèle ; réserver aux injections ciblées</xhtml>
          </documentation>
        </variable>
        <variable name="SimM3SensorsWord">
          <type>
            <BYTE />
          </type>
          <initialValue>
            <simpleValue value="16#07" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Mot manuel valide nominal : P2</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickLeft_Rev_TREMIE_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🕹️ STIMULI OPÉRATEUR — les boutons directionnels imposent 0/5000/10000 ; combinaison = neutre.
Translation M3 Arrière vers Trémie (RawX=0, RawY=5000)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRight_Fwd_MAINT_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation M3 Avant vers Maintenance (RawX=10000, RawY=5000)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickFwd_Up_Close_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Treuils Montée M1/M2 / Fermeture Benne M2 (RawX=5000, RawY=10000)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRev_Down_Open_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Treuils Descente M1/M2 / Ouverture Benne M2 (RawX=5000, RawY=0)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRawX">
          <type>
            <INT />
          </type>
          <initialValue>
            <simpleValue value="5000" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Stimulus analogique avancé 0..10000, utilisé sans bouton directionnel</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRawY">
          <type>
            <INT />
          </type>
          <initialValue>
            <simpleValue value="5000" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Stimulus analogique avancé 0..10000, utilisé sans bouton directionnel</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRawButton">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Homme-mort brut : TRUE = bouton joystick appuyé</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickOvershoot_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = dépassement de montée au-delà de 100% (défaut capteur hors plage)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickBagotement_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = bagotement au relâchement (petit balancement autour du neutre)</xhtml>
          </documentation>
        </variable>
        <variable name="SimEncoderSpeedFactor">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="1" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🪝 STIMULI TREUILS — paramètres du modèle codeur et injection ponctuelle d'un défaut synchro.
Multiplicateur vitesse codeurs simulés ; 1.0 = nominal</xhtml>
          </documentation>
        </variable>
        <variable name="SimSyncDeviationInjectM1">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Front montant : ajoute SimSyncDeviationOffset_M à la position M1 simulée</xhtml>
          </documentation>
        </variable>
        <variable name="SimSyncDeviationInjectM2">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Front montant : ajoute SimSyncDeviationOffset_M à la position M2 simulée</xhtml>
          </documentation>
        </variable>
        <variable name="SimSyncDeviationOffset_M">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.5" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Écart signé injecté, mètres ; persiste dans la position simulée jusqu'au reset/preset</xhtml>
          </documentation>
        </variable>
        <variable name="SimKoboldContactValue">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ STIMULI SAFETY — fait capteur amont, jamais une sortie de commande forcée.
TRUE = Kobold détecte un contact fond simulé</xhtml>
          </documentation>
        </variable>
