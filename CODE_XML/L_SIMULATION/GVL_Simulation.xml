          <initialValue>
            <simpleValue value="5000" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Stimulus analogique avancé 0..10000, utilisé sans bouton directionnel</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRawY">
          <type>
            <INT />
          </type>
          <initialValue>
            <simpleValue value="5000" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Stimulus analogique avancé 0..10000, utilisé sans bouton directionnel</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickRawButton">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Homme-mort brut : TRUE = bouton joystick appuyé</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickOvershoot_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = dépassement de montée au-delà de 100% (défaut capteur hors plage)</xhtml>
          </documentation>
        </variable>
        <variable name="SimJoystickBagotement_Active">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = bagotement au relâchement (petit balancement autour du neutre)</xhtml>
          </documentation>
        </variable>
        <variable name="SimBtnTremie">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🎛️ STIMULI BOUTONS IHM M3 — simulation des boutons IHM Translation M3 (Trémie/Maintenance).
Pilotent GVL_IHM.M3Translation.Cmd.BtnTremie/BtnMaintenance UNIQUEMENT en mode simulation
ET quand JoyMaster est inactif (le joystick prime sinon). Défaut FALSE = bouton relâché.
TRUE = bouton IHM "vers Trémie" simulé appuyé</xhtml>
          </documentation>
        </variable>
        <variable name="SimBtnMaintenance">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = bouton IHM "vers Maintenance" simulé appuyé</xhtml>
          </documentation>
        </variable>
        <variable name="SimEncoderSpeedFactor">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="1" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🪝 STIMULI TREUILS — paramètres du modèle codeur et injection ponctuelle d'un défaut synchro.
Multiplicateur vitesse codeurs simulés ; 1.0 = nominal</xhtml>
          </documentation>
        </variable>
        <variable name="SimWinchCoast_M">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.35" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Roulis inertiel treuils simulés après coupure des relais (m). 0 = arrêt net. ~0.35 = la benne roule quelques dizaines de cm après l'arrêt commandé -&gt; finit dans la bande ouvert/fermé (±CoherenceLimitM) malgré l'anticipation d'arrêt (Close 1.0 / Open 1.3).</xhtml>
          </documentation>
        </variable>
        <variable name="SimSyncDeviationInjectM1">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Front montant : ajoute SimSyncDeviationOffset_M à la position M1 simulée</xhtml>
          </documentation>
        </variable>
        <variable name="SimSyncDeviationInjectM2">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Front montant : ajoute SimSyncDeviationOffset_M à la position M2 simulée</xhtml>
          </documentation>
        </variable>
        <variable name="SimSyncDeviationOffset_M">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.5" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Écart signé injecté, mètres ; persiste dans la position simulée jusqu'au reset/preset</xhtml>
          </documentation>
        </variable>
        <variable name="SimWinchDynamicsActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=== PROFIL SIMPLE / DYNAMIQUES TREUILS ===
FALSE = retour historique instantané ; TRUE = applique les trois réglages synthétiques ci-dessous.</xhtml>
          </documentation>
        </variable>
        <variable name="SimWinchSpeedReportTauS">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.15" />
          </initialValue>
        </variable>
        <variable name="SimWinchBrakeOpenDelayS">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.1" />
          </initialValue>
        </variable>
        <variable name="SimWinchBrakeCloseDelayS">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.09" />
          </initialValue>
        </variable>
        <variable name="SimWinchElectricalDiagnosticsActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Diagnostic électrique isolé : ne pilote jamais une entrée safety ou une commande moteur.</xhtml>
          </documentation>
        </variable>
        <variable name="SimM2TensionedCableFaultInject">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Injection safety explicite : TRUE simule le câble non tendu ; FALSE = signal nominal sain.</xhtml>
          </documentation>
        </variable>
        <variable name="SimM2CoupledDescentModelActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🪝 MODÈLE M2 / KOBOLD — réglages de banc, actifs exclusivement via FB_SimBench.
M2 est calculé depuis M1 pendant une descente BOTH effective. Le coefficient est
issu de la trace 2026-09-05 ; TRUE par défaut pour reproduire le comportement mesuré.</xhtml>
          </documentation>
        </variable>
        <variable name="SimM2CoupledDescentFactor">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="0.9333" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Ratio déplacement M2 / déplacement M1 en descente BOTH (mesure: 0,6 m / 9 m)</xhtml>
          </documentation>
        </variable>
        <variable name="SimKoboldAutoModeActive">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Le mode auto est armé sur entrée SEMI_AUTO pendant la simulation et libéré à sa sortie.
Une désactivation opérateur pendant une plongée est prise en compte à la plongée suivante.</xhtml>
          </documentation>
        </variable>
        <variable name="SimKoboldAutoDepth_M">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="-15" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Altitude fond signée (m), négative sous l'eau</xhtml>
          </documentation>
        </variable>
        <variable name="SimKoboldPowerUpTime">
          <type>
            <TIME />
          </type>
          <initialValue>
            <simpleValue value="TIME#50ms" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Réponse sonde après alimentation Kobold</xhtml>
          </documentation>
        </variable>
        <variable name="SimKoboldCoast_M">
          <type>
            <REAL />
          </type>
          <initialValue>
            <simpleValue value="1" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">Roulis déterministe M1/M2 après arrêt Kobold (m)</xhtml>
          </documentation>
        </variable>
        <variable name="SimKoboldContactValue">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ STIMULI SAFETY — fait capteur amont, jamais une sortie de commande forcée.
TRUE = Kobold détecte un contact fond simulé</xhtml>
          </documentation>
        </variable>
        <variable name="SimChainOk">
          <type>
            <BOOL />
          </type>
          <initialValue>
            <simpleValue value="FALSE" />
          </initialValue>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">🧪 Contrôle granulaire de la chaîne AU : TRUE = simuler la chaîne fermée (on peut armer) ;
FALSE = chaîne ouverte (on ne peut pas armer). Défaut FALSE → à la ré-entrée en simu,
la chaîne est ouverte et le contacteur non engagé (on n'a pas armé).</xhtml>
          </documentation>
        </variable>
