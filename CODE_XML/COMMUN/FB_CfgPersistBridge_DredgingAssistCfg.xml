          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🌉 FB_CfgPersistBridge_DredgingAssistCfg — Pont IHM/persistance prélèvement
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

JustRestored := FALSE;
IF NOT Hmi.Initialized THEN
    Hmi := Persist;
    Hmi.Initialized := TRUE;
    JustRestored := TRUE;
ELSE
    Persist := Hmi;
END_IF;
</xhtml>
          </ST>
        </body>
