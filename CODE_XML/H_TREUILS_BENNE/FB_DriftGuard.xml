    <pous>
      <pou name="FB_DriftGuard" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Arm">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== COMMANDES ET SEUILS ===
--&gt; [CMD] Condition d'armement de la surveillance</xhtml>
              </documentation>
            </variable>
            <variable name="PositionM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [HW] Position courante a surveiller (m)</xhtml>
              </documentation>
            </variable>
            <variable name="ToleranceM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Tolerance de derive maximale autorisee (m)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="RefPosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MESURES ET ETATS ===
&lt;-- [DIAG] Position de reference capturee a l'armement (m)</xhtml>
              </documentation>
            </variable>
            <variable name="DriftM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] Derive absolue courante (m)</xhtml>
              </documentation>
            </variable>
            <variable name="Violation">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [STAT] Alarme derive maximale depassee</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="WasArmed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== VARIABLES LOCALES INTERNES ===
. [LOC] Memoire etat armement cycle precedent</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   📐 FB_DriftGuard — Détection de dérive de position sous armement
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Capture position de référence et détection de dérive anormale
   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
   🔌 Interface : Brique interne de sécurité (compose FB_Safety_Winch)
   🔒 Sécurité : Détection de mouvement non commandé et glissement
   =======================================================================</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_DriftGuard) ===

IF Arm THEN
    IF NOT WasArmed THEN
        RefPosM := PositionM;   // Capture au 1er cycle armé uniquement
        WasArmed := TRUE;
    END_IF;
    DriftM := ABS(PositionM - RefPosM);
    Violation := DriftM &gt; ToleranceM;
ELSE
    WasArmed := FALSE;
    DriftM := 0.0;
    Violation := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
