              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== BYPASSES ET SIMULATION ===
--&gt; [TST] Neutralise la surveillance ecart</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="DeltaPosM">
