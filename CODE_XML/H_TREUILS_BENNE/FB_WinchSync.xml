              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MESURES ET DIAGNOSTICS DE SYNCHRO ===
&lt;-- [DIAG] Ecart absolu position |M1 - M2| (m)</xhtml>
              </documentation>
            </variable>
            <variable name="SignedDeltaPosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] Ecart signe position (M1 - M2) (m)</xhtml>
              </documentation>
            </variable>
            <variable name="SyncDeviationWarn">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] Seuil 1 depasse : signaler / forcer palier 1</xhtml>
              </documentation>
            </variable>
