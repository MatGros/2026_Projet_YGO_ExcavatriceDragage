              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== REGLAGES ET CONFIGURATION ===
--&gt; [CFG] Seuil 1 (Warn) — ecart max avant alerte (m)</xhtml>
              </documentation>
            </variable>
            <variable name="CfgSyncCriticalToleranceM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.5" />
              </initialValue>
              <documentation>
