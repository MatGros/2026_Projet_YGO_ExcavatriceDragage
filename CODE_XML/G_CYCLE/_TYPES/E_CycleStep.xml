        <addData>
          <data name="http://www.3s-software.com/plcopenxml/enumvaluedocumentation" handleUnknown="implementation">
            <EnumValueDocumentation>
              <EnumValue>
                <Name>X0_PREPARATION</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Début de graphe : à la TRÉMIE, treuils en position HAUTE</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X1_HOMING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Vitesses lentes pour chercher capteur top + référencement</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X2_WORK_POS_SELECT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Sélection cible Trémie/P1/Maintenance + translation validée</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X3_OPEN_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Ouverture benne (si déjà ouverte -&gt; passe vite)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X4_DESCEND_OPEN</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Plongée benne ouverte, M1+M2 synchro, Kobold mesure ON</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X5_BOTTOM_CONFIRMED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fond validé (FB_DiveSearch) ; arrêt descente</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X6_CLOSE_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fermeture benne — tolérance « à peu près fermé »</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X7_CTRL_ASCENT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Remontée palier 1 de contrôle</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X8_ASCENT_LOADED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Remontée nominale jusqu'à limite haute</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X9_DRAIN_PAUSE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Égouttage temporisé — durée configurable / passable IHM</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X10_TRANSLATE_DUMP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation vers trémie (départ P1) + avertissements IHM</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X11A_DUMP_ARRIVE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Arrivée trémie : treuils à l'arrêt, attente geste opérateur (ex-X11)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X13_DONE_SYNC</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fin de cycle, synchronisation finale (R4) + compteur + durée cycle</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>STABILIZING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">État d'attente/stabilisation — pas une erreur</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X11B_DUMP_OPEN</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Vidage à la trémie : ouverture benne, LES DEUX treuils à l'arrêt (aucune descente couplée)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X11C_DUMP_REPOSITION</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repositionnement couplé M1+M2 (option IHM maintenue) : descente lente pour dégager la vidange, retour X11b au relâchement</xhtml>
                </Documentation>
              </EnumValue>
            </EnumValueDocumentation>
