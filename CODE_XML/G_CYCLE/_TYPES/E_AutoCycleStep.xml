        <addData>
          <data name="http://www.3s-software.com/plcopenxml/enumvaluedocumentation" handleUnknown="implementation">
            <EnumValueDocumentation>
              <EnumValue>
                <Name>AX0_REPOS</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repos / park : toutes commandes 0, etat neutre</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX1_HOMING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Verif reference machine (HomedM1/M2) - aucun mouvement</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX2_TRANSLATE_P1</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation vers P1 au joystick (pas de selection, comme maintenance)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX3_OPEN_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Ouverture benne (si deja ouverte -&gt; passe vite)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX4_DESCEND_OPEN</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Plongee benne ouverte, M1+M2 synchro, Kobold mesure ON</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX5_BOTTOM_CONFIRMED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fond confirme (Kobold) ; montee lente securisee</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX6_CLOSE_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fermeture benne - tolerance a peu pres ferme</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX7_CTRL_ASCENT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Remontee palier 1 de controle + surveillance ecart M1/M2</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX8_ASCENT_LOADED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Remontee en charge jusqu'a limite haute</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX9_DRAIN_PAUSE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Egouttage temporise - duree configurable / passable IHM</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX10_TRANSLATE_DUMP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation vers tremie (depart P1) + avertissements IHM</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX11A_DUMP_ARRIVE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Arrivee tremie : treuils a l'arret, attente geste operateur</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX13_DONE_SYNC</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fin de cycle : compteur vidages + duree cycle</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX_STAB</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repli defaut / stabilisation - pas une erreur</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX11B_DUMP_OPEN</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Vidage tremie : ouverture benne, LES DEUX treuils a l'arret</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX11C_DUMP_REPOSITION</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repositionnement couple M1+M2 (option IHM maintenue), retour AX11B au relachement</xhtml>
                </Documentation>
              </EnumValue>
            </EnumValueDocumentation>
