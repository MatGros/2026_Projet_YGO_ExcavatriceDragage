              <EnumValue>
                <Name>HX0_REPOS</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repos : N1 libre bloque si NOT Homed, M3 bloque N1/SEMI, attente 5s BP joy N1 ou BtnStart N2</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>HX1_BUCKET_PREPARE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">M2 seul palier 1, ouv + ferm sans butees soft, garde continue 20s + decompte, BtnValidate neutre</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>HX2_CLIMB_TO_TOP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Couple M1+M2 palier 1 : montee lente + detente 2s max/geste, viser avant TOP sans toucher</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>HX3_TOP_CLEARANCE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Contact TOP = perdu/surcourse -&gt; montee interdite, descente ~4s apres relachement TOP -&gt; retour HX1</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>HX4_FINAL_CONFIRM</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Arret avant TOP + avertissement -&gt; BtnValidate neutre -&gt; preset 8.5m M1+M2 + CommitClose -&gt; Homed</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>HX7_FAILED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Echec / abandon : coupure mouvements, purge etats, attente Reset conscient</xhtml>
                </Documentation>
              </EnumValue>
            </EnumValueDocumentation>
