    <pous>
      <pou name="FB_Translation_PositionEstimator" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Active le calcul</xhtml>
              </documentation>
            </variable>
            <variable name="Reset">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Front d'acquittement / réinitialisation</xhtml>
              </documentation>
            </variable>
            <variable name="DriveActualFreqHz">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Fréquence réelle variateur en Hz (ex: 5.0 Hz)</xhtml>
              </documentation>
            </variable>
            <variable name="Direction">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sens effectif : +1 = Fwd (vers Trémie), -1 = Rev (vers Maint), 0 = Arrêt</xhtml>
              </documentation>
            </variable>
            <variable name="SensorMaintenance">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">5 Capteurs de position fixes
Capteur 0 : Maintenance (0.0 m)</xhtml>
              </documentation>
            </variable>
            <variable name="SensorP1">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Capteur 1 : P1 (ex: 6.0 m)</xhtml>
              </documentation>
            </variable>
            <variable name="SensorP2">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Capteur 2 : P2 (ex: 14.0 m)</xhtml>
              </documentation>
            </variable>
            <variable name="SensorPV">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Capteur 3 : PV (ex: 21.0 m)</xhtml>
              </documentation>
            </variable>
            <variable name="SensorTremie">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Capteur 4 : Trémie (ex: 25.0 m)</xhtml>
              </documentation>
            </variable>
            <variable name="PosMaintenanceM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Positions de référence calibrées (mètres) depuis GVL_PERSISTENT</xhtml>
              </documentation>
            </variable>
            <variable name="PosP1M">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="6" />
              </initialValue>
            </variable>
            <variable name="PosP2M">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="14" />
              </initialValue>
            </variable>
            <variable name="PosPVM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="21" />
              </initialValue>
            </variable>
            <variable name="PosTremieM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="25" />
              </initialValue>
            </variable>
            <variable name="GainMetersPerHzSec">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.008333" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Gain de vitesse : mètres parcourus par Hz par seconde (ex: 50 Hz = 0.416 m/s =&gt; Gain = 0.008333 m/Hz.s)</xhtml>
              </documentation>
            </variable>
            <variable name="PersistedPositionM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🆕 2026-08-06 : reprise après reboot — l'appelant recopie en continu PositionEstimatedM/
       Initialized vers GVL_PERSISTENT (pas de bridge dédié, simple recopie comme _TranslationSetFreq_Hz)
       et réinjecte ici au redémarrage, pour ne pas perdre l'estimation odométrique à chaque coupure.</xhtml>
              </documentation>
            </variable>
            <variable name="PersistedInitialized">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="PositionEstimatedM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Position continue estimée en mètres</xhtml>
              </documentation>
            </variable>
            <variable name="Initialized">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🆕 exposé pour recopie persistante côté appelant</xhtml>
              </documentation>
            </variable>
            <variable name="Recalibrated">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Pulse 1 cycle lors d'un recalage sur capteur</xhtml>
              </documentation>
            </variable>
            <variable name="RecalibratedSensorId">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">0=Maint, 1=P1, 2=P2, 3=PV, 4=Trémie, -1=Aucun</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="TrigTremie">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="TrigPV">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="TrigP2">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="TrigP1">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="TrigMaintenance">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
            <variable name="CycleTimeCalc">
              <type>
                <derived name="FB_CycleTime" />
              </type>
            </variable>
            <variable name="ColdStart">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="TRUE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🆕 seed unique depuis Persisted* au premier scan utile</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   ↔️ FB_Translation_PositionEstimator — Estimateur de Position Continue M3
   ───────────────────────────────────────────────────────────────
   📄 Doc métier : DOC/AF/AF_Partie-11_Fonction_Translation_v2.1.md §3
   🎯 Rôle : Calculer par odométrie (intégration temporelle vitesse/fréquence Hz * sens)
      la position estimée continue en mètres (0.0 m à la Maintenance -&gt; +X m à la Trémie),
      avec re-calage absolu automatique instantané sur le franchissement des 5 capteurs fixes.
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

// === IMPLEMENTATION ===

IF NOT Enable THEN
    Recalibrated := FALSE;
    RecalibratedSensorId := -1;
    RETURN;
END_IF;

IF ColdStart THEN
    PositionEstimatedM := PersistedPositionM;
    Initialized := PersistedInitialized;
    ColdStart := FALSE;
END_IF;

CycleTimeCalc(DefaultValueS := 0.010);
Recalibrated := FALSE;

// 1. Détection des fronts montants sur franchissement des capteurs fixes
TrigTremie(CLK := SensorTremie);
TrigPV(CLK := SensorPV);
TrigP2(CLK := SensorP2);
TrigP1(CLK := SensorP1);
TrigMaintenance(CLK := SensorMaintenance);

// 2. Recalage absolu prioritaire sur contact capteur
IF TrigMaintenance.Q THEN
    PositionEstimatedM := PosMaintenanceM;
    Recalibrated := TRUE;
    RecalibratedSensorId := 0;
ELSIF TrigP1.Q THEN
    PositionEstimatedM := PosP1M;
    Recalibrated := TRUE;
    RecalibratedSensorId := 1;
ELSIF TrigP2.Q THEN
    PositionEstimatedM := PosP2M;
    Recalibrated := TRUE;
    RecalibratedSensorId := 2;
ELSIF TrigPV.Q THEN
    PositionEstimatedM := PosPVM;
    Recalibrated := TRUE;
    RecalibratedSensorId := 3;
ELSIF TrigTremie.Q THEN
    PositionEstimatedM := PosTremieM;
    Recalibrated := TRUE;
    RecalibratedSensorId := 4;
ELSE
    // Initialisation au tout premier démarrage sur le premier capteur actif vu
    IF NOT Initialized THEN
        IF SensorTremie THEN PositionEstimatedM := PosTremieM; Initialized := TRUE;
        ELSIF SensorPV THEN PositionEstimatedM := PosPVM; Initialized := TRUE;
        ELSIF SensorP2 THEN PositionEstimatedM := PosP2M; Initialized := TRUE;
        ELSIF SensorP1 THEN PositionEstimatedM := PosP1M; Initialized := TRUE;
        ELSIF SensorMaintenance THEN PositionEstimatedM := PosMaintenanceM; Initialized := TRUE;
        END_IF;
    END_IF;

    // 3. Intégration temporelle continue (Odométrie cycle par cycle)
    // dX = Direction * (FreqHz * Gain) * dt
    IF Direction &lt;&gt; 0 AND DriveActualFreqHz &gt; 0.1 THEN
        PositionEstimatedM := PositionEstimatedM + (INT_TO_REAL(Direction) * DriveActualFreqHz * GainMetersPerHzSec * CycleTimeCalc.CycleTimeS);
    END_IF;
END_IF;

// Bornage de sécurité pour éviter la dérive infinie hors rail
PositionEstimatedM := LIMIT(PosMaintenanceM - 0.5, PositionEstimatedM, PosTremieM + 0.5);
</xhtml>
          </ST>
        </body>
