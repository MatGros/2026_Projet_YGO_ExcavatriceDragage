        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">==============================================================
   [IHM] ST_Safety_Emergency_HmiCmd -- Commandes IHM pour la chaine AU
   --------------------------------------------------------------
   Role : structure d'echange pour les commandes operateur
          de la chaine d'arret d'urgence (miroir ST_ModesCmd).
   Pattern : identique a GVL_IHM.Modes.Cmd dans le projet reel.
          L'IHM ecrit ces champs, le programme les consomme.
   ==============================================================
    Docs : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.0.md
           DOC/AF/AF_Partie-07_Interface_IHM_v2.0.md</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_Safety_Emergency_HmiState">
        <baseType>
          <struct>
            <variable name="ChainOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">[OK] Etats generaux
Boucle AU fermee (saine)</xhtml>
              </documentation>
            </variable>
            <variable name="ContactorOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Contacteur puissance engage</xhtml>
              </documentation>
            </variable>
            <variable name="PowerCutOffActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Coupure puissance demandee par une safety metier</xhtml>
              </documentation>
            </variable>
            <variable name="Armable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">[AU] Sequence de rearmement
Pret au rearmement (chain OK + pas de lockout + pas de defaut)</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingBusy">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sequence armement en cours</xhtml>
              </documentation>
            </variable>
            <variable name="Step">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Etape sequence (0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm)</xhtml>
              </documentation>
            </variable>
            <variable name="Error">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">[KO] Diagnostics
Synthese defaut</xhtml>
              </documentation>
            </variable>
            <variable name="ErrorId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">bit0=RedundancyTestFailed, bit1=ArmingFailed</xhtml>
              </documentation>
            </variable>
            <variable name="RedundancyTestFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Auto-test A/B a echoue (canal colle/shunte)</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Rearmement echoue (timeout confirmation)</xhtml>
              </documentation>
            </variable>
            <variable name="LockoutActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Verrouillage 5s entre tentatives</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>5488551c-eaa1-56ec-847b-781e247f8eab</ObjectId>
