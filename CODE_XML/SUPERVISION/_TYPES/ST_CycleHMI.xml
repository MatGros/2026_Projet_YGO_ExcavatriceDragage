        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🔄 ST_CycleHMI — Données d'échange IHM du cycle semi-automatique
   ───────────────────────────────────────────────────────────────
   📄 Structuration en Cmd / State / Cfg / Test (2026-07-24), homogène avec ST_WinchHMI.
   🐛 T66 : Cfg protégé par persistance GVL_PERSISTENT (voir PRG_SUPERVISION_CFC.st §2/§3) —
   avant ce lot, SetDepth_M/SetOffset_M n'avaient AUCUN backing persistant (juste un défaut
   compilé dans le DUT), contrairement à tous les autres domaines déjà traités.
   ═══════════════════════════════════════════════════════════════</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_CycleCfg">
        <baseType>
          <struct>
            <variable name="SetDepth_M">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="-12.5" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📐 Profondeur de dragage cible (m, négative)</xhtml>
              </documentation>
            </variable>
            <variable name="SetOffset_M">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="1.5" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📐 Décalage cible de fermeture de la benne (m)</xhtml>
              </documentation>
            </variable>
            <variable name="Initialized">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🚦 flag restauration boot</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
