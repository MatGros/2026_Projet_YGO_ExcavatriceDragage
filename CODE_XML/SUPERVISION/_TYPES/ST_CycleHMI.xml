              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔄 Étape courante du Grafcet</xhtml>
              </documentation>
            </variable>
            <variable name="CycleStateStr">
              <type>
                <string length="80" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📝 Libellé texte de l'étape courante</xhtml>
              </documentation>
            </variable>
            <variable name="SelTarget">
              <type>
                <INT />
              </type>
              <documentation>
