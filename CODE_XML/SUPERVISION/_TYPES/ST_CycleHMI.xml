                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟢 Séquenceur prêt</xhtml>
              </documentation>
            </variable>
            <variable name="Busy">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚙️ Cycle en cours</xhtml>
              </documentation>
            </variable>
            <variable name="Done">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">✅ Cycle terminé</xhtml>
              </documentation>
            </variable>
            <variable name="Error">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔴 Défaut cycle</xhtml>
              </documentation>
            </variable>
            <variable name="ErrorId">
              <type>
                <WORD />
