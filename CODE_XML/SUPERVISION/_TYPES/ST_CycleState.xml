  <types>
    <dataTypes>
      <dataType name="ST_CycleState">
        <baseType>
          <struct>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟢 Séquenceur prêt</xhtml>
              </documentation>
            </variable>
            <variable name="Busy">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚙️ Cycle en cours</xhtml>
              </documentation>
            </variable>
            <variable name="Done">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">✅ Cycle terminé</xhtml>
              </documentation>
            </variable>
            <variable name="Error">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔴 Défaut cycle</xhtml>
              </documentation>
            </variable>
            <variable name="ErrorId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">❌ Code défaut cycle</xhtml>
              </documentation>
            </variable>
            <variable name="CycleStep">
              <type>
                <derived name="E_CycleStep" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔄 Étape courante du Grafcet</xhtml>
              </documentation>
            </variable>
            <variable name="CycleStateStr">
              <type>
                <string length="80" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📝 Libellé texte de l'étape courante</xhtml>
              </documentation>
            </variable>
            <variable name="SelTarget">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🎯 Miroir lecture seule de GVL_IHM.TranslationM3.Cmd.SelTarget</xhtml>
              </documentation>
            </variable>
            <variable name="KoboldContactFond">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Retour physique réel capteur contact de fond Kobold</xhtml>
              </documentation>
            </variable>
            <variable name="KoboldContactorCmd">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Commande contacteur Kobold (calculée par FB_Cycle)</xhtml>
              </documentation>
            </variable>
            <variable name="LimitLegalReached">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📐 Miroir de GVL_IHM.Commun.LimitLegalReached</xhtml>
              </documentation>
            </variable>
            <variable name="LimitLegalDepth_M">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📐 Miroir de GVL_IHM.Commun.Cfg.LimitLegalDepthMinAllowed_M</xhtml>
              </documentation>
            </variable>
            <variable name="WinchSyncError">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚖️ Miroir de l'erreur synchro M1/M2</xhtml>
              </documentation>
            </variable>
            <variable name="WinchSyncDelta_M">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚖️ Miroir de l'écart synchro M1/M2</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedMismatch_Mps">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🐢 Écart de vitesse mesuré (T43/T45)</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedMismatchActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🐢 Écart de vitesse détecté</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedMismatchConfirmed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🐢 Écart de vitesse confirmé</xhtml>
              </documentation>
            </variable>
            <variable name="M1Position_M">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📊 Position câble M1</xhtml>
              </documentation>
            </variable>
            <variable name="M2Position_M">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📊 Position câble M2</xhtml>
              </documentation>
            </variable>
            <variable name="DeadmanArmed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔫 Homme-mort joystick armé</xhtml>
              </documentation>
            </variable>
            <variable name="JoystickMotionActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🕹️ Mouvement joystick actif</xhtml>
              </documentation>
            </variable>
            <variable name="MotionPermit">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟢 Homme-mort + axe Y actif (CycleMotionPermit)</xhtml>
              </documentation>
            </variable>
            <variable name="CycleStepAtError">
              <type>
                <derived name="E_CycleStep" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🧊 Étape spécifique au moment du défaut (R9)</xhtml>
              </documentation>
            </variable>
            <variable name="SampleCount">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🆕 Compteur de prélèvements (RETAIN, Q3bis)</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
