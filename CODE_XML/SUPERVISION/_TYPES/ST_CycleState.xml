        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🚦 ST_CycleState — États et diagnostics IHM du cycle semi-automatique
   ═══════════════════════════════════════════════════════════════</xhtml>
        </documentation>
      </dataType>
      <dataType name="E_CycleStep">
        <baseType>
          <enum>
            <values>
              <value name="X0_PREPARATION" value="0" />
              <value name="X1_HOMING" value="1" />
              <value name="X2_WORK_POS_SELECT" value="2" />
              <value name="X3_OPEN_BUCKET" value="3" />
              <value name="X4_DESCEND_OPEN" value="4" />
              <value name="X5_BOTTOM_CONFIRMED" value="5" />
              <value name="X6_CLOSE_BUCKET" value="6" />
              <value name="X7_CTRL_ASCENT" value="7" />
              <value name="X8_ASCENT_LOADED" value="8" />
              <value name="X9_DRAIN_PAUSE" value="9" />
              <value name="X10_TRANSLATE_DUMP" value="10" />
              <value name="X11_OPEN_DUMP" value="11" />
              <value name="X13_DONE_SYNC" value="13" />
              <value name="STABILIZING" value="14" />
            </values>
          </enum>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/enumvaluedocumentation" handleUnknown="implementation">
            <EnumValueDocumentation>
              <EnumValue>
                <Name>X0_PREPARATION</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🏁 Début de graphe : à la TRÉMIE, treuils en position HAUTE</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X1_HOMING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🆕 vitesses lentes pour chercher capteur top + référencement</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X2_WORK_POS_SELECT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">sélection cible Trémie/P1/Maintenance + translation validée</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X3_OPEN_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🆕 ouverture benne (si déjà ouverte → passe vite)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X4_DESCEND_OPEN</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">plongée benne ouverte, M1+M2 synchro, Kobold mesure ON</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X5_BOTTOM_CONFIRMED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">fond validé (FB_DiveSearch) ; arrêt descente</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X6_CLOSE_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">fermeture benne — tolérance « à peu près fermé »</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X7_CTRL_ASCENT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">remontée palier 1 de contrôle</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X8_ASCENT_LOADED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">remontée nominale jusqu'à limite haute</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X9_DRAIN_PAUSE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">égouttage temporisé — temps affiché IHM</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X10_TRANSLATE_DUMP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">translation vers trémie + avertissements IHM</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X11_OPEN_DUMP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">ouverture benne = vidage ; montée possible, descente ouvre</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>X13_DONE_SYNC</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">fin de cycle, synchronisation finale (R4) + compteur</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>STABILIZING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🆕 état d'attente/stabilisation (ex-ERROR_HOLD) — pas une erreur</xhtml>
                </Documentation>
              </EnumValue>
            </EnumValueDocumentation>
          </data>
