  <types>
    <dataTypes>
      <dataType name="ST_SafetyChecklist">
        <baseType>
          <struct>
            <variable name="Step1_InputModulesOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">1. Intégrité matérielle &amp; modules E/S
TRUE = Les 3 cartes E/S physiques sont RUNNING ➔ En simu : GVL_Simulation.SimSafetyActive=1</xhtml>
              </documentation>
            </variable>
            <variable name="Step2_EmergencyBtnNotCut">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Pas d'appui AU ➔ Déverrouiller le BP coup-de-poing physique ou IHM : GVL_IHM.Modes.Cmd.BtnEmergencyCutOff</xhtml>
              </documentation>
            </variable>
            <variable name="Step3_EmergencyChainClosed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Boucle physique AU fermée (EmergencyChainClosed_DI)</xhtml>
              </documentation>
            </variable>
            <variable name="Step4_ContactorRedundancyOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">2. Conditions de réarmement
TRUE = Test de redondance contacteurs OK ➔ Attendre la retombée complète des contacteurs</xhtml>
              </documentation>
            </variable>
            <variable name="Step5_ArmingAllowed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Machine armable ➔ Appuyer sur BP Reset IHM : GVL_IHM.Modes.Cmd.BtnFaultReset</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingPulseActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">3. Séquence de réarmement
TRUE = Impulsion d'armement 500ms en cours</xhtml>
              </documentation>
            </variable>
            <variable name="PowerContactorEngaged">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Contacteur principal sous tension (PowerContactorEngaged_DI)</xhtml>
              </documentation>
            </variable>
            <variable name="AllConditionsMet">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Chaîne de sécurité OK et puissance engagée</xhtml>
              </documentation>
            </variable>
            <variable name="SafetyError">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">4. Erreurs
TRUE = Défaut sécurité actif ➔ Acquitter via : GVL_IHM.Modes.Cmd.BtnFaultReset</xhtml>
              </documentation>
            </variable>
            <variable name="RedundancyTestFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Défaut test de redondance contacteurs</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Échec de la séquence d'armement</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
