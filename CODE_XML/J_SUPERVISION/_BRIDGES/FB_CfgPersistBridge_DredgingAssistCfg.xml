    <pous>
      <pou name="FB_CfgPersistBridge_DredgingAssistCfg" pouType="functionBlock">
        <interface>
          <inputVars />
          <outputVars>
            <variable name="JustRestored">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== ETATS RESTAURATION ===
&lt;-- [STAT] Vrai sur le cycle de restauration initiale</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <inOutVars>
            <variable name="Hmi">
              <type>
                <derived name="ST_DredgingAssistCfg" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== BUS CONFIGURATION ET PERSISTANCE ===
&lt;-&gt; [BUS] Structure de configuration IHM</xhtml>
              </documentation>
            </variable>
            <variable name="Persist">
              <type>
                <derived name="ST_DredgingAssistCfg" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-&gt; [BUS] Structure de configuration persistante</xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   💾 FB_CfgPersistBridge_DredgingAssistCfg — Pont persistance prélèvement
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Restauration et synchronisation bidirectionnelle IHM / Persist
   💾 Persistance : Transfert GVL_PERSISTENT &lt;-&gt; GVL_IHM sur Initialized
   📄 Doc métier : DOC/AF/AF_Partie-03_Contrats_Composants_v2.3.md §3
   =======================================================================</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

JustRestored := FALSE;
IF NOT Hmi.Initialized THEN
    Hmi := Persist;
    Hmi.Initialized := TRUE;
    JustRestored := TRUE;
ELSE
    Persist := Hmi;
END_IF;
</xhtml>
          </ST>
        </body>
