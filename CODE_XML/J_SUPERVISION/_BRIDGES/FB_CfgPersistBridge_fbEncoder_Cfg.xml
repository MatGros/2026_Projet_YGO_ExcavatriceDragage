          <inOutVars>
            <variable name="Hmi">
              <type>
                <derived name="ST_fbEncoder_Cfg" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== BUS CONFIGURATION ET PERSISTANCE ===
&lt;-&gt; [BUS] Structure de configuration IHM commune</xhtml>
              </documentation>
            </variable>
