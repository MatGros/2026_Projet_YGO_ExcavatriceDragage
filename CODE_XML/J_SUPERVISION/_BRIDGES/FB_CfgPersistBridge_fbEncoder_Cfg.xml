              </documentation>
            </variable>
          </inOutVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   💾 FB_CfgPersistBridge_fbEncoder_Cfg — Pont persistance pour ST_fbEncoder_Cfg
   ───────────────────────────────────────────────────────────────────────
   🎯 Rôle : restauration et synchronisation bidirectionnelle IHM / Persist.
   💾 Persistance : transfert GVL_PERSISTENT &lt;-&gt; GVL_IHM sur Initialized.
   📄 Doc : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
   =======================================================================</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

JustRestored := FALSE;
IF NOT Hmi.Initialized THEN
    Hmi := Persist;
    Hmi.Initialized := TRUE;
    JustRestored := TRUE;
ELSE
    Persist := Hmi;
END_IF;
</xhtml>
          </ST>
        </body>
