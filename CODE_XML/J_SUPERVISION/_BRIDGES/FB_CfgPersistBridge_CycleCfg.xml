              </documentation>
            </variable>
          </inOutVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   💾 FB_CfgPersistBridge_CycleCfg — Pont persistance pour ST_CycleCfg
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Restauration et synchronisation bidirectionnelle IHM / Persist
   💾 Persistance : Transfert GVL_PERSISTENT &lt;-&gt; GVL_IHM sur Initialized
   📄 Doc métier : DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md §3
   =======================================================================</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

JustRestored := FALSE;
IF NOT Hmi.Initialized THEN
    Hmi := Persist;
    Hmi.Initialized := TRUE;
    JustRestored := TRUE;
ELSE
    Persist := Hmi;
END_IF;
</xhtml>
          </ST>
        </body>
