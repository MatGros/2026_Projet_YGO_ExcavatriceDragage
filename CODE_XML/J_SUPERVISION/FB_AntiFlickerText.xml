    <pous>
      <pou name="FB_AntiFlickerText" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="NewText">
              <type>
                <string length="120" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Texte candidat à afficher</xhtml>
              </documentation>
            </variable>
            <variable name="ForceInstant">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] TRUE = afficher immédiatement (défaut critique), sans maintien</xhtml>
              </documentation>
            </variable>
            <variable name="HoldTime">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#500ms" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Durée de maintien min avant changement (AF-07 §5.3)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Text">
              <type>
                <string length="120" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [STAT] Texte stabilisé exposé à l'IHM</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="TonHold">
              <type>
                <derived name="TON" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Temporisation de maintien</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🧊 FB_AntiFlickerText — Lissage anti-clignotement d'un texte IHM
   ───────────────────────────────────────────────────────────────
   📄 Doc : DOC/AF/AF_Partie-07_Interface_IHM_v2.3.md §5.3
   🎯 Responsabilité : maintient un texte warning/état un temps minimum
      avant de laisser le contenu changer, et laisse passer en direct
      (sans maintien) les messages critiques (défauts AU/puissance).
   🛡️ Sécurité : l'action de sécurité reste instantanée — ce FB ne
      retarde jamais un texte, il ne fait que stabiliser l'affichage.
      Il n'a aucun effet sur la machine.
   ═══════════════════════════════════════════════════════════════</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

{region "§1 Lissage anti-clignotement"}
// Défaut critique : affichage immédiat, le TON est remis à zéro (aucune latence).
IF ForceInstant THEN
    Text := NewText;
    TonHold(IN := FALSE);
ELSE
    // Warning / état : le texte ne change qu'après maintien min (HoldTime).
    // Un signal qui oscille plus vite que HoldTime → texte stable.
    TonHold(IN := (NewText &lt;&gt; Text), PT := HoldTime);
    IF TonHold.Q THEN
        Text := NewText;
    END_IF;
END_IF;
{endregion}
</xhtml>
          </ST>
        </body>
