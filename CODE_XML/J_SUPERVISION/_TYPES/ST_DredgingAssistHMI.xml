            <EnumValueDocumentation>
              <EnumValue>
                <Name>WAIT_PRECONDITIONS</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Attente benne ouverte, positions et Kobold au repos</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>READY_TO_DESCEND</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Prêt à assister une demande de descente</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SEARCHING_IMMERSION</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Descente : attente front 0-&gt;1 dans fenêtre eau</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SEARCHING_BOTTOM</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Immersion validée : attente front 1-&gt;0 au fond</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>BOTTOM_CONFIRMED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fond validé ; extraction peut être demandée</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>ERROR_HOLD</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Séquence invalide, descente assistée interdite</xhtml>
                </Documentation>
