  <types>
    <dataTypes>
      <dataType name="ST_SafetyWinch">
        <baseType>
          <struct>
            <variable name="Error">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ Bloc sécurité (Safety) en défaut</xhtml>
              </documentation>
            </variable>
            <variable name="ErrorId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">❌ Code bitfield du défaut de sécurité</xhtml>
              </documentation>
            </variable>
            <variable name="SafeStop">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟧 Arrêt rapide activé par la sécurité</xhtml>
              </documentation>
            </variable>
            <variable name="DescendPermit">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟢 Descente autorisée (TRUE = OK | FALSE = mou de câble / limite basse)</xhtml>
              </documentation>
            </variable>
            <variable name="AscentPermit">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟢 Montée autorisée (TRUE = OK | FALSE = fin de course haut)</xhtml>
              </documentation>
            </variable>
            <variable name="SlackCable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚠️ Mou de câble physiquement détecté</xhtml>
              </documentation>
            </variable>
            <variable name="ThermalFault">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔥 Surchauffe thermique moteur</xhtml>
              </documentation>
            </variable>
            <variable name="EncoderFault">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Perte de liaison ou incohérence codeur</xhtml>
              </documentation>
            </variable>
            <variable name="BypassActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Bypass codeur effectivement accepté, uniquement MAINT_N2</xhtml>
              </documentation>
            </variable>
            <variable name="CableLimitDescent">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚠️ Longueur max de câble atteinte (limite basse physique)</xhtml>
              </documentation>
            </variable>
            <variable name="CableLimitAscent">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚠️ Limite haute d'exploitation normale atteinte</xhtml>
              </documentation>
            </variable>
            <variable name="MecaADrift_M">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📐 Dérive mesurée Méca A (m)</xhtml>
              </documentation>
            </variable>
            <variable name="MecaCDrift_M">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📐 Dérive mesurée Méca C (m)</xhtml>
              </documentation>
            </variable>
            <variable name="MecaBElapsedTime">
              <type>
                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⏳ Temps écoulé confirmation contacteurs/frein</xhtml>
              </documentation>
            </variable>
