      <dataType name="ST_MotionChecklist">
        <baseType>
          <struct>
            <variable name="Step1_PowerEngaged">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">1. Puissance &amp; Mode
TRUE = Contacteur principal sous tension (PowerContactorEngaged_DI) ➔ Armer puissance via Reset</xhtml>
              </documentation>
            </variable>
            <variable name="Step2_ModeAuthorized">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Mode MAINT_N1 ou N2 actif (pas DISABLE) ➔ Commutateur Mode IHM</xhtml>
              </documentation>
            </variable>
            <variable name="Step3_NotBusyOtherTask">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Pas d'autre séquence en cours (Homing, Benne busy, etc.)</xhtml>
              </documentation>
            </variable>
            <variable name="HwIn_PowerContactorEngaged_DI">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">1bis. Entrées physiques directes HwIn (vérité terrain)
Contacteur puissance principal issu de HwIn.Machine</xhtml>
              </documentation>
            </variable>
            <variable name="HwIn_BrakeIsOpen_DI">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Retour fin de course frein (1 = ouvert) issu de HwIn</xhtml>
              </documentation>
            </variable>
            <variable name="Cmd_BrakeRelease">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ordre de commande d'ouverture de frein généré par l'automate</xhtml>
              </documentation>
            </variable>
            <variable name="Step4_MotionRequested">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">2. Intention &amp; Demande
TRUE = Demande active (Bouton IHM ou Joystick) ➔ Si IHM : TglJoystickMaster doit être à 0 !</xhtml>
              </documentation>
            </variable>
            <variable name="RequestedDirection">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">+1 = Ascending, -1 = Descending, 0 = Repos</xhtml>
              </documentation>
            </variable>
            <variable name="RequestedSpeedPct">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">0..100 % consigne demandée</xhtml>
              </documentation>
            </variable>
            <variable name="Step5_NoSafetyFault">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">3. Chaîne de Sécurité &amp; Verrous
TRUE = Pas de SafeStop ni AU actif sur cet axe</xhtml>
              </documentation>
            </variable>
            <variable name="Step6_DirectionAllowed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Sens autorisé (AscentPermit/DescendPermit / TremiePermit/MaintenancePermit)</xhtml>
              </documentation>
            </variable>
            <variable name="Step7_BrakeReleased">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Commande frein activée &amp; retour frein OK</xhtml>
              </documentation>
            </variable>
            <variable name="Step8_OutputInterlockOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Étage de sortie LD débloqué (pas d'interlock actif).</xhtml>
              </documentation>
            </variable>
            <variable name="AllConditionsMet">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟢 TRUE = TOUTES LES CONDITIONS SONT REMPLIES, LES RELAIS DOIVENT COLLER !</xhtml>
              </documentation>
            </variable>
            <variable name="RelayFwdActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛗 Relais Ascending physiquement commandé</xhtml>
              </documentation>
            </variable>
            <variable name="RelayRevActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛗 Relais Descending physiquement commandé</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedContactor1Active">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Contacteur de vitesse Palier 1 commandé</xhtml>
              </documentation>
            </variable>
            <variable name="Step8_InterlockState">
              <type>
                <derived name="E_WinchFinalInterlockState" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">5. Barrière finale — état &amp; cause publiés (T371, LECTURE SEULE)
⚠️ Ajout en FIN de STRUCT : aucun champ existant n'est décalé (mapping IHM/SCADA + online change).
       ⚠️ VOCABULAIRE COMMUN aux 3 axes (famille E_WinchFinalInterlock...), choisi parce que ce DUT est
          PARTAGÉ par M1, M2 et M3 et qu'AUCUNE conversion de type n'est nécessaire :
          · M1/M2 — recopie DIRECTE de l'énumération publiée par la barrière (aucune projection) ;
          · M3   — la barrière M3 ne publie qu'un état dérivé du défaut : E_State.READY -&gt; READY et
                   E_State.ERROR -&gt; FAULT (projection EXPLICITE, cf. FB_TroubleshootingView.st §11),
                   ses 3 raisons étant identiques (NONE / BRAKE_COMMAND_NOT_CONFIRMED / RESTART_INHIBITED).
          Le type énuméré (et non INT) évite toute conversion — la conversion explicite de l'énumération
          d'un membre d'IEC_STRUCT n'est pas supportée par le compilateur de test, et un INT aurait rendu
          la table de valeurs DÉPENDANTE DE L'AXE. La famille M3 (E_State) n'est volontairement pas
          réutilisée ici : sa numérotation diffère (READY = 2 vs 1) et rendrait la lecture ambiguë.
       ⚠️ USAGE DIAGNOSTIC UNIQUEMENT (latence N-1 assumée, projection PRG_04:1688-1696) : aucune ligne
          de CONDUITE ne doit consommer ces deux champs.
🛡️ [DIAG/LECTURE] État publié de la barrière</xhtml>
              </documentation>
            </variable>
            <variable name="Step8_InterlockReason">
              <type>
                <derived name="E_WinchFinalInterlockReason" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ [DIAG/LECTURE] Cause MÉMORISÉE publiée par la</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
