  <types>
    <dataTypes>
      <dataType name="ST_SafetyChecklist">
        <baseType>
          <struct>
            <variable name="SimulationModeActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">0. Aiguillage source — dit QUELLE entree alimente les steps 1-3 ci-dessous.
       Absent jusqu'ici : diagnostiquer un blocage AU en full simu obligeait a rouvrir
       GVL_Simulation dans un Watch separe (, banc sans HW).
TRUE = bit maitre simu actif (GVL_Simulation.SimulationModeActive)</xhtml>
              </documentation>
            </variable>
            <variable name="SimSafetyActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = domaine Safety simule ➔ Step1-3 lisent FB_Sim_Safety, pas les DI/comm reelles</xhtml>
              </documentation>
            </variable>
            <variable name="HwIn_EmergencyChainClosed_DI">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">0bis. Entrées physiques directes HwIn (vérité terrain)
Boucle AU physique ou simulée issue de HwIn.Machine</xhtml>
              </documentation>
            </variable>
            <variable name="HwIn_PowerContactorEngaged_DI">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Retour contacteur de puissance issu de HwIn.Machine</xhtml>
              </documentation>
            </variable>
            <variable name="HwIn_EmergencyBtnCut_HMI">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Commande coupure AU IHM</xhtml>
              </documentation>
            </variable>
            <variable name="Step1_InputModulesOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">1. Intégrité matérielle &amp; modules E/S
TRUE = Les 3 cartes E/S physiques sont RUNNING ➔ En simu : GVL_Simulation.SimSafetyActive=1</xhtml>
              </documentation>
            </variable>
            <variable name="Step2_EmergencyBtnNotCut">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Pas d'appui AU ➔ Déverrouiller le BP coup-de-poing physique ou IHM : GVL_IHM.Modes.Cmd.BtnEmergencyCutOff</xhtml>
              </documentation>
            </variable>
            <variable name="Step3_EmergencyChainClosed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Boucle physique AU fermée (EmergencyChainClosed_DI)</xhtml>
              </documentation>
            </variable>
            <variable name="Step4_ContactorReleased">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">2. Conditions de réarmement
TRUE = Contacteur relâché ; précondition AF01 avant réarmement</xhtml>
              </documentation>
            </variable>
            <variable name="Step5_ArmingAllowed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Armable ; acquitter si nécessaire puis générer un front BtnEmergencyArming</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingStep">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">3. Séquence de réarmement
0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingPulseActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Impulsion d'armement en cours</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingBusy">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = séquence de réarmement ou verrouillage en cours</xhtml>
              </documentation>
            </variable>
            <variable name="LockoutActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = verrouillage temporel entre tentatives</xhtml>
              </documentation>
            </variable>
            <variable name="PowerContactorEngaged">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Contacteur principal sous tension (PowerContactorEngaged_DI)</xhtml>
              </documentation>
            </variable>
            <variable name="PowerCutOffActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = demande de coupure safety active</xhtml>
              </documentation>
            </variable>
            <variable name="PowerCutOffRequest">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = demande de coupure AU (entrée instSafetyEmergencyManagement)</xhtml>
              </documentation>
            </variable>
            <variable name="MaintainAActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = maintien voie A demandé</xhtml>
              </documentation>
            </variable>
            <variable name="MaintainBActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = maintien voie B demandé</xhtml>
              </documentation>
            </variable>
            <variable name="AllConditionsMet">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = état final : chaîne OK et puissance engagée</xhtml>
              </documentation>
            </variable>
            <variable name="SafetyError">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">4. Erreurs
TRUE = Défaut sécurité actif</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingErrorId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">bit0 redondance ; bit1 échec confirmation contacteur</xhtml>
              </documentation>
            </variable>
            <variable name="RedundancyTestFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Défaut test de redondance contacteurs</xhtml>
              </documentation>
            </variable>
            <variable name="ArmingFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">TRUE = Échec de la séquence d'armement</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
