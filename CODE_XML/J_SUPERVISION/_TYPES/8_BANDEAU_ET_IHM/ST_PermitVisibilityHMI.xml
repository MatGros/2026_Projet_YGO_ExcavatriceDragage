      <dataType name="E_WinchTraceBlockReason">
        <baseType>
          <enum>
            <values>
              <value name="NONE" value="0" />
              <value name="POWER_CUTOFF" value="1" />
              <value name="AXIS_DISABLED" value="2" />
              <value name="SAFESTOP" value="3" />
              <value name="SAFETY_FAULT" value="4" />
              <value name="SAFETY_PERMIT_MISSING" value="5" />
              <value name="PROCESS_PERMIT_MISSING" value="6" />
              <value name="COUPLING_BLOCKED" value="7" />
              <value name="WINCH_FAULT" value="8" />
              <value name="FINAL_INTERLOCK_BLOCKED" value="9" />
            </values>
          </enum>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/enumvaluedocumentation" handleUnknown="implementation">
            <EnumValueDocumentation>
              <EnumValue>
                <Name>NONE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Aucun blocage - au moins un sens effectivement permis</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>POWER_CUTOFF</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Coupure puissance amont (instSafetyWinch.PowerCutOff) - priorite max</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AXIS_DISABLED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Axe neutralise (Mode=DISABLE ou InhibitMx -&gt; Enable FALSE)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SAFESTOP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">SafeStop effectif (rampe rapide demandee)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SAFETY_FAULT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Defaut safety latched (FB_Safety_Winch.Fault.Error)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SAFETY_PERMIT_MISSING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Aucun sens ne delivre de permit safety (limite / mou de cable / homing)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>PROCESS_PERMIT_MISSING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Permit process absent (benne / fond Kobold / limite legale / extraction)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>COUPLING_BLOCKED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Couplage synchro anti-telescopage (l'autre axe bloque)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>WINCH_FAULT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Defaut treuil latched (FB_Winch.Fault.Error)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>FINAL_INTERLOCK_BLOCKED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Barriere finale en defaut (frein / redemarrage)</xhtml>
                </Documentation>
              </EnumValue>
            </EnumValueDocumentation>
