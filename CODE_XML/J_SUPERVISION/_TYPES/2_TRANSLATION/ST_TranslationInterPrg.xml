              <EnumValue>
                <Name>NONE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">✅ Aucun blocage — permis de mouvement effectif</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>POWER_CUTOFF</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🧨 Coupure puissance amont (instSafetyTranslationM3.PowerCutOff) — priorité max</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SAFESTOP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🟧 SafeStop effectif (InputModule OR safety M3)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SAFETY_FAULT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ Défaut safety M3 latched (FB_Safety_Translation.Fault.Error)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>HEIGHT_INTERLOCK</Name>
