                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🚧 Interlock hauteur M1/M2 actif (risque collision)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>DRIVE_UNAVAILABLE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">📡 Variateur AC600 injoignable / non opérationnel</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>FINAL_INTERLOCK</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">🛑 Barrière finale en défaut (frein / redémarrage)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>FAULT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">❌ Défaut mouvement M3 latched (FB_Translation.Fault.Error)</xhtml>
                </Documentation>
              </EnumValue>
