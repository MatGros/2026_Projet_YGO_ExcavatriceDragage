              </documentation>
            </variable>
            <variable name="MaintenanceTargetEnable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔓 TRUE = Autorise le déplacement vers la cible 4 (Maintenance) ; actif uniquement en mode MAINT_N2</xhtml>
              </documentation>
            </variable>
            <variable name="SimulationModeActive">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="HeightInterlockBlocking">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">: TRUE = translation bloquée, M1 ou M2 sous la hauteur mini requise</xhtml>
              </documentation>
            </variable>
