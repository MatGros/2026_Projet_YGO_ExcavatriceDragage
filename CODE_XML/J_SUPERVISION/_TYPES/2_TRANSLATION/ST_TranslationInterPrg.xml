            </variable>
            <variable name="BrakeCommandOpenConfirmed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Contacteur/bobine desserrage confirmé, pas frein mécanique</xhtml>
