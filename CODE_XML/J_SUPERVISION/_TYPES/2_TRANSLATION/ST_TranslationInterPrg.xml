            <variable name="PositionMaintenance">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="AtTremie">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">: mot EXACT — front franc arrivée/cible (voir PositionXxx ci-dessus = cumulatif zone, réservé ralentissement)
jeton "dernier capteur franchi" (front + libération sur mouvement confirmé) — logique de positionnement</xhtml>
              </documentation>
            </variable>
            <variable name="AtPV">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="AtP2">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="AtP1">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="AtMaintenance">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="M3StatusText">
              <type>
                <string length="80" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">T249-B : texte statut position M3 (INFO, lecture seule) — jeton "at position" sur front capteur sinon zone SensorsWord. Ex "M3 a P1 -&gt; Maintenance", "M3 entre P2 et P1"</xhtml>
              </documentation>
            </variable>
            <variable name="EstimatedPosM3_M">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📏 Position continue estimée en mètres (0.0 m Maint -&gt; +X m Trémie) — persistante, survit reboot</xhtml>
              </documentation>
            </variable>
            <variable name="SensorsWord">
              <type>
                <BYTE />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">bit4=Trémie, bit3=PV, bit2=P2, bit1=P1, bit0=Maintenance</xhtml>
              </documentation>
            </variable>
            <variable name="SensorWordIncoherent">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="LimitSwitchTremie">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🚧 Fin de course extrême Trémie (ex-LimitSwitchFwd)</xhtml>
              </documentation>
            </variable>
            <variable name="LimitSwitchMaintenance">
              <type>
                <BOOL />
