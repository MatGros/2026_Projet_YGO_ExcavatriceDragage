                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⏱️ Écoulé watchdog 500ms</xhtml>
              </documentation>
            </variable>
            <variable name="DriveCommReady">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Diagnostic variateur EtherCAT (décodé — pas de bit-masking côté IHM)
📡 Variateur M3 : communication prête (StatusWord bit7)</xhtml>
              </documentation>
            </variable>
            <variable name="DrivePowerReady">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚡ Variateur M3 : puissance prête (StatusWord bit0)</xhtml>
              </documentation>
            </variable>
            <variable name="PositionTremie">
              <type>
                <BOOL />
