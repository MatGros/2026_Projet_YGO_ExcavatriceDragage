      <dataType name="ST_BypassTranslation">
        <baseType>
          <struct>
            <variable name="OperatorComm">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📡 1. Communication &amp; Systèmes auxiliaires
📡 Bypass communication esclave CANopen Joystick / heartbeat IHM</xhtml>
              </documentation>
            </variable>
            <variable name="DriveComm">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">📡 Bypass diagnostic esclave EtherCAT AC600 (variateur)</xhtml>
              </documentation>
            </variable>
            <variable name="ContactorFeedback">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Bypass feedbacks contacteur de frein</xhtml>
              </documentation>
            </variable>
            <variable name="PhaseRotation">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚡ Bypass défaut rotation de phases (commun machine)</xhtml>
              </documentation>
            </variable>
            <variable name="BrakeThermal">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🌡️ Bypass surchauffe thermique frein (commun machine)</xhtml>
              </documentation>
            </variable>
            <variable name="LimitSwitch">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🚧 2. Limites physiques et Positionnement
🚧 Bypass fins de course physiques avant/arrière</xhtml>
              </documentation>
            </variable>
            <variable name="SensorIncoherent">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🧭 Bypass incohérence mot capteurs de position</xhtml>
              </documentation>
            </variable>
            <variable name="MinHeight">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">: Bypass interlock hauteur mini M1/M2 requise pour translation</xhtml>
              </documentation>
            </variable>
            <variable name="MecaA">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚙️ 3. Sécurité Mécanique (Méca A-B)
🔄 Bypass Méca A : mouvement non commandé à l'arrêt</xhtml>
              </documentation>
            </variable>
            <variable name="MecaB">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛑 Bypass Méca B : absence confirmation arrêt (frein/contacteurs)</xhtml>
              </documentation>
            </variable>
            <variable name="Safety">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ 4. Hiérarchie &amp; Restauration
🛡️ Bypass groupé : tous les bits qui provoquent un PowerCutOff</xhtml>
              </documentation>
            </variable>
            <variable name="Process">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚙️ Bypass groupé : tous les bits qui provoquent un SafeStop</xhtml>
              </documentation>
            </variable>
            <variable name="Global">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🌐 Bypass Global : ignore toutes les sécurités de cet axe</xhtml>
              </documentation>
            </variable>
            <variable name="Initialized">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Flag restauration boot dédié (défaut FALSE non ambigu, contrairement à une valeur métier)
🚦 TRUE = bypass restauré depuis GVL_BypassRetain ce boot</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
