              </documentation>
            </variable>
            <variable name="FinalInterlockState">
              <type>
                <derived name="E_State" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ État final lecture seule</xhtml>
              </documentation>
            </variable>
            <variable name="FinalInterlockReason">
              <type>
                <derived name="E_TranslationFinalInterlockReason" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ Cause finale mémorisée</xhtml>
