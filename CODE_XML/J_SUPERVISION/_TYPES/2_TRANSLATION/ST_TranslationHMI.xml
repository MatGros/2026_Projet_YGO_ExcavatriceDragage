      <dataType name="ST_TranslationCmd">
        <baseType>
          <struct>
            <variable name="SelPositioning">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🎯 TRUE = positionneur sur SelTarget ; FALSE = jog libre</xhtml>
              </documentation>
            </variable>
            <variable name="SelTarget">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔢 Numéro de la cible de position sélectionnée</xhtml>
              </documentation>
            </variable>
            <variable name="BtnTremie">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">↔️ Requête marche vers Trémie (ex-BtnFwd), pilotage IHM exclusif</xhtml>
              </documentation>
            </variable>
            <variable name="BtnMaintenance">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">↔️ Requête marche vers Maintenance (ex-BtnRev), pilotage IHM exclusif</xhtml>
              </documentation>
            </variable>
            <variable name="SetFreq_Hz">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🎯 Consigne fréquence manuelle [Hz], limitée par PRG_06_Outputs</xhtml>
              </documentation>
            </variable>
            <variable name="InvertDirection">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔀 Switch machine unique : GVL_IHM.Modes.Cmd.TglJoystickMaster (ST_ModesCmd), applicable à M1/M2 ET M3.
🔄 TRUE = inverse Fwd→Maintenance / Rev→Trémie (mise en service)</xhtml>
              </documentation>
            </variable>
            <variable name="TglMaintenanceZoneAccess">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">: autorisation CONSCIENTE zone Maintenance, EN PLUS de MAINT_N2 (Auth.MaintenanceM3TargetEnable)</xhtml>
              </documentation>
            </variable>
            <variable name="Initialized">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🚦 TRUE = SetFreq_Hz restauré depuis GVL_PERSISTENT ce boot</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>9ba58c6e-bb66-5815-b28d-8fed6fa33365</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🎮 ST_TranslationCmd — Commandes IHM pour la Translation M3
   ───────────────────────────────────────────────────────────────
   🎨 Destiné au pilotage de la translation M3 depuis l'IHM.
   📄 : Initialized protège SetFreq_Hz (seul réglage à survivre au reboot),
      sans pont générique pour ne jamais persister BtnTremie/BtnMaintenance.
   ═══════════════════════════════════════════════════════════════</xhtml>
        </documentation>
      </dataType>
