              </documentation>
            </variable>
            <variable name="BtnAbort">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⏹️ Abandon / arrêt cycle automatique</xhtml>
              </documentation>
            </variable>
            <variable name="BtnResumeAfterFault">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Reprise consciente depuis AX_STAB vers l'etape d'origine</xhtml>
              </documentation>
            </variable>
            <variable name="BtnReset">
              <type>
                <BOOL />
              </type>
              <documentation>
