      <dataType name="ST_MachineHoming">
        <baseType>
          <struct>
            <variable name="Homed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Qualification conjointe reference machine</xhtml>
              </documentation>
            </variable>
            <variable name="SetPosBucketOpen">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Valider position actuelle = reference benne ouverte</xhtml>
              </documentation>
            </variable>
            <variable name="SetPosBucketClose">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Valider position actuelle = reference benne fermee</xhtml>
              </documentation>
            </variable>
            <variable name="Active">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Homing conjoint en cours</xhtml>
              </documentation>
            </variable>
            <variable name="HomingLoss">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Perte reference en mouvement : arret controle SafeStop</xhtml>
              </documentation>
            </variable>
            <variable name="Step">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Etape guidee reference (echelle de priorite E_MachineHomingStep)</xhtml>
              </documentation>
            </variable>
            <variable name="Instruction">
              <type>
                <string length="120" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Consigne IHM reference</xhtml>
              </documentation>
            </variable>
            <variable name="Failed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Transaction reference abandonnee</xhtml>
              </documentation>
            </variable>
            <variable name="SeqStep">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Step GRAFCET courant (E_MachineHomingTxState HX0..HXF)</xhtml>
              </documentation>
            </variable>
            <variable name="M3Locked">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation M3 interdite pendant le cycle de homing machine</xhtml>
              </documentation>
            </variable>
            <variable name="CmdWinchM1">
              <type>
                <derived name="ST_ProgramWinchRequest" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ordre treuil M1 couple palier 1 (HX2 montee / HX3 descente)</xhtml>
              </documentation>
            </variable>
            <variable name="CmdWinchM2">
              <type>
                <derived name="ST_ProgramWinchRequest" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ordre treuil M2 couple palier 1 (HX2 montee / HX3 descente)</xhtml>
              </documentation>
            </variable>
            <variable name="CmdBucketOpen">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ordre ouverture benne palier 1 sans FDC soft (HX4)</xhtml>
              </documentation>
            </variable>
            <variable name="CmdBucketClose">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Ordre fermeture benne palier 1 sans FDC soft (HX4)</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>719346ef-3775-5b4e-ac3c-37b255640eba</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   🧭 ST_MachineHoming — Etat publie du homing conjoint machine (M1/M2/benne)
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Regroupe les 8 sorties homing a plat de PRG_02_Acquisition en
             un bus struct unique, publie sur le bus inter-PRG.
   🔒 Sécurité : Homed = qualification conjointe reference machine (gate SEMI_AUTO).
                 HomingLoss = perte reference en mouvement : arret controle SafeStop.
   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.4.md (F09.08)
   =======================================================================</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_MachineHomingCfg">
        <baseType>
          <struct>
            <variable name="ForceStepTarget">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔧 Step GRAFCET cible du forçage (0=HX0 .. 9=HXF), borné côté FB</xhtml>
              </documentation>
            </variable>
            <variable name="Initialized">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🚦 flag restauration boot</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>f880fd6c-2d2e-5164-a545-6de3d9045768</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   ⚙️ ST_MachineHomingCfg — Réglages IHM du cycle de référencement machine
   ───────────────────────────────────────────────────────────────
   🎯 Mise en service. Les réglages géométriques (positions capteur, offsets benne)
      restent portés par GVL_PERSISTENT (_WinchM1CfgPersist / _BucketCfgPersist).
   💾 Ponté vers persist (_MachineHomingCfgPersist) via FB_CfgPersistBridge_MachineHomingCfg.
   ═══════════════════════════════════════════════════════════════</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_MachineHomingCmd">
        <baseType>
          <struct>
            <variable name="BtnStart">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">▶️ Lancer le cycle de homing machine (MAINT_N2, front) — alternative au motif 3 appuis joystick</xhtml>
              </documentation>
            </variable>
            <variable name="BtnValidate">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">✅ Validation depuis IHM (front) — équivaut à 1 appui du motif 3 appuis joystick</xhtml>
              </documentation>
            </variable>
            <variable name="BtnAbort">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⏹️ Quitter / abandonner le cycle homing (front) — retour HX0 sans mouvement</xhtml>
              </documentation>
            </variable>
            <variable name="TglCommissioning">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔧 Case mise en service : déverrouille le forçage de step (MAINT_N2). NON persisté (reset au reboot = sûr).</xhtml>
              </documentation>
            </variable>
            <variable name="BtnForceStepApply">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔧 Applique le forçage de step (front) — impulsion ; cible = ST_MachineHomingCfg.ForceStepTarget</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>866e29f3-d271-58a8-a751-8cc142d17dc5</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🎮 ST_MachineHomingCmd — Commandes IHM du cycle de référencement machine
   ───────────────────────────────────────────────────────────────
   🎯 Cycle homing machine (FB_MachineHomingCycle) — orchestré en MAINT_N2.
      Séparé de ST_CycleCmd (cycle SEMI_AUTO) et de ST_ModesCmd (modes de marche).
      Boutons momentanés uniquement ; réglages -&gt; ST_MachineHomingCfg.
   ═══════════════════════════════════════════════════════════════</xhtml>
        </documentation>
      </dataType>
