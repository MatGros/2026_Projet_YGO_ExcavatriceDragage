      <dataType name="E_AutoCycleStep">
        <baseType>
          <enum>
            <values>
              <value name="AX0_REPOS" value="0" />
              <value name="AX1_INIT" value="1" />
              <value name="AX2_TRANSLATE_P1" value="2" />
              <value name="AX3_OPEN_BUCKET" value="3" />
              <value name="AX4_DESCEND_DIVING" value="4" />
              <value name="AX5_KOBOLD_INIT" value="5" />
              <value name="AX6_SEARCH_IMMERSION" value="6" />
              <value name="AX7_SEARCH_BOTTOM" value="7" />
              <value name="AX8_BOTTOM_CONFIRMED" value="8" />
              <value name="AX9_RAISE_OFF_BOTTOM" value="9" />
              <value name="AX10_CLOSE_BUCKET" value="10" />
              <value name="AX11_CTRL_ASCENT" value="11" />
              <value name="AX12_LOADED_ASCENT" value="12" />
              <value name="AX13_DRAIN_PAUSE" value="13" />
              <value name="AX14_TRANSLATE_DUMP" value="14" />
              <value name="AX15A_DUMP_ARRIVE" value="15" />
              <value name="AX15B_DUMP_OPEN" value="16" />
              <value name="AX15C_DUMP_REPOSITION" value="17" />
              <value name="AX18_DONE_SYNC" value="18" />
              <value name="AX_STAB" value="19" />
              <value name="AX_DIVING_RETRY" value="20" />
              <value name="AX3_WAIT_DIVE_START" value="21" />
            </values>
          </enum>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/enumvaluedocumentation" handleUnknown="implementation">
            <EnumValueDocumentation>
              <EnumValue>
                <Name>AX0_REPOS</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repos / park : toutes commandes 0, etat neutre - etape initiale pure</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX1_INIT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Verif CONDITIONS INITIALES (Homed M1/M2, treuils FDC haut, M3 pas a droite de P1) - aucun mouvement, aucun referencement</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX2_TRANSLATE_P1</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation vers P1 : joystick vers la droite, le cycle n'emet aucune commande M3 ; surveillance treuils au FDC haut</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX3_OPEN_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Ouverture benne jusqu'au FDC logiciel benne ouverte
--- DIVING (5 steps + retry) ---</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX4_DESCEND_DIVING</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Plongee couplee benne ouverte palier 4 jusqu'a l'altimetrie de lancement (DiveStartMin_M) - Kobold PAS enclenche</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX5_KOBOLD_INIT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Activation contacteur Kobold &lt;&lt; au vol &gt;&gt;, verif retour contacteur, descente palier 4 maintenue</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX6_SEARCH_IMMERSION</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Recherche entree dans l'eau : attente front DI Kobold 0-&gt;1, descente palier 4 maintenue</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX7_SEARCH_BOTTOM</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Recherche du fond : attente front DI Kobold 1-&gt;0, descente palier 4 maintenue</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX8_BOTTOM_CONFIRMED</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fond confirme : coupure instantanee treuils, set bit fond, TouchPositionM / RaiseTargetM
--- EXTRACTION (4 steps) ---</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX9_RAISE_OFF_BOTTOM</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Retente les cables (palier 1), decollement du fond ; selecteur couplage BOTH/M1/M2 accessible</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX10_CLOSE_BUCKET</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fermeture benne, treuils explicitement 0</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX11_CTRL_ASCENT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Montee controle palier max reglable [1..2] + surveillance ecart vitesse M1/M2 ; benne mal fermee autorisee</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX12_LOADED_ASCENT</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Montee en charge : palier 4 si benne fermee, palier 1 si mal fermee ; pas de ralenti 1 m avant top
--- DECHARGE (6 steps) ---</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX13_DRAIN_PAUSE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Egouttage temporise - duree reglable IHM + bypass immediat</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX14_TRANSLATE_DUMP</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Translation vers tremie (depart P1) + avertissements IHM</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX15A_DUMP_ARRIVE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Arrivee tremie : treuils a l'arret, attente geste operateur</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX15B_DUMP_OPEN</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Vidage : ouverture benne au-dessus de la tremie, LES DEUX treuils a l'arret</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX15C_DUMP_REPOSITION</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repositionnement couple M1+M2 (option IHM maintenue), retour AX15B au relachement</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX18_DONE_SYNC</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Fin de passe : compteur vidages + duree cycle ; msg &lt;&lt; aller en P1 &gt;&gt; ; rebouclage direct sur AX2
--- STEPS SPECIAUX ---</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX_STAB</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Repli defaut / stabilisation - pas une erreur</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX_DIVING_RETRY</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Reprise diving : remontee assistee palier lent jusqu'au FDC haut puis retour AX4 ; sur erreur Kobold / joystick relache / palier &lt;&gt; 4 en AX5..AX7</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>AX3_WAIT_DIVE_START</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Transition benne-&gt;plongee : sorties neutres jusqu'a l'arret mecanique confirme M1/M2, joystick pousse maintenu</xhtml>
                </Documentation>
              </EnumValue>
            </EnumValueDocumentation>
          </data>
