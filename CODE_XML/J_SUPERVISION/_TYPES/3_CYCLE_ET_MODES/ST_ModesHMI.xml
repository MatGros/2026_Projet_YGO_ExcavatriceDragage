        <baseType>
          <enum>
            <values>
              <value name="DISABLE" value="0" />
              <value name="MAINT_N1" value="1" />
              <value name="MAINT_N2" value="2" />
              <value name="SEMI_AUTO" value="3" />
            </values>
          </enum>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/enumvaluedocumentation" handleUnknown="implementation">
            <EnumValueDocumentation>
              <EnumValue>
                <Name>DISABLE</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Mode Désactivé / Veille de sécurité (sorties bloquées)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>MAINT_N1</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Manuel Niveau 1 : Pilotage unitaire avec toutes sécurités actives</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>MAINT_N2</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Manuel Niveau 2 : Pilotage dégradé (droits étendus + bypasses autorisés)</xhtml>
                </Documentation>
              </EnumValue>
              <EnumValue>
                <Name>SEMI_AUTO</Name>
                <Documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Mode Semi-Automatique (séquenceur automatique)</xhtml>
                </Documentation>
              </EnumValue>
            </EnumValueDocumentation>
