          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🎚️ ST_ModesHMI — Données d'échange IHM pour les modes de marche
   ───────────────────────────────────────────────────────────────
   📄 Structuration en Cmd / State , homogène avec ST_WinchHMI/ST_SyncHMI/ST_BucketHMI.
   Pas de Cfg (aucun réglage numérique dans ce domaine) ni de Bypass (concept absent de Modes).
   ═══════════════════════════════════════════════════════════════</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_ModesCmd">
        <baseType>
          <struct>
            <variable name="SelMode">
              <type>
                <derived name="E_Mode" />
              </type>
              <initialValue>
                <simpleValue value="E_Mode.MAINT_N1" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🖥️ Demande de changement de mode de marche — accès N2 filtré côté IHM ()</xhtml>
              </documentation>
            </variable>
            <variable name="BtnFaultReset">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔔 Acquittement défauts/alarmes domaine sécurité/métier — jamais Modes/Cycle</xhtml>
              </documentation>
            </variable>
            <variable name="BtnModeReset">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔁 Acquittement défaut FB_Modes uniquement ()</xhtml>
              </documentation>
            </variable>
            <variable name="BtnEmergencyArming">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">— Séquence réarmement AU (voir DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.1.md §5)
🎮 Commande IHM réarmement contacteur puissance (front) — PAS de réarmement automatique</xhtml>
              </documentation>
            </variable>
            <variable name="BtnEmergencyCutOff">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🎮 Commande IHM coupure d'urgence puissance amont (arrêt à distance)</xhtml>
              </documentation>
            </variable>
            <variable name="SelJoystickWinch">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Sélection treuil au joystick, arbitrée par FB_Modes (0=couplé nominal, 1/2 unitaires MAINT_N2 uniquement)
🕹️ 0=M1+M2 couplés (nominal), 1=M1 seul, 2=M2 seul — unitaires MAINT_N2 uniquement</xhtml>
              </documentation>
            </variable>
            <variable name="TglJoystickMaster">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="TRUE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">— bascule UNIQUEMENT la SOURCE du signal StartStop/Direction/
SpeedTgt_Pct (joystick vs boutons IHM) — SelJoystickWinch ci-dessus reste l'unique autorité de
sélection treuil (M1/M2/Couplé), appliquée IDENTIQUEMENT quelle que soit la source.
🔀 Switch machine unique — pilote aussi Translation M3.
🕹️ TRUE (défaut) = joystick pilote Winch M1/M2 ET Translation M3 ; FALSE = boutons IHM (BtnUp/BtnDown, BtnFwd/BtnRev)</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>edbd07e7-72fc-5cee-a795-a49979bf9667</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🎮 ST_ModesCmd — Commandes IHM pour les modes de marche
   ═══════════════════════════════════════════════════════════════</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_ModesState">
        <baseType>
          <struct>
            <variable name="CurrentMode">
              <type>
                <derived name="E_Mode" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🎚️ Mode de marche actuellement actif</xhtml>
              </documentation>
            </variable>
            <variable name="PowerContactorEngaged">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🛡️ État de la chaîne d'arrêt d'urgence</xhtml>
              </documentation>
            </variable>
            <variable name="AnyFaultActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">: au moins un défaut/alarme actif dans le domaine</xhtml>
              </documentation>
            </variable>
            <variable name="PowerCutOffActive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🧨 : au moins un Méca A/B/C (FB_Safety_Winch) ou</xhtml>
              </documentation>
            </variable>
            <variable name="EmergencyChainOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔗 Boucle AU saine (coup-de-poing relâchés + pas de PowerCutOff PLC actif)</xhtml>
              </documentation>
            </variable>
            <variable name="PowerContactorOk">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🔌 Contacteur de puissance confirmé engagé (miroir PowerContactorEngaged)</xhtml>
              </documentation>
            </variable>
            <variable name="EmergencyArmable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🟢 Réarmement possible maintenant (chaîne saine, ni séquence ni verrouillage en cours,</xhtml>
              </documentation>
            </variable>
            <variable name="EmergencyArmingBusy">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⏳ Auto-test A/B, pulse, confirmation OU verrouillage 5s en cours — nouvelle demande ignorée</xhtml>
              </documentation>
            </variable>
            <variable name="RedundancyTestFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Canal A ou B non fonctionnel détecté à l'auto-test — bloque tout réarmement (front Reset requis)</xhtml>
              </documentation>
            </variable>
            <variable name="EmergencyArmingFailed">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Impulsion envoyée mais contacteur puissance jamais confirmé sous 2s (front Reset + contacteur confirmé requis)</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>607d2d07-1efc-59e2-9ca9-53d413d7cf77</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">═══════════════════════════════════════════════════════════════
   🚦 ST_ModesState — États et diagnostics IHM des modes de marche
