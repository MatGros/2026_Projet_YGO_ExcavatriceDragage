      <dataType name="ST_Fault">
        <baseType>
          <struct>
            <variable name="Error">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] vue LIVE : au moins une cause présente maintenant</xhtml>
              </documentation>
            </variable>
            <variable name="ErrorId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] bitfield des causes présentes maintenant (0 si aucune)</xhtml>
              </documentation>
            </variable>
            <variable name="Latched">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] vue LATCHÉE : défaut non acquitté, reste jusqu'au front Reset</xhtml>
              </documentation>
            </variable>
            <variable name="LatchedId">
              <type>
                <WORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [DIAG] ErrorId figé à l'apparition du défaut, effacé au Reset</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>ffe904a3-501c-5aac-bc38-202f178a61f2</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   🧩 ST_Fault — Brique socle défaut (2 vues : live + latchée)
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : porter l'état défaut d'un composant, applicable dans TOUS les cas
      (acquittable ou non), sans brique warning séparée.
        • Vue LIVE   (Error / ErrorId)     : suit la cause, retombe seule à 0.
        • Vue LATCHÉE (Latched / LatchedId): mémorisée au défaut, reste jusqu'au front Reset.
      Le choix acquittable / non-acquittable se fait PAR CAUSE
      (ST_FaultCause.Latching), jamais par bloc.
   🔒 Sécurité : interlock TOUJOURS sur la cause brute (Error / ErrorId), jamais
      sur l'acquittement. Reset TOUJOURS effectif, jamais conditionné (std §9).
   🧬 Composition : brique de base réutilisable — sortie de FB, struct métier, GVL.
      Texte IHM NON stocké ici : dérivé côté IHM depuis LatchedId / ErrorId.
   📄 Doc : DOC/STDS/CODE_QUALITY_STANDARDS.md §2quinquies / §9
   =======================================================================</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_fbJoystick_AxisCmd">
        <baseType>
          <struct>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== CONSIGNES DE PILOTAGE AXE ===
--&gt; [CMD] Autorisation globale pipeline (FALSE=neutralisation, sorties coupees)</xhtml>
              </documentation>
            </variable>
            <variable name="StartStop">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Validation de mouvement (TRUE=acceleration, FALSE=deceleration/arret)</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedTgt">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Vitesse cible non signee (0...100 %, signe/sens donné par Direction) - IHM</xhtml>
              </documentation>
            </variable>
            <variable name="StepTgt">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Palier de vitesse (1..5, 0=arret) - logique/limitations (derive de SpeedTgt)</xhtml>
              </documentation>
            </variable>
            <variable name="DirectionNegative">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Direction joystick ou intension de gestuelle</xhtml>
              </documentation>
            </variable>
            <variable name="DirectionPositive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Direction joystick ou intension de gestuelle</xhtml>
              </documentation>
            </variable>
            <variable name="AtNeutral">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] TRUE si axes en zone morte (position centrale)</xhtml>
              </documentation>
            </variable>
            <variable name="Direction">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MONITORING IHM (derive des bits ci-dessus, jamais lu en interlock) ===
&lt;-- [STAT] Sens -1=Rev / 0=Neutre / +1=Fwd (anim IHM fleche ; lu aussi logique treuils PRG_04)</xhtml>
              </documentation>
            </variable>
            <variable name="Deflection">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [STAT] Deflexion signee -100..+100 % (anim IHM jauge/barre)</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
