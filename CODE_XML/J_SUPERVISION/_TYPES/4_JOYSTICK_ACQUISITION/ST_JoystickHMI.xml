              </documentation>
            </variable>
            <variable name="AxisCmdY">
              <type>
                <derived name="ST_fbJoystick_AxisCmd" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">⚙️ Consigne d'axe Y normalisée (sortie FB_Joystick)</xhtml>
              </documentation>
            </variable>
            <variable name="NeutralXAct">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🎯 Neutre X calibré actuel (lecture seule)</xhtml>
              </documentation>
            </variable>
            <variable name="NeutralYAct">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🎯 Neutre Y calibré actuel (lecture seule)</xhtml>
              </documentation>
            </variable>
            <variable name="DeadmanArmed">
