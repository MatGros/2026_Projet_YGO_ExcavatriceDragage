              </documentation>
            </variable>
            <variable name="RawY">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🕹️ Axe Y brut du joystick (0..10000)</xhtml>
              </documentation>
            </variable>
            <variable name="RawButton">
              <type>
                <BOOL />
              </type>
              <documentation>
