      <dataType name="ST_fbJoystick_Cfg">
        <baseType>
          <struct>
            <variable name="DeadbandRaw">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="300" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Zone morte en points ADC bruts (0..10000)</xhtml>
              </documentation>
            </variable>
            <variable name="NeutralHoldTime">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#100MS" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Maintien continu au neutre avant désarmement homme-mort</xhtml>
              </documentation>
            </variable>
            <variable name="DeadmanArmHoldTime">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#100MS" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Appui continu bouton requis pour armer le geste</xhtml>
              </documentation>
            </variable>
            <variable name="DeadmanArmGraceTime">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#3S" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Délai de grâce post-armement avant désarmement neutre</xhtml>
              </documentation>
            </variable>
            <variable name="RawOutOfRangeMargin">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="500" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Marge ADC autour des bornes [0..10000] avant défaut capteur (AF08 §5bis)</xhtml>
              </documentation>
            </variable>
            <variable name="Initialized">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🚦 Flag restauration boot (interne pont FB_CfgPersistBridge_fbJoystick_Cfg)</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>15265f47-4d56-5d85-af5c-415e86b1194e</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   ⚙️ ST_fbJoystick_Cfg — Réglages regroupés de FB_Joystick
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : porter en un bloc les 5 paramètres de conditionnement du geste
      (zone morte, temporisations homme-mort, marge défaut capteur).
      Passé à FB_Joystick via l'entrée `Cfg` — échange bloc IHM / persistant.
   🧬 Pattern cfg : aligné sur ST_CycleCfg / ST_WinchCfg (préfixe ST_&lt;Domaine&gt;Cfg,
      instance persistante dans GVL_PERSISTENT, pont FB_CfgPersistBridge_* à venir).
   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.5.md (§5bis)
   =======================================================================</xhtml>
        </documentation>
      </dataType>
      <dataType name="ST_fbJoystick_AxisCmd">
        <baseType>
          <struct>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== CONSIGNES DE PILOTAGE AXE ===
--&gt; [CMD] Autorisation globale pipeline (FALSE=neutralisation, sorties coupees)</xhtml>
              </documentation>
            </variable>
            <variable name="StartStop">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Validation de mouvement (TRUE=acceleration, FALSE=deceleration/arret)</xhtml>
              </documentation>
            </variable>
            <variable name="SpeedTgt">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Vitesse cible non signee (0...100 %, signe/sens donné par Direction)</xhtml>
              </documentation>
            </variable>
            <variable name="DirectionNegative">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Direction joystick ou intension de gestuelle</xhtml>
              </documentation>
            </variable>
            <variable name="DirectionPositive">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Direction joystick ou intension de gestuelle</xhtml>
              </documentation>
            </variable>
            <variable name="AtNeutral">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] TRUE si axes en zone morte (position centrale)</xhtml>
              </documentation>
            </variable>
            <variable name="Direction">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MONITORING IHM (derive des bits ci-dessus, jamais lu en interlock) ===
&lt;-- [STAT] Sens -1=Rev / 0=Neutre / +1=Fwd (anim IHM fleche ; lu aussi logique treuils PRG_04)</xhtml>
              </documentation>
            </variable>
            <variable name="Deflection">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [STAT] Deflexion signee -100..+100 % (anim IHM jauge/barre)</xhtml>
              </documentation>
            </variable>
          </struct>
        </baseType>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>b6fd2799-de8b-52a1-87c0-15b96ff2b5f6</ObjectId>
          </data>
        </addData>
        <documentation>
          <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   🕹️ ST_fbJoystick_AxisCmd — Consigne d'axe normalisée (sortie FB_Joystick)
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Structure de consigne d'axe produite par FB_Joystick.
   📤 Champs : Enable, StartStop, SpeedTgt + direction en bits (DirectionPositive/Negative, AtNeutral).
   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.5.md
   =======================================================================</xhtml>
        </documentation>
      </dataType>
