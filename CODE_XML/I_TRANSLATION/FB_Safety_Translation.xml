                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Délai Méca B</xhtml>
              </documentation>
            </variable>
            <variable name="UncommandedActiveB">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Méca B active</xhtml>
              </documentation>
            </variable>
            <variable name="UncommandedActiveA">
