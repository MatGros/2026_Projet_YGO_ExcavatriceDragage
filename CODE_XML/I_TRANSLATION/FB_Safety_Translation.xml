            <variable name="FirstScanDone">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Initialisation premier scan</xhtml>
              </documentation>
            </variable>
            <variable name="TonStartupWarmup">
              <type>
                <derived name="TON" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Inhibition 3s au boot + effacement auto coms</xhtml>
              </documentation>
            </variable>
