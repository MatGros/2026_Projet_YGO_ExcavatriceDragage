    <pous>
      <pou name="FB_Filter_PT1" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="ValueIn">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== CONSIGNES DE PILOTAGE &amp; CONFIGURATION ===
--&gt; [CMD] Consigne d'axe brute a filtrer</xhtml>
              </documentation>
            </variable>
            <variable name="TimeConst">
              <type>
                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Constante de temps du filtre (ex: T#200ms)</xhtml>
              </documentation>
            </variable>
            <variable name="CycleTimeS">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Temps de cycle reel de la tache en secondes (ex: 0.02)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="ValueOut">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== SORTIES LISSÉES ===
&lt;-- [STAT] Consigne d'axe lissee par filtre PT1</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="T">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== VARIABLES LOCALES INTERNES ===
. [LOC]  Constante de temps convertie en secondes</xhtml>
              </documentation>
            </variable>
            <variable name="Alpha">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC]  Facteur d'attenuation du filtre exponentiel</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   ⚙️ FB_Filter_PT1 — Filtre passe-bas premier ordre (PT1 numérique)
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Filtre exponentiel discret y[k] = a*x[k] + (1-a)*y[k-1]
             avec a = CycleTimeS / (T + CycleTimeS). Pass-through si T=0 ou Cycle=0.
   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.0.md
   =======================================================================</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

T := TIME_TO_REAL(TimeConst) / 1000.0; // ms → s

IF T &lt;= 0.0 OR CycleTimeS &lt;= 0.0 THEN
    ValueOut := ValueIn;
ELSE
    Alpha    := CycleTimeS / (T + CycleTimeS);
    ValueOut := Alpha * ValueIn + (1.0 - Alpha) * ValueOut;
END_IF;
</xhtml>
          </ST>
        </body>
