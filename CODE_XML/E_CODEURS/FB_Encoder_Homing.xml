              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">État courant de la machine d'état</xhtml>
              </documentation>
            </variable>
            <variable name="StateAtError">
              <type>
                <derived name="E_State" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">État mémorisé lors de l'apparition du défaut</xhtml>
              </documentation>
