              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Cible retenue en metres</xhtml>
              </documentation>
            </variable>
            <variable name="RawDiffRestart">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Ecart brut de position au redemarrage</xhtml>
              </documentation>
            </variable>
