      <pou name="FB_Encoder_Scale" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="RawPos">
              <type>
                <UDINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== DONNEES ENTREE &amp; REFERENCES BRUTES ===
--&gt; [HW]  Position brute codeur (sortie FB_Encoder_Abs, gelee sur doute)</xhtml>
              </documentation>
            </variable>
            <variable name="HomingRefRaw">
              <type>
                <UDINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Reference brute figee au dernier homing (ST_Encoder_Calib)</xhtml>
              </documentation>
            </variable>
            <variable name="CableM_PerRev">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="2" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== PARAMETRES &amp; RATIOS DE CONVERSION ===
--&gt; [CFG] Developpement cable par tour tambour (m/tour)</xhtml>
              </documentation>
            </variable>
            <variable name="PointsPerRev">
              <type>
                <UDINT />
              </type>
              <initialValue>
                <simpleValue value="8192" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Resolution codeur (pts/tour)</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="CablePosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MESURE CONVERTIE ===
&lt;-- [DIAG] Position cable en metres (+ enroule, - sous l'eau)</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="RawDiff">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== CALCULS INTERNES ===
. [LOC] Ecart signe RawPos - HomingRefRaw</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   ⚙️ FB_Encoder_Scale — Mise à l'échelle points → mètres (1 par treuil)
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Calcul de la position câble en mètres par conversion arithmétique signée
   🔒 Polarité : CablePosM signée (+ enroulé, - sous l'eau)
   🔌 Architecture : Convertisseur de mesure unitaire par treuil
   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
   =======================================================================
=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Scale) ===</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Scale) ===

// 🧮 Écart signé sûr : conversion DINT AVANT soustraction (§3.1) — jamais l'inverse
RawDiff := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(HomingRefRaw);

// 📏 Formule fixe points → mètres (Partie10 §2), garde division par zéro
IF PointsPerRev &gt; 0 THEN
    CablePosM := DINT_TO_REAL(RawDiff) * (CableM_PerRev / UDINT_TO_REAL(PointsPerRev));
ELSE
    CablePosM := 0.0;
END_IF;
</xhtml>
          </ST>
        </body>
