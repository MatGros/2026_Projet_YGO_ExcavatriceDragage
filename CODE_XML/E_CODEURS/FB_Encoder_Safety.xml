                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== TESTS &amp; BYPASS ===
--&gt; [TST] Neutralisation defaut de bornage pour mise en service</xhtml>
              </documentation>
            </variable>
