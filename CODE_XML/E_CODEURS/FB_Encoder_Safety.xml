    <pous>
      <pou name="FB_Encoder_Safety" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Enable">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== COMMANDES &amp; AUTORISATIONS ===
--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)</xhtml>
              </documentation>
            </variable>
            <variable name="Reset">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CMD] Acquittement defaut (front montant)</xhtml>
              </documentation>
            </variable>
            <variable name="CablePosM">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MESURES &amp; ALERTE HOMING ===
--&gt; [HW]  Position calculee (m, sortie FB_Encoder_Scale)</xhtml>
              </documentation>
            </variable>
            <variable name="HomingSuspect">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [SAFE] Alerte incoherence redemarrage (FB_Encoder_Homing)</xhtml>
              </documentation>
            </variable>
            <variable name="PositionMinM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="-99" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== REGLAGES &amp; BORNES PHYSIQUES ===
--&gt; [CFG] Plafond bornage physique bas (m)</xhtml>
              </documentation>
            </variable>
            <variable name="PositionMaxM">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="99" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">--&gt; [CFG] Plafond bornage physique haut (m)</xhtml>
              </documentation>
            </variable>
            <variable name="BypassGlobal">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== TESTS &amp; BYPASS ===
--&gt; [TST] Neutralisation defaut de bornage pour mise en service</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Ready">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== ETATS IEC &amp; SYNOPTIQUE ===
&lt;-- [STAT] FB pret a fonctionner</xhtml>
              </documentation>
            </variable>
            <variable name="Status">
              <type>
                <derived name="ST_FbStatus" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">🧩 Statut transverse (forme cible) — regroupe Busy/Done/Error/ErrorId/State/StateAtError.
ErrorId bit0: "Bornes", bit1: "Boot suspect".</xhtml>
              </documentation>
            </variable>
            <variable name="CablePosMSafe">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== MESURES SURE &amp; SECURITE ===
&lt;-- [DIAG] Position cable instantanee transmise (m)</xhtml>
              </documentation>
            </variable>
            <variable name="EncoderIncoherent">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">&lt;-- [SAFE] Incoherence ou hors bornes (TRUE = defaut)</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="ResetEdge">
              <type>
                <derived name="R_TRIG" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">=== DETECTEURS DE FRONT ===
. [LOC] Detecteur front montant Reset</xhtml>
              </documentation>
            </variable>
            <variable name="ErrorEdge">
              <type>
                <derived name="R_TRIG" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">. [LOC] Detecteur front montant Error</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">=======================================================================
   🛡️ FB_Encoder_Safety — Bornage physique &amp; surveillance cohérence
   ───────────────────────────────────────────────────────────────
   🎯 Rôle : Bornage physique absolu [-99; +99]m et relais d'incohérence redémarrage
   🔒 Polarité : EncoderIncoherent=TRUE en cas de hors bornes ou HomingSuspect
   🛡️ Sécurité : Verrouillage de la position câble sûre
   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md
   =======================================================================</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">

{region "§1 Gate"}
// 🛑 1. GATE
IF NOT Enable THEN
    Ready := FALSE; Status.Busy := FALSE; Status.Done := FALSE;
    Status.State := E_State.DISABLED;
    CablePosMSafe := CablePosM;
    EncoderIncoherent := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
Status.State := E_State.READY;
{endregion}

{region "§2 Reset front"}
// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);
{endregion}

{region "§3 Bypass global"}
// 🌐 3. BYPASS GLOBAL
IF BypassGlobal THEN
    Status.ErrorId := 16#0000;
END_IF;
{endregion}

{region "§4 Surveillance bornage"}
// 🔍 4. SURVEILLANCE BORNAGE PHYSIQUE ABSOLU (bit0)
IF NOT BypassGlobal AND ((CablePosM &lt; PositionMinM) OR (CablePosM &gt; PositionMaxM)) THEN
    Status.ErrorId := Status.ErrorId OR 16#0001;
ELSE
    Status.ErrorId := Status.ErrorId AND 16#FFFE; (* Auto-clearing dès retour dans la plage *)
END_IF;
{endregion}

{region "§5 Relais incohérence redémarrage"}
// 🔍 5. RELAIS INCOHÉRENCE REDÉMARRAGE (bit1)
IF NOT BypassGlobal THEN
    IF HomingSuspect THEN
        Status.ErrorId := Status.ErrorId OR 16#0002;
    ELSE
        Status.ErrorId := Status.ErrorId AND 16#FFFD;
    END_IF;
END_IF;
{endregion}

{region "§6 Transmission mesure"}
// 📏 6. TRANSMISSION DE LA MESURE (Toujours réelle, non figée)
CablePosMSafe := CablePosM;
{endregion}

{region "§7 Sorties état et sécurité"}
// 📤 7. SORTIES ÉTAT &amp; SÉCURITÉ
Status.Error := (Status.ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Status.Error);
IF ErrorEdge.Q THEN
    Status.StateAtError := Status.State;
END_IF;

EncoderIncoherent := Status.Error;
Status.Busy := FALSE;
Status.Done := FALSE;
{endregion}
</xhtml>
          </ST>
        </body>
