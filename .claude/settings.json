      "Bash(python TOOLS/AGENT_WORKFLOW/scripts/generate_codesys_diff_bundle.py *)",
      "Bash(cd \"C:\\_MGS\\DEV\\2026_Projet_YGO_ExcavatriceDragage\" && python TOOLS/AGENT_WORKFLOW/scripts/generate_codesys_diff_bundle.py *)",
      "mcp__modex__*",
      "__claude-auto-approve__",
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "TodoWrite(*)",
      "Task(*)",
      "NotebookEdit(*)",
      "mcp__*(*)"
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python TOOLS/AGENT_WORKFLOW/scripts/hook_pre_edit.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve'}))\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({decision: 'approve', answer: 'yes'}))\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python TOOLS/AGENT_WORKFLOW/scripts/hook_post_edit.py",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python TOOLS/AGENT_WORKFLOW/scripts/hook_stop.py",
            "timeout": 150
          }
        ]
      }
    ]
  }
}