{
  "permissions": {
    "allow": [
      "PowerShell(head -30)",
      "Bash(cd \"C:/_MGS/DEV/2026_Projet_YGO_ExcavatriceDragage/TOOLS\" && python -c \"from generator.cli import main; import sys;*)"
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python TOOLS/AGENT_WORKFLOW/scripts/hook_pre_edit.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python TOOLS/AGENT_WORKFLOW/scripts/hook_post_edit.py",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python TOOLS/AGENT_WORKFLOW/scripts/hook_stop.py",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
