# Backups generes par inject.py
PRJ/*.bak
*.bak

# CODESYS temporary files
*.~u
*.~d

# Python
__pycache__/
*.pyc
TOOLS/OUTILS_ST2PY/out/
TOOLS/OUTILS_ST2PY/.st2py_cache.json
TOOLS/OUTILS_ST2PY/tests_dir_marker

# Claude Code local settings
.claude/settings.local.json

# Documentation archivée — versions périmées, NE PAS prendre en compte pour le projet
ARCHIVES/Doc/
ARCHIVES/Prj_codesys/

.pytest_cache/
# Projets CODESYS : binaires lourds et propres a la machine -> hors depot.
# On exclut le CONTENU (/*) et non le dossier lui-meme, sinon git refuse d'y
# redescendre et les exceptions ci-dessous seraient sans effet.
PRJ_CODESYS/*
# Exception : l'export du programme reel est VERSIONNE — il sert de reference
# pour comparer CODE/ au programme reellement charge dans l'automate.
!PRJ_CODESYS/PROJ_Full_ImportExport/
PRJ_CODESYS/PROJ_Full_ImportExport/*
!PRJ_CODESYS/PROJ_Full_ImportExport/Device.export

# Workspace launcher artifacts
launch_workspace.bat
launch_workspace.ps1

