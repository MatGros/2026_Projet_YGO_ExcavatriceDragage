# Temporary & local scripts
pi-agent-duration-notify.ts
%TEMP%/

# Backups generes par inject.py
PRJ/*.bak
*.bak

# CODESYS temporary files
*.~u
*.~d
*.tmp
CODE_XML.tmp/

# Python
venv/
env/
.venv/
/tests/
__pycache__/
*.pyc
# Artefacts generes par l'outil ST2PY : un dossier par domaine machine.
# Jamais commites : ils sont reproductibles par `fb_gen.py` a partir du bundle.
# Exception : RESULTS/<DOMAINE>/tests/*.py est du CODE de test versionne, pas un artefact genere.
ARCHIVES/Tools/OUTILS_ST2PY/RESULTS/*
!ARCHIVES/Tools/OUTILS_ST2PY/RESULTS/*/tests/
!ARCHIVES/Tools/OUTILS_ST2PY/RESULTS/*/tests/*.py
!ARCHIVES/Tools/OUTILS_ST2PY/RESULTS/conftest.py
ARCHIVES/Tools/OUTILS_ST2PY/.st2py_cache.json

# Claude Code local settings
.claude/settings.local.json

# Documentation archivée — versions périmées, NE PAS prendre en compte pour le projet
ARCHIVES/Doc/
ARCHIVES/Prj_codesys/

.pytest_cache/
# Projets CODESYS : binaires lourds et propres a la machine -> hors depot.
# On exclut le CONTENU (/*) et non le dossier lui-meme, sinon git refuse d'y
# redescendre et les exceptions ci-dessous seraient sans effet.
PRJ_CODESYS/*
# Exception : l'export du programme reel est VERSIONNE — il sert de reference
# pour comparer CODE/ au programme reellement charge dans l'automate.
!PRJ_CODESYS/PROJ_Full_ImportExport/
PRJ_CODESYS/PROJ_Full_ImportExport/*
!PRJ_CODESYS/PROJ_Full_ImportExport/Device.export

# Workspace launcher artifacts
launch_workspace.bat
launch_workspace.ps1

# WSL / Tmuxinator / Tests
.tmuxinator/
.pytest_cache/
.pytest-run/

# Outils / Agents / Plugins tiers
.agents/
.codex/
.immorterm/
.opencode/
.pi/
opencode.json
.mcp.json
package-lock.json

# Configuration et caches IDE
.cursor/
.windsurf/
.clinerules/
.vscode/*
!.vscode/settings.json
!.vscode/sessions.json
.claude/
.mgs-workspace.code-workspace
node_modules/


# Artefacts de sous-agents Pi (transcripts regenerables, ~26 Mo)
# 2026-08-05 : anciens artefacts archives (93 Mo) — le gate de routage ne scanne plus
# que les artefacts vivants .pi-subagents/artifacts/.
.pi-subagents/artifacts*/

# Scratchs d'agent a la racine (fichiers de travail temporaires, jamais du livrable).
# Ajoute apres deux fuites accidentelles dans des commits (2026-08).
/_*.py
/_*.txt
/_*.log
/zz_*
/scratch/
# Dossier temp de gates sandbox (artefact d'exécution agent, vide) - ne jamais commiter
/.tmp_gates/

# Snapshot fige (reference fonctionnelle v0.5.25_DepartSoirEssai 2026-08-07) - ne plus modifier
CODE_v0.5.25_20260807/

# Snapshot fige (etat avant regression preset codeurs, commit c2f82d2 2026-08-03) - reference historique
CODE_2026-08-03_avant_ee4d08b/

# Fichiers temporaires du generateur PLCopenXML (tmpXXXX.xml)
/tmp/
/.tmpsandbox/

# Etat local et transitoire du Task Manager (verrous inter-agents).
/DOC/WFLOW/TASK_LOCKS.json
/DOC/WFLOW/.task_manager.write.lock
/DOC/WFLOW/.task_manager.server*.lock

