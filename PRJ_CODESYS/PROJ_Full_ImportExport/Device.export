            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_SyncHMI — Données d'échange IHM pour la synchronisation
///   ───────────────────────────────────────────────────────────────
///   🎨 Paramètres d'écart, écart réel et alarmes.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SyncHMI :
STRUCT
	///⚙️ Paramètres / Calibration (Lecture/Écriture)
	///📐 Tolérance max d'écart (m) — 🔧 REX 2026-07-08 (5) : 0.10→0.25, aligné GVL_PERSISTENT.WinchSyncTolerance_M
	SyncToleranceM: REAL := 0.25;
	///🚦 États (Lecture seule)
	///📊 Écart de position réel mesuré (m)
	DeltaPosM: REAL;
	///⚖️ Indicateur si surveillance active
	SyncActive: BOOL;
	///⚠️ LED d'alarme écart hors tolérance
	SyncWarn: BOOL;
	///🟢 Bloc de synchro prêt
	Ready: BOOL;
	///🔴 Alarme synchro active
	Error: BOOL;
	///❌ Code défaut synchro
	ErrorId: WORD;
	///🤖 État de l'automate interne
	State: E_State;
	///🎮 Commandes / Bypasses
	///☑️ 🔧 REX 2026-07-08 : coché = synchro voulue (MAINT_N1/N2), ex-OverrideSync inversé
	SyncEnableRequest: BOOL := TRUE;
END_STRUCT
END_TYPE
</Single>
