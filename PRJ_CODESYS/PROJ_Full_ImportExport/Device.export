          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639186933407773619</Single>
      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(* ═══════════════════════════════════════════════════════════════
   🔌 ST_ContactorCheck — Double vérification commande/retour contacteur
   ───────────────────────────────────────────────────────────────
   📄 Doc métier : DOC/AF_Partie2_Architecture_Programme_v2.6.md §8,
                   DOC/AF_Partie3_Template_FB_Commun_v1.2.md §7bis
   Utilisé par FB_Brake (frein) et FB_Winch (contacteurs de sens) pour
   détecter un collage / une absence de fermeture d'un contacteur de
   puissance, au-delà d'un délai de cohérence (FeedbackTimeout du FB
   appelant).
   ═══════════════════════════════════════════════════════════════ *)

TYPE ST_ContactorCheck :
STRUCT
    Command     : BOOL;   // Ordre envoyé au contacteur (TRUE = fermé/actif)
    Feedback    : BOOL;   // Retour d'état câblé (TRUE = effectivement fermé)
    StuckClosed : BOOL;   // Diag : commande OFF mais retour ON depuis trop longtemps → PowerCutOff
    StuckOpen   : BOOL;   // Diag : commande ON mais retour OFF depuis trop longtemps
END_STRUCT
END_TYPE
</Single>
            <Single Name="LineInfoPersistence" Type="string">b917c37d-44df-46a0-871a-29de2d249295_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">42</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">d0f31ba0-ba05-435b-b91d-dc9eba7e617f</Single>
      <Array Name="Path" Type="string">
