            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔧 ST_BypassWinch — Bypass maintenance dédiés à UN treuil (M1 ou M2)
///   ───────────────────────────────────────────────────────────────
///   🎨 Regroupe les bypass "dégradé assumé" propres à un axe (codeur,
///      contacteurs) — chaque treuil a son propre matériel, donc son
///      propre struct (imbriqué M1Winch.Bypass / M2Winch.Bypass).
///   🔒 Doctrine : actionnable UNIQUEMENT en MAINT_N2, RETAIN, jamais masque
///      les autres défauts du même bloc (voir DOC/AUDITS/Bypass/REGISTRE_ACTIONS_Bypass_v1.0.md).
///   ⚠️ Les bypass de capteurs COMMUNS (SlackCable, TopPositionSensor — capteur
///      physique unique partagé M1/M2) sont dans ST_CommunHMI.Bypass, PAS ici.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BypassWinch :
STRUCT
	///📡 1. Communication &amp; Systèmes auxiliaires
	///📡 Bypass communication esclave CANopen Joystick / heartbeat IHM
	OperatorComm: BOOL;
	///🔌 Bypass diagnostic esclave EtherCAT COD (codeur absolu)
	EncoderFault: BOOL;
	///🔌 Bypass feedbacks contacteurs de puissance et frein
	ContactorFeedback: BOOL;
	///⚡ Bypass défaut rotation de phases (commun machine)
	PhaseRotation: BOOL;
	///🌡️ Bypass surchauffe thermique frein (commun machine)
	BrakeThermal: BOOL;
	///🚧 2. Limites physiques et Positionnement
	///🚧 Bypass fin de course physique haute
	TopLimitSwitch: BOOL;
	///🚧 Bypass limite basse physique (longueur de câble max)
	CableLimitSwitch: BOOL;
	///⚙️ 3. Sécurité Mécanique (Méca A-E)
	///🔄 Bypass Méca A : mouvement non commandé à l'arrêt
	MecaA: BOOL;
	///🛑 Bypass Méca B : absence confirmation arrêt (frein/contacteurs)
	MecaB: BOOL;
	///🏋️ Bypass Méca C : glissement de charge (benne M1)
	MecaC: BOOL;
	///🚧 Bypass Méca D : arrivée butée haute anormale
	MecaD: BOOL;
	///🔄 Bypass Méca E : désynchronisation critique
	MecaE: BOOL;
	///🛡️ 4. Hiérarchie &amp; Restauration
	///🛡️ Bypass groupé : tous les bits qui provoquent un PowerCutOff
	Safety: BOOL;
	///⚙️ Bypass groupé : tous les bits qui provoquent un SafeStop
	Process: BOOL;
	///🌐 Bypass Global : ignore toutes les sécurités de cet axe
	Global: BOOL;
	///🐛 FIX persistance (voir DOC/AUDITS/ConfigPersistence/) : flag restauration boot dédié
	///(défaut FALSE non ambigu, contrairement à une valeur métier) — PRG_09_Supervision.st
	///🚦 TRUE = bypass restauré depuis GVL_BypassRetain ce boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
