      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

// 🛑 1. Appels des instances internes
Logic(
    Enable := Enable,
    Reset := Reset,
    ArmRequest := ArmRequest,
    EmergencyChain := EmergencyChain,
    EmergencyStopOk := EmergencyStopOk,
    PowerCutOffRequest := PowerCutOffRequest,
    CmdEmergencyCutOff := CmdEmergencyCutOff
);

Output(
    Enable := Enable,
    Cmd := Logic.Cmd
);

// 📤 2. Propagation des signaux vers les sorties du bloc parent
Ready := Enable;
Busy  := (Logic.ArmingSeqStep &lt;&gt; 0);
Done  := EmergencyStopOk;
Error := Logic.Error;
ErrorId := Logic.ErrorId;

PowerCutOff_A_RQ   := Output.PowerCutOff_A_RQ;
PowerCutOff_B_RQ   := Output.PowerCutOff_B_RQ;
EmergencyArming_RQ := Output.EmergencyArming_RQ;

ArmingSeqStep                := Logic.ArmingSeqStep;
RedundancyTestFailed         := Logic.RedundancyTestFailed;
EmergencyArmingFailed        := Logic.EmergencyArmingFailed;
EmergencyArmingLockoutActive := Logic.EmergencyArmingLockoutActive;
</Single>
            <Single Name="LineInfoPersistence" Type="string">fec28e54-c2e9-52ff-aa9e-cdc3b3341d91_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Safety_EmergencyManagement — Bloc Safety Composite (Parent)
///   ───────────────────────────────────────────────────────────────
///   📄 Rôle : Bloc de sécurité principal de la boucle d'arrêt d'urgence.
///   🧩 Encapsule la Logique (FB_Safety_EmergencyManagementLogic) et le 
///      Pilote Physique (FB_Safety_EmergencyManagementOutput) par composition.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Safety_EmergencyManagement
VAR_INPUT
	///Active la surveillance
	Enable: BOOL;
	///Front acquittement défauts
	Reset: BOOL;
	///Demande de réarmement (CmdEmergencyArming)
	ArmRequest: BOOL;
	///Retour physique boucle d'urgence amont contacteur
	EmergencyChain: BOOL;
	///Confirmation contacteur de puissance principal
	EmergencyStopOk: BOOL;
	///Requête de coupure logique issue des métiers
	PowerCutOffRequest: BOOL;
	///Commande d'ouverture d'urgence depuis l'IHM
	CmdEmergencyCutOff: BOOL;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: RedundancyTestFailed, bit1: EmergencyArmingFailed
	ErrorId: WORD;
	///Sortie de pilotage canal A (maintenu à TRUE, fail-safe)
	PowerCutOff_A_RQ: BOOL;
	///Sortie de pilotage canal B (maintenu à TRUE, fail-safe)
	PowerCutOff_B_RQ: BOOL;
	///Impulsion réarmement physique (1s)
	EmergencyArming_RQ: BOOL;
	///Étape de diagnostic : 0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm
	ArmingSeqStep: INT;
	///Canal A ou B resté collé/shunté détecté à l'auto-test
	RedundancyTestFailed: BOOL;
	///Contacteur de puissance n'a pas confirmé l'armement
	EmergencyArmingFailed: BOOL;
	///Verrouillage temporel de 5s entre les essais
	EmergencyArmingLockoutActive: BOOL;
END_VAR
VAR
	///🧱 Composition interne des sous-blocs
	Logic: FB_Safety_EmergencyManagementLogic;
	Output: FB_Safety_EmergencyManagementOutput;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">fec28e54-c2e9-52ff-aa9e-cdc3b3341d91_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">88</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">1e02b709-e2a1-4a30-832d-85a3574f6a16</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">Logique API</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">AU</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">caf20e65-2056-55b9-b3cc-b6cc1b3bfe7b</Single>
        <Single Name="ParentGuid" Type="System.Guid">103fbab6-1b12-4ccb-9cc6-6c66cad0e1cb</Single>
        <Single Name="Name" Type="string">FB_Safety_EmergencyManagementLogic</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">24568a24-c491-472c-a21f-ee5d33859fab</Single>
            </Key>
            <Value>
              <Single Type="{24568a24-c491-472c-a21f-ee5d33859fab}" Method="IArchivable">
                <Single Name="MemoryReserveForOnlineChange" Type="int">0</Single>
                <Single Name="ExcludeFromBuild" Type="bool">False</Single>
                <Single Name="External" Type="bool">False</Single>
                <Single Name="EnableSystemCall" Type="bool">False</Single>
                <Single Name="CompilerDefines" Type="string"></Single>
                <Single Name="LinkAlways" Type="bool">False</Single>
                <Array Name="Undefines" Type="string" />
              </Single>
            </Value>
          </Entry>
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">1e02b709-e2a1-4a30-832d-85a3574f6a16</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639199740620776676</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

// 🛑 1. GATE — neutralisation si désactivé
IF NOT Enable THEN
    Error := FALSE;
    ErrorId := 16#0000;
    Cmd.PowerCutOff_A_Cmd := FALSE;
    Cmd.PowerCutOff_B_Cmd := FALSE;
    Cmd.EmergencyArming_Cmd := FALSE;
    ArmingSeqStep := 0;
    RedundancyTestFailed := FALSE;
    EmergencyArmingFailed := FALSE;
    EmergencyArmingLockoutActive := FALSE;
    ForceTestA := FALSE;
    ForceTestB := FALSE;
    TonTestA(IN := FALSE);
    TonRestoreA(IN := FALSE);
    TonTestB(IN := FALSE);
    TonRestoreB(IN := FALSE);
    TonArmingPulse(IN := FALSE);
    TonArmingConfirm(IN := FALSE);
    TonArmingLockout(IN := FALSE);
    RETURN;
END_IF;

ResetEdge(CLK := Reset);
ArmReqEdge(CLK := ArmRequest);

// 🔍 2. ACQUITTEMENT DES DÉFAUTS
IF ResetEdge.Q THEN
    RedundancyTestFailed := FALSE;
    IF EmergencyStopOk THEN
        EmergencyArmingFailed := FALSE;
    END_IF;
END_IF;

// 🚦 3. DÉCLENCHEMENT DE LA SÉQUENCE DE SÉCURITÉ
IF ArmReqEdge.Q AND (ArmingSeqStep = 0) AND EmergencyChain 
   AND NOT EmergencyArmingLockoutActive 
   AND NOT EmergencyStopOk THEN
    ArmingSeqStep := 1;
END_IF;

// ⏱️ Étape 1 : Coupe canal A seul, vérifie que la boucle tombe
TonTestA(IN := (ArmingSeqStep = 1), PT := T#200ms);
IF ArmingSeqStep = 1 THEN
    ForceTestA := TRUE;
    IF TonTestA.Q THEN
        ForceTestA := FALSE;
        IF EmergencyChain THEN
            RedundancyTestFailed := TRUE;
            ArmingSeqStep := 0;
        ELSE
            ArmingSeqStep := 2;
        END_IF;
    END_IF;
ELSE
    ForceTestA := FALSE;
END_IF;

// ⏱️ Étape 2 : Restaure A, attend le retour sain de la boucle amont
TonRestoreA(IN := (ArmingSeqStep = 2), PT := T#200ms);
IF (ArmingSeqStep = 2) AND TonRestoreA.Q THEN
    IF EmergencyChain THEN
        ArmingSeqStep := 3;
    ELSE
        ArmingSeqStep := 0;
    END_IF;
END_IF;

// ⏱️ Étape 3 : Coupe canal B seul, vérifie que la boucle tombe
TonTestB(IN := (ArmingSeqStep = 3), PT := T#200ms);
IF ArmingSeqStep = 3 THEN
    ForceTestB := TRUE;
    IF TonTestB.Q THEN
        ForceTestB := FALSE;
        IF EmergencyChain THEN
            RedundancyTestFailed := TRUE;
            ArmingSeqStep := 0;
        ELSE
            ArmingSeqStep := 4;
        END_IF;
    END_IF;
ELSE
    ForceTestB := FALSE;
END_IF;

// ⏱️ Étape 4 : Restaure B, attend le retour sain de la boucle amont
TonRestoreB(IN := (ArmingSeqStep = 4), PT := T#200ms);
IF (ArmingSeqStep = 4) AND TonRestoreB.Q THEN
    IF EmergencyChain THEN
        ArmingSeqStep := 5;
    ELSE
        ArmingSeqStep := 0;
    END_IF;
END_IF;

// ⏱️ Étape 5 : Les 2 canaux validés -&gt; impulsion réarmement physique (1s)
TonArmingPulse(IN := (ArmingSeqStep = 5), PT := T#1s);
Cmd.EmergencyArming_Cmd := (ArmingSeqStep = 5);
IF (ArmingSeqStep = 5) AND TonArmingPulse.Q THEN
    ArmingSeqStep := 6;
END_IF;

// ⏱️ Étape 6 : Attente confirmation contacteur principal (2s max)
TonArmingConfirm(IN := (ArmingSeqStep = 6), PT := T#2s);
IF ArmingSeqStep = 6 THEN
    IF EmergencyStopOk THEN
        ArmingSeqStep := 0;
        EmergencyArmingLockoutActive := FALSE;
    ELSIF TonArmingConfirm.Q THEN
        EmergencyArmingFailed := TRUE;
        ArmingSeqStep := 0;
        EmergencyArmingLockoutActive := TRUE;
    END_IF;
END_IF;

// ⏱️ Séquence de verrouillage temporel (5s)
TonArmingLockout(IN := EmergencyArmingLockoutActive, PT := T#5s);
IF TonArmingLockout.Q THEN
    EmergencyArmingLockoutActive := FALSE;
END_IF;

// 📤 4. GÉNÉRATION DES CONSIGNES LOGIQUES
Cmd.PowerCutOff_A_Cmd := NOT PowerCutOffRequest AND NOT ForceTestA AND NOT CmdEmergencyCutOff AND NOT RedundancyTestFailed;
Cmd.PowerCutOff_B_Cmd := NOT PowerCutOffRequest AND NOT ForceTestB AND NOT CmdEmergencyCutOff AND NOT RedundancyTestFailed;

// 📤 5. SYNTHÈSE DES ERREURS
ErrorId := 16#0000;
IF RedundancyTestFailed THEN
    ErrorId := ErrorId OR 16#0001;
END_IF;
IF EmergencyArmingFailed THEN
    ErrorId := ErrorId OR 16#0002;
END_IF;

Error := (ErrorId &lt;&gt; 16#0000);
</Single>
            <Single Name="LineInfoPersistence" Type="string">caf20e65-2056-55b9-b3cc-b6cc1b3bfe7b_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Safety_EmergencyManagementLogic — Décision &amp; Séquencement
///   ───────────────────────────────────────────────────────────────
///   📄 Rôle : Gère la machine d'état d'auto-test et de réarmement de
///      la boucle d'arrêt d'urgence. Produit les consignes logiques.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Safety_EmergencyManagementLogic
VAR_INPUT
	///Active la surveillance
	Enable: BOOL;
	///Front acquittement défauts
	Reset: BOOL;
	///Demande de réarmement (CmdEmergencyArming)
	ArmRequest: BOOL;
	///Retour physique boucle d'urgence amont contacteur
	EmergencyChain: BOOL;
	///Confirmation contacteur de puissance principal
	EmergencyStopOk: BOOL;
	///Requête de coupure logique issue des métiers
	PowerCutOffRequest: BOOL;
	///Commande d'ouverture d'urgence depuis l'IHM
	CmdEmergencyCutOff: BOOL;
END_VAR
VAR_OUTPUT
	Error: BOOL;
	///bit0: RedundancyTestFailed, bit1: EmergencyArmingFailed
	ErrorId: WORD;
	///Structure de commande logique produite
	Cmd: ST_EmergencyManagementCmd;
	///Étape de diagnostic : 0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm
	ArmingSeqStep: INT;
	///Canal A ou B resté collé/shunté détecté à l'auto-test
	RedundancyTestFailed: BOOL;
	///Contacteur de puissance n'a pas confirmé l'armement
	EmergencyArmingFailed: BOOL;
	///Verrouillage temporel de 5s entre les essais
	EmergencyArmingLockoutActive: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ArmReqEdge: R_TRIG;
	ForceTestA: BOOL;
	ForceTestB: BOOL;
	TonTestA: TON;
	TonRestoreA: TON;
	TonTestB: TON;
	TonRestoreB: TON;
	TonArmingPulse: TON;
	TonArmingConfirm: TON;
	TonArmingLockout: TON;
END_VAR
</Single>
