            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestCheckConfig — Configuration d'un check (une assertion)
///═══════════════════════════════════════════════════════════════
TYPE ST_TestCheckConfig :
STRUCT
	///Type de check
	Kind: E_TestCheckKind;
	///Mode d'évaluation
	Mode: E_TestCheckMode;
	///Index de la sonde dans le tableau correspondant
	ProbeIdx: INT;
	///Valeur attendue pour BOOL_EQUAL
	ExpectedBool: BOOL;
	///Valeur attendue pour DINT_EQUAL / DINT_NOT_EQUAL
	ExpectedDint: DINT;
	///Bornes pour DINT_IN_RANGE
	ExpectedMin: DINT;
	ExpectedMax: DINT;
	///Masque pour WORD_MASK_*
	Mask: WORD;
	///Bornes pour REAL_IN_RANGE
	RealMin: REAL;
	RealMax: REAL;
	///Durée de stabilité requise pour CHECK_WAIT_UNTIL
	StablePT: TIME;
END_STRUCT
END_TYPE
</Single>
