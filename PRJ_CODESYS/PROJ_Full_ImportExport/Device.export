      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Abs) ===

{region "§1 Causes &amp; Socle Défaut (évalué en continu)"}
// 🔑 1. RESET FRONT
ResetEdge(CLK := Reset);

// 🔍 2. DIAGNOSTIC BUS / ALARME (Cause 0 : live)
instCauses[0].Active   := (AlarmsIn &lt;&gt; 0) OR NOT SlaveOperational;
instCauses[0].Latching := FALSE;
instCauses[0].Texte    := 'Defaut communication EtherCAT codeur absolu';

// ⏱️ 3. TIMEOUT PRESET (Cause 1 : latched)
IF ResetEdge.Q AND (PresetSeqStep = 0) THEN
    PresetTimeoutError := FALSE;
END_IF;
instCauses[1].Active   := PresetTimeoutError;
instCauses[1].Latching := TRUE;
instCauses[1].Texte    := 'Timeout sequence preset SDO codeur';

// Appel du socle de défaut
instFault(Enable := Enable, Reset := Reset, Causes := instCauses);
Fault := instFault.Fault;

EncoderAvailable := NOT instCauses[0].Active;
{endregion}

{region "§2 Gate neutralisation"}
// 🛑 2. GATE
IF NOT Enable THEN
    EncoderAvailable := FALSE;
    Ready := FALSE;
    PresetTriggerCmd := 16#0000; CodeSeqTriggerCmd := 16#0000; PresetValueOut := 0;
    PresetSeqStep := 0;
    PresetCompleted := FALSE;
    PresetTimer(IN := FALSE, PT := PresetTimeout);
    PresetTimerVisual(IN := FALSE, PT := T#500MS);
    // RawPos, AngleRaw et TurnCount sont volontairement gelés hors Enable
    // (AF09 F09.01 / AC5) : aucune lecture bus ni remise a zero dans ce gate.
    RETURN;
END_IF;

Ready := Enable AND NOT Fault.Latched;
{endregion}

{region "§3 Lecture position"}
// 📥 3. LECTURE POSITION — GELER SUR DOUTE (Partie10 §6)
// Si EncoderAvailable=FALSE : RawPos/AngleRaw/TurnCount conservent leur dernière valeur (pas de RETURN
// global ici pour ne pas geler aussi la séquence preset/l'état — seule la lecture est gelée).
IF EncoderAvailable THEN
    RawPos := RawPosIn;   // Sens de comptage géré côté codeur (CoE 6000h bit0, startup parameter CODESYS) — voir Partie10 §3bis. Plus de calcul ici.
    AngleRaw := UDINT_TO_UINT(RawPos MOD PointsPerRev);
    TurnCount := RawPos / PointsPerRev;
END_IF;
{endregion}

{region "§4 Séquence preset"}
// 🔧 4. SÉQUENCE PRESET (écriture bus)
// PresetTriggerCmd := 2 déclenche le référencement à PresetValue (valeur de commande, pas un
// masque de bits). CodeSeqTriggerCmd : rôle non identifié — laissé à 0, PAS piloté tant que sa
// fonction n'est pas confirmée. Ne jamais lui donner une valeur arbitraire.
PresetReqEdge(CLK := PresetRequest);
PresetCompleted := FALSE;
CodeSeqTriggerCmd := 16#0000;           // non piloté — rôle inconnu, voir note ci-dessus
CASE PresetSeqStep OF
    0: // IDLE
        PresetTriggerCmd := 0;
        IF PresetReqEdge.Q AND EncoderAvailable THEN
            PresetValueOut := PresetValue;
            PresetSeqStep := 1;
            PresetTimer(IN := TRUE, PT := PresetTimeout);
        END_IF;
    1: // Déclenchement preset (laissé actif pendant 0.5s pour confort visuel en simulation/bus)
        PresetTriggerCmd := 2;   // Référence le codeur à PresetValueOut
        RawDiff := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(PresetValueOut);
        IF ABS(RawDiff) &lt;= UDINT_TO_DINT(PresetTolerancePts) THEN
            PresetTimer(IN := FALSE, PT := PresetTimeout);
            PresetTimerVisual(IN := TRUE, PT := T#500MS);
            IF PresetTimerVisual.Q THEN
                PresetTriggerCmd := 0;
                PresetCompleted := TRUE;
                PresetSeqStep := 0;
                PresetTimerVisual(IN := FALSE, PT := T#500MS);
            END_IF;
        ELSIF PresetTimer.Q THEN
            PresetTriggerCmd := 0;
            PresetTimeoutError := TRUE;
            PresetSeqStep := 0;
            PresetTimer(IN := FALSE, PT := PresetTimeout);
            PresetTimerVisual(IN := FALSE, PT := T#500MS);
        END_IF;
END_CASE;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">c7aa3c0c-0761-458e-9ead-c65eb2e8bb93_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔌 FB_Encoder_Abs — Acquisition codeur absolu (accès bus EtherCAT)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Accès bus EtherCAT, extraction positions brutes et séquence de Preset SDO
///   🔒 Polarité : EncoderAvailable=TRUE si communication bus et esclave OK
///   🔌 Architecture : Module d'acquisition codeur absolu
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
///   =======================================================================
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Abs) ===
FUNCTION_BLOCK FB_Encoder_Abs
VAR_INPUT
	///=== COMMANDES &amp; AUTORISATIONS ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut (front montant)
	Reset: BOOL;
	///--&gt; [CMD] Demande de preset (front montant)
	PresetRequest: BOOL;
	///=== BUS ETHERCAT &amp; CAPTEUR HW ===
	///--&gt; [HW]  Position brute EtherCAT
	RawPosIn: UDINT;
	///--&gt; [HW]  Codes alarmes bruts EtherCAT
	AlarmsIn: UINT;
	///--&gt; [HW]  Codes avertissements bruts EtherCAT
	WarningsIn: UINT;
	///--&gt; [HW]  Statut esclave EtherCAT operationnel
	SlaveOperational: BOOL;
	///=== PARAMETRES &amp; REGLAGES ===
	///--&gt; [CFG] Resolution codeur (pts/tour)
	PointsPerRev: UDINT := 8192;
	///--&gt; [CFG] Valeur cible de preset
	PresetValue: UDINT;
	///--&gt; [CFG] Temporisation max attente preset
	PresetTimeout: TIME := TIME#2s0ms;
	///--&gt; [CFG] Tolerance relecture post-preset (pts)
	PresetTolerancePts: UDINT := 10;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///🧩 Statut transverse (forme cible ST_Fault)
	Fault: ST_Fault;
	///=== MESURES &amp; DONNEES CODEUR ===
	///&lt;-- [DIAG] Position brute gelee si non disponible
	RawPos: UDINT;
	///&lt;-- [STAT] Codeur operationnel et disponible
	EncoderAvailable: BOOL;
	///&lt;-- [DIAG] Angle brut sur un tour (MOD PointsPerRev)
	AngleRaw: UINT;
	///&lt;-- [DIAG] Nombre de tours bruts (RawPos / PointsPerRev)
	TurnCount: UDINT;
	///=== COMMANDES &amp; ECHANGE BUS ETHERCAT ===
	///&lt;-- [ACT]  Ordre declenchement preset vers PDO Rx
	PresetTriggerCmd: WORD;
	///&lt;-- [ACT]  Ordre sequence code vers PDO Rx
	CodeSeqTriggerCmd: WORD;
	///&lt;-- [ACT]  Valeur de preset transmise au PDO Rx
	PresetValueOut: UDINT;
END_VAR
VAR
	///=== DETECTEURS DE FRONT ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///. [LOC] Detecteur front montant PresetRequest
	PresetReqEdge: R_TRIG;
	///=== TEMPORISATEURS INTERNES ===
	///. [LOC] Temporisateur timeout sequence preset
	PresetTimer: TON;
	///. [LOC] Temporisateur maintien visuel impulsion (500ms)
	PresetTimerVisual: TON;
	///=== VARIABLES INTERNES DE CALCUL &amp; ETAT ===
	///. [LOC] Etape sequence preset (0:IDLE, 1:PULSE/WAIT)
	PresetSeqStep: INT;
	///. [LOC] Ecart signe entre RawPos et PresetValueOut
	RawDiff: DINT;
	///. [LOC] Fait de fin de maintien preset (un scan)
	PresetCompleted: BOOL;
	///. [LOC] Latch interne timeout séquence preset
	PresetTimeoutError: BOOL;
	///=== SOCLE DEFAUT (FB_FaultCore) ===
	///* [INST] Socle défaut transverse
	instFault: FB_FaultCore;
	///. [LOC] Table des causes nommées
	instCauses: ARRAY[0..15] OF ST_FaultCause;
END_VAR
</Single>
