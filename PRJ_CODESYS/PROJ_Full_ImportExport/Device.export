            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_BucketConfig — Configuration des offsets du benne
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie12_Fonction_Benne_v1.0.md §4.A
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BucketConfig :
STRUCT
	///Écart M1/M2 en mètres benne ouvert
	OffsetOpenM: REAL;
	///Écart M1/M2 en mètres benne fermé
	OffsetCloseM: REAL;
	///Seuil de détection d'incohérence au boot
	CoherenceLimitM: REAL;
END_STRUCT
END_TYPE
