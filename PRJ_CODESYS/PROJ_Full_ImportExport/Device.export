          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_WinchSymmetryHMI :
STRUCT
	BtnReset: BOOL;
	SymmetryOk: BOOL;
	SymmetryValid: BOOL;
	DeltaStartDelay_Ms: UDINT;
	DeltaBrakeReleaseTime_Ms: UDINT;
	DeltaBrakeApplyTime_Ms: UDINT;
	DeltaStopDistance_M: REAL;
	DeltaStopTime_Ms: UDINT;
	MaxSyncDeviation_M: REAL;
END_STRUCT
END_TYPE
