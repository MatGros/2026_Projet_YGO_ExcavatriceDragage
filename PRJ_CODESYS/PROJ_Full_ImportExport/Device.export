            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔧 ST_SyncCfg — Configuration de la synchronisation M1/M2
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SyncCfg :
STRUCT
