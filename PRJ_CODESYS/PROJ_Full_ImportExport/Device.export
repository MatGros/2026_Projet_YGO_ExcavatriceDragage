            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 ST_Winch_SymmetryData — Données mesurées de symétrie M1/M2
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure des résultats de mesures et d'écarts du diagnostic symétrie
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
///   =======================================================================
TYPE ST_Winch_SymmetryData :
STRUCT
	///Ecart mesure au demarrage (ms)
	DeltaStartDelay_Ms: UDINT;
	///Ecart mesure temps desserrage frein (ms)
	DeltaBrakeReleaseTime_Ms: UDINT;
	///Ecart mesure temps serrage frein (ms)
	DeltaBrakeApplyTime_Ms: UDINT;
	///Ecart mesure distance d'arret (mm)
	DeltaStopDistance_Mm: UDINT;
	///Ecart mesure temps d'arret (ms)
	DeltaStopTime_Ms: UDINT;
	///Ecart maximal de synchronisme enregistre (m)
	MaxSyncDeviation_M: REAL;
END_STRUCT
END_TYPE
</Single>
