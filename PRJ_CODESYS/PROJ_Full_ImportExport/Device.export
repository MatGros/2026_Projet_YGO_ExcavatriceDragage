          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639197103395348257</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (corps du PROGRAM PRG_05_Cycle) ===

// Appel du séquenceur de cycle principal avec tous ses raccordements
instCycle(
    Enable              := (PRG_04_Modes.instModes.Mode = E_Mode.SEMI_AUTO) AND NOT PRG_10_Outputs.ManuActive,
    Reset               := CmdResetCycle_IHM,
    EmergencyStopOk     := PRG_00_Inputs.EmergencyStopOk,
    
    StartCycle          := CmdStartCycle_IHM,
    PauseCycle          := CmdPauseCycle_IHM,
    AbortCycle          := CmdAbortCycle_IHM,
    
    TargetDepthM        := TargetDepthM,
    TargetOffsetM       := TargetOffsetM,
    SelectedTargetNum_IHM := GVL_IHM.Chariot.SelectedTargetNum,

    // Capteur fond touché détecté par le mou de câble physique (sécurité positive)
    BottomTouched       := NOT PRG_00_Inputs.SlackCableSwitch,
    M1_CablePosM        := PRG_02_Encoders.instEncoderScaleM1.CablePosM,
    M2_CablePosM        := PRG_02_Encoders.instEncoderScaleM2.CablePosM,

    // Position chariot
    Chariot_At_Fosse1   := PRG_00_Inputs.ChariotPosFosse1,
    Chariot_At_Fosse2   := PRG_00_Inputs.ChariotPosFosse2,
    Chariot_At_Maintenance := PRG_00_Inputs.ChariotPosMaintenance,
    Chariot_At_Tremie   := PRG_00_Inputs.ChariotPosTremie,
    Chariot_Busy        := PRG_07_ChariotControl.instChariotM3.Busy,
    Chariot_Done        := PRG_07_ChariotControl.instChariotM3.Done,

    // Mouvements mâchoires grappin (gérés par instGrappin)
    Grappin_Busy        := PRG_06_WinchControl.instGrappin.Busy,
    Grappin_Done        := PRG_06_WinchControl.instGrappin.Done,
    Grappin_IsOpen      := GVL_PERSISTENT.GrappinState.IsOpen,
    Grappin_IsClosed    := GVL_PERSISTENT.GrappinState.IsClosed
);
</Single>
            <Single Name="LineInfoPersistence" Type="string">37c173d1-e05f-53f4-aa3f-3cc90e6be97a_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔄 PRG_05_Cycle — Séquenceur du Cycle Automatique / Semi-Auto (Grafcet)
///   ───────────────────────────────────────────────────────────────
///   ⚙️ Exécuté par la tâche PLC en position 5.
///   ✅ Gère la machine d'état principale de dragage (FB_Cycle).
///   ═══════════════════════════════════════════════════════════════
PROGRAM PRG_05_Cycle
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	///Instance du séquenceur automatique
	instCycle: FB_Cycle;
	///Commandes issues de la supervision (IHM)
	///Lancement cycle automatique
	CmdStartCycle_IHM: BOOL;
	///Pause cycle automatique
	CmdPauseCycle_IHM: BOOL;
	///Abandon / arrêt cycle automatique
	CmdAbortCycle_IHM: BOOL;
	///🔧 REX 2026-07-07 : reset dédié FB_Cycle, jamais mélangé au reset défauts général
	CmdResetCycle_IHM: BOOL;
	///Paramètres cibles réglés par l'opérateur
	///Profondeur de dragage cible (mètres, négative)
	TargetDepthM: REAL := -12.5;
	///Décalage cible de fermeture du grappin (mètres)
	TargetOffsetM: REAL := 1.5;
END_VAR
</Single>
