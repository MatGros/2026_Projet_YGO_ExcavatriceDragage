	CountRising: BOOL;
	ExpectedMin: DINT;
	ExpectedMax: DINT;
END_VAR
VAR_OUTPUT
	Count: DINT;
	InRange: BOOL;
END_VAR
VAR
	TrigRising: R_TRIG;
	TrigFalling: F_TRIG;
END_VAR
