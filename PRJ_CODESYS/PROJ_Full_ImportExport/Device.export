      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚨 ST_AlarmBanner — Bandeau d'alarme defilant (carrousel n/N)
///   ───────────────────────────────────────────────────────────────
///   🎯 Role : liste les defauts/warnings actifs de toute la machine,
///      affiches un a la fois en rotation (FB_Hmi_BannerFormatter S5)
///   📄 Doc : DOC/AF/AF_Partie-07_Interface_IHM_v2.2.md S6
///   ═══════════════════════════════════════════════════════════════
TYPE ST_AlarmBanner :
STRUCT
	///TRUE = au moins un defaut/warning actif
	HasAlarm: BOOL;
	///Texte du message courant : [ORGANE] raison breve
	Text: STRING(120);
	///Position courante (1-based, 0 si aucun defaut)
	Index: INT;
	///Nombre total de messages actifs
	Count: INT;
	///📋 Liste complete instantanee de tous les defauts actifs
	AlarmArray: ARRAY[0..49] OF STRING(120);
END_STRUCT
END_TYPE
</Single>
