          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Ramp
VAR_INPUT
    Target      : REAL;       // Cible visée
    AccelRate   : REAL;       // Taux d'accélération (%/s)
    DecelRate   : REAL;       // Taux de décélération (%/s)
    CycleTimeS  : REAL;       // Temps de cycle réel en secondes
END_VAR
VAR_OUTPUT
    Current     : REAL;       // Valeur courante amortie
END_VAR
VAR
    StepX       : REAL;
END_VAR</Single>
