      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// PROGRAM PLC_PRG

// 1. ÉVALUATION DE LA SÉCURITÉ TRANSVERSE
InstanceSafety(
    Enable := TRUE,
    EStopArmed := LocalEmergencyStopTOR,
    CanOnline := diagCAN.IsOnline,
    CanOperational := diagCAN.IsOperational,
    EthercatOk := LocalEthercatOk
);

// 2. ACQUISITION DU GESTE OPÉRATEUR SÉCURISÉ
InstanceJoystick(
    Enable := TRUE,
    SafeStop := InstanceSafety.SafeStop,   // Reçoit la sécurité positive inversée
    SafetyOk := InstanceSafety.SafetyOk,   // Reçoit le feu vert global
    CanOnline := diagCAN.IsOnline,
    CanOperational := diagCAN.IsOperational,
    RawX := JoyXRaw_ANA1,
    RawY := JoyYRaw_ANA2,
    RawButton := JoyBtnRaw
);</Single>
