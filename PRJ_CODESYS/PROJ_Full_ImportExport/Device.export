            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🖥️ ST_HmiBanner — Bandeau d'information et messages opérateur
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-07_Interface_IHM_v2.0.md §4
///   🎯 Responsabilité : regroupe les 4 champs de guidage et contexte
///      IHM à responsabilités disjointes (Macro, Micro, Dérogations, Action).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_HmiBanner :
STRUCT
	///1. Macro : [RÉEL/SIMU] [MODE] [COUPLAGE]
	GlobalContextText: STRING(80);
	///2. Micro : Cycle Maître &gt; Sous-cycle / Étape active
	SequenceProgressText: STRING(120);
	///3. Dérogations : Bypass, bridages, butées inactives
	SpecialConditionText: STRING(120);
	///4. Action attendue : [ORGANE] Action physique &gt; Fin
	OperatorActionText: STRING(120);
END_STRUCT
END_TYPE
</Single>
