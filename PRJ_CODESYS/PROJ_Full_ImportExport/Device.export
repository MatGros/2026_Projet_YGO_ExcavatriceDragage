          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎛️ GVL_IHM — Variables globales d'échange pour l'IHM
///   ───────────────────────────────────────────────────────────────
///   📄 Lot A : Mise en service et calibration de la machine de dragage.
///   💾 Déclaré en RETAIN pour la persistance des configurations opérateur.
///   ═══════════════════════════════════════════════════════════════
VAR_GLOBAL RETAIN
	///🛗 Variables d'échange IHM Treuil Principal M1
	WinchM1: ST_WinchHMI;
	///🛗 Variables d'échange IHM Treuil Auxiliaire M2
	WinchM2: ST_WinchHMI;
	///🪣 Variables d'échange IHM Mécanisme Grappin
	Grappin: ST_GrappinHMI;
	///⚖️ Variables d'échange IHM Surveillance de synchro
	Sync: ST_SyncHMI;
	///🕹️ Variables d'échange IHM Joystick
	Joystick: ST_JoystickHMI;
	///🎚️ Variables d'échange IHM Modes de marche
	Modes: ST_ModesHMI;
	///↔️ Variables d'échange IHM Chariot M3
	Chariot: ST_ChariotHMI;
	///📡 Variables d'échange IHM Diagnostics réseau
	Network: ST_NetworkDiagHMI;
	///🌐 REX 2026-07-08 : signaux communs, pas propres à un axe (TopPositionSensorActive, BrakeThermalFault, LimitLegal)
	Common: ST_CommonHMI;
	///🛠️ Variables d'échange IHM provisoires pour pilotage manuel direct (Secours)
	IHM_MANU: ST_IHM_MANU;
	///🚩 Indicateur d'initialisation IHM depuis PERSISTENT
	HmiInitDone: BOOL;
END_VAR</Single>
