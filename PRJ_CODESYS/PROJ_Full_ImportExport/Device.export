        <Single Name="Timestamp" Type="long">639237203753363057</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

{region "§1 Gate neutralisation"}
// 🛑 1. GATE
IF NOT Enable THEN
    DeltaPosM := 0.0; SignedDeltaPosM := 0.0;
    SyncDeviationWarn := FALSE; SyncDeviationFault := FALSE;
    WarnLatched := FALSE;
    RETURN;
END_IF;
ResetEdge(CLK := Reset);
{endregion}

{region "§2 Calcul ecart"}
// 📏 2. ÉCART M1/M2 — calculé en continu si les 2 treuils sont fiables (HomedAndReliable)
IF HomedAndReliableM1 AND HomedAndReliableM2 THEN
    SignedDeltaPosM := CablePosM1 - CablePosM2 + ActiveOffsetM;
    DeltaPosM := ABS(SignedDeltaPosM);
ELSE
    SignedDeltaPosM := 0.0;
    DeltaPosM := 0.0;
END_IF;
{endregion}

{region "§3 Surveillance ecart 2 seuils"}
// 🔍 3. SURVEILLANCE ECART — 2 seuils (Warn/Fault).
// Warn (seuil 1) = INSTANTANE + LATCH : degrade le palier 1 des que l'ecart depasse,
// sans retard temporel ni oscillation (fidele a l'ancien SyncDegradedStep1).
// Fault (seuil 2) = filtre temporel pour le transitoire mecanique d'arret.
IF NOT BypassGlobal THEN
    WarnActive  := SyncEnable AND HomedAndReliableM1 AND HomedAndReliableM2 AND (DeltaPosM &gt; CfgSyncToleranceM);
    FaultActive := SyncEnable AND HomedAndReliableM1 AND HomedAndReliableM2 AND (DeltaPosM &gt; CfgSyncCriticalToleranceM);

    // Latch Warn : reste actif tant que la cause persiste OU que Reset n'a pas ete demande
    IF WarnActive THEN
        WarnLatched := TRUE;
    ELSIF ResetEdge.Q AND NOT WarnActive THEN
        WarnLatched := FALSE;
    END_IF;
    SyncDeviationWarn := WarnActive OR WarnLatched;

    DeviationFaultTimer(IN := FaultActive, PT := T#800ms);
    SyncDeviationFault := DeviationFaultTimer.Q;
ELSE
    SyncDeviationWarn := FALSE;
    SyncDeviationFault := FALSE;
    WarnLatched := FALSE;
END_IF;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">c73e7088-68ce-44f8-b329-191ba6d79f99_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📏 FB_SyncDeviation — Comparateur d'ecart position M1/M2 (pur)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Signaler l'ecart de position entre M1 et M2 sur 2 seuils
///      (Warn = signaler / Fault = critique). Comparateur PUR : il signale,
///      il ne decide pas de ralentir ni d'arreter — le consommateur decide.
///   🔌 Interface : Bloc de surveillance transverse (1 instance)
///   🧬 Responsabilite : n'interprete PAS l'etat benne. Il reçoit ActiveOffsetM
///      deja resolu (calcul offset-selon-etat-benne = FB_Bucket/HoldOffset).
///   🔒 Polarite : SyncDeviationWarn/Fault = TRUE si ecart hors seuil.
///   📄 Doc : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   =======================================================================
FUNCTION_BLOCK FB_SyncDeviation
VAR_INPUT
	///=== COMMANDES ET CONSIGNES ===
	///--&gt; [CMD] Validation surveillance globale
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut sur front
	Reset: BOOL;
	///--&gt; [CMD] Autorisation utilisateur synchro
	SyncEnable: BOOL;
	///=== MESURES ET ETATS CODEURS ===
	///--&gt; [HW] Position cable treuil M1 (m)
	CablePosM1: REAL;
	///--&gt; [HW] Position cable treuil M2 (m)
	CablePosM2: REAL;
	///--&gt; [STAT] Gate fiable M1 (FB_EncoderReliability)
	HomedAndReliableM1: BOOL;
	///--&gt; [STAT] Gate fiable M2 (FB_EncoderReliability)
	HomedAndReliableM2: BOOL;
	///=== REGLAGES ET CONFIGURATION ===
	///--&gt; [CFG] Seuil 1 (Warn) — ecart max avant alerte (m)
	CfgSyncToleranceM: REAL := 0.1;
	///--&gt; [CFG] Seuil 2 (Fault) — ecart critique (m)
	CfgSyncCriticalToleranceM: REAL := 0.5;
	///--&gt; [CFG] Offset cible RESOLU (ex: benne)
	ActiveOffsetM: REAL := 0;
	///=== BYPASSES ET SIMULATION ===
	///--&gt; [TST] Neutralise la surveillance ecart
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	///=== MESURES ET DIAGNOSTICS DE SYNCHRO ===
	///&lt;-- [DIAG] Ecart absolu position |M1 - M2| (m)
	DeltaPosM: REAL;
	///&lt;-- [DIAG] Ecart signe position (M1 - M2) (m)
	SignedDeltaPosM: REAL;
	///&lt;-- [DIAG] Seuil 1 depasse : signaler / forcer palier 1
	SyncDeviationWarn: BOOL;
	///&lt;-- [SAFE] Seuil 2 depasse : ecart critique (block signal)
	SyncDeviationFault: BOOL;
END_VAR
VAR
	///=== DETECTEURS ET TIMERS INTERNES ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///. [LOC] Tempo filtrage transitoire ecart (seuil 2)
	DeviationFaultTimer: TON;
	///=== VARIABLES LOCALES INTERNES ===
	///. [LOC] Ecart hors seuil 1 actif
	WarnActive: BOOL;
	///. [LOC] Ecart hors seuil 2 actif
	FaultActive: BOOL;
	///. [LOC] Latch ecart seuil 1 (degrada palier 1 stable)
	WarnLatched: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">c73e7088-68ce-44f8-b329-191ba6d79f99_Decl_LineIds</Single>
          </Single>
