            <Single Name="TextBlobForSerialisation" Type="string">T := TIME_TO_REAL(TimeConst) / 1000.0;

IF (T + CycleTimeS) &gt; 0.0 THEN
    Alpha := CycleTimeS / (T + CycleTimeS);
    ValueOut := ValueOut + Alpha * (ValueIn - ValueOut);
ELSE
    ValueOut := ValueIn;
END_IF;</Single>
