            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Sim_DigitalMirror) ===

IF NOT Enable THEN
    TonMirror(IN := FALSE, PT := MirrorDelay);
    Feedback := Command;   // Hors simulation : miroir idéal (comportement précédent conservé)
    RETURN;
END_IF;

TonMirror(IN := (Command &lt;&gt; Feedback), PT := MirrorDelay);
IF TonMirror.Q THEN
    Feedback := Command;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">81504ce5-b647-53c2-8f8b-ce94a0f64dac_Impl_LineIds</Single>
          </Single>
