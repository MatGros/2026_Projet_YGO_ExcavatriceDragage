          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🩺 ST_InputModuleDiagHMI — Diagnostic carte des modules DI TOR réelles
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.3.md §3bis
///   🎨 Granularité MODULE (pas canal) : GetDeviceState() est un état de carte,
///      pas un diagnostic par voie. Un module en défaut ne dit pas *quelle*
///      TOR ment, seulement qu'aucune des TOR qu'il porte n'est fiable.
///   🔗 Producteur : PRG_02_Acquisition (3 appels GetDeviceState()).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_InputModuleDiagHMI :
STRUCT
	///TRUE = module Local_Digital_IO opérationnel (8 TOR Winch/Machine)
	LocalDigitalIoOk: BOOL;
	///TRUE = module VH_0800END opérationnel (7 TOR freins/thermiques/AU)
	Vh0800EndOk: BOOL;
	///TRUE = module VH_0808ETP opérationnel (7 TOR positions M3/hydraulique/crible)
	Vh0808EtpOk: BOOL;
	///TRUE = au moins un des 3 modules DI hors service
	Fault: BOOL;
END_STRUCT
END_TYPE
</Single>
