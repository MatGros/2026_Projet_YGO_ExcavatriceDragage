            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ðŸª ST_fbWinch_DriveRequest â€” RequÃªte d'axe treuil (producteur PRG_04)
///   â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
///   ðŸŽ¯ RÃ´le : Demande de mouvement, palier et bornes de clamp d'un treuil
///   ðŸ“„ Doc mÃ©tier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   ðŸ“¤ Producteur : PRG_04_Treuils_Benne (une par treuil M1/M2)
///   ðŸ“¥ Consommateur : FB_Winch
///   ðŸ”’ Structs cibles + champs conservÃ©s pour garder le dÃ©codage %â†’palier
///      et le clamp DANS FB_Winch (comportement bit-identique). Les champs
///      SpeedStepReq / MinStepUp sont dÃ©clarÃ©s mais non consommÃ©s (usage aval).
///   =======================================================================
TYPE ST_fbWinch_DriveRequest :
STRUCT
	///=== ORDRE DE MOUVEMENT ===
	///TRUE = mouvement demandÃ©
	StartStop: BOOL;
	///-1: Descente, 0: Stop, 1: Montee
	Direction: INT;
	///[cible] Palier demandÃ© dÃ©codÃ© en amont (usage aval)
	SpeedStepReq: INT;
	///[08a] Consigne vitesse % (0.0..100.0) â€” dÃ©codage conservÃ© dans FB_Winch
	SpeedTgt_Pct: REAL;
	///=== BORNES DE CLAMP (agrÃ©gÃ©es PRG_04) ===
	///[cible] Plancher palier montÃ©e (usage aval)
	MinStepUp: INT;
	///Plafond palier montÃ©e (1..5)
	MaxStepUp: INT := 5;
	///Plancher palier descente (0 = aucun) -- plongee Kobold
	MinStepDown: INT := 0;
	///Plafond palier descente (1..5)
	MaxStepDown: INT := 3;
	///=== LIMITES EFFECTIVES DU CYCLE ===
	///Position limite haute active (m)
	TopLimitM: REAL := 8.5;
	///Position limite basse active (m)
	BottomLimitM: REAL := -20;
	///=== DIAGNOSTIC (jamais lu par la logique FB_Winch) ===
	///[diag] Couplage synchro actif (garde de revue)
	SyncCoupled: BOOL;
	///=== CHAMPS CONSERVÃ‰S (clamp interne FB_Winch) ===
	///[08a] Vitesse limitÃ©e au palier 1 (approche homing)
	HomingApproachActive: BOOL;
END_STRUCT
END_TYPE
</Single>
