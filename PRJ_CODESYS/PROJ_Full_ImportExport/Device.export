            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestInvariantConfig — Configuration d'un invariant multi-étapes
///═══════════════════════════════════════════════════════════════
TYPE ST_TestInvariantConfig :
STRUCT
	///Configuration du check (Kind/sonde/valeur attendue)
	Check: ST_TestCheckConfig;
	///Étape qui arme cet invariant
	ArmAtStepId: INT;
	///Étape qui désarme cet invariant (0 = jusqu'à la fin de la suite)
	DisarmAtStepId: INT;
END_STRUCT
END_TYPE
</Single>
