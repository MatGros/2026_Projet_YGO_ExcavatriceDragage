          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🕵️‍♂️ GVL_Troubleshooting — GVL Globale de Recherche de Pannes (Orientée Fonctions &amp; Contexte)
///   ───────────────────────────────────────────────────────────────
///   ⚙️ Emplacement : CODE/J_SUPERVISION/GVL_Troubleshooting.st
///   🎨 Structurée par CONTEXTE GLOBAL MACHINE + FONCTIONS MÉTIER (Utilisation Opérateur).
///   💬 Permet de localiser en 3 secondes l'environnement et le blocage d'une action.
///   ═══════════════════════════════════════════════════════════════
{attribute 'qualified_only' := ''}
VAR_GLOBAL
	///🌐 0. Contexte Global Machine (Mode, Simu, Commande, Bypass)
	ContexteMachineGlobal: ST_ChainContextGlobal;
	///🛗 1. Levage Synchronisé M1+M2 (Mode Couplé Nominal)
	LevageSynchroniseM1M2: ST_ChainWinchSync;
	///🛗 2. Levage Unitaire M1 (Treuil Retenue)
	LevageUnitaireM1: ST_ChainWinch;
	///🛗 3. Levage Unitaire M2 (Treuil Benne)
	LevageUnitaireM2: ST_ChainWinch;
	///🪣 4. Ouverture / Fermeture Benne
	BenneOuvertureFermeture: ST_ChainBucket;
	///↔️ 5. Translation Pont M3 (Variateur AC600)
	TranslationPontM3: ST_ChainTranslation;
	///🌊 5bis. Assistance Plongée/Extraction/Vidage Trémie
	AssistanceDragage: ST_ChainDredgingAssist;
	///🔄 6. Séquenceur de Cycle Semi-Automatique (X0 à X13)
	CycleSemiAuto: ST_ChainCycleSemiAuto;
	///🎯 Diagnostic chronologique Homing M1 (Treuil Retenue)
	HomingM1: ST_HomingChecklist;
	///🎯 Diagnostic chronologique Homing M2 (Treuil Benne)
	HomingM2: ST_HomingChecklist;
	///🛡️ Diagnostic chronologique Chaîne de Sécurité &amp; Réarmement AU
	Safety: ST_SafetyChecklist;
	///🕹️ Diagnostic chronologique Bus CANopen &amp; Homme-Mort Joystick
	Joystick: ST_JoystickChecklist;
	///⚙️ Diagnostic chronologique Mouvement M1 (Treuil Retenue)
	MotionM1: ST_MotionChecklist;
	///⚙️ Diagnostic chronologique Mouvement M2 (Treuil Benne)
	MotionM2: ST_MotionChecklist;
	///⚙️ Diagnostic chronologique Mouvement M3 (Translation)
	MotionM3: ST_MotionChecklist;
	///📥 Image complète des entrées réelles / qualifiées / simulées
	Inputs: ST_HardwareImage;
END_VAR</Single>
