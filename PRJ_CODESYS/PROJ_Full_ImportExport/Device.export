            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ST_BucketCfg — Configuration de la benne (M2)
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BucketCfg :
STRUCT
	///Offsets Open/Close/Coherence
	Config: ST_fbBucket_Config;
	///⏱️ Temps max pour l'ouverture/fermeture
	CfgTimeoutDuration: TIME := TIME#30s0ms;
	///🚦 flag restauration boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
