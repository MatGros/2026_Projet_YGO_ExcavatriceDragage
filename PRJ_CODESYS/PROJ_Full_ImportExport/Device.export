        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📤 FB_Output — Sortie relais + feedback (brique réduite)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie-06_IO_Conditioning_v1.6.md §2
///   🧭 Interface RÉDUITE (Partie3 §1bis) — relais de commande BAS NIVEAU :
///      transmet fidèlement `Command` (déjà résolu/rampé par le FB métier
///      appelant), ne décide JAMAIS lui-même d'un arrêt de mouvement.
///   🔁 Rôle : inversion NO/NC, option blink 1Hz, double vérification
///      commande/retour (contacteur collé/absent), diagnostic voie/carte.
///   🔴 INTÉGRATION dans Winch/Translation/etc. : PAS encore décidée (choix
///      d'architecture en attente — composition interne, remplacerait la
///      logique actuelle TonFwdFeedback/ST_ContactorCheck manuelle dans
///      FB_Winch/FB_Translation — vs FB_IO générique séparé). Ce fichier
///      ne fait QUE créer la brique elle-même.
///   ═══════════════════════════════════════════════════════════════
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Output) ===
FUNCTION_BLOCK FB_Output
VAR_INPUT
	///Ordre logique, déjà résolu/rampé par le FB métier appelant
	Command: BOOL;
	///TRUE = NC
	InvertLogic: BOOL;
	///Retour d'état actionneur (optionnel)
	FeedbackRaw: BOOL;
	///Activer le contrôle de rétroaction
	UseFeedback: BOOL;
	///Option : clignotement 1 Hz (diagnostic/visu)
	Blink1Hz: BOOL;
	///Délai max cohérence cmd/retour
	FeedbackTimeout: TIME := TIME#500ms;
	///Diag voie/carte sortie OK — TRUE par défaut si pas de diag dispo
	ChannelOk: BOOL := TRUE;
END_VAR
VAR_OUTPUT
	///Vers la carte de sortie
	State: BOOL;
	///Retour cohérent avec la commande
	FeedbackOk: BOOL;
	Error: BOOL;
	///bit0: "Feedback sortie incohérent" - feedback incohérent ; bit1: "Défaut matériel sortie (Carte HS)" - voie/carte HS
	ErrorId: WORD;
END_VAR
VAR
	BlinkTimer: TON;
	BlinkState: BOOL;
	FeedbackTon: TON;
END_VAR
</Single>
