        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧠 FB_Hmi_BannerFormatter — Formateur du bandeau d'information IHM
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-07_Interface_IHM_v2.1.md §4, §4bis
///   🎯 Responsabilité : assemble les 4 textes du bandeau + le carrousel
///      d'alarmes, expose la cause observable du blocage courant, sans
///      piloter la machine.
///   🛡️ Sécurité : priorité AU/puissance, SafeStop, puis interlocks métier.
///      L'anti-clignotement est délégué à FB_AntiFlickerText (AF-07 §4.3).
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Hmi_BannerFormatter
VAR_INPUT
	///--&gt; [CMD] Active le formateur
	Enable: BOOL := TRUE;
	///--&gt; [TST] Mode simulation actif
	SimulationModeActive: BOOL;
	///--&gt; [CMD] Mode courant
	CurrentMode: E_Mode;
	///--&gt; [HW] Treuils M1/M2 couplés
	BothAxesCoupled: BOOL;
	///--&gt; [CMD] 1 = M1, 2 = M2
	WinchSelected: INT;
	///🔄 Cycle &amp; sous-cycles
	///--&gt; [HW] Étape cycle
	CycleStep: E_CycleStep;
	///--&gt; [HW] Libellé détaillé de l'étape cycle (FB_Cycle.CycleStateStr)
	CycleStateStr: STRING(80);
	///--&gt; [DIAG] Code défaut cycle (FB_Cycle.ErrorId) — notifié à STABILIZING
	CycleErrorId: WORD;
	///--&gt; [DIAG] Dernière étape avant le défaut (FB_Cycle.CycleStepAtError)
	CycleStepAtError: E_CycleStep;
	///--&gt; [HW] État plongée
	DiveState: E_DiveSearchState;
	///--&gt; [HW] État extraction
	ExtractionState: E_ExtractionSequenceState;
	///--&gt; [HW] Référencement en cours
	HomingActive: BOOL;
	///--&gt; [HW] Étape homing M1
	HomingStepM1: INT;
	///--&gt; [HW] Étape homing M2
	HomingStepM2: INT;
	///🛡️ Dérogations &amp; particularités
	///--&gt; [TST] Bypass global
	BypassGlobalActive: BOOL;
	///--&gt; [TST] Bypass treuil M1
	BypassWinchM1Active: BOOL;
	///--&gt; [TST] Bypass treuil M2
	BypassWinchM2Active: BOOL;
	///--&gt; [TST] Bypass translation
	BypassTranslation: BOOL;
	///--&gt; [TST] Bypass synchro
	BypassSyncActive: BOOL;
	///--&gt; [TST] Synchro bridée
	SyncDegradedActive: BOOL;
	///--&gt; [SAFE] Limite légale atteinte
	LegalLimitReached: BOOL;
	///🎮 Sécurité, causes et intention de direction
	///--&gt; [SAFE] Chaîne AU fermée
	EmergencyChainClosed: BOOL;
	///--&gt; [SAFE] Contacteur puissance
	PowerContactorEngaged: BOOL;
	///--&gt; [SAFE] Coupure puissance active
	PowerCutOffActiveAny: BOOL;
	///--&gt; [SAFE] Agrégat M1/M2 par OR — tout SafeStop affiché (bandeau conservateur)
	SafeStopActive: BOOL;
	///--&gt; [SAFE] Agrégat M1/M2 par AND
	DescendPermit: BOOL;
	///--&gt; [SAFE] Agrégat M1/M2 par AND
	AscentPermit: BOOL;
	///--&gt; [HW] Benne ouverte
	BucketIsOpen: BOOL;
	///--&gt; [HW] Benne fermee (montee non bridée)
	BucketIsClosed: BOOL;
	///--&gt; [HW] Plongée active
	DiveActive: BOOL;
	///--&gt; [SAFE] Agrégat M1/M2 par OR — toute limite haute affichée
	TopLimitReached: BOOL;
	///--&gt; [CMD] Direction demandée couplée
	CoupledUserRequestDirection: INT;
	///--&gt; [CMD] Direction logique M1
	M1LogicRequestDirection: INT;
	///--&gt; [CMD] Direction logique M2
	M2LogicRequestDirection: INT;
	///--&gt; [CMD] Direction cycle
	CycleRequestDirection: INT;
	///--&gt; [SAFE] Homme-mort armé
	DeadmanArmed: BOOL;
	///--&gt; [HW] Joystick au neutre
	JoystickAtNeutral: BOOL;
	///--&gt; [HW] Cycle auto actif
	CycleAutoBusy: BOOL;
	///🚨 Bandeau d'alarme défilant (§5) — diagnostics safety et ErrorId machine entière
	///--&gt; [SAFE] Diagnostic sécurité treuil M1
	WinchM1Safety: ST_SafetyWinch;
	///--&gt; [SAFE] Diagnostic sécurité treuil M2
	WinchM2Safety: ST_SafetyWinch;
	///--&gt; [SAFE] Diagnostic sécurité translation M3
	TranslationSafety: ST_SafetyTranslation;
	///--&gt; [DIAG] Code défaut benne (FB_Bucket.ErrorId)
	BucketErrorId: WORD;
	///--&gt; [DIAG] Code défaut synchro M1/M2 (FB_WinchSync.ErrorId)
	SyncErrorId: WORD;
	///--&gt; [DIAG] Code défaut plongée (FB_DiveSearch.ErrorId)
	DiveErrorId: WORD;
	///--&gt; [DIAG] Code défaut extraction (FB_ExtractionSequence.ErrorId)
	ExtractionErrorId: WORD;
	///--&gt; [DIAG] Code défaut chaîne AU (FB_Safety_EmergencyManagement.Diag.ErrorId)
	EmergencyErrorId: WORD;
	///--&gt; [DIAG] Defaut redondance contacteurs AU (lisee -&gt; message explicite)
	RedundancyTestFailed: BOOL;
	///--&gt; [DIAG] Echec rearmement contacteur AU (lisee -&gt; message explicite)
	EmergencyArmingFailed: BOOL;
	///--&gt; [CFG] Durée d'affichage par message du carrousel
	AlarmHoldTime: TIME := TIME#1s0ms;
END_VAR
VAR_OUTPUT
	///&lt;-- [STAT] Bandeau IHM assemblé
	Banner: ST_HmiBanner;
END_VAR
VAR
	///. [LOC] Préfixe RÉEL/SIMU
	PrefixContext: STRING(20);
	///. [LOC] Libellé mode
	ModeStr: STRING(30);
	///. [LOC] Libellé couplage
	CouplingStr: STRING(30);
	///. [LOC] Direction courante
	CurrentDirection: INT;
	///. [LOC] Interlock métier : mouvement demandé mais permit absent
	DirectionBlocked: BOOL;
	///. [LOC] Au moins un bypass actif
	AnyBypassActive: BOOL;
	///. [LOC] Défaut/interlock critique : affiché immédiatement (sans maintien)
	CriticalActionActive: BOOL;
	///. [LOC] Texte condition spéciale
	SpecialConditionCandidate: STRING(120);
	///. [LOC] Texte action opérateur
	OperatorActionCandidate: STRING(120);
	///. [LOC] Libellé de l'étape d'origine du défaut
	StepAtErrorStr: STRING(40);
	///* [INST] §3 Condition spéciale (warning → maintenu)
	AntiFlickSpecial: FB_AntiFlickerText;
	///* [INST] §4 Action opérateur (critique → direct, warning → maintenu)
	AntiFlickOperator: FB_AntiFlickerText;
	///. [LOC] §5 Tempo de maintien par message du carrousel
	TonAlarmBanner: TON;
	///. [LOC] §5 Messages actifs collectés ce scan
	AlarmArray: ARRAY[0..31] OF STRING(120);
	///. [LOC] §5 Nombre de messages actifs
	AlarmCount: INT;
	///. [LOC] §5 Index courant du carrousel (0-based)
	AlarmIndex: INT;
	///. [LOC] Anti-clignotement warnings/états (AF-07 §4.3)
	CST_BannerHoldTime: TIME := TIME#500ms;
	///. [LOC] Taille du carrousel d'alarmes (AF-07 §4bis)
	CST_NbMaxAlarmes: INT := 32;
END_VAR
</Single>
