        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ FB_Encoder_SpeedMeasure — Mesure de vitesse câble horodatée
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Calcul de la vitesse absolue et signée sur fenêtre glissante horodatée
///   🔒 Polarité : Valid=TRUE après 6 échantillons couvrant au moins 50ms
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md
///   =======================================================================
FUNCTION_BLOCK FB_Encoder_SpeedMeasure
VAR_INPUT
	///=== COMMANDES &amp; AUTORISATIONS ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Purge immediate de l'historique (front montant)
	Reset: BOOL;
	///=== MESURE SURES EN ENTREE ===
	///--&gt; [HW]  Position cable sure en metres (FB_Encoder_Safety)
	Position_M: REAL;
	///--&gt; [SAFE] Validite de la chaine codeur
	PositionValid: BOOL;
END_VAR
VAR_OUTPUT
	///=== VITESSE CALCULÉE &amp; VALIDITE ===
	///&lt;-- [DIAG] Vitesse absolue sur la fenetre glissante (m/s)
	Speed_Mps: REAL;
	///&lt;-- [DIAG] Vitesse signee (+ montee, - descente) (m/s)
	SignedSpeed_Mps: REAL;
	///&lt;-- [STAT] Vitesse valide (6 ech. sur 50 ms)
	Valid: BOOL;
END_VAR
VAR
	///=== HISTORIQUE &amp; ECHANTILLONS ===
	///. [LOC] Tableau des 6 positions enregistrees
	Positions_M: ARRAY[0..5] OF REAL;
	///. [LOC] Horodatage associe aux 6 positions
	Timestamps: ARRAY[0..5] OF TIME;
	///=== HORODATAGE &amp; TEMPORISATION ===
	///. [LOC] Horodatage courant du cycle
	CurrentTimestamp: TIME;
	///. [LOC] Horodatage de l'echantillon precedent
	LastTimestamp: TIME;
	///. [LOC] Temps ecoule depuis le dernier echantillon
	ElapsedSinceSample: TIME;
	///. [LOC] Temps total ecoule sur la fenetre de mesure
	WindowElapsed: TIME;
	///=== COMPTEURS &amp; ETATS INTERNES ===
	///. [LOC] Nombre d'echantillons collectes dans la fenetre
	CollectedSamples: INT;
	///. [LOC] Index de boucle de decalage
	Index: INT;
	///. [LOC] Indicateur d'initialisation du premier horodatage
	TimestampInitialized: BOOL;
	///=== PARAMETRES DE LA FENETRE GLISSANTE ===
	///Fenetre glissante de mesure
	WindowTime: TIME := TIME#50MS;
	///Periode minimale entre deux echantillons
	SamplePeriod: TIME := TIME#10MS;
	///Nombre total d'echantillons requis
	SampleCount: INT := 6;
END_VAR
</Single>
