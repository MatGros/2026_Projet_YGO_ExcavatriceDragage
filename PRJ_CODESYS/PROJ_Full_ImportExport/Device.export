        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   FB_SpeedStep — Décodeur palier vers contacteurs
///   Rôle : applique les bornes de palier puis lit la table contacteurs.
///   Le calcul de la consigne discrète est fait par le producteur amont.
///   =======================================================================
FUNCTION_BLOCK FB_SpeedStep
VAR_INPUT
	Enable: BOOL;
	///--&gt; [CMD] Palier demandé (0..5)
	SpeedStepReq: INT := 0;
	///--&gt; [CFG] Table contacteurs propre au treuil
	Table: ST_SpeedStepTable;
	///--&gt; [CFG] Plancher palier, rétro-compatible
	MinStepNumber: INT := 1;
	///--&gt; [CFG] Plafond palier atteignable
	MaxStepNumber: INT := 5;
END_VAR
VAR_OUTPUT
	///&lt;-- [STAT] Palier actif (0..5)
	StepNumber: INT;
	///&lt;-- [ACT] Ordre contacteur vitesse palier 1
	Contactor1: BOOL;
	///&lt;-- [ACT] Ordre contacteur vitesse palier 2
	Contactor2: BOOL;
	///&lt;-- [ACT] Ordre contacteur vitesse palier 3
	Contactor3: BOOL;
	///&lt;-- [ACT] Ordre contacteur vitesse palier 4
	Contactor4: BOOL;
	///&lt;-- [DIAG] Table de paliers invalide
	ConfigError: BOOL;
	///&lt;-- [DIAG] Bitfield erreur table
	ConfigErrorId: WORD;
END_VAR
VAR
	_ConfigValid: BOOL;
	_ConfigErrorIdInt: WORD;
	_MaxStepClamped: INT;
	_MinStepClamped: INT;
END_VAR
</Single>
