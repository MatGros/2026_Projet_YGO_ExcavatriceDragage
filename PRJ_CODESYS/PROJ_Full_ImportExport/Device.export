        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639223207765593456</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// ⏱️ Horodatage natif : le calcul utilise le temps réellement écoulé, jamais un cycle supposé.
CurrentTimestamp := TIME();

// Purge des six positions sur rupture de confiance : aucune source antérieure ne peut contaminer la mesure.
IF NOT Enable OR Reset OR NOT PositionValid THEN
    Speed_Mps := 0.0;
    SignedSpeed_Mps := 0.0;
    Valid := FALSE;
    CollectedSamples := 0;
    TimestampInitialized := FALSE;
    RETURN;
END_IF;

// 🕒 Première position de la nouvelle fenêtre.
IF NOT TimestampInitialized THEN
    Positions_M[0] := Position_M;
    Timestamps[0] := CurrentTimestamp;
    LastTimestamp := CurrentTimestamp;
    CollectedSamples := 1;
    TimestampInitialized := TRUE;
    Speed_Mps := 0.0;
    SignedSpeed_Mps := 0.0;
    Valid := FALSE;
    RETURN;
END_IF;

// 🛡️ Rebouclage de TIME détecté localement : purge sans réutiliser le delta aberrant (indépendant de T88).
IF CurrentTimestamp &lt; LastTimestamp THEN
    Positions_M[0] := Position_M;
    Timestamps[0] := CurrentTimestamp;
    LastTimestamp := CurrentTimestamp;
    CollectedSamples := 1;
    Speed_Mps := 0.0;
    SignedSpeed_Mps := 0.0;
    Valid := FALSE;
    RETURN;
END_IF;

ElapsedSinceSample := CurrentTimestamp - LastTimestamp;

// 🛡️ Delta nul : aucune division et aucun doublon d'échantillon.
IF ElapsedSinceSample &lt;= T#0MS THEN
    RETURN;
END_IF;

// 📥 Six positions espacées d'au moins 10 ms donnent cinq intervalles sur la fenêtre interne de 50 ms.
IF ElapsedSinceSample &gt;= SamplePeriod THEN
    LastTimestamp := CurrentTimestamp;

    IF CollectedSamples &lt; SampleCount THEN
        Positions_M[CollectedSamples] := Position_M;
        Timestamps[CollectedSamples] := CurrentTimestamp;
        CollectedSamples := CollectedSamples + 1;
    ELSE
        FOR Index := 0 TO 4 DO
            Positions_M[Index] := Positions_M[Index + 1];
            Timestamps[Index] := Timestamps[Index + 1];
        END_FOR;
        Positions_M[5] := Position_M;
        Timestamps[5] := CurrentTimestamp;
    END_IF;

    IF CollectedSamples = SampleCount THEN
        // 🛡️ Ordre temporel et durée minimale contrôlés avant toute conversion/division.
        IF Timestamps[5] &gt;= Timestamps[0] THEN
            WindowElapsed := Timestamps[5] - Timestamps[0];
            IF WindowElapsed &gt;= WindowTime THEN
                SignedSpeed_Mps := (Positions_M[5] - Positions_M[0])
                                   / (UDINT_TO_REAL(TIME_TO_UDINT(WindowElapsed)) / 1000.0);
                Speed_Mps := ABS(SignedSpeed_Mps);
                Valid := TRUE;
            ELSE
                Speed_Mps := 0.0;
                SignedSpeed_Mps := 0.0;
                Valid := FALSE;
            END_IF;
        ELSE
            Speed_Mps := 0.0;
            SignedSpeed_Mps := 0.0;
            Valid := FALSE;
            CollectedSamples := 0;
            TimestampInitialized := FALSE;
        END_IF;
    END_IF;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">7c9ddc31-d2fb-5a0c-b88b-8e212bb798cd_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📐 FB_Encoder_SpeedMeasure — Mesure de vitesse câble horodatée
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md §3.8
///   🛡️ Sécurité : mesure propriétaire de la chaîne codeur ; aucune réaction machine
///   🧩 Dépendances : position sûre fournie par FB_Encoder_Safety
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Encoder_SpeedMeasure
VAR_INPUT
	///Autorise l'acquisition
	Enable: BOOL;
	///Purge immédiate de l'historique
	Reset: BOOL;
	///Position câble sûre en mètres
	Position_M: REAL;
	///TRUE si la chaîne codeur garantit la position
	PositionValid: BOOL;
END_VAR
VAR_OUTPUT
	///Vitesse absolue sur la fenêtre horodatée
	Speed_Mps: REAL;
	///Vitesse signée : positive montée, négative descente
	SignedSpeed_Mps: REAL;
	///TRUE après 6 positions couvrant au moins 50 ms
	Valid: BOOL;
END_VAR
VAR
	WindowTime: TIME := TIME#50MS;
	SamplePeriod: TIME := TIME#10MS;
	SampleCount: INT := 6;
	Positions_M: ARRAY[0..5] OF REAL;
	Timestamps: ARRAY[0..5] OF TIME;
	CurrentTimestamp: TIME;
	LastTimestamp: TIME;
	ElapsedSinceSample: TIME;
	WindowElapsed: TIME;
	CollectedSamples: INT;
	Index: INT;
	TimestampInitialized: BOOL;
END_VAR
</Single>
