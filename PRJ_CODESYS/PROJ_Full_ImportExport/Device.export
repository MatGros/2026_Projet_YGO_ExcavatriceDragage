	///🔌 Contacteur/bobine, pas frein mécanique
	Idx406_BrakeCommandOpenConfirmed: BOOL;
	///⏱️ Watchdog 500ms écoulé
	Idx407_BrakeTimeoutElapsed: TIME;
END_STRUCT
END_TYPE
