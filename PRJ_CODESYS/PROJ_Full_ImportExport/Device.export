          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 ST_Safety_Emergency_State — État public de la chaîne d'arrêt d'urgence
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Bus d'état public de la chaîne d'arrêt d'urgence
///   🔌 Interface : Produit par FB_Safety_EmergencyManagement, consommé par Supervision/Troubleshooting
///   📄 Doc métier : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.0.md
///   =======================================================================
TYPE ST_Safety_Emergency_State :
STRUCT
	///Boucle AU fermee (EmergencyChainClosed = TRUE)
	ChainOk: BOOL;
	///Contacteur puissance confirme engage (PowerContactorEngaged = TRUE)
	ContactorOk: BOOL;
	///Etape sequence armement : 0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm
	Step: INT;
	///Rearmement possible maintenant : chain OK, step=0, pas de lockout, pas de defaut redondance
	Armable: BOOL;
	///Sequence armement OU lockout en cours (nouvelle demande ignoree)
	ArmingBusy: BOOL;
END_STRUCT
END_TYPE
</Single>
