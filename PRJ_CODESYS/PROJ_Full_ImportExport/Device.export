          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926780345489</Single>
      </Single>
      <Single Name="Object" Type="{ffbfa93a-b94d-45fc-a329-229860183b1d}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 GVL_PLC_Tests_Const — Constantes de dimensionnement
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Définit les tailles limites des tables de tests
///      pour l'orchestrateur et le moteur de tests.
///   ═══════════════════════════════════════════════════════════════
{attribute 'qualified_only' := ''}
VAR_GLOBAL CONSTANT
	///par suite
	MaxTestCases: INT := 8;
	///par suite, table PLATE ; WINCH-CORE-01 ajoute les étapes 65..111
	MaxSteps: INT := 128;
	///CheckTable par suite
	MaxChecks: INT := 64;
	MaxChecksPerStep: INT := 10;
	///actifs en parallèle
	MaxInvariants: INT := 4;
	MaxProbeBool: INT := 32;
	///INT/WORD/étapes séquenceur → conversion au câblage (WORD_TO_DINT)
	MaxProbeDint: INT := 16;
	///analogiques + TIME → REAL ms
	MaxProbeReal: INT := 16;
	///instances FB_TestStimulus par suite
	MaxAnalogStims: INT := 4;
	///plus gros poste mémoire par stim
	MaxSeqValues: INT := 8;
	///MainTask — base des mesures en cycles
	TaskCycleMs: INT := 10;
	///🛡️ garde-fou orchestrateur : 3 min maximum par suite
	MaxSuiteDurationMs: DINT := 180000;
	///journal circulaire des événements
	MaxTestEvents: INT := 32;
	///index de suite (Cmd.RunSuite)
	SuiteSafety: INT := 1;
	///index de suite Translation M3 (Cmd.RunSuite)
	SuiteTranslation: INT := 2;
	///index de suite Bucket (Cmd.RunSuite)
	SuiteBucket: INT := 3;
	///index de suite Codeurs/Homing nominal (Cmd.RunSuite)
	SuiteEncoder: INT := 4;
	///index de suite Modes/Homme-mort, post-suppression IHM_MANU (Cmd.RunSuite)
	SuiteModes: INT := 5;
	///index de suite Heartbeat IHM↔PLC (Cmd.RunSuite)
	SuiteHeartbeat: INT := 6;
	///index Supervision/Persistance config — 7 = Framework Validation
	SuiteSupervision: INT := 8;
END_VAR</Single>
