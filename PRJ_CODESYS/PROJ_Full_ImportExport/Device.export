      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// === IMPLEMENTATION ===
TrigA(CLK := EventA);
TrigB(CLK := EventB);

IF NOT Arm THEN
    OrderOk := FALSE;
    Failed  := FALSE;
    HasA    := FALSE;
    Timer(IN := FALSE);
    RETURN;
END_IF;

// Échec immédiat si B se produit avant A
IF TrigB.Q AND NOT HasA THEN
    Failed  := TRUE;
    OrderOk := FALSE;
END_IF;

// Mémorisation de la survenue de A
IF TrigA.Q AND NOT Failed AND NOT OrderOk THEN
    HasA := TRUE;
END_IF;

// Armement du timeout une fois que A s'est produit
Timer(IN := HasA AND NOT OrderOk AND NOT Failed, PT := TimeoutPT);

IF Timer.Q THEN
    Failed  := TRUE;
    OrderOk := FALSE;
END_IF;

// Validation du succès si B arrive après A et dans les temps
IF HasA AND TrigB.Q AND NOT Failed THEN
    OrderOk := TRUE;
END_IF;
</Single>
