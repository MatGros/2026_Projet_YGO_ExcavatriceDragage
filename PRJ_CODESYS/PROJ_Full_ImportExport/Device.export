            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Winch_Inputs :
STRUCT
	///[Valeur brutes pts] Codeur connecté
	Idx101_EncoderRawPos: DINT;
	///[mètres] Position calculée du câble
	Idx102_CablePos_M: REAL;
	///1 = OK (Tous contacteurs retombés à l'arrêt) | 0 = Contacteur collé 🔴
