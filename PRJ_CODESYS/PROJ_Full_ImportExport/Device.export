            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_CycleStep :
(
	///Vérifs cohérence états + sécurités, mise en position init
	INIT := 0,
	///Choix opérateur pos travail 1/2 + déplacement validé joystick
	WORK_POS_SELECT := 1,
	///Plongée benne déjà ouvert, M1+M2 synchro
	DESCENDING_OPEN := 2,
	///Attente info BOOL capteur "fond touché"
	BOTTOM_TOUCH_WAIT := 3,
	///Désynchro M2 petite vitesse (offset X) → fermeture benne
	SYNCHRO_ADJUST := 4,
	///Remontée lente de contrôle (vérification fermeture)
	CTRL_ASCENDING := 5,
	///Remontée pleine vitesse charge
	ASCENDING_LOADED := 6,
	///Égouttage temporisé (durée RETAIN)
	DRAINING_PAUSE := 7,
	///Déplacement translation M3 vers trémie
	TRANSLATION_MOVE := 8,
	///Descente de vidage + ouverture benne
	DESCENDING_OPEN_DUMP := 9,
	///Retour position travail (remontée synchro)
	RETURN_WORK_POS := 10,
	///Cycle terminé, prêt à reboucler
	READY := 11,
	///Arrêt sûr figé sur défaut (SafeStop)
	ERROR_HOLD := 12
);
END_TYPE
</Single>
