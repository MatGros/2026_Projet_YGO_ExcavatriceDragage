            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_PresetConfirmMode :
(
	///Confirmation par relecture de position
	READBACK_ONLY := 0,
	///Relecture et bit d'état matériel
	READBACK_AND_STATUSBIT := 1,
	///Bit d'état matériel uniquement
	STATUSBIT_ONLY := 2
);
END_TYPE
</Single>
