      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// 1. Get CAN bus logic status
BusState := CANopen_Manager.GetBusState(
    xDiagnosisInfoAvailable =&gt; BusDiagAvailable, 
    eError =&gt; BusError
);

// 2. Get Joystick node status
DeviceState := JOY1_JOYSTICK_MCB560_CO4201A.GetDeviceState(
    xDiagnosisInfoAvailable =&gt; DevDiagAvailable, 
    eError =&gt; DeviceError
);

// 3. Evaluate if device is physically connected/found
IF DeviceState &lt;&gt; DEVICE_STATE.NOT_FOUND THEN
    IsOnline := TRUE;
ELSE
    IsOnline := FALSE;
END_IF;

// 4. Evaluate if device is actively Operational (NMT Operational / Running)
IF DeviceState = DEVICE_STATE.RUNNING THEN
    IsOperational := TRUE;
ELSE
    IsOperational := FALSE; 
    // (If FALSE, it might be stopped, pre-operational, or disconnected)
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">77594c8b-d37e-4460-a0f5-f5314a888c10_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM diagCAN
VAR
    // Bus &amp; Device states
    BusState         : BUS_STATE;
    DeviceState      : DEVICE_STATE;
    
    // Internal function execution errors (0 = NO_ERROR)
    BusError         : INT;
    DeviceError      : INT;
    
    // Diagnosis status flags
    BusDiagAvailable : BOOL;
    DevDiagAvailable : BOOL;
    
    // Status flags
    IsOnline         : BOOL; // Device is physically present on the bus
    IsOperational    : BOOL; // Device is running and actively processing I/O (PDO)
END_VAR</Single>
