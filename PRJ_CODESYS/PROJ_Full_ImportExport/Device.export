            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📡 ST_DiagDevice — Structure diagnostic d'un esclave ou bus
///   ═══════════════════════════════════════════════════════════════
TYPE ST_DiagDevice :
STRUCT
	///Esclave visible sur le bus
	Online: BOOL;
	///Esclave en mode OP (opérationnel)
	Operational: BOOL;
	///Signal de défaut actif pour cet esclave
	Error: BOOL;
	///Code défaut détaillé
	ErrorId: WORD;
	///Phase courante du cycle de diagnostic
	State: E_DiagState;
	///Instantané de la phase lors de l'anomalie
	StateAtError: E_DiagState;
END_STRUCT
END_TYPE
</Single>
            <Single Name="LineInfoPersistence" Type="string">2175cb52-b3bb-4bf8-be5e-82cd87fedae6_Decl_LineIds</Single>
