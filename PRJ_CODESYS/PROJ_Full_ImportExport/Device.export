          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ST_BypassTranslation — Bypass maintenance dédiés à Translation M3
///   ───────────────────────────────────────────────────────────────
///   🔒 Doctrine : actionnable UNIQUEMENT en MAINT_N2, RETAIN, jamais masque
///      les autres défauts du même bloc (voir REGISTRE_ACTIONS_Bypass_v1.0 (archive)).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BypassTranslation :
STRUCT
	///📡 1. Communication &amp; Systèmes auxiliaires
	///📡 Bypass communication esclave CANopen Joystick / heartbeat IHM
	OperatorComm: BOOL;
	///📡 Bypass diagnostic esclave EtherCAT AC600 (variateur)
	DriveComm: BOOL;
	///🔌 Bypass feedbacks contacteur de frein
	ContactorFeedback: BOOL;
	///⚡ Bypass défaut rotation de phases (commun machine)
	PhaseRotation: BOOL;
	///🌡️ Bypass surchauffe thermique frein (commun machine)
	BrakeThermal: BOOL;
	///🚧 2. Limites physiques et Positionnement
	///🚧 Bypass fins de course physiques avant/arrière
	LimitSwitch: BOOL;
	///🧭 Bypass incohérence mot capteurs de position
	SensorIncoherent: BOOL;
	///: Bypass interlock hauteur mini M1/M2 requise pour translation
	MinHeight: BOOL;
	///⚙️ 3. Sécurité Mécanique (Méca A-B)
	///🔄 Bypass Méca A : mouvement non commandé à l'arrêt
	MecaA: BOOL;
	///🛑 Bypass Méca B : absence confirmation arrêt (frein/contacteurs)
	MecaB: BOOL;
	///🛡️ 4. Hiérarchie &amp; Restauration
	///🛡️ Bypass groupé : tous les bits qui provoquent un PowerCutOff
	Safety: BOOL;
	///⚙️ Bypass groupé : tous les bits qui provoquent un SafeStop
	Process: BOOL;
	///🌐 Bypass Global : ignore toutes les sécurités de cet axe
	Global: BOOL;
	///Flag restauration boot dédié (défaut FALSE non ambigu, contrairement à une valeur métier)
	///🚦 TRUE = bypass restauré depuis GVL_BypassRetain ce boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
