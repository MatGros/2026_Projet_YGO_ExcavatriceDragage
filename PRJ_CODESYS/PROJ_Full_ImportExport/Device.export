END_VAR
VAR_OUTPUT
	OrderOk: BOOL;
	Failed: BOOL;
END_VAR
VAR
	TrigA: R_TRIG;
	TrigB: R_TRIG;
	Timer: TON;
	HasA: BOOL;
END_VAR
</Single>
