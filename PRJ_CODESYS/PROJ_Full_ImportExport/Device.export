            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ↔️ ST_ChariotHMI — Données d'échange IHM pour le Chariot M3
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des états, commandes et diagnostics du chariot.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_ChariotHMI :
STRUCT
	///🤖 État de l'automate interne (FB_Chariot)
	FBState: E_State;
	///🟢 Chariot prêt à fonctionner
	Ready: BOOL;
	///⚙️ Mouvement en cours
	Busy: BOOL;
	///✅ Mouvement terminé avec succès
	Done: BOOL;
	///🔴 Chariot en défaut
	Error: BOOL;
	///❌ Code du défaut actif
	ErrorId: WORD;
	///🔓 Commande de desserrage du frein
	BrakeCmd: BOOL;
	///🔌 Retour physique de l'état du frein
	BrakeFeedback: BOOL;
	///🎯 Capteur de détection de la position cible atteint
	PositionSensorTarget: BOOL;
	///🔢 Numéro de la cible de position sélectionnée
	SelectedTargetNum: INT;
	///📡 Mot d'état du variateur (EtherCAT)
	DriveStatusWord: WORD;
	///📈 Fréquence de sortie réelle du variateur (Hz)
	DriveActualFreqHz: REAL;
	///🔌 Activation du bypass des retours contacteurs
	BypassContactorFeedback: BOOL;
	///🔓 Activation du bypass du retour frein
	BypassBrakeFeedback: BOOL;
	///🛡️ Bloc sécurité (Safety) en défaut
	SafetyError: BOOL;
	///❌ Code bitfield du défaut de sécurité
	SafetyErrorId: WORD;
END_STRUCT
END_TYPE
</Single>
