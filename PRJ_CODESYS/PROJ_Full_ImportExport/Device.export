        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔀 FB_WinchDirectionInterlock — Interlock de changement de sens
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Temporise le changement de sens d'un treuil (dead time)
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   🔌 Interface : Brique technique (contrat light, pas de defaut)
///   🔒 Sécurité : D18 — au front montant Enable, n'adopte pas le sens
///                 immediatement (temps mort) ; pas de redemarrage inrush
///   =======================================================================
FUNCTION_BLOCK FB_WinchDirectionInterlock
VAR_INPUT
	///--&gt; [CMD] Gate TON (TRUE = treuil arrete, contacteurs retombes)
	Enable: BOOL;
	///--&gt; [CMD] Front montant Enable du FB parent (D18)
	EnableRising: BOOL;
	///--&gt; [CMD] Acquittement defaut (front) : purge la memoire de direction
	Reset: BOOL;
	///--&gt; [CMD] Sens demande (-1: Descente, 0: Stop, 1: Montee)
	ReqDirection: INT;
	///--&gt; [CFG] Delai interlock changement de sens montee
	ChangeDelayUp: TIME;
	///--&gt; [CFG] Delai interlock changement de sens descente
	ChangeDelayDown: TIME;
END_VAR
VAR_OUTPUT
	///&lt;-- [DIAG] Sens interne memorise
	CommandedDirection: INT;
	///&lt;-- [DIAG] Changement de sens en attente
	DirectionChangePending: BOOL;
	///&lt;-- [DIAG] Ecoule delai changement de sens
	DelayElapsed: TIME;
END_VAR
VAR
	///. [LOC] Temporisation changement de sens
	DirectionChangeDelay: TON;
	///. [LOC] Delai effectif selon sens
	EffectiveDelay: TIME;
	///. [LOC] Temps mort D18 arme (front Enable)
	DeadTimeArmed: BOOL;
	///. [LOC] Dernier sens non nul memorise (interlock apres neutre)
	LastDirection: INT;
	///. [LOC] Front Reset : purge la memoire de direction
	ResetEdge: R_TRIG;
END_VAR
</Single>
