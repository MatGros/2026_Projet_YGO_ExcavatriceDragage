        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224114395023098</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// 🛑 1. GATE — aucune estimation lorsque le bloc est désactivé ou l'AU absent.
IF NOT Enable OR NOT PowerContactorEngaged THEN
    Ready := FALSE;
    Busy := FALSE;
    Done := FALSE;
    Error := FALSE;
    ErrorId := 16#0000;
    State := E_State.DISABLED;
    SpeedBand := 0;
    EstimatedLoadPct := 0.0;
    Configured := FALSE;
    Ascending := FALSE;
    HasPreviousBand := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
Busy := FALSE;
Done := FALSE;
State := E_State.READY;
ResetEdge(CLK := Reset);
Configured := LoadTable.IsConfigured;
// 📈 WINCH-CORE-01 : l'estimation de charge n'a de sens qu'en montée.
// La bande de vitesse reste calculée pour le diagnostic et le garde-fou de palier,
// mais EstimatedLoadPct est forcée à zéro à l'arrêt et en descente.
Ascending := (MeasuredSpeedSignedMps &gt; 0.0);

// 📏 2. CLASSEMENT DE LA VITESSE — hystérésis autour des 4 frontières.
IF (MeasuredSpeedMps &lt; 0.0) OR (SpeedConfig.MaxMeasuredSpeedMps &lt;= 0.0) THEN
    ErrorId := ErrorId OR 16#0001;
    SpeedBand := 0;
ELSIF NOT HasPreviousBand THEN
    IF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[1] THEN
        PreviousSpeedBand := 1;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[2] THEN
        PreviousSpeedBand := 2;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[3] THEN
        PreviousSpeedBand := 3;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[4] THEN
        PreviousSpeedBand := 4;
    ELSE
        PreviousSpeedBand := 5;
    END_IF;
    HasPreviousBand := TRUE;
    SpeedBand := PreviousSpeedBand;
ELSE
    // 🔒 Valider l'état mémorisé avant toute indexation dynamique.
    IF PreviousSpeedBand &lt; 1 OR PreviousSpeedBand &gt; 5 THEN
        PreviousSpeedBand := 1;
        ErrorId := ErrorId OR 16#0001;
    END_IF;

    // CODESYS ne garantit pas le court-circuit des expressions AND :
    // chaque borne est donc testée dans une branche séparée avant accès.
    IF PreviousSpeedBand &lt; 5 THEN
        IF MeasuredSpeedMps &gt; (SpeedConfig.SpeedBandMaxMps[PreviousSpeedBand]
                               + SpeedConfig.SpeedBandHysteresisMps) THEN
            PreviousSpeedBand := PreviousSpeedBand + 1;
        END_IF;
    END_IF;
    IF PreviousSpeedBand &gt; 1 THEN
        IF MeasuredSpeedMps &lt; (SpeedConfig.SpeedBandMaxMps[PreviousSpeedBand - 1]
                               - SpeedConfig.SpeedBandHysteresisMps) THEN
            PreviousSpeedBand := PreviousSpeedBand - 1;
        END_IF;
    END_IF;
    SpeedBand := PreviousSpeedBand;
END_IF;

// 📊 3. LECTURE TABLE — bornes séparées avant l'accès au tableau 5x5.
EstimatedLoadPct := 0.0;
IF Configured THEN
    IF Ascending THEN
        IF ActiveSpeedStep &gt;= 1 THEN
            IF ActiveSpeedStep &lt;= 5 THEN
                IF SpeedBand &gt;= 1 THEN
                    IF SpeedBand &lt;= 5 THEN
                        SelectedLoadPct := LoadTable.LoadPctByStepAndSpeedBand[ActiveSpeedStep][SpeedBand];
                        IF (SelectedLoadPct &lt; 0.0) OR (SelectedLoadPct &gt; 100.0) THEN
                            ErrorId := ErrorId OR 16#0001;
                        ELSE
                            EstimatedLoadPct := SelectedLoadPct;
                        END_IF;
                    END_IF;
                END_IF;
            END_IF;
        END_IF;
    END_IF;
END_IF;

// 📤 4. SORTIES D'ÉTAT ET ACQUITTEMENT.
IF ResetEdge.Q AND (ErrorId &lt;&gt; 16#0000) AND (MeasuredSpeedMps &gt;= 0.0) THEN
    ErrorId := 16#0000;
END_IF;
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">a7b3ae5f-a7d8-45e1-a565-5fa0609f362b_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════════════════════
///   📊 FB_WinchLoadEstimator — Estimation empirique de charge treuil
///   ═══════════════════════════════════════════════════════════════════════════════
///   🧩 Brique de diagnostic/information, sans commande moteur et sans SafeStop.
///   🎯 Croise le palier commandé et la bande de vitesse mesurée pour lire une
///      estimation dans ST_WinchLoadEstimateTable.
///   ⚠️ La table doit être explicitement marquée IsConfigured : sinon la sortie
///      reste à 0 % et Configured reste FALSE.
///   ═══════════════════════════════════════════════════════════════════════════════
///   📄 Docs : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
FUNCTION_BLOCK FB_WinchLoadEstimator
VAR_INPUT
	Enable: BOOL;
	Reset: BOOL;
	PowerContactorEngaged: BOOL;
	Mode: E_Mode;
	///Palier commandé 0..5
	ActiveSpeedStep: INT;
	///Vitesse câble absolue
	MeasuredSpeedMps: REAL;
	///Vitesse signée : positive = montée, négative = descente
	MeasuredSpeedSignedMps: REAL;
	///Plages vitesse mesurée
	SpeedConfig: ST_WinchSpeedConfig;
	///Table empirique 5x5
	LoadTable: ST_WinchLoadEstimateTable;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0 : entrée/table invalide
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///Bande vitesse courante 0..5
	SpeedBand: INT;
	///Estimation informative 0..100 %
	EstimatedLoadPct: REAL;
	///TRUE si table explicitement validée
	Configured: BOOL;
	///TRUE uniquement pendant une montée mesurée
	Ascending: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	PreviousSpeedBand: INT;
	HasPreviousBand: BOOL;
	SelectedLoadPct: REAL;
END_VAR
</Single>
