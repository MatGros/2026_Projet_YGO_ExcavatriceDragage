      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">3a5e41df-32fc-43b4-a892-206fa518ddb1</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">Logique API</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">C_DIAG_RESEAUX</Single>
      </Array>
