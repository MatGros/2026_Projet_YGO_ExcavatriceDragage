        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639230302275762665</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

{region "§1 Gate"}
// 🛑 1. GATE
IF NOT Enable THEN
    Ready := FALSE; Status.Busy := FALSE; Status.Done := FALSE;
    Status.State := E_State.DISABLED;
    CablePosMSafe := CablePosM;
    EncoderIncoherent := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
Status.State := E_State.READY;
{endregion}

{region "§2 Reset front"}
// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);
{endregion}

{region "§3 Bypass global"}
// 🌐 3. BYPASS GLOBAL
IF BypassGlobal THEN
    Status.ErrorId := 16#0000;
END_IF;
{endregion}

{region "§4 Surveillance bornage"}
// 🔍 4. SURVEILLANCE BORNAGE PHYSIQUE ABSOLU (bit0)
IF NOT BypassGlobal AND ((CablePosM &lt; PositionMinM) OR (CablePosM &gt; PositionMaxM)) THEN
    Status.ErrorId := Status.ErrorId OR 16#0001;
ELSE
    Status.ErrorId := Status.ErrorId AND 16#FFFE; (* Auto-clearing dès retour dans la plage *)
END_IF;
{endregion}

{region "§5 Relais incohérence redémarrage"}
// 🔍 5. RELAIS INCOHÉRENCE REDÉMARRAGE (bit1)
IF NOT BypassGlobal THEN
    IF HomingSuspect THEN
        Status.ErrorId := Status.ErrorId OR 16#0002;
    ELSE
        Status.ErrorId := Status.ErrorId AND 16#FFFD;
    END_IF;
END_IF;
{endregion}

{region "§6 Transmission mesure"}
// 📏 6. TRANSMISSION DE LA MESURE (Toujours réelle, non figée)
CablePosMSafe := CablePosM;
{endregion}

{region "§7 Sorties état et sécurité"}
// 📤 7. SORTIES ÉTAT &amp; SÉCURITÉ
Status.Error := (Status.ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Status.Error);
IF ErrorEdge.Q THEN
    Status.StateAtError := Status.State;
END_IF;

EncoderIncoherent := Status.Error;
Status.Busy := FALSE;
Status.Done := FALSE;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">69c17808-0a2e-5cda-8135-4bc53222fe41_Impl_LineIds</Single>
