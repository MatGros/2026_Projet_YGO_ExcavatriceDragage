            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 GVL_Chariot_M3_Stub — Variables STUB M3
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie11_Fonction_Chariot_v1.2.md §7
///   🔧 CORRECTIF (2026-07-03) : réintégration de M3_RelayFwd/Rev/SpeedGv,
///      M3_ContactorFeedbackFwd/Rev, M3_DriveFaultFeedback,
///      M3_PositionSensorTarget — retirés par erreur le 2026-07-03
///      (câblage I/O réel pas encore fait, PRG_MAIN.st en dépend toujours
///      → 31 erreurs de compilation). Seul `M3_BrakeCmd` est réel (I/O
///      Mapping Device.export, 2026-07-02) — il ne revient PAS ici.
///   🔧 CORRECTIF (2026-07-03quattuordecies) : `M3_BrakeFeedback` RETIRÉ — retour
///      frein M3 désormais réel (`M3_BrakeContactorFeedback_DI`, conditionné dans
///      `FB_InputsMachine`), plus de miroir logiciel nécessaire.
///   ═══════════════════════════════════════════════════════════════
VAR_GLOBAL
	///🖥️ Sélecteur test maintenance (0=Aucun, 1=Fosse1, 2=Fosse2, 3=Maintenance, 4=Trémie)
	StubChariotPositionSelect_IHM: INT := 0;
	///🔌 Sortie — contacteur sens avant M3 (STUB, DEGRADED_IO)
	M3_RelayFwd: BOOL;
	///🔌 Sortie — contacteur sens arrière M3 (STUB, DEGRADED_IO)
	M3_RelayRev: BOOL;
	///🔌 Sortie — présélection GV M3 (STUB, DEGRADED_IO)
	M3_RelaySpeedGv: BOOL;
	///🔧 Mirés activement par PRG_MAIN.st (bloc 🧪 SIMULATION) sur les commandes ci-dessus (contacteur "idéal")
	///🔌 Entrée — retour contacteur sens avant M3 (STUB, miroir de M3_RelayFwd)
	M3_ContactorFeedbackFwd: BOOL;
	///🔌 Entrée — retour contacteur sens arrière M3 (STUB, miroir de M3_RelayRev)
	M3_ContactorFeedbackRev: BOOL;
	///🎯 Capteur position cible (PAS de miroir automatique — forcer manuellement en instance CODESYS, Partie11 §9bis)
	///🔌 Entrée — capteur position cible M3 (STUB, arbitré par sélecteur ci-dessus)
	M3_PositionSensorTarget: BOOL;
	///🔴 Retour défaut variateur — PAS de miroir, reste FALSE tant que non câblé
	///🔌 Entrée — défaut variateur TOR M3 (STUB, toujours FALSE)
	M3_DriveFaultFeedback: BOOL;
END_VAR</Single>
