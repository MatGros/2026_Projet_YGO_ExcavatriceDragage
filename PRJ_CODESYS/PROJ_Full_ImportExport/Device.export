        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🖥️ PRG_07_Supervision — Échanges IHM, Diagnostics et Initialisation Boot
///   ───────────────────────────────────────────────────────────────
///   ⚙️ Exécuté par la tâche PLC en position 7.
///   ✅ Regroupe tout le mapping bidirectionnel GVL_IHM / GVL_PERSISTENT.
///   ✅ Expose FaultMachineReset_IHM pour tous les programmes du domaine sécurité/métier.
///   📄 Docs : DOC/AF/AF_Partie-07_Interface_IHM_v2.1.md
///   ═══════════════════════════════════════════════════════════════
PROGRAM PRG_07_Supervision
VAR_INPUT
END_VAR
VAR_OUTPUT
	///=== 🚨 ACQUITTEMENT GLOBAL MACHINE ===
	///&lt;-- [CMD] Impulsion d'acquittement defaut globale machine
	FaultMachineReset_IHM: BOOL;
END_VAR
VAR
	///=== ⏱️ SOUS-INSTANCES FB ===
	///* [INST] Clignoteur 1 Hz (heartbeat IHM)
	instBlink1Hz: BLINK;
	///* [INST] Front acquittement config restauree
	instAckConfigRestored: R_TRIG;
	///* [INST] Pont persistance config synchro
	instCfgPersistBridgeSync: FB_CfgPersistBridge_SyncCfg;
	///* [INST] Pont persistance config cycle
	instCfgPersistBridgeCycle: FB_CfgPersistBridge_CycleCfg;
	///* [INST] Pont persistance config assist dragage
	instCfgPersistBridgeDredgingAssist: FB_CfgPersistBridge_DredgingAssistCfg;
	///* [INST] Pont persistance config commune
	instCfgPersistBridgeCommun: FB_CfgPersistBridge_CommunCfg;
	///* [INST] Pont persistance config benne
	instCfgPersistBridgeBucket: FB_CfgPersistBridge_BucketCfg;
	///* [INST] Pont persistance config treuil M1
	instCfgPersistBridgeWinchM1: FB_CfgPersistBridge_WinchCfg;
	///* [INST] Pont persistance config treuil M2
	instCfgPersistBridgeWinchM2: FB_CfgPersistBridge_WinchCfg;
	///* [INST] Pont persistance config translation
	instCfgPersistBridgeTranslation: FB_CfgPersistBridge_TranslationCfg;
	///* [INST] Surveillance heartbeat IHM
	instDiagIhmHeartbeat: FB_Diag_IhmHeartbeat;
	///* [INST] Preflight acquisition avant demarrage
	instPreflight: FB_Acquisition_Preflight;
	///* [INST] Formatage bandeau IHM (alarmes/etats)
	instHmiBannerFormatter: FB_Hmi_BannerFormatter;
	///* [INST] Vue troubleshooting (diagnostic IHM)
	instTroubleshootingView: FB_TroubleshootingView;
	///=== 🚦 MÉMOIRE SYNC BYPASS BIDIRECTIONNEL (RETAIN ↔ IHM) ===
	///. [LOC] Memoire bypass Translation (sync bidirectionnel)
	PrevTranslationBypass: BOOL;
	///. [LOC] Memoire bypass M1 (sync bidirectionnel)
	PrevM1Bypass: BOOL;
	///. [LOC] Memoire bypass M2 (sync bidirectionnel)
	PrevM2Bypass: BOOL;
	///. [LOC] Memoire bypass synchro (sync bidirectionnel)
	PrevSyncBypass: BOOL;
	///. [LOC] Memoire bypass commun global (sync bidirectionnel)
	PrevCommunBypass: BOOL;
	///. [LOC] Memoire bypass limite legale (sync bidirectionnel)
	PrevLimitLegal: BOOL;
	///. [LOC] Memoire bypass fin de course haut (sync bidirectionnel)
	PrevTopLimitSwitch: BOOL;
	///. [LOC] Memoire bypass fin de course haut logiciel (sync bidirectionnel)
	PrevTopLimitSoftware: BOOL;
	///. [LOC] Memoire bypass limite cable (sync bidirectionnel)
	PrevCableLimitSwitch: BOOL;
	///. [LOC] Memoire bypass mou de cable (sync bidirectionnel)
	PrevSlackCable: BOOL;
	///=== 🧪 DÉTECTEURS FRONT SIMULATION BYPASS (pilotage bypass IHM) ===
	///. [LOC] Front montant SimulationBypassActive
	SimBypassRise: R_TRIG;
	///. [LOC] Front descendant SimulationBypassActive
	SimBypassFall: F_TRIG;
END_VAR
</Single>
