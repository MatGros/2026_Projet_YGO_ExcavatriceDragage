          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🕹️ ST_JoystickChecklist — Diagnostic chronologique communication &amp; prise en main Joystick
///   ───────────────────────────────────────────────────────────────
///   🎨 Permet de vérifier la chaîne Joystick (CANopen, Homme-mort, Neutre, Calibration).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_JoystickChecklist :
STRUCT
	///1. Bus &amp; Matériel
	///TRUE = Bus CANopen en état ACTIVE
	Step1_CanBusActive: BOOL;
	///TRUE = Esclave JOY1 en état RUNNING
	Step2_JoystickOperational: BOOL;
	///1bis. Entrées physiques directes HwIn
	///Bouton brut homme-mort issu de HwIn.Operator
	HwIn_JoyBtnRaw_DI: BOOL;
	///TRUE = Axe X au neutre (PRG_02_Acquisition.JoystickXNeutral)
	NeutralXAct: BOOL;
	///TRUE = Axe Y au neutre (PRG_02_Acquisition.JoystickYNeutral)
	NeutralYAct: BOOL;
	///2. Prise en main &amp; Sécurité
	///TRUE = Bouton Homme-Mort appuyé
	Step3_DeadmanPressed: BOOL;
	///TRUE = Repassé par le neutre (autorisation mouvement)
	Step4_NeutralAcquired: BOOL;
	///TRUE = Homme-Mort armé avec passage au neutre validé
	DeadmanArmed: BOOL;
	///3. Éligibilité globale
	///TRUE = Joystick prêt pour piloter un axe
	AllConditionsMet: BOOL;
	///TRUE = Joystick maître sélectionné IHM
	JoystickSelected: BOOL;
	///Sélection Treuil (0=Couplé M1+M2, 1=M1 seul, 2=M2 seul)
	SelJoystickWinch: INT;
	///4. Mesures brutes &amp; Filtrées
	///Valeur brute axe X (0..10000)
	RawX: INT;
	///Valeur brute axe Y (0..10000)
	RawY: INT;
	///Déflexion signée X (%)
	DeflectionX_Pct: REAL;
	///Déflexion signée Y (%)
	DeflectionY_Pct: REAL;
	///Direction filtrée X (-1 / 0 / +1)
	DirectionX: INT;
	///Direction filtrée Y (-1 / 0 / +1)
	DirectionY: INT;
END_STRUCT
END_TYPE
</Single>
