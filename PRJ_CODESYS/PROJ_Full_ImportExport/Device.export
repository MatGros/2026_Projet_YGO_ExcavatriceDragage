          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Winch_Control :
STRUCT
	///1 = Prêt / Mouvement Autorisé | 0 = Bloqué
	Idx401_MotionAllowed: BOOL;
	///Palier Vitesse Calculé (0, 1, 2, 3, 4)
	Idx402_SpeedStepCalculated: INT;
	///[%] Consigne Vitesse après Rampe
	Idx403_SpeedRamp_Pct: REAL;
	///1 = Ordre Ouverture Frein | 0 = Ordre Serrage
	Idx404_BrakeReleaseAuthorized: BOOL;
	///🛡️ État frontière _LD
	Idx405_FinalInterlockState: E_WinchFinalInterlockState;
	///🛡️ Cause mémorisée
	Idx406_FinalInterlockReason: E_WinchFinalInterlockReason;
	///🪜 Palier réellement autorisé
	Idx407_FinalAuthorizedStep: INT;
	///🔌 Contacteur/bobine, pas frein mécanique
	Idx408_BrakeCommandOpenConfirmed: BOOL;
	///⏱️ Watchdog 500ms écoulé
	Idx409_BrakeTimeoutElapsed: TIME;
	///⏱️ Verrou 900ms écoulé
	Idx410_RestartDelayElapsed: TIME;
	///⏱️ Délai palier 1s250 écoulé
	Idx411_StepDelayElapsed: TIME;
	///🆕 2026-08-07 : Palier plafonné à 1, approche limite haute
	Idx412_InTopSlowdownZone: BOOL;
	///🆕 2026-08-07 : Palier plafonné à 1, approche limite basse (câble ou légale)
	Idx413_InBottomSlowdownZone: BOOL;
	///🆕 2026-08-07 : Limite basse active (m) — câble physique OU légale, la plus restrictive
	Idx414_BottomLimitActiveM: REAL;
END_STRUCT
END_TYPE
</Single>
