          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_DredgingAssistState — États publics assistance prélèvement
///   ═══════════════════════════════════════════════════════════════
TYPE ST_DredgingAssistState :
STRUCT
	DiveReady: BOOL;
	DiveBusy: BOOL;
	DiveDone: BOOL;
	DiveError: BOOL;
	DiveErrorId: WORD;
	DiveState: E_DiveSearchState;
	BottomTouchConfirmed: BOOL;
	ExtractionReady: BOOL;
	ExtractionBusy: BOOL;
	ExtractionDone: BOOL;
	ExtractionError: BOOL;
	ExtractionErrorId: WORD;
	ExtractionState: E_ExtractionSequenceState;
	///Une seule consigne conduite, arbitré en PRG_09
	OperatorActionId: WORD;
	///Texte de secours ; IHM peut mapper l'identifiant
	OperatorAction: STRING(120);
	///🆕 2026-08-07 : mode vidage à la trémie (pas de FB dédié, logique combinatoire PRG_04)
	///TglEnableDumpAtTremie (bit IHM brut)
	DumpAtTremieArmed: BOOL;
	///Armé ET Mode MAINT_N1/N2 (mode réellement actif)
	DumpAtTremieAssistActive: BOOL;
	///M3_AtTremieStable
	DumpAtTremieAtTremie: BOOL;
	///CmdOpen_IHM déclenché par ce mode
	DumpAtTremieBucketOpenArmed: BOOL;
	///ForbidDescent M1/M2 forcé par ce mode (hors P1/Maintenance)
	DumpAtTremieDescentLocked: BOOL;
	///🆕 2026-08-07 (9) : diagnostic bypass séquence DiveSearch
	///TglBypassDiveSearchSequence armé (descente couplée en cours)
	BypassDiveActive: BOOL;
	///Fond confirmé par le bypass (front montant Kobold en descente)
	BypassKoboldBottomTouched: BOOL;
END_STRUCT
END_TYPE
</Single>
