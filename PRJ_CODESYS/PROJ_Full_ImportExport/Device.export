            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎮 ST_OperatorAction — Consigne unique de conduite opérateur
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-07_Interface_IHM_v2.0.md
///   🎯 Les alarmes restent dans Error/ErrorId : cette struct répond seulement
///      à « quelle action attend-on maintenant de l'opérateur ? ».
///   ═══════════════════════════════════════════════════════════════
TYPE ST_OperatorAction :
STRUCT
	///Identifiant stable : table de textes IHM possible
	ActionId: WORD;
	///Texte de secours pour IHM/diagnostic acceptant les STRING
	Text: STRING(120);
END_STRUCT
END_TYPE
