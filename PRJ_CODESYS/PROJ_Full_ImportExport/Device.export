      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎯 ST_HomingChecklist — Diagnostic chronologique de référencement (Dépannage)
///   ───────────────────────────────────────────────────────────────
///   🎨 Permet de localiser immédiatement l'étape qui bloque le Homing (M1/M2).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_HomingChecklist :
STRUCT
	///1. Pré-requis de mode
	///TRUE = Mode MAINT_N1 ou MAINT_N2 actif ➔ Commutateur Mode IHM : GVL_IHM.Modes
	Step1_ModeAuthorized: BOOL;
	///TRUE = Treuil sélectionné en MAINT_N2 ➔ Bouton IHM : GVL_IHM.Modes.Cmd.TglJoystickMaster / Selection Treuil
	Step2_WinchSelected: BOOL;
	///2. Santé Matériel &amp; Bus
	///TRUE = Codeur EtherCAT OK &amp; E/S OK ➔ Si simu : GVL_Simulation.SimWinchActive=1 / SimSafetyActive=1
	Step3_EncoderAvailable: BOOL;
	///2bis. Entrées physiques directes HwIn (vérité terrain)
	///Retours contacteurs retombés issus de HwIn.Winch
	HwIn_ContactorsReleased_DI: BOOL;
	///Retour fin de course frein (1 = ouvert) issu de HwIn.Winch
	HwIn_BrakeIsOpen_DI: BOOL;
	///Capteur position haute commun libre (1 = libre) issu de HwIn.Winch
	HwIn_TopPositionFree_DI: BOOL;
	///3. État Physique Machine
	///TRUE = Tous les contacteurs retombés (attendre l'arrêt complet)
	Step4_ContactorsReleased: BOOL;
	///TRUE = Frein serré (attendre l'arrêt complet)
	Step5_BrakeApplied: BOOL;
	///📍 Fin de course haut physique (TRUE = au contact)
	TopPositionSensorActive: BOOL;
	///🪣 Benne Ouvert (TRUE = Ouvert) ➔ Pour forcer sans codeur : GVL_IHM.M2TreuilBenne.Bucket.Cmd.BtnConfirmOpenPos
	BucketIsOpen: BOOL;
	///4. Séquence &amp; Bilan
	///TRUE = Prêt pour le homing ! ➔ Déclencher : GVL_IHM.M1TreuilRetenue.Cmd.BtnHome (à 8m) ou BtnHomingAtZero (à 0m)
	AllConditionsMet: BOOL;
	///TRUE = Séquence de calage en cours
	HomingBusy: BOOL;
	///TRUE = Calage réussi
	HomingDone: BOOL;
	///TRUE = Treuil actuellement référencé
	HomingHomed: BOOL;
	///TRUE = Doute redémarrage ➔ Lever le doute via : GVL_IHM.M1TreuilRetenue.Cmd.BtnConfirmCoherence
	HomingSuspect: BOOL;
	///5. Code de rejet exact
	///Bitmask d'erreur FB_Encoder_Homing.ErrorId
	RejectErrorMask: WORD;
END_STRUCT
END_TYPE
</Single>
