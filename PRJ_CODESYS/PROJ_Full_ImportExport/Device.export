            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_TestCheckMode :
(
	///Vérité exigée au 1er cycle d'évaluation de l'étape (fail sinon)
	CHECK_INSTANT := 0,
	///Attendre que ça devienne vrai, tenu StablePT en continu (T#0s = immédiat), borné par TimeoutPT d'étape
	CHECK_WAIT_UNTIL := 1,
	///Doit rester vrai CHAQUE cycle de la fenêtre — fail immédiat à la 1re violation
	CHECK_INVARIANT := 2,
	///Ne doit JAMAIS devenir vrai — pass à l'expiration du TimeoutPT d'étape (= la fenêtre)
	CHECK_NEVER_DURING := 3
);
END_TYPE
</Single>
