      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_Mode :
(
	///Mode Désactivé / Veille de sécurité (sorties bloquées)
	DISABLE := 0,
	///Manuel Niveau 1 : Pilotage unitaire avec toutes sécurités actives
	MAINT_N1 := 1,
	///Manuel Niveau 2 : Pilotage dégradé (droits étendus + bypasses autorisés)
	MAINT_N2 := 2,
	///Mode Semi-Automatique (séquenceur automatique)
	SEMI_AUTO := 3
);
END_TYPE
</Single>
