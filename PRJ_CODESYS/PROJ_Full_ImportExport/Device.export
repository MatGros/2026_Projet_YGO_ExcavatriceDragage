          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">VAR_GLOBAL RETAIN PERSISTENT
	{attribute 'order_in_persistent_editor' := '0'}
	_CalibM1: ST_Encoder_Calib;
	{attribute 'order_in_persistent_editor' := '1'}
	_CalibM2: ST_Encoder_Calib;
	{attribute 'order_in_persistent_editor' := '2'}
	_WinchSpeedStepTable: ST_SpeedStepTable := (P1R1 := FALSE, P1R2 := FALSE, P1R3 := FALSE, P1R4 := FALSE, P2R1 := TRUE, P2R2 := FALSE, P2R3 := FALSE, P2R4 := FALSE, P3R1 := TRUE, P3R2 := TRUE, P3R3 := FALSE, P3R4 := FALSE, P4R1 := TRUE, P4R2 := TRUE, P4R3 := TRUE, P4R4 := FALSE, P5R1 := TRUE, P5R2 := TRUE, P5R3 := TRUE, P5R4 := TRUE, StepThreshold_Pct := [20, 40, 60, 80, 100]);
	{attribute 'order_in_persistent_editor' := '3'}
	_WinchSpeedConfig: ST_WinchSpeedConfig := (MaxMeasuredSpeedMps := 2, SpeedBandMaxMps := [0.4, 0.8, 1.2, 1.6, 2], SpeedBandHysteresisMps := 0.05);
	{attribute 'order_in_persistent_editor' := '4'}
	_WinchLoadEstimateTable: ST_WinchLoadEstimateTable;
	{attribute 'order_in_persistent_editor' := '5'}
	_WinchSymmetryCfgPersist: ST_Winch_SymmetryCfg;
	{attribute 'order_in_persistent_editor' := '6'}
	_WinchSymmetryDataPersist: ST_Winch_SymmetryData;
	{attribute 'order_in_persistent_editor' := '7'}
