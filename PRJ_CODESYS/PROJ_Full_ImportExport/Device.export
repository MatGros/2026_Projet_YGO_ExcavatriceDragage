            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926774839210</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// === IMPLEMENTATION ===
StartTrig(CLK := StartEvent);
StopTrig(CLK := StopEvent);

IF NOT Arm THEN
    Running := FALSE;
    Done := FALSE;
    InWindow := FALSE;
    ElapsedMs := 0;
    CycleCount := 0;
    RETURN;
END_IF;

IF StartTrig.Q AND NOT Running AND NOT Done THEN
    Running := TRUE;
    CycleCount := 0;
END_IF;

IF Running THEN
    // Incrémente le compteur de cycles
    CycleCount := CycleCount + 1;
    ElapsedMs := UDINT_TO_DINT(CycleCount * INT_TO_UDINT(GVL_PLC_Tests_Const.TaskCycleMs));
    
    IF StopTrig.Q THEN
        Running := FALSE;
        Done := TRUE;
        InWindow := (ElapsedMs &gt;= ExpectedMinMs AND ElapsedMs &lt;= ExpectedMaxMs);
    END_IF;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">c8f19b9a-1c60-4318-b0cd-60ecb4364ff1_Impl_LineIds</Single>
