          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_BucketState — État mémorisé et diagnostic du benne
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch/FB_Bucket_v1.0.md §4.B
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BucketState :
STRUCT
	///TRUE = Benne ouvert mémorisé
	IsOpen: BOOL;
	///TRUE = Benne fermé mémorisé
	IsClosed: BOOL;
	///⚠️ Dépassement ouverture : Delta &lt; OffsetOpen - Tolerance
	TooOpen: BOOL;
	///⚠️ Dépassement fermeture : Delta &gt; OffsetClose + Tolerance
	TooClosed: BOOL;
	///↔️ Position intermédiaire (entre Ouvert et Fermé)
	IsIntermediate: BOOL;
	///Dernière position M2 mémorisée ouvert
	LastPosM2Open: REAL;
	///Dernière position M2 mémorisée fermé
	LastPosM2Close: REAL;
	///État non sûr (divergence boot/réel)
	StateIncoherent: BOOL;
END_STRUCT
END_TYPE
</Single>
