          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧲 ST_EncoderHMI — Données d'échange IHM pour les codeurs absolus
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des informations et diagnostics des codeurs.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_EncoderHMI :
STRUCT
	///📊 Position brute lue sur le bus
	RawPos: UDINT;
	///⚠️ Code d'alarme brut du codeur
	Alarms: UINT;
	///🟧 Code d'avertissement brut du codeur
	Warnings: UINT;
	///📡 Esclave EtherCAT opérationnel
	SlaveOperational: BOOL;
	///🎯 Commande de preset active
	PresetTriggerCmd: WORD;
	///📐 Valeur de preset envoyée au codeur
	PresetValueOut: UDINT;
	///Codeur en défaut (liaison EtherCAT ou preset)
	Error: BOOL;
	///❌ Code défaut codeur
	ErrorId: WORD;
	///🎯 Homing — prise d'origine / référencement
	///🎯 Prise d'origine (Homing) validée
	Homed: BOOL;
	///⏳ Référencement en cours
	HomingBusy: BOOL;
	///✅ Pulse de référencement réussi
	HomingDone: BOOL;
	///Défaut de référencement
	HomingError: BOOL;
	///❌ Bitfield défaut homing
	HomingErrorId: WORD;
	///🤖 État FB_Encoder_Homing
	HomingState: E_State;
	///🧭 État lors du défaut
	HomingStateAtError: E_State;
	///⚠️ Référence à confirmer
	HomingSuspect: BOOL;
	///📐 Référence brute appliquée
	HomingRefRaw: UDINT;
END_STRUCT
END_TYPE
</Single>
