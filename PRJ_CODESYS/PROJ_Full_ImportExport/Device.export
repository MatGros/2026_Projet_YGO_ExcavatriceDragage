	///TRUE = frein SERRÉ (NOT BrakeFeedback — IHM garde le sens serré)
	Idx104_BrakeApplied: BOOL;
	///1 = Température OK (Sain) | 0 = Surchauffe Moteur M1 🔴
	Idx105_ThermalOk_DI: BOOL;
END_STRUCT
END_TYPE
