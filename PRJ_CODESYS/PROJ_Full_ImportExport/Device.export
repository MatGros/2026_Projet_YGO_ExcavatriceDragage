        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639237203752784341</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

{region "§1 Causes &amp; Socle Défaut (évalué en continu)"}
// 🔑 1. RESET FRONT
ResetEdge(CLK := Reset);

IF ResetEdge.Q OR BypassGlobal THEN
    PhaseRotationFault    := FALSE;
    BrakeThermalFault     := FALSE;
    MecaBFault            := FALSE;
    MecaAFault            := FALSE;
    SensorIncoherentFault := FALSE;
END_IF;

IF NOT FirstScanDone THEN
    FirstScanDone := TRUE;
    PhaseRotationFault    := FALSE;
    BrakeThermalFault     := FALSE;
    MecaBFault            := FALSE;
    MecaAFault            := FALSE;
    SensorIncoherentFault := FALSE;
END_IF;

IF NOT BypassGlobal THEN
    TonStartupWarmup(IN := Enable, PT := T#3s);

    // Cause 0 : Perte com opérateur (live)
    IF TonStartupWarmup.Q AND NOT (BypassProcess OR BypassOperatorComm) THEN
        instCauses[0].Active := (NOT JoystickOnline OR NOT JoystickOperational OR NOT HeartbeatIhmOk);
    ELSE
        instCauses[0].Active := FALSE;
    END_IF;
    instCauses[0].Latching := FALSE;
    instCauses[0].Texte    := 'Perte communication operateur translation';

    // Cause 1 : Perte EtherCAT drive (live)
    IF TonStartupWarmup.Q AND NOT (BypassProcess OR BypassDriveComm) THEN
        instCauses[1].Active := (NOT DriveOnline OR NOT DriveOperational);
    ELSE
        instCauses[1].Active := FALSE;
    END_IF;
    instCauses[1].Latching := FALSE;
    instCauses[1].Texte    := 'Perte communication EtherCAT variateur M3';

    // Cause 2 : Rotation de phase (latched)
    IF NOT (BypassProcess OR BypassPhaseRotation) AND NOT PhaseRotationOk THEN
        PhaseRotationFault := TRUE;
    END_IF;
    instCauses[2].Active   := PhaseRotationFault;
    instCauses[2].Latching := TRUE;
    instCauses[2].Texte    := 'Defaut rotation de phases';

    // Cause 3 : Thermique frein (latched)
    IF NOT (BypassSafety OR BypassBrakeThermal) AND BrakeThermalFeedback THEN
        BrakeThermalFault := TRUE;
    END_IF;
    instCauses[3].Active   := BrakeThermalFault;
    instCauses[3].Latching := TRUE;
    instCauses[3].Texte    := 'Surchauffe thermique frein translation';

    // Cause 4 : Méca B (latched)
    IF NOT (BypassSafety OR BypassMecaB) THEN
        IF NOT HeartbeatIhmOk THEN
            UncommandedActiveB := (ABS(DriveActualFreqHz) &gt; 0.5) OR DriveStatusWord.0 OR BrakeFeedback;
        ELSIF (Direction = 0) AND NOT BrakeCmd THEN
            UncommandedActiveB := DriveStatusWord.0 OR BrakeFeedback;
        ELSE
            UncommandedActiveB := FALSE;
        END_IF;
        TonMecaB(IN := UncommandedActiveB, PT := PostRampTimeout);
        IF TonMecaB.Q THEN MecaBFault := TRUE; END_IF;
    ELSE
        TonMecaB(IN := FALSE);
    END_IF;
    instCauses[4].Active   := MecaBFault;
    instCauses[4].Latching := TRUE;
    instCauses[4].Texte    := 'Absence confirmation arret translation (Meca B)';

    // Cause 5 : Méca A (latched)
    IF NOT (BypassSafety OR BypassMecaA) THEN
        IF (Direction = 0) AND NOT BrakeCmd THEN
            UncommandedActiveA := ABS(DriveActualFreqHz) &gt; 0.5;
        ELSE
            UncommandedActiveA := FALSE;
        END_IF;
        TonMecaA(IN := UncommandedActiveA, PT := T#1S);
        IF TonMecaA.Q THEN MecaAFault := TRUE; END_IF;
    ELSE
        TonMecaA(IN := FALSE);
    END_IF;
    instCauses[5].Active   := MecaAFault;
    instCauses[5].Latching := TRUE;
    instCauses[5].Texte    := 'Mouvement non commande translation (Meca A)';

    // Cause 6 : Limite extrême escalade (live)
    IF NOT (BypassSafety OR BypassLimitSwitch) THEN
        OverrunCondition := (LimitSwitchFwd AND (Direction = 1) AND (ABS(DriveActualFreqHz) &gt; 0.5 OR DriveStatusWord.0))
                         OR (LimitSwitchRev AND (Direction = -1) AND (ABS(DriveActualFreqHz) &gt; 0.5 OR DriveStatusWord.0));
        TonLimitSwitchOverrun(IN := OverrunCondition, PT := T#1S500MS);
        instCauses[6].Active := TonLimitSwitchOverrun.Q;
    ELSE
        TonLimitSwitchOverrun(IN := FALSE);
        instCauses[6].Active := FALSE;
    END_IF;
    instCauses[6].Latching := FALSE;
    instCauses[6].Texte    := 'Depassement limite extreme translation';

    // Cause 7 : Mot capteurs incohérent (latched)
    IF NOT (BypassSafety OR BypassSensorIncoherent) AND SensorWordIncoherent THEN
        SensorIncoherentFault := TRUE;
    END_IF;
    instCauses[7].Active   := SensorIncoherentFault;
    instCauses[7].Latching := TRUE;
    instCauses[7].Texte    := 'Incoherence combinaison capteurs translation';

ELSE
    TonMecaB(IN := FALSE);
    TonMecaA(IN := FALSE);
    TonLimitSwitchOverrun(IN := FALSE);
END_IF;

// Appel du socle de défaut
instFault(Enable := Enable, Reset := Reset, Causes := instCauses);
Fault := instFault.Fault;
{endregion}

{region "§2 Gate neutralisation"}
// 🛑 2. GATE
IF NOT Enable THEN
    SafeStop := FALSE;
    PowerCutOff := FALSE;
    ErrorOperatorComm := FALSE;
    ErrorDriveComm := FALSE;
    ErrorPhaseRotation := FALSE;
    ErrorBrakeThermal := FALSE;
    ErrorMecaB := FALSE;
    ErrorMecaA := FALSE;
    ErrorLimitSwitch := FALSE;
    ErrorSensorIncoherent := FALSE;
    TonMecaB(IN := FALSE);
    TonMecaA(IN := FALSE);
    TonLimitSwitchOverrun(IN := FALSE);
    TonStartupWarmup(IN := FALSE);
    Ready := FALSE;
    RETURN;
END_IF;

Ready := Enable AND NOT Fault.Latched;
{endregion}

{region "§3 Sorties sécurités et drapeaux IHM"}
// 📤 3. SORTIES SÉCURITÉ &amp; DRAPEAUX
SafeStop := Fault.Error OR NOT PowerContactorEngaged;

// PowerCutOff actif si bits 3..7 actifs (causes physiques)
PowerCutOff := (Fault.ErrorId AND 16#00F8) &lt;&gt; 16#0000;

ErrorOperatorComm     := instCauses[0].Active;
ErrorDriveComm        := instCauses[1].Active;
ErrorPhaseRotation    := instCauses[2].Active;
ErrorBrakeThermal     := instCauses[3].Active;
ErrorMecaB            := instCauses[4].Active;
ErrorMecaA            := instCauses[5].Active;
ErrorLimitSwitch      := instCauses[6].Active;
ErrorSensorIncoherent := instCauses[7].Active;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">48677159-75d3-4cf5-8a66-e0804bd1da8a_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Safety_Translation — Bloc Safety pour le Translation M3 (EtherCAT)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-11_Fonction_Translation_v2.3.md
///   Rôle : Surveillance joystick, bus EtherCAT, rotation de phases,
///      thermique frein commun, Méca A (vitesse non commandée à l'arrêt),
///      Méca B (frein/variateur en mouvement à l'arrêt), et Fdc extrêmes.
///   🎯 Invariant : les défauts de communication (bits 0/1/2) ne coupent
///      jamais la puissance amont (SafeStop seul) ; seuls les défauts
///      physiques (bits 3..7) déclenchent PowerCutOff.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Safety_Translation
VAR_INPUT
	///--&gt; [CMD] Active la surveillance
	Enable: BOOL;
	///--&gt; [CMD] Front acquittement défauts
	Reset: BOOL;
	///--&gt; [SAFE] Chaîne AU réarmée + conditions globales OK
	PowerContactorEngaged: BOOL;
	///--&gt; [CMD] Mode courant
	Mode: E_Mode;
	///--&gt; [HW] instDiagCanOpen.DeviceJoystick.Online
	JoystickOnline: BOOL;
	///--&gt; [HW] instDiagCanOpen.DeviceJoystick.Operational
	JoystickOperational: BOOL;
	///--&gt; [HW] IHM↔PLC : TRUE après front post-boot, FALSE = perte communication opérateur
	HeartbeatIhmOk: BOOL;
	///--&gt; [HW] PRG_02_Acquisition.HwIn.Machine.PhaseRotationOk_DI (TRUE = OK)
	PhaseRotationOk: BOOL;
	///--&gt; [HW] Thermique frein commun M1/M2/M3 (NC, TRUE = surchauffe/perte)
	BrakeThermalFeedback: BOOL;
	///🔌 Spécifique EtherCAT &amp; Capteurs réels
	///--&gt; [HW] Status diagnostic communication EtherCAT (Online)
	DriveOnline: BOOL;
	///--&gt; [HW] Status diagnostic communication EtherCAT (Operational)
	DriveOperational: BOOL;
	///--&gt; [HW] Mot d'état variateur AC600
	DriveStatusWord: WORD;
	///--&gt; [HW] Vitesse réelle variateur (Hz)
	DriveActualFreqHz: REAL;
	///--&gt; [HW] Retour d'état bobine frein (TRUE = ouvert/desserré)
	BrakeFeedback: BOOL;
	///--&gt; [HW] Commande frein
	BrakeCmd: BOOL;
	///--&gt; [CMD] Direction commandée
	Direction: INT;
	///--&gt; [HW] Fin de course extrême avant
	LimitSwitchFwd: BOOL;
	///--&gt; [HW] Fin de course extrême arrière
	LimitSwitchRev: BOOL;
	///--&gt; [HW] Mot des 5 capteurs position hors combinaisons valides (FB_Translation_PositionDecoder.Incoherent)
	SensorWordIncoherent: BOOL;
	///🔧 Bypass des surveillances (GVL_IHM.TranslationM3.Bypass)
	///--&gt; [TST] Bypass GLOBAL : ignore TOUTES les surveillances ci-dessous (prioritaire)
	BypassGlobal: BOOL := FALSE;
	///--&gt; [TST] Bypass perte communication opérateur
	BypassOperatorComm: BOOL := FALSE;
	///--&gt; [TST] Bypass perte communication drive
	BypassDriveComm: BOOL := FALSE;
	///--&gt; [TST] Bypass défaut rotation phases
	BypassPhaseRotation: BOOL := FALSE;
	///--&gt; [TST] Bypass surchauffe frein
	BypassBrakeThermal: BOOL := FALSE;
	///--&gt; [TST] Bypass Méca B
	BypassMecaB: BOOL := FALSE;
	///--&gt; [TST] Bypass Méca A
	BypassMecaA: BOOL := FALSE;
	///--&gt; [TST] Bypass butées extrêmes
	BypassLimitSwitch: BOOL := FALSE;
	///--&gt; [TST] Bypass incohérence mot capteurs
	BypassSensorIncoherent: BOOL := FALSE;
	///--&gt; [TST] Bypass groupé PowerCutOff (BrakeThermal/MecaB/MecaA/LimitSwitch/SensorIncoherent)
	BypassSafety: BOOL := FALSE;
	///--&gt; [TST] Bypass groupé SafeStop seul (OperatorComm/DriveComm/PhaseRotation/ContactorFeedback)
	BypassProcess: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	///&lt;-- [STAT] FB prêt (sortie libre, hors ST_Status)
	Ready: BOOL;
	///🧩 Statut transverse (forme cible ST_Fault)
	Fault: ST_Fault;
	///&lt;-- [ACT] Décélération rapide (PLC)
	SafeStop: BOOL;
	///&lt;-- [ACT] Coup de poing / coupure puissance amont
	PowerCutOff: BOOL;
	///&lt;-- [DIAG] Perte communication opérateur : joystick CAN ou heartbeat IHM (bit0)
	ErrorOperatorComm: BOOL;
	///&lt;-- [DIAG] Perte communication EtherCAT variateur (bit1)
	ErrorDriveComm: BOOL;
	///&lt;-- [DIAG] Mauvaise rotation de phases (bit2)
	ErrorPhaseRotation: BOOL;
	///&lt;-- [DIAG] Surchauffe thermique frein commun (bit3)
	ErrorBrakeThermal: BOOL;
	///&lt;-- [DIAG] Absence confirmation arrêt (Méca B - bit4)
	ErrorMecaB: BOOL;
	///&lt;-- [DIAG] Mouvement non commandé (Méca A - bit5)
	ErrorMecaA: BOOL;
	///&lt;-- [DIAG] Limite extrême Translation atteinte (bit6)
	ErrorLimitSwitch: BOOL;
	///&lt;-- [DIAG] Incohérence mot capteurs position (bit7)
	ErrorSensorIncoherent: BOOL;
END_VAR
VAR
	///. [LOC] Front Reset
	ResetEdge: R_TRIG;
	///. [LOC] Sécurité à l'arrêt (Méca B)
	TonMecaB: TON;
	///. [LOC] Sécurité mouvement non commandé (Méca A)
	TonMecaA: TON;
	///. [LOC] Surveillance poussée anormale / escalade fin de course
	TonLimitSwitchOverrun: TON;
	///. [LOC] Condition escalade fin de course
	OverrunCondition: BOOL;
	///. [LOC] Délai Méca B
	PostRampTimeout: TIME := TIME#3S;
	///. [LOC] Méca B active
	UncommandedActiveB: BOOL;
	///. [LOC] Méca A active
	UncommandedActiveA: BOOL;
	///. [LOC] Initialisation premier scan
	FirstScanDone: BOOL;
	///. [LOC] Inhibition 3s au boot + effacement auto coms
	TonStartupWarmup: TON;
	///Latches défauts
	///. [LOC] Latch rotation phase
	PhaseRotationFault: BOOL;
	///. [LOC] Latch thermique frein
	BrakeThermalFault: BOOL;
	///. [LOC] Latch Méca B
	MecaBFault: BOOL;
	///. [LOC] Latch Méca A
	MecaAFault: BOOL;
	///. [LOC] Latch mot capteurs incohérent
	SensorIncoherentFault: BOOL;
	///Socle défaut
	///* [INST] Socle défaut transverse
	instFault: FB_FaultCore;
	///. [LOC] Table des causes nommées
	instCauses: ARRAY[0..15] OF ST_FaultCause;
END_VAR
</Single>
