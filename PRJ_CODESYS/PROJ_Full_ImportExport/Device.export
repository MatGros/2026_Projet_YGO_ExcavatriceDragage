          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639237203751846988</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Homing) ===

{region "§1 Causes &amp; Socle Défaut (évalué en continu)"}
// 🔑 1. FRONTS
ResetEdge(CLK := Reset);
HomeEdge(CLK := Home);
ConfirmCoherenceEdge(CLK := BtnConfirmCoherence);

// Effacement des latches d'erreur sur Reset conscient
IF ResetEdge.Q THEN
    PresetConfirmationFailed := FALSE;
    HomingModeError := FALSE;
    TargetOutOfRangeError := FALSE;
    PresetFailError := FALSE;
END_IF;

// Levée de doute incohérence boot (BtnConfirmCoherence)
IF ConfirmCoherenceEdge.Q AND HomingPermit THEN
    Calib.HomingSuspect := FALSE;
    BootIncoherentError := FALSE;
END_IF;

// Configuration des causes nommées
instCauses[0].Active   := HomingModeError;
instCauses[0].Latching := TRUE;
instCauses[0].Texte    := 'Homing non autorise dans ce mode';

instCauses[1].Active   := TargetOutOfRangeError;
instCauses[1].Latching := TRUE;
instCauses[1].Texte    := 'Cible de homing hors plage';

instCauses[2].Active   := PresetFailError;
instCauses[2].Latching := TRUE;
instCauses[2].Texte    := 'Echec confirmation transaction preset';

instCauses[3].Active   := BootIncoherentError;
instCauses[3].Latching := TRUE;
instCauses[3].Texte    := 'Incoherence position codeur au demarrage';

// Appel du socle de défaut
instFault(Enable := Enable, Reset := Reset, Causes := instCauses);
Fault := instFault.Fault;
{endregion}

{region "§2 Gate neutralisation"}
// 🛑 2. GATE — neutralisation ; on continue toutefois d'exposer le dernier état RETAIN connu
// (FB_Encoder_Scale a besoin de HomingRefRaw même si ce FB est désactivé)
IF NOT Enable THEN
    PresetRequest := FALSE;
    PresetValue := 0;
    Ready := FALSE;
    Lifecycle.Busy := FALSE;
    Lifecycle.Done := FALSE;
    InitDone := FALSE;   // Force un nouveau contrôle à la prochaine activation
    PresetVerificationActive := FALSE;
    PresetVerifyTimer(IN := FALSE, PT := CST_PresetVerifyTime);
    Homed := Calib.Homed;
    HomingSuspect := Calib.HomingSuspect;
    HomingRefRaw := Calib.HomingRefRaw;
    // PresetConfirmationFailed est un diagnostic latch : il est gelé hors Enable
    RETURN;
END_IF;

Ready := Enable AND NOT Fault.Latched;
{endregion}

{region "§3 Cohérence au redémarrage"}
// 🔍 3. COHÉRENCE AU REDÉMARRAGE — une fois par session Enable, dès que le codeur répond
IF NOT InitDone THEN
    IF EncoderAvailable THEN
        RawDiffRestart := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(Calib.LastKnownRawPos);
        IF Calib.Homed AND (ABS(RawDiffRestart) &gt; UDINT_TO_DINT(Calib.RestartCoherenceTolerancePts)) THEN
            Calib.HomingSuspect := TRUE;
            BootIncoherentError := TRUE;
        END_IF;
        InitDone := TRUE;
    END_IF;
END_IF;
{endregion}

{region "§4 Demande et déclenchement homing"}
// ⚙️ 4. DEMANDE &amp; DÉCLENCHEMENT HOMING
PresetRequest := FALSE;
PresetValue := 0;
TopSensorEdge(CLK := TopPositionSensor);
DynamicTargetEdge(CLK := UseDynamicTarget);

HomingModeOk := HomingPermit;

IF HomeEdge.Q AND NOT HomingModeOk THEN
    HomingModeError := TRUE;
END_IF;

NominalHomingTrigger := HomingModeOk AND NOT UseDynamicTarget
                         AND ((Home AND TopSensorEdge.Q) OR (HomeEdge.Q AND TopPositionSensor));

UnitaryHomingTrigger := HomingModeOk AND NOT UseDynamicTarget AND HomeEdge.Q;

DynamicHomingTrigger := HomingModeOk AND (DynamicTargetEdge.Q OR (UseDynamicTarget AND HomeEdge.Q));

HomingTrigger := (NominalHomingTrigger OR UnitaryHomingTrigger OR DynamicHomingTrigger)
                 AND NOT PresetVerificationActive;

IF HomingTrigger THEN
    IF UseDynamicTarget THEN
        TargetPositionM := DynamicHomingTargetM;
    ELSIF NominalHomingTrigger THEN
        TargetPositionM := CfgTopSensorPosM;
    ELSE
        TargetPositionM := CfgHomingTargetM;
    END_IF;

    // Bornage obligatoire avant écriture (CODE_QUALITY_STANDARDS §6) [-99;+99] m
    IF (TargetPositionM &lt; -99.0) OR (TargetPositionM &gt; 99.0) THEN
        TargetOutOfRangeError := TRUE;
    ELSE
        TargetPoints := REAL_TO_DINT(TargetPositionM * UDINT_TO_REAL(PointsPerRev) / CableM_PerRev);
        PendingHomingRefRaw := DINT_TO_UDINT(UDINT_TO_DINT(RawPos) - TargetPoints);
        PresetValue := RawPos;
        PresetRequest := TRUE;
        PresetVerificationActive := TRUE;
        Lifecycle.Done := FALSE;
    END_IF;
END_IF;
{endregion}

{region "§5 Suivi de transaction preset"}
// ⏳ 5. SUIVI DE LA TRANSACTION PRESET
PresetVerifyTimer(IN := PresetVerificationActive, PT := CST_PresetVerifyTime);
IF PresetVerificationActive AND PresetVerifyTimer.Q THEN
    CandidateRawDiff := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(PendingHomingRefRaw);
    IF PointsPerRev &lt;&gt; 0 THEN
        CandidateCablePosM := DINT_TO_REAL(CandidateRawDiff) * CableM_PerRev / UDINT_TO_REAL(PointsPerRev);
    ELSE
        CandidateCablePosM := 0.0;
    END_IF;
    ReadbackOk := ABS(CandidateCablePosM - TargetPositionM) &lt;= CST_HomingVerifyToleranceM;
    StatusBitOk := PresetStatusBit;

    CASE Cfg.PresetConfirmMode OF
        E_PresetConfirmMode.READBACK_ONLY:
            PresetConfirmed := ReadbackOk;
        E_PresetConfirmMode.READBACK_AND_STATUSBIT:
            PresetConfirmed := ReadbackOk AND StatusBitOk;
        E_PresetConfirmMode.STATUSBIT_ONLY:
            PresetConfirmed := StatusBitOk;
        ELSE
            PresetConfirmed := FALSE;
    END_CASE;

    IF PresetConfirmed THEN
        Calib.HomingRefRaw := PendingHomingRefRaw;
        Calib.Homed := TRUE;
        Calib.HomingSuspect := FALSE;
        Calib.LastKnownRawPos := RawPos;
        PresetConfirmationFailed := FALSE;
        PresetFailError := FALSE;
        Lifecycle.Done := TRUE;
    ELSE
        Calib.HomingSuspect := TRUE;
        PresetConfirmationFailed := TRUE;
        PresetFailError := TRUE;
        Lifecycle.Done := FALSE;
    END_IF;

    PresetVerificationActive := FALSE;
    PresetVerifyTimer(IN := FALSE, PT := CST_PresetVerifyTime);
END_IF;
{endregion}

{region "§6 Sorties état &amp; calibration"}
// 📤 6. SORTIES ÉTAT &amp; CALIBRATION
IF EncoderAvailable AND NOT PresetVerificationActive THEN
    Calib.LastKnownRawPos := RawPos;
END_IF;

Lifecycle.Busy := PresetVerificationActive;
Homed := Calib.Homed AND NOT Calib.HomingSuspect;
HomingSuspect := Calib.HomingSuspect;
HomingRefRaw := Calib.HomingRefRaw;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">b303b445-a3f5-466e-8287-dac5e376f6c8_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ FB_Encoder_Homing — Référencement codeur nominal ou unitaire
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Séquence de référencement nominal (capteur haut) ou unitaire (MAINT_N2)
///   🔒 Polarité : Homed=TRUE dès qu'un référencement valide est enregistré
///   🔌 Architecture : Expose ST_Encoder_Calib en VAR_IN_OUT
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
///   =======================================================================
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Homing) ===
FUNCTION_BLOCK FB_Encoder_Homing
VAR_INPUT
	///=== COMMANDES &amp; AUTORISATIONS ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut (front montant)
	Reset: BOOL;
	///--&gt; [CMD] Demande de referencement (front)
	Home: BOOL;
	///--&gt; [CMD] Autorisation de homer (calculee par le caller)
	HomingPermit: BOOL;
	///--&gt; [CMD] Levee de doute d'incoherence au boot (front)
	BtnConfirmCoherence: BOOL;
	///=== CIBLES &amp; CONFIGURATION HOMING ===
	///--&gt; [CFG] Cible libre homing unitaire (m)
	CfgHomingTargetM: REAL;
	///--&gt; [CFG] Activation cible dynamique
	UseDynamicTarget: BOOL := FALSE;
	///--&gt; [CFG] Cible dynamique de referencement (m)
	DynamicHomingTargetM: REAL := 0;
	///--&gt; [CFG] Cible homing nominal capteur haut (m)
	CfgTopSensorPosM: REAL := 8.5;
	///=== RETOURS HW &amp; CAPTEURS ===
	///--&gt; [HW]  Capteur physique position haute unique
	TopPositionSensor: BOOL;
	///=== MESURES &amp; RETOURS FB CODEUR ABSOLU ===
	///--&gt; [HW]  Position brute codeur (sortie FB_Encoder_Abs)
	RawPos: UDINT;
	///--&gt; [HW]  Codeur absolu disponible et valide
	EncoderAvailable: BOOL;
	///--&gt; [HW]  Bit d'etat preset optionnel, FALSE si non cable
	PresetStatusBit: BOOL;
	///=== REGLAGES TRANSACTION PRESET ===
	///--&gt; [CFG] Mode de confirmation preset
	Cfg: ST_fbEncoder_Cfg;
	///=== CARACTERISTIQUES MECANIQUES &amp; BUS ===
	///--&gt; [CFG] Resolution codeur (pts/tour)
	PointsPerRev: UDINT := 8192;
	///--&gt; [CFG] Capacite multitour max codeur (tours)
	MultiTurnRevsMax: UDINT := 4096;
	///--&gt; [CFG] Perimetre tambour / developpement cable (m/tour)
	CableM_PerRev: REAL := 2;
	///=== TESTS &amp; BYPASS ===
	///--&gt; [TST] Neutralisation securites pour mise en service
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///🧩 Statut transverse (forme cible ST_Fault)
	Fault: ST_Fault;
	///🧩 Cycle de vie (forme cible ST_Lifecycle)
	Lifecycle: ST_Lifecycle;
	///=== COMMANDES VERS FB_ENCODER_ABS ===
	///&lt;-- [ACT]  Pulse demande d'ecriture preset SDO
	PresetRequest: BOOL;
	///&lt;-- [ACT]  Valeur de cible brute pour preset SDO
	PresetValue: UDINT;
	///=== RESULTATS &amp; MEMOIRE CALIBRATION ===
	///&lt;-- [STAT] Codeur pagine et referencie
	Homed: BOOL;
	///&lt;-- [DIAG] Incoherence redemarrage a lever
	HomingSuspect: BOOL;
	///&lt;-- [DIAG] Offset de reference brut calcule
	HomingRefRaw: UDINT;
	///&lt;-- [DIAG] Latch derniere verification preset echouee
	PresetConfirmationFailed: BOOL;
END_VAR
VAR_IN_OUT
	///=== STRUCTURE DE CALIBRATION PERSISTANTE ===
	///&lt;-&gt; [BUS] Structure de calibration RETAIN
	Calib: ST_Encoder_Calib;
END_VAR
VAR
	///=== DETECTEURS DE FRONT ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///. [LOC] Detecteur front montant Home
	HomeEdge: R_TRIG;
	///. [LOC] Detecteur front montant BtnConfirmCoherence
	ConfirmCoherenceEdge: R_TRIG;
	///. [LOC] Detecteur front montant TopPositionSensor
	TopSensorEdge: R_TRIG;
	///. [LOC] Detecteur front montant UseDynamicTarget
	DynamicTargetEdge: R_TRIG;
	///=== ETATS &amp; DRAPEAUX INTERNES ===
	///. [LOC] Controle incoherence boot effectue
	InitDone: BOOL;
	///. [LOC] Mode de fonctionnement valide pour homing
	HomingModeOk: BOOL;
	///. [LOC] Condition de declenchement homing nominal
	NominalHomingTrigger: BOOL;
	///. [LOC] Condition de declenchement homing unitaire
	UnitaryHomingTrigger: BOOL;
	///. [LOC] Condition de declenchement homing dynamique
	DynamicHomingTrigger: BOOL;
	///. [LOC] Synthese declenchement homing
	HomingTrigger: BOOL;
	///. [LOC] Verification preset en attente
	PresetVerificationActive: BOOL;
	///. [LOC] Resultat du mode de confirmation selectionne
	PresetConfirmed: BOOL;
	///=== DRAPEAUX DEFAUTS INTERNES ===
	///. [LOC] Latch erreur mode
	HomingModeError: BOOL;
	///. [LOC] Latch cible hors limites
	TargetOutOfRangeError: BOOL;
	///. [LOC] Latch échec preset
	PresetFailError: BOOL;
	///. [LOC] Latch incohérence boot
	BootIncoherentError: BOOL;
	///=== VARIABLES DE CALCUL ===
	///. [LOC] Ecart cible converti en points
	TargetPoints: DINT;
	///. [LOC] Cible retenue en metres
	TargetPositionM: REAL;
	///. [LOC] Ecart brut de position au redemarrage
	RawDiffRestart: DINT;
	///. [LOC] Reference candidate, non publiee avant succes
	PendingHomingRefRaw: UDINT;
	///. [LOC] Ecart brut de la mesure candidate
	CandidateRawDiff: DINT;
	///. [LOC] Position candidate calculee avant commit
	CandidateCablePosM: REAL;
	///. [LOC] Mesure candidate dans la tolerance
	ReadbackOk: BOOL;
	///. [LOC] Etat du bit optionnel de confirmation
	StatusBitOk: BOOL;
	///. [LOC] Temporisation historique de verification 500ms
	PresetVerifyTimer: TON;
	///=== SOCLE DEFAUT (FB_FaultCore) ===
	///* [INST] Socle défaut transverse
	instFault: FB_FaultCore;
	///. [LOC] Table des causes nommées
	instCauses: ARRAY[0..15] OF ST_FaultCause;
	///=== TOLERANCE &amp; TEMPORISATION TRANSACTION ===
	///Tolerance mesure cible (m)
	CST_HomingVerifyToleranceM: REAL := 0.01;
	///Latence historique avant relecture
	CST_PresetVerifyTime: TIME := TIME#500MS;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">b303b445-a3f5-466e-8287-dac5e376f6c8_Decl_LineIds</Single>
