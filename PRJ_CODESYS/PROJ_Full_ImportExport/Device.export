        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

{region "§1 Gate"}
IF NOT Enable THEN
    MaintainA_RQ   := FALSE;
    MaintainB_RQ   := FALSE;
    ArmPulse_RQ    := FALSE;

    State.ChainOk        := FALSE;
    State.ContactorOk    := FALSE;
    State.Step           := 0;
    State.Armable        := FALSE;
    State.ArmingBusy     := FALSE;

    Diag.Error                := FALSE;
    Diag.ErrorId              := 16#0000;
    Diag.RedundancyTestFailed := FALSE;
    Diag.ArmFailed            := FALSE;
    Diag.LockoutActive        := FALSE;
    Diag.LastAbortStep        := 0;
    Diag.LastAbortCause       := 16#0000;
    RETURN;
END_IF;
{endregion}

{region "§2 Projection sorties et bus"}
// ⚡ Sorties physiques — écriture directe des ordres logiques
MaintainA_RQ := Cmd.MaintainA_Cmd;
MaintainB_RQ := Cmd.MaintainB_Cmd;
ArmPulse_RQ  := Cmd.ArmPulse_Cmd;

// 🚦 Bus d'état public
State.ChainOk        := ChainOk;
State.ContactorOk    := ContactorOk;
State.Step           := ArmingStep;
State.Armable        := Armable;
State.ArmingBusy     := ArmingBusy;

// 🛡️ Bus diagnostic public
Diag.Error                := Error;
Diag.ErrorId              := ErrorId;
Diag.RedundancyTestFailed := RedundancyTestFailed;
Diag.ArmFailed            := ArmFailed;
Diag.LockoutActive        := LockoutActive;
Diag.LastAbortStep        := LastAbortStep;
Diag.LastAbortCause       := LastAbortCause;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">2ee550de-489d-47fe-9204-cdcdbdaed56c_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔒 FB_Safety_EmergencyManagementOutput — Projection Physique Fail-Safe
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Enable gate + copie consignes logiques vers sorties physiques
///   🔒 Polarité : MaintainA/B_RQ en maintien (TRUE = voie saine)
///   🔌 Architecture : Projection physique fail-safe
///   📄 Doc métier : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.1.md
///   =======================================================================
FUNCTION_BLOCK FB_Safety_EmergencyManagementOutput
VAR_INPUT
	///=== CONSIGNES &amp; COMMANDES LOGIQUES ===
	///--&gt; [CMD]  Active le pilote (FALSE = toutes sorties a FALSE)
	Enable: BOOL;
	///--&gt; [CMD] Ordres logiques recus du bloc logique
	Cmd: ST_Safety_Emergency_InternalCmd;
	///=== RETOURS D'ETAT &amp; DIAGNOSTICS (MIROIRS) ===
	///--&gt; [HW]   Miroir EmergencyChainClosed (pour bus State)
	ChainOk: BOOL;
	///--&gt; [HW]   Miroir PowerContactorEngaged (pour bus State)
	ContactorOk: BOOL;
	///--&gt; [STAT] Miroir ArmingSeqStep (pour bus State)
	ArmingStep: INT;
	///--&gt; [STAT] Calcule par Logic (pour bus State)
	Armable: BOOL;
	///--&gt; [STAT] Calcule par Logic (pour bus State)
	ArmingBusy: BOOL;
	///--&gt; [DIAG] Miroir Error (pour bus Diag)
	Error: BOOL;
	///--&gt; [DIAG] Miroir ErrorId (pour bus Diag)
	ErrorId: WORD;
	///--&gt; [DIAG] Miroir RedundancyTestFailed (pour bus Diag)
	RedundancyTestFailed: BOOL;
	///--&gt; [DIAG] Miroir ArmFailed (pour bus Diag)
	ArmFailed: BOOL;
	///--&gt; [DIAG] Miroir LockoutActive (pour bus Diag)
	LockoutActive: BOOL;
	///--&gt; [DIAG] Miroir LastAbortStep (pour bus Diag)
	LastAbortStep: INT;
	///--&gt; [DIAG] Miroir LastAbortCause (pour bus Diag)
	LastAbortCause: WORD;
END_VAR
VAR_OUTPUT
	///=== SORTIES PHYSIQUES TERMINALES ===
	///&lt;-- [ACT]  Vers relais maintien canal A (TRUE = voie maintenue)
	MaintainA_RQ: BOOL;
	///&lt;-- [ACT]  Vers relais maintien canal B (TRUE = voie maintenue)
	MaintainB_RQ: BOOL;
	///&lt;-- [ACT]  Vers contacteur impulsion rearmement (TRUE = pulse actif)
	ArmPulse_RQ: BOOL;
	///=== BUS D'ETAT &amp; DIAGNOSTIC PUBLICS ===
	///&lt;-- [STAT] Bus d'etat public
	State: ST_Safety_Emergency_State;
	///&lt;-- [DIAG] Bus diagnostic public
	Diag: ST_Safety_Emergency_Diag;
END_VAR
</Single>
