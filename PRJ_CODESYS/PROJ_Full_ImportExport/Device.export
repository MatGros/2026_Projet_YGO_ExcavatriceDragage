          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🕹️ ST_AcquisitionJoystickQualified — Données joystick qualifiées
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Encapsuler les commandes d'axes, statut homme-mort et diagnostics
///      produits par FB_Joystick dans PRG_02_Acquisition.
///   📤 Producteur unique : PRG_02_Acquisition (Data.Joystick).
///   📄 Doc : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.4.md
///   ═══════════════════════════════════════════════════════════════
TYPE ST_AcquisitionJoystickQualified :
STRUCT
	///📊 Commande et direction qualifiée axe X
	AxisX: ST_fbJoystick_AxisCmd;
	///📊 Commande et direction qualifiée axe Y
	AxisY: ST_fbJoystick_AxisCmd;
	///🔒 Homme-mort armé et valide
	DeadmanArmed: BOOL;
	///🟢 Les deux axes X et Y sont au neutre
	AtNeutralXY: BOOL;
	///⚠️ Tentative d'armement sans permission
	ArmingPermitDenied: BOOL;
	///🟢 Façade joystick prête et opérationnelle
	Ready: BOOL;
	///❌ Diagnostic défaut joystick
	Fault: ST_Fault;
	///📍 Valeur ADC neutre calibré X
	NeutralXAct: INT;
	///📍 Valeur ADC neutre calibré Y
	NeutralYAct: INT;
END_STRUCT
END_TYPE
</Single>
