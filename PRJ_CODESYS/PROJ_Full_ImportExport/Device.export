        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔄 FB_Cycle — Séquenceur du Cycle Automatique (Grafcet de dragage)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-04_Mode_SemiAuto_Sequenceur_v2.0.md
///   🔌 Conforme au contrat FB standard (Partie3 §1bis).
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Cycle
VAR_INPUT
	///Activation générale du séquenceur
	Enable: BOOL;
	///Acquittement défaut (front)
	Reset: BOOL;
	///Chaîne de sécurité OK
	PowerContactorEngaged: BOOL;
	///Homme-mort + joystick actif
	CycleMotionPermit: BOOL;
	///💓 IHM↔PLC valide ; FALSE = repli cycle obligatoire
	HeartbeatIhmOk: BOOL;
	///Commandes opérateur
	///Demande lancement / reprise cycle (IHM)
	StartCycle: BOOL;
	///Demande pause temporaire (IHM)
	PauseCycle: BOOL;
	///Demande abandon cycle (IHM)
	AbortCycle: BOOL;
	///Cibles et paramètres
	///Profondeur de consigne (négative)
	SetDepthM: REAL;
	///Écart de fermeture benne cible
	SetOffsetM: REAL;
	///Cible sélectionnée (2=P2, 3=P1)
	SelectedTargetNum_IHM: INT;
	///Feedbacks physique &amp; matériel
	///Retour dédié Kobold : TRUE = contact fond détecté
	KoboldContactFond: BOOL;
	///Limite légale atteinte (descente interdite)
	LimitLegalReached: BOOL;
	///Profondeur légale minimale autorisée
	LimitLegalDepthM: REAL;
	///Désynchronisme bloquant M1/M2
	WinchSyncError: BOOL;
	///Écart codeurs M1/M2 pour diagnostic
	WinchSyncDeltaM: REAL;
	///Position câble treuil M1 (recalée)
	M1_CablePosM: REAL;
	///Position câble treuil M2 (recalée)
	M2_CablePosM: REAL;
	///Vitesse linéaire mesurée M1 (m/s)
	M1_MeasuredSpeedMps: REAL;
	///Vitesse linéaire mesurée M2 (m/s)
	M2_MeasuredSpeedMps: REAL;
	///Seuil écart vitesse ; 0 = contrôle désactivé
	SpeedMismatchThresholdMps: REAL;
	///Durée de confirmation ; 0 = contrôle désactivé
	SpeedMismatchTimeout: TIME;
	///Limite haute d'exploitation M1 ; seuil de fin ASCENDING_LOADED
	CableLimitM1AscentM: REAL;
	///Feedbacks Translation M3
	///Capteur position P1 (ex-Fosse1)
	Translation_At_P1: BOOL;
	///Capteur position P2 (ex-Fosse2)
	Translation_At_P2: BOOL;
	///Capteur fin de course maintenance
	Translation_At_Maintenance: BOOL;
	///Capteur fin de course trémie
	Translation_At_Tremie: BOOL;
	///Mouvement translation en cours
	Translation_Busy: BOOL;
	///Cible translation atteinte
	Translation_Done: BOOL;
	///Feedbacks Benne
	///Mouvement mâchoires benne en cours
	Benne_Busy: BOOL;
	///Mouvement ouverture/fermeture terminé
	Benne_Done: BOOL;
	///Benne mécaniquement ouvert mémorisé
	Benne_IsOpen: BOOL;
	///Benne mécaniquement fermé mémorisé
	Benne_IsClosed: BOOL;
END_VAR
VAR_OUTPUT
	///Séquenceur disponible
	Ready: BOOL;
	///Cycle automatique actif
	Busy: BOOL;
	///Cycle automatique complété
	Done: BOOL;
	///Défaut cycle
	Error: BOOL;
	///bit0: Timeout/limite, bit1: désynchronisme, bit2: cible invalide, bit3: stabilisation impossible, bit4: écart vitesse, bit5: perte heartbeat
	ErrorId: WORD;
	///Écart absolu vitesse M1/M2 (m/s)
	SpeedMismatchMps: REAL;
	///Seuil vitesse dépassé sur le cycle courant
	SpeedMismatchActive: BOOL;
	///Écart vitesse confirmé pendant SpeedMismatchTimeout
	SpeedMismatchConfirmed: BOOL;
	///Commandes structurées (demandes de mouvement)
	///Demande treuil M1
	WinchM1Cmd: ST_WinchCmdDemand;
	///Demande treuil M2
	WinchM2Cmd: ST_WinchCmdDemand;
	///Demande translation M3
	TranslationCmd: ST_TranslationCmdDemand;
	///Demande benne
	BucketCmd: ST_BucketCmdDemand;
	///Métadonnées d'affichage IHM
	///Étape active du Grafcet
	CycleStep: E_CycleStep;
	///Libellé en clair de l'étape
	CycleStateStr: STRING(80);
END_VAR
VAR
	ResetEdge: R_TRIG;
	StartEdge: R_TRIG;
	PauseEdge: R_TRIG;
	AbortEdge: R_TRIG;
	///Séquencement
	State: E_CycleStep := E_CycleStep.INIT;
	SavedState: E_CycleStep := E_CycleStep.INIT;
	IsPaused: BOOL := FALSE;
	///Mémorisations et Timers
	///Position M1 mémorisée lors du contact fond
	TouchPositionM: REAL;
	///Profondeur de remontée mémorisée
	RaiseTargetM: REAL;
	///Temporisateur de vidage (égouttage)
	DrainingTimer: TON;
	///Temporisation maximale de remontée lente après fermeture
	StabilizationTimer: TON;
	///Confirmation temporelle écart de vitesse M1/M2
	SpeedMismatchTimer: TON;
	///Cible de travail mémorisée (2=P2 ou 3=P1)
	SelectedWorkTarget: INT;
	///Paramètres internes
	///Distance de remontée lente de contrôle
	CtrlAscentDistM: REAL := 2;
	///Écart maximal admis entre les deux codeurs
	CtrlAscentToleranceM: REAL := 0.25;
	///Temps maximal pour atteindre la zone de stabilisation
	CtrlAscentTimeout: TIME := TIME#30s0ms;
	///Temps d'égouttage par défaut
	DrainingTime: TIME := TIME#5s0ms;
END_VAR
</Single>
