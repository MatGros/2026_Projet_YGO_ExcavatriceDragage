            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_ProgramSequence :
(
	///Aucune séquence active
	NONE := 0,
	///Cycle semi-automatique principal (FB_Cycle)
	MAIN_CYCLE := 1,
	///Recherche de fond Kobold (réservé future migration)
	DIVE_SEARCH := 2,
	///Séquence d'extraction (réservé future migration)
	EXTRACTION := 3
);
END_TYPE
</Single>
