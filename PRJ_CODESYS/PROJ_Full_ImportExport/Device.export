          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestStimAnalogConfig — Configuration d'un stimulus instrumenté
///═══════════════════════════════════════════════════════════════
TYPE ST_TestStimAnalogConfig :
STRUCT
	///Type de stimulus (pulse, rampe, séquence)
	Kind: E_TestStimKind;
	///Valeur de départ pour la rampe
	StartReal: REAL;
	///Valeur cible pour la rampe
	TargetReal: REAL;
	///Durée de l'impulsion (PULSE_BOOL)
	PulsePT: TIME;
	///Durée de transition de la rampe
	RampPT: TIME;
	///Valeurs de la séquence
	SeqValues: ARRAY[1..GVL_PLC_Tests_Const.MaxSeqValues] OF REAL;
	///Nombre de valeurs utilisées dans la séquence
	SeqCount: INT;
	///Temps de maintien de chaque valeur de la séquence
	SeqDwellPT: TIME;
END_STRUCT
END_TYPE
</Single>
