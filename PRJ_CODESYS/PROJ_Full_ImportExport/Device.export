    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">c15e60d0-eb0b-45e6-8a83-9a363a273872</Single>
        <Single Name="ParentGuid" Type="System.Guid">103fbab6-1b12-4ccb-9cc6-6c66cad0e1cb</Single>
        <Single Name="Name" Type="string">FB_TranslationReportFinalizer</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">24568a24-c491-472c-a21f-ee5d33859fab</Single>
            </Key>
            <Value>
              <Single Type="{24568a24-c491-472c-a21f-ee5d33859fab}" Method="IArchivable">
                <Single Name="MemoryReserveForOnlineChange" Type="int">0</Single>
                <Single Name="ExcludeFromBuild" Type="bool">False</Single>
                <Single Name="External" Type="bool">False</Single>
                <Single Name="EnableSystemCall" Type="bool">False</Single>
                <Single Name="CompilerDefines" Type="string"></Single>
                <Single Name="LinkAlways" Type="bool">False</Single>
                <Array Name="Undefines" Type="string" />
              </Single>
            </Value>
          </Entry>
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">bb0fb193-0050-4ddb-b61c-816718e8aa15</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926775179153</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// === IMPLEMENTATION ===
IF RunStart THEN
    Report.Name := 'Translation Validation';
    Report.InProgress := TRUE;
    Report.AllPassed := FALSE;
    Report.AnyFailed := FALSE;
    Report.Aborted := FALSE;
    Report.TerminalState := E_TestTerminalState.TEST_TERMINAL_NONE;
    Report.ErrorCode := 0;
    Report.ErrorMessage := '';
    Report.FailedTestCase := 0;
    Report.FailureSummary := '';
    Report.CurrentStepId := 0;
    Report.CurrentCaseId := 0;
    Report.Duration := T#0s;
    Report.RunCounter := Report.RunCounter + 1;
    FOR Idx := 1 TO GVL_PLC_Tests_Const.MaxSteps DO
        Report.Steps[Idx].Executed := FALSE;
        Report.Steps[Idx].Passed := FALSE;
        Report.Steps[Idx].FailReason := E_TestFailReason.FAIL_NONE;
        Report.Steps[Idx].FailedCheckIdx := 0;
        Report.Steps[Idx].FailedInvariantId := 0;
        Report.Steps[Idx].Duration := T#0s;
    END_FOR;
    FOR Idx := 1 TO GVL_PLC_Tests_Const.MaxTestCases DO
        Report.Cases[Idx].Name := CaseTable[Idx].Name;
        Report.Cases[Idx].Executed := FALSE;
        Report.Cases[Idx].Ok := FALSE;
        Report.Cases[Idx].FailedStepId := 0;
        Report.Cases[Idx].FailReason := E_TestFailReason.FAIL_NONE;
        Report.Cases[Idx].Duration := T#0s;
    END_FOR;
    Result.TerminalState := E_TestTerminalState.TEST_TERMINAL_NONE;
    Result.RequestedCaseId := RequestedCaseId;
    Result.ExecutedCaseId := 0;
    Result.AllPassed := FALSE;
    Result.AnyFailed := FALSE;
    Result.FailedCaseId := 0;
    Result.FailedCaseName := '';
    Result.FailReason := E_TestFailReason.FAIL_NONE;
    Result.ErrorCode := 0;
    Result.ErrorMessage := '';
    Result.CasesTotal := 0;
    Result.CasesPassed := 0;
    Result.CasesFailed := 0;
    Result.Duration := T#0s;
    Result.RunCounter := Report.RunCounter;
END_IF;

IF Busy THEN
    Report.Duration := Report.Duration + UDINT_TO_TIME(INT_TO_UDINT(GVL_PLC_Tests_Const.TaskCycleMs));
END_IF;

// 🧾 Agrégation incrémentale : validation séparée avant toute indexation.
IF StepVerdict THEN
    IF StepId &lt; 1 OR StepId &gt; GVL_PLC_Tests_Const.MaxSteps THEN
        Report.ErrorCode := 1050;
        Report.ErrorMessage := 'Verdict StepId hors limites';
        Report.AnyFailed := TRUE;
        RETURN;
    END_IF;
    Report.Steps[StepId].Executed := TRUE;
    Report.Steps[StepId].Passed := StepPassed;
    Report.Steps[StepId].FailReason := StepFailReason;
    Report.Steps[StepId].FailedCheckIdx := StepFailedCheckIdx;
    Report.Steps[StepId].Duration := StepDuration;
    Report.Steps[StepId].ObservedBool := StepObservedBool;
    Report.Steps[StepId].ObservedDint := StepObservedDint;
    Report.Steps[StepId].ObservedReal := StepObservedReal;
    Report.CurrentStepId := StepId;
    Report.CurrentCaseId := StepCaseId;

    IF StepCaseId &gt;= 1 THEN
        IF StepCaseId &lt;= GVL_PLC_Tests_Const.MaxTestCases THEN
        IF NOT Report.Cases[StepCaseId].Executed THEN
            Report.Cases[StepCaseId].Executed := TRUE;
            Report.Cases[StepCaseId].Ok := TRUE;
        END_IF;
        Report.Cases[StepCaseId].Duration := Report.Cases[StepCaseId].Duration + StepDuration;
        IF NOT StepPassed THEN
            Report.Cases[StepCaseId].Ok := FALSE;
            IF Report.Cases[StepCaseId].FailedStepId = 0 THEN
                Report.Cases[StepCaseId].FailedStepId := StepId;
                Report.Cases[StepCaseId].FailReason := StepFailReason;
            END_IF;
        END_IF;
        ELSE
            Report.ErrorCode := 1051;
            Report.ErrorMessage := 'Verdict CaseId hors limites';
            Report.AnyFailed := TRUE;
        END_IF;
    ELSE
        Report.ErrorCode := 1051;
        Report.ErrorMessage := 'Verdict CaseId hors limites';
        Report.AnyFailed := TRUE;
    END_IF;
END_IF;

IF Finalize THEN
    Report.InProgress := FALSE;
    Report.TerminalState := TerminalState;
    Report.ErrorCode := ErrorCode;
    Report.ErrorMessage := ErrorMessage;
    Report.Aborted := (TerminalState = E_TestTerminalState.TEST_TERMINAL_ABORTED);
    CasesTotalLocal := 0;
    CasesPassedLocal := 0;
    CasesFailedLocal := 0;
    FirstFailedCase := 0;
    Report.FailureSummary := '';

    FOR CaseIdx := 1 TO GVL_PLC_Tests_Const.MaxTestCases DO
        IF Report.Cases[CaseIdx].Executed THEN
            CasesTotalLocal := CasesTotalLocal + 1;
            IF Report.Cases[CaseIdx].Ok THEN
                CasesPassedLocal := CasesPassedLocal + 1;
            ELSE
                CasesFailedLocal := CasesFailedLocal + 1;
                IF FirstFailedCase = 0 THEN FirstFailedCase := CaseIdx; END_IF;
                CASE Report.Cases[CaseIdx].FailReason OF
                    E_TestFailReason.FAIL_TIMEOUT: ReasonText := 'FAIL_TIMEOUT';
                    E_TestFailReason.FAIL_CHECK: ReasonText := 'FAIL_CHECK';
                    E_TestFailReason.FAIL_INVARIANT: ReasonText := 'FAIL_INVARIANT';
                    E_TestFailReason.FAIL_WINDOW_EARLY: ReasonText := 'FAIL_WINDOW_EARLY';
                    E_TestFailReason.FAIL_ABORTED: ReasonText := 'FAIL_ABORTED';
                ELSE ReasonText := 'FAIL_NONE';
                END_CASE;
                EntryText := CONCAT(Report.Cases[CaseIdx].Name, ' (step ');
                EntryText := CONCAT(EntryText, INT_TO_STRING(Report.Cases[CaseIdx].FailedStepId));
                EntryText := CONCAT(EntryText, '): ');
                EntryText := CONCAT(EntryText, ReasonText);
                IF Report.FailureSummary = '' THEN
                    Report.FailureSummary := EntryText;
                ELSE
                    Report.FailureSummary := CONCAT(Report.FailureSummary, ' | ');
                    Report.FailureSummary := CONCAT(Report.FailureSummary, EntryText);
                END_IF;
            END_IF;
        END_IF;
    END_FOR;

    Report.AllPassed := (TerminalState = E_TestTerminalState.TEST_TERMINAL_DONE)
                     AND (CasesTotalLocal &gt; 0)
                     AND (CasesFailedLocal = 0);
    Report.AnyFailed := NOT Report.AllPassed;
    Report.FailedTestCase := FirstFailedCase;

    Result.TerminalState := TerminalState;
    Result.RequestedCaseId := RequestedCaseId;
    Result.ExecutedCaseId := Report.CurrentCaseId;
    Result.AllPassed := Report.AllPassed;
    Result.AnyFailed := Report.AnyFailed;
    Result.FailedCaseId := FirstFailedCase;
    IF FirstFailedCase &gt; 0 THEN
        Result.FailedCaseName := Report.Cases[FirstFailedCase].Name;
        Result.FailReason := Report.Cases[FirstFailedCase].FailReason;
    ELSE
        Result.FailedCaseName := '';
        Result.FailReason := E_TestFailReason.FAIL_NONE;
    END_IF;
    Result.ErrorCode := ErrorCode;
    Result.ErrorMessage := ErrorMessage;
    Result.CasesTotal := CasesTotalLocal;
    Result.CasesPassed := CasesPassedLocal;
    Result.CasesFailed := CasesFailedLocal;
    Result.Duration := Report.Duration;
    Result.RunCounter := Report.RunCounter;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">c15e60d0-eb0b-45e6-8a83-9a363a273872_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 FB_TranslationReportFinalizer — Rapport incrémental Translation
///───────────────────────────────────────────────────────────────
///🎯 Responsabilité UNIQUE : enregistrer les verdicts réels et finaliser
///un rapport borné. Aucun parcours du graphe de transitions.
///═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_TranslationReportFinalizer
VAR_INPUT
	RunStart: BOOL;
	RequestedCaseId: INT;
	Busy: BOOL;
	StepVerdict: BOOL;
	StepId: INT;
	StepCaseId: INT;
	StepPassed: BOOL;
	StepFailReason: E_TestFailReason;
	StepFailedCheckIdx: INT;
	StepDuration: TIME;
	StepObservedBool: BOOL;
	StepObservedDint: DINT;
	StepObservedReal: REAL;
	Finalize: BOOL;
	TerminalState: E_TestTerminalState;
	ErrorCode: INT;
	ErrorMessage: STRING(160);
END_VAR
VAR_OUTPUT
END_VAR
VAR_IN_OUT
	StepTable: ARRAY[1..GVL_PLC_Tests_Const.MaxSteps] OF ST_TestStepConfig;
	CaseTable: ARRAY[1..GVL_PLC_Tests_Const.MaxTestCases] OF ST_TestCaseConfig;
	Report: ST_TestSuiteReport;
	Result: ST_TranslationTestResult;
END_VAR
VAR
	Idx: INT;
	CaseIdx: INT;
	CasesTotalLocal: INT;
	CasesPassedLocal: INT;
	CasesFailedLocal: INT;
	FirstFailedCase: INT;
	ReasonText: STRING(20);
	EntryText: STRING(80);
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">c15e60d0-eb0b-45e6-8a83-9a363a273872_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">214</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">bb0fb193-0050-4ddb-b61c-816718e8aa15</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">Logique API</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">SIMULATION</Single>
        <Single Type="string">PLC_TESTS</Single>
        <Single Type="string">CORE</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">944364f9-6eb8-4f19-a71a-d7c61b6747a3</Single>
        <Single Name="ParentGuid" Type="System.Guid">103fbab6-1b12-4ccb-9cc6-6c66cad0e1cb</Single>
        <Single Name="Name" Type="string">FB_TranslationStepExecutor</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">24568a24-c491-472c-a21f-ee5d33859fab</Single>
            </Key>
            <Value>
              <Single Type="{24568a24-c491-472c-a21f-ee5d33859fab}" Method="IArchivable">
                <Single Name="MemoryReserveForOnlineChange" Type="int">0</Single>
                <Single Name="ExcludeFromBuild" Type="bool">False</Single>
                <Single Name="External" Type="bool">False</Single>
                <Single Name="EnableSystemCall" Type="bool">False</Single>
                <Single Name="CompilerDefines" Type="string"></Single>
                <Single Name="LinkAlways" Type="bool">False</Single>
                <Array Name="Undefines" Type="string" />
              </Single>
            </Value>
          </Entry>
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">bb0fb193-0050-4ddb-b61c-816718e8aa15</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926775298950</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// === IMPLEMENTATION ===
StartTrig(CLK := Start);
StepVerdict := FALSE;

// 1. 🛑 Abort — niveau, priorité absolue
IF Abort THEN
    IF Busy THEN
        StepVerdict := TRUE;
        VerdictStepId := CurrentStepId;
        VerdictCaseId := CurrentCaseId;
        VerdictPassed := FALSE;
        VerdictFailReason := E_TestFailReason.FAIL_ABORTED;
        VerdictFailedCheckIdx := 0;
        VerdictDuration := StepElapsed;
        VerdictObservedBool := FALSE;
        VerdictObservedDint := 0;
        VerdictObservedReal := 0.0;
        AnyFailed := TRUE;
        TerminalState := E_TestTerminalState.TEST_TERMINAL_ABORTED;
    END_IF;
    Busy := FALSE;
    RunDone := TRUE;
    ActiveStimulusId := 0;
    CurrentStepId := 0;
    StepStarted := FALSE;
    RETURN;
END_IF;

// 2. 🟢 Démarrage — résolution CaseId -&gt; 1er step, JAMAIS de FirstStepId externe
IF StartTrig.Q THEN
    ConfigError := FALSE;
    ConfigErrorStepId := 0;
    TerminalState := E_TestTerminalState.TEST_TERMINAL_NONE;

    IF CaseId &lt; 0 OR CaseId &gt; 6 THEN
        ConfigError := TRUE;
        ConfigErrorStepId := CaseId;
        Busy := FALSE;
        RunDone := TRUE;
        AnyFailed := TRUE;
        ActiveStimulusId := 0;
        CurrentStepId := 0;
        TerminalState := E_TestTerminalState.TEST_TERMINAL_CONFIG_ERROR;
        RETURN;
    END_IF;

    IF CaseId = 0 THEN
        CurrentStepId := CaseTable[1].FirstStep;
    ELSE
        CurrentStepId := CaseTable[CaseId].FirstStep;
    END_IF;

    IF CurrentStepId &lt; 1 OR CurrentStepId &gt; GVL_PLC_Tests_Const.MaxSteps THEN
        ConfigError := TRUE;
        ConfigErrorStepId := CurrentStepId;
        Busy := FALSE;
        RunDone := TRUE;
        AnyFailed := TRUE;
        ActiveStimulusId := 0;
        CurrentStepId := 0;
        TerminalState := E_TestTerminalState.TEST_TERMINAL_CONFIG_ERROR;
        RETURN;
    END_IF;

    Busy := TRUE;
    RunDone := FALSE;
    AnyFailed := FALSE;
    StepStarted := FALSE;
    TransitionCount := 0;
END_IF;

IF NOT Busy THEN
    RETURN;
END_IF;

// 3. 🛡️ Garde-fou runtime (défense en profondeur — Plan valide déjà statiquement)
IF CurrentStepId &lt; 1 OR CurrentStepId &gt; GVL_PLC_Tests_Const.MaxSteps THEN
    Busy := FALSE;
    RunDone := TRUE;
    AnyFailed := TRUE;
    ActiveStimulusId := 0;
    ConfigError := TRUE;
    ConfigErrorStepId := CurrentStepId;
    TerminalState := E_TestTerminalState.TEST_TERMINAL_CONFIG_ERROR;
    RETURN;
END_IF;

CurrentCaseId := StepTable[CurrentStepId].CaseId;
ActiveStimulusId := StepTable[CurrentStepId].StimulusId;

IF NOT StepStarted THEN
    StepStarted := TRUE;
    StepElapsed := T#0s;
    DwellTimer(IN := FALSE);
    StepTimer(IN := FALSE);
    FOR Jdx := 1 TO GVL_PLC_Tests_Const.MaxChecksPerStep DO
        CheckPassed[Jdx] := FALSE;
        CheckFailed[Jdx] := FALSE;
        InstantEvaluated[Jdx] := FALSE;
        StableTimers[Jdx](IN := FALSE);
    END_FOR;
END_IF;

StepElapsed := StepElapsed + UDINT_TO_TIME(INT_TO_UDINT(GVL_PLC_Tests_Const.TaskCycleMs));

// 4. 🕐 Dwell (tempo fixe avant évaluation — T#0s = aucune, cas actuel Translation)
DwellTimer(IN := TRUE, PT := StepTable[CurrentStepId].DwellPT);
IF NOT DwellTimer.Q THEN
    RETURN;
END_IF;

// 5. ✅ Évaluation des checks — verrouillage "latch and hold" par check
//    (un check WAIT_UNTIL passé le reste jusqu'à la fin de l'étape, même si
//    la sonde redevient momentanément fausse — sémantique identique à
//    l'ancien FB_TestCheck, réécrite ici sans l'instancier)
FOR Jdx := 1 TO GVL_PLC_Tests_Const.MaxChecksPerStep DO
    Kdx := StepTable[CurrentStepId].CheckIdx[Jdx];
    // 🔒 CODESYS n'assure pas le court-circuit : valider AVANT tout accès.
    IF Kdx &lt; 0 OR Kdx &gt; GVL_PLC_Tests_Const.MaxChecks THEN
        Busy := FALSE;
        RunDone := TRUE;
        AnyFailed := TRUE;
        ActiveStimulusId := 0;
        ConfigError := TRUE;
        ConfigErrorStepId := CurrentStepId;
        TerminalState := E_TestTerminalState.TEST_TERMINAL_CONFIG_ERROR;
        RETURN;
    END_IF;
    IF Kdx &gt; 0 THEN
        Cond := FALSE;
        ProbeIdx := CheckTable[Kdx].ProbeIdx;
        CASE CheckTable[Kdx].Kind OF
            E_TestCheckKind.BOOL_EQUAL:
                IF ProbeIdx &gt;= 1 THEN
                    IF ProbeIdx &lt;= GVL_PLC_Tests_Const.MaxProbeBool THEN
                        ObsBoolArr[Jdx] := ProbeBool[ProbeIdx];
                        Cond := (ObsBoolArr[Jdx] = CheckTable[Kdx].ExpectedBool);
                    END_IF;
                END_IF;
            E_TestCheckKind.WORD_MASK_NONE:
                IF ProbeIdx &gt;= 1 THEN
                    IF ProbeIdx &lt;= GVL_PLC_Tests_Const.MaxProbeDint THEN
                        ObsDintArr[Jdx] := ProbeDint[ProbeIdx];
                        Cond := ((DINT_TO_WORD(ObsDintArr[Jdx]) AND CheckTable[Kdx].Mask) = 0);
                    END_IF;
                END_IF;
            E_TestCheckKind.REAL_IN_RANGE:
                IF ProbeIdx &gt;= 1 THEN
                    IF ProbeIdx &lt;= GVL_PLC_Tests_Const.MaxProbeReal THEN
                        ObsRealArr[Jdx] := ProbeReal[ProbeIdx];
                        Cond := (ObsRealArr[Jdx] &gt;= CheckTable[Kdx].RealMin AND ObsRealArr[Jdx] &lt;= CheckTable[Kdx].RealMax);
                    END_IF;
                END_IF;
            // Kind hors périmètre (voir FB_TranslationTestPlan) -&gt; Cond reste FALSE
        END_CASE;

        IF NOT CheckPassed[Jdx] AND NOT CheckFailed[Jdx] THEN
            CASE CheckTable[Kdx].Mode OF
                E_TestCheckMode.CHECK_INSTANT:
                    IF NOT InstantEvaluated[Jdx] THEN
                        InstantEvaluated[Jdx] := TRUE;
                        IF Cond THEN
                            CheckPassed[Jdx] := TRUE;
                        ELSE
                            CheckFailed[Jdx] := TRUE;
                        END_IF;
                    END_IF;
                E_TestCheckMode.CHECK_WAIT_UNTIL:
                    StableTimers[Jdx](IN := Cond, PT := CheckTable[Kdx].StablePT);
                    IF StableTimers[Jdx].Q THEN
                        CheckPassed[Jdx] := TRUE;
                    END_IF;
            END_CASE;
        END_IF;
    END_IF;
END_FOR;

// 6. 🧾 Agrégat des checks de l'étape
AllChecksLatched := TRUE;
AnyCheckFailedLocal := FALSE;
FailedCheckIdxLocal := 0;
FailedCheckSlotLocal := 0;
FOR Jdx := 1 TO GVL_PLC_Tests_Const.MaxChecksPerStep DO
    Kdx := StepTable[CurrentStepId].CheckIdx[Jdx];
    IF Kdx &gt; 0 THEN
        IF CheckFailed[Jdx] AND NOT AnyCheckFailedLocal THEN
            AnyCheckFailedLocal := TRUE;
            FailedCheckIdxLocal := Kdx;
            FailedCheckSlotLocal := Jdx; // 🔧 REX : slot RÉEL du check fautif (pas un index figé)
        ELSIF NOT CheckPassed[Jdx] THEN
            AllChecksLatched := FALSE;
        END_IF;
    END_IF;
END_FOR;

// 7. 📸 Verdict
VerdictReached := FALSE;
IF AnyCheckFailedLocal THEN
    VerdictReached := TRUE;
    VerdictPassedLocal := FALSE;
    VerdictReasonLocal := E_TestFailReason.FAIL_CHECK;
    VerdictCheckIdxLocal := FailedCheckIdxLocal;
    // 🔒 Défense en profondeur avant indexation du snapshot fautif.
    IF FailedCheckSlotLocal &gt;= 1 THEN
        IF FailedCheckSlotLocal &lt;= GVL_PLC_Tests_Const.MaxChecksPerStep THEN
            VerdictObsBoolLocal := ObsBoolArr[FailedCheckSlotLocal];
            VerdictObsDintLocal := ObsDintArr[FailedCheckSlotLocal];
            VerdictObsRealLocal := ObsRealArr[FailedCheckSlotLocal];
        ELSE
            VerdictObsBoolLocal := FALSE;
            VerdictObsDintLocal := 0;
            VerdictObsRealLocal := 0.0;
        END_IF;
    ELSE
        VerdictObsBoolLocal := FALSE;
        VerdictObsDintLocal := 0;
        VerdictObsRealLocal := 0.0;
    END_IF;
ELSE
    StepTimer(IN := TRUE, PT := StepTable[CurrentStepId].TimeoutPT);
    IF AllChecksLatched THEN
        VerdictReached := TRUE;
        IF StepElapsed &lt; StepTable[CurrentStepId].MinPT THEN
            VerdictPassedLocal := FALSE;
            VerdictReasonLocal := E_TestFailReason.FAIL_WINDOW_EARLY;
            VerdictCheckIdxLocal := 0;
        ELSE
            VerdictPassedLocal := TRUE;
            VerdictReasonLocal := E_TestFailReason.FAIL_NONE;
            VerdictCheckIdxLocal := 0;
        END_IF;
        VerdictObsBoolLocal := ObsBoolArr[1];
        VerdictObsDintLocal := ObsDintArr[1];
        VerdictObsRealLocal := ObsRealArr[1];
    ELSIF StepTimer.Q THEN
        VerdictReached := TRUE;
        VerdictPassedLocal := FALSE;
        VerdictReasonLocal := E_TestFailReason.FAIL_TIMEOUT;
        VerdictCheckIdxLocal := 0;
        VerdictObsBoolLocal := FALSE;
        VerdictObsDintLocal := 0;
        VerdictObsRealLocal := 0.0;
    END_IF;
END_IF;

IF NOT VerdictReached THEN
    RETURN; // ⏳ Toujours en attente, rien à publier ce scan
END_IF;

// 8. ➡️ Résolution de l'étape suivante — cantonnement de cas ICI (audit v1.0 C2)
IF VerdictPassedLocal THEN
    NextCandidate := StepTable[CurrentStepId].NextOnPass;
ELSIF StepTable[CurrentStepId].FailAction = E_TestFailAction.FAIL_ABORT_SUITE THEN
    NextCandidate := 0;
ELSE
    NextCandidate := StepTable[CurrentStepId].NextOnFail;
END_IF;

// 🔒 Aucun accès StepTable[0] : CODESYS peut évaluer tous les opérandes de AND.
IF NextCandidate &lt;&gt; 0 THEN
    IF NextCandidate &lt; 1 OR NextCandidate &gt; GVL_PLC_Tests_Const.MaxSteps THEN
        Busy := FALSE;
        RunDone := TRUE;
        AnyFailed := TRUE;
        ActiveStimulusId := 0;
        ConfigError := TRUE;
        ConfigErrorStepId := NextCandidate;
        TerminalState := E_TestTerminalState.TEST_TERMINAL_CONFIG_ERROR;
        RETURN;
    END_IF;
    // Un cas ciblé ne déborde jamais sur le cas suivant.
    IF CaseId &lt;&gt; 0 THEN
        IF StepTable[NextCandidate].CaseId &lt;&gt; CaseId THEN
            NextCandidate := 0;
        END_IF;
    END_IF;
END_IF;

// 9. 🧾 Publication du verdict pour FB_TranslationReportFinalizer
StepVerdict := TRUE;
VerdictStepId := CurrentStepId;
VerdictCaseId := CurrentCaseId;
VerdictPassed := VerdictPassedLocal;
VerdictFailReason := VerdictReasonLocal;
VerdictFailedCheckIdx := VerdictCheckIdxLocal;
VerdictDuration := StepElapsed;
VerdictObservedBool := VerdictObsBoolLocal;
VerdictObservedDint := VerdictObsDintLocal;
VerdictObservedReal := VerdictObsRealLocal;

IF NOT VerdictPassedLocal THEN
    AnyFailed := TRUE;
END_IF;

// 10. 🔁 Transition bornée (garde runtime contre tout cycle résiduel)
TransitionCount := TransitionCount + 1;
IF TransitionCount &gt; GVL_PLC_Tests_Const.MaxSteps THEN
    Busy := FALSE;
    RunDone := TRUE;
    AnyFailed := TRUE;
    ActiveStimulusId := 0;
    ConfigError := TRUE;
    ConfigErrorStepId := CurrentStepId;
    TerminalState := E_TestTerminalState.TEST_TERMINAL_CONFIG_ERROR;
    RETURN;
END_IF;
CurrentStepId := NextCandidate;
StepStarted := FALSE;
IF NextCandidate = 0 THEN
    Busy := FALSE;
    RunDone := TRUE;
    ActiveStimulusId := 0; // 🛡️ Garantie structurelle — double garantie avec FB_TranslationTestCleanup
    IF AnyFailed THEN
        TerminalState := E_TestTerminalState.TEST_TERMINAL_FAILED;
    ELSE
        TerminalState := E_TestTerminalState.TEST_TERMINAL_DONE;
    END_IF;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">944364f9-6eb8-4f19-a71a-d7c61b6747a3_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 FB_TranslationStepExecutor — Exécution étape/check Translation M3
///───────────────────────────────────────────────────────────────
///🎯 Responsabilité UNIQUE : faire progresser UNE suite de tests
///Translation, étape par étape (Dwell → Checks → Timeout/MinPT →
///verdict → étape suivante), en respectant le cantonnement à un
///seul cas (CaseId 1..6) ou à l'enchaînement complet (CaseId=0).
///N'écrit AUCUNE variable GVL, ne construit AUCUNE table (voir
///FB_TranslationTestPlan) et n'assemble AUCUN rapport (voir
///FB_TranslationReportFinalizer, qui consomme StepVerdict/Verdict*).
///🆕 Tranche verticale NEUVE Translation (2026-07-22) — n'instancie NI
///FB_TestSequencer NI FB_TestCheck/FB_Timeout (anciennes BRICKS) :
///logique de check réécrite ici, restreinte aux 3 Kind / 2 Mode
///réellement utilisés par les 6 TC Translation (voir FB_TranslationTestPlan).
///🔒 Cantonnement de cas (remplace le FirstStepId manipulé par le
///manager, audit v1.0 C2) : CaseId est résolu en 1er step via
///CaseTable UNIQUEMENT ici (jamais exposé par FB_TranslationValidation).
///Toute étape suivante qui change de CaseId alors qu'un cas est
///ciblé (CaseId&lt;&gt;0) termine proprement le run (NextStepId:=0).
///═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_TranslationStepExecutor
VAR_INPUT
	///Front : résout CaseId -&gt; 1er step (CaseTable) et démarre
	Start: BOOL;
	///Niveau : arrêt immédiat propre
	Abort: BOOL;
	///0 = toutes les cases (1..6) ; 1..6 = case ciblée uniquement
	CaseId: INT;
END_VAR
VAR_OUTPUT
	Busy: BOOL;
	///Fin de run (niveau, tenu jusqu'au prochain Start)
	RunDone: BOOL;
	AnyFailed: BOOL;
	///🛡️ Garde-fou runtime (Plan valide déjà statiquement)
	ConfigError: BOOL;
	ConfigErrorStepId: INT;
	CurrentStepId: INT;
	CurrentCaseId: INT;
	///0 GARANTI sur tout chemin terminal (Done/Abort/ConfigError)
	ActiveStimulusId: INT;
	StepElapsed: TIME;
	TerminalState: E_TestTerminalState;
	///🧾 Verdict d'étape — pulse 1 scan, consommé par FB_TranslationReportFinalizer
	StepVerdict: BOOL;
	VerdictStepId: INT;
	VerdictCaseId: INT;
	VerdictPassed: BOOL;
	VerdictFailReason: E_TestFailReason;
	VerdictFailedCheckIdx: INT;
	VerdictDuration: TIME;
	VerdictObservedBool: BOOL;
	VerdictObservedDint: DINT;
	VerdictObservedReal: REAL;
END_VAR
VAR_IN_OUT
	StepTable: ARRAY[1..GVL_PLC_Tests_Const.MaxSteps] OF ST_TestStepConfig;
	CheckTable: ARRAY[1..GVL_PLC_Tests_Const.MaxChecks] OF ST_TestCheckConfig;
	CaseTable: ARRAY[1..GVL_PLC_Tests_Const.MaxTestCases] OF ST_TestCaseConfig;
	ProbeBool: ARRAY[1..GVL_PLC_Tests_Const.MaxProbeBool] OF BOOL;
	ProbeDint: ARRAY[1..GVL_PLC_Tests_Const.MaxProbeDint] OF DINT;
	ProbeReal: ARRAY[1..GVL_PLC_Tests_Const.MaxProbeReal] OF REAL;
END_VAR
VAR
	StartTrig: R_TRIG;
	StepStarted: BOOL;
	DwellTimer: TON;
	StepTimer: TON;
	StableTimers: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF TON;
	CheckPassed: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF BOOL;
	CheckFailed: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF BOOL;
	InstantEvaluated: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF BOOL;
	ObsBoolArr: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF BOOL;
	ObsDintArr: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF DINT;
	ObsRealArr: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF REAL;
	Jdx, Kdx: INT;
	ProbeIdx: INT;
	Cond: BOOL;
	AllChecksLatched: BOOL;
	AnyCheckFailedLocal: BOOL;
	FailedCheckIdxLocal: INT;
	///Slot RÉEL (Jdx, 1..MaxChecksPerStep) du check fautif
	FailedCheckSlotLocal: INT;
	///Verdict de l'étape (émis au plus une fois par scan)
	VerdictReached: BOOL;
	VerdictPassedLocal: BOOL;
	VerdictReasonLocal: E_TestFailReason;
	VerdictCheckIdxLocal: INT;
	VerdictObsBoolLocal: BOOL;
	VerdictObsDintLocal: DINT;
	VerdictObsRealLocal: REAL;
	NextCandidate: INT;
	///Garde anti-cycle runtime, bornée par MaxSteps
	TransitionCount: INT;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">944364f9-6eb8-4f19-a71a-d7c61b6747a3_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">416</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">bb0fb193-0050-4ddb-b61c-816718e8aa15</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">Logique API</Single>
        <Single Type="string">Application</Single>
