            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Scale) ===

// 🧮 Écart signé sûr : conversion DINT AVANT soustraction (§3.1) — jamais l'inverse
RawDiff := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(HomingRefRaw);

// 📏 Formule fixe points → mètres (Partie10 §2), garde division par zéro
IF PointsPerRev &gt; 0 THEN
    CablePosM := DINT_TO_REAL(RawDiff) * (CableM_PerRev / UDINT_TO_REAL(PointsPerRev));
ELSE
    CablePosM := 0.0;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">744ec130-f116-4d71-a3a0-ab904de15e1a_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ FB_Encoder_Scale — Mise à l'échelle points → mètres (1 par treuil)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Calcul de la position câble en mètres par conversion arithmétique signée
///   🔒 Polarité : CablePosM signée (+ enroulé, - sous l'eau)
///   🔌 Architecture : Convertisseur de mesure unitaire par treuil
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
///   =======================================================================
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Scale) ===
FUNCTION_BLOCK FB_Encoder_Scale
VAR_INPUT
	///=== DONNEES ENTREE &amp; REFERENCES BRUTES ===
	///--&gt; [HW]  Position brute codeur (sortie FB_Encoder_Abs, gelee sur doute)
	RawPos: UDINT;
	///--&gt; [CFG] Reference brute figee au dernier homing (ST_Encoder_Calib)
	HomingRefRaw: UDINT;
	///=== PARAMETRES &amp; RATIOS DE CONVERSION ===
	///--&gt; [CFG] Developpement cable par tour tambour (m/tour)
	CableM_PerRev: REAL := 2;
	///--&gt; [CFG] Resolution codeur (pts/tour)
	PointsPerRev: UDINT := 8192;
END_VAR
VAR_OUTPUT
	///=== MESURE CONVERTIE ===
	///&lt;-- [DIAG] Position cable en metres (+ enroule, - sous l'eau)
	CablePosM: REAL;
END_VAR
VAR
	///=== CALCULS INTERNES ===
	///. [LOC] Ecart signe RawPos - HomingRefRaw
	RawDiff: DINT;
END_VAR
</Single>
