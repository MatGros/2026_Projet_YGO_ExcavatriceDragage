            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎮 ST_WinchCmd — Commandes IHM pour un Treuil M1/M2
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné au pilotage manuel et maintenance du treuil depuis l'IHM.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_WinchCmd :
STRUCT
	///⬆️ Mouvement montee maintenu (mode boutons IHM, MAINT_N1 accessible)
	BtnUp: BOOL;
	///⬇️ Mouvement descente maintenu (mode boutons IHM, MAINT_N1 accessible)
	BtnDown: BOOL;
	///🔑 Demande reset exposée par treuil ; agrégée dans le reset domaine partagé
	BtnReset: BOOL;
	///🎯 Homing nominal si Couplé, unitaire si M1/M2 sélectionné en MAINT_N2
	BtnHome: BOOL;
	///🔓 Confirmation de cohérence au démarrage
	BtnConfirmCoherence: BOOL;
	///Bouton IHM inhibition treuil — mise en service,
	BtnInhibit: BOOL;
	///Force le homing à 0 m (points codeur centre),
	BtnHomingAtZero: BOOL;
	///Autorisation MAINTENUE de dépasser le FDC
	BtnOverrideTopSoftware: BOOL;
END_STRUCT
END_TYPE
</Single>
