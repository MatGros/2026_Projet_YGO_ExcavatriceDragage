            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📤 FB_Safety_EmergencyOutput — Pilote Physique de Sécurité
///   ───────────────────────────────────────────────────────────────
///   📄 Rôle : Transmet les ordres de sécurité logiques vers les 
///      sorties physiques de l'automate (relais d'AU A/B/Impulsion).
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Safety_EmergencyManagementOutput
VAR_INPUT
	///Active le pilote
	Enable: BOOL;
	///Ordres logiques reçus du bloc logique
	Cmd: ST_EmergencyManagementCmd;
END_VAR
VAR_OUTPUT
	///Vers le relais de coupure physique A
	PowerCutOff_A_RQ: BOOL;
	///Vers le relais de coupure physique B
	PowerCutOff_B_RQ: BOOL;
	///Vers le contacteur d'impulsion de réarmement
	EmergencyArming_RQ: BOOL;
END_VAR
</Single>
