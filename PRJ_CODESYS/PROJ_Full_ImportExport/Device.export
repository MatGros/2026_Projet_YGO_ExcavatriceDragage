        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Safety_EmergencyManagement — Composite &amp; Façade Publique
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Façade publique, instance unique ; câblage interne Logic/Output &amp; exposition des bus d'état
///   🧩 Architecture : Câblage interne Logic/Output &amp; exposition des bus d'état
///   📄 Docs : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle/FB_Safety_EmergencyManagement_v1.1.md
///            DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.0.md
///            DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
FUNCTION_BLOCK FB_Safety_EmergencyManagement
VAR_INPUT
	///Active la surveillance
	Enable: BOOL;
	///Front acquittement défauts
	Reset: BOOL;
	///Demande de réarmement (BtnEmergencyArming)
	ArmRequest: BOOL;
	///Retour physique boucle d'urgence amont contacteur
	EmergencyChainClosed: BOOL;
	///Confirmation contacteur de puissance principal
	PowerContactorEngaged: BOOL;
	///Requête de coupure logique issue des métiers
	PowerCutOffRequest: BOOL;
	///Commande d'ouverture d'urgence depuis l'IHM
	BtnEmergencyCutOff: BOOL;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: RedundancyTestFailed, bit1: EmergencyArmingFailed, bit3: StartupFail
	ErrorId: WORD;
	///⚡ Sorties physiques (polarité maintien explicite)
	///Sortie de pilotage canal A (TRUE = voie maintenue, FALSE = coupure)
	MaintainA_RQ: BOOL;
	///Sortie de pilotage canal B (TRUE = voie maintenue, FALSE = coupure)
	MaintainB_RQ: BOOL;
	///Impulsion réarmement physique (1s)
	ArmPulse_RQ: BOOL;
	///🚦 Bus d'état public (AF §8.2)
	///ChainOk, ContactorOk, Step, Armable, ArmingBusy
	State: ST_Safety_Emergency_State;
	///Error, ErrorId, Redundancy, ArmFailed, Lockout
	Diag: ST_Safety_Emergency_Diag;
	///🩺 Diagnostics scalaires (rétrocompatibilité PRG_10/GVL_Global)
	ArmingSeqStep: INT;
	RedundancyTestFailed: BOOL;
	EmergencyArmingFailed: BOOL;
	EmergencyArmingLockoutActive: BOOL;
END_VAR
VAR
	///🧱 Composition interne des sous-blocs
	Logic: FB_Safety_EmergencyManagementLogic;
	Output: FB_Safety_EmergencyManagementOutput;
END_VAR
</Single>
