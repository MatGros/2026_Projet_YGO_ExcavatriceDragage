      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔄 ST_ChainCycleSemiAuto — Diagnostic chronologique Séquenceur Semi-Auto
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Vue dépannage / Watch CODESYS pour le cycle semi-automatique
///   📄 Doc métier : DOC/AF/AF_Partie-14_Fonction_Troubleshooting/FB_TroubleshootingView_v1.2.md
///   🔒 Sécurité : 100% lecture seule / diagnostic d'observation
///   =======================================================================
TYPE ST_ChainCycleSemiAuto :
STRUCT
	///🚦 1. Conditions d'engagement et autorisations
	///1 = Mode arbitré SEMI_AUTO actif | 0 = Autre mode
	Idx101_ModeSemiAutoActive: BOOL;
	///1 = Chaîne de sécurité OK (PowerContactorEngaged)
	Idx102_PowerAndSafetyOk: BOOL;
	///1 = Liaison IHM&lt;-&gt;PLC valide
	Idx103_HeartbeatIhmOk: BOOL;
	///1 = Bouton homme-mort armé (fenêtre 3s active)
	Idx104_DeadmanArmed: BOOL;
	///1 = Permis mouvement armé (manche hors zone neutre)
	Idx105_MancheDeflechi: BOOL;
	///1 = Codeurs treuils M1 et M2 référencés
	Idx106_HomedM1M2: BOOL;
	///1 = Demande Start reçue (IHM)
	Idx107_StartCycleRequest: BOOL;
	///1 = Demande Abort reçue (IHM)
	Idx108_AbortCycleRequest: BOOL;
	///🔄 2. État du Séquenceur
	///1 = Séquenceur prêt à démarrer
	Idx201_Ready: BOOL;
	///1 = Cycle en cours d'exécution
	Idx202_Busy: BOOL;
	///1 = Cycle terminé avec succès
	Idx203_Done: BOOL;
	///1 = Défaut ou anomalie bloquante sur le cycle
	Idx204_Error: BOOL;
	///Code d'erreur interne FB_Cycle
	Idx205_ErrorId: WORD;
	///Étape courante (X0 à X13 + STABILIZING)
	Idx206_Step: E_CycleStep;
	///Libellé explicite de l'étape
	Idx207_StepStr: STRING(40);
	///Étape mémorisée lors du dernier défaut
	Idx208_StepAtError: E_CycleStep;
	///🎯 3. Consignes &amp; Feedbacks Opérationnels
	///Cible translation sélectionnée (1=Trémie, 3=P1)
	Idx301_TargetPosition: INT;
	///Profondeur de consigne (m)
	Idx302_TargetDepth_M: REAL;
	///1 = Détection contact fond Kobold
	Idx303_KoboldBottomTouch: BOOL;
	///1 = Alerte écart de vitesse M1/M2 active
	Idx304_SpeedMismatchActive: BOOL;
	///1 = Limite légale atteinte (descente bloquée)
	Idx305_LimitLegalReached: BOOL;
	///1 = Erreur de synchronisme M1/M2
	Idx306_WinchSyncError: BOOL;
END_STRUCT
END_TYPE
</Single>
