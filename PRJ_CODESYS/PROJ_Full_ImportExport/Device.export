            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Winch_Demandes :
STRUCT
	///[pts] Bruts convertisseur (-2048 à +2048)
	Idx201_JoyRawPhysical_ANA: INT;
	///[%] Consigne Joystick (-100% à +100%)
	Idx202_JoyScaledPhysical_Pct: REAL;
	///1 = Appui Bouton Montée IHM | 0 = Relâché
	Idx203_HmiManualCmd_BtnUp: BOOL;
	///1 = Appui Bouton Descente IHM | 0 = Relâché
