          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639223207766350576</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

IF NOT Enable THEN
    MaintainA_RQ   := FALSE;
    MaintainB_RQ   := FALSE;
    ArmPulse_RQ    := FALSE;

    State.ChainOk        := FALSE;
    State.ContactorOk    := FALSE;
    State.Step           := 0;
    State.Armable        := FALSE;
    State.ArmingBusy     := FALSE;

    Diag.Error                := FALSE;
    Diag.ErrorId              := 16#0000;
    Diag.RedundancyTestFailed := FALSE;
    Diag.ArmFailed            := FALSE;
    Diag.LockoutActive        := FALSE;
    RETURN;
END_IF;

// ⚡ Sorties physiques — écriture directe des ordres logiques
MaintainA_RQ := Cmd.MaintainA_Cmd;
MaintainB_RQ := Cmd.MaintainB_Cmd;
ArmPulse_RQ  := Cmd.ArmPulse_Cmd;

// 🚦 Bus d'état public
State.ChainOk        := ChainOk;
State.ContactorOk    := ContactorOk;
State.Step           := ArmingStep;
State.Armable        := Armable;
State.ArmingBusy     := ArmingBusy;

// 🛡️ Bus diagnostic public
Diag.Error                := Error;
Diag.ErrorId              := ErrorId;
Diag.RedundancyTestFailed := RedundancyTestFailed;
Diag.ArmFailed            := ArmFailed;
Diag.LockoutActive        := LockoutActive;
</Single>
            <Single Name="LineInfoPersistence" Type="string">d3f89721-8269-5526-aac8-48009a2f16a2_Impl_LineIds</Single>
