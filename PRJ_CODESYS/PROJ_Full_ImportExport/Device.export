      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// Détection du comportement (Accélération vs Décélération)
IF (Target &gt; 0.0 AND Target &gt; Current) OR (Target &lt; 0.0 AND Target &lt; Current) THEN
    StepX := AccelRate * CycleTimeS; // S'éloigne du zéro
ELSE
    StepX := DecelRate * CycleTimeS; // Retourne vers le zéro
END_IF;

// Application de la rampe
IF Current &lt; Target THEN
    Current := Current + StepX;
    IF Current &gt; Target THEN Current := Target; END_IF;
ELSIF Current &gt; Target THEN
    Current := Current - StepX;
    IF Current &lt; Target THEN Current := Target; END_IF;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">23e9e94e-7410-4b07-b9b0-4899f0fa4662_Impl_LineIds</Single>
