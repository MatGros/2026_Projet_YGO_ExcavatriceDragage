        <Single Name="Timestamp" Type="long">639237203750138010</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

{region "§1 Lissage anti-clignotement"}
// Défaut critique : affichage immédiat, le TON est remis à zéro (aucune latence).
IF ForceInstant THEN
    Text := NewText;
    TonHold(IN := FALSE);
ELSE
    // Warning / état : le texte ne change qu'après maintien min (HoldTime).
    // Un signal qui oscille plus vite que HoldTime → texte stable.
    TonHold(IN := (NewText &lt;&gt; Text), PT := HoldTime);
    IF TonHold.Q THEN
        Text := NewText;
    END_IF;
END_IF;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">7fcaec66-d8eb-497d-a5af-ee1f19c5c0be_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧊 FB_AntiFlickerText — Lissage anti-clignotement d'un texte IHM
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-07_Interface_IHM_v2.2.md §5.3
///   🎯 Responsabilité : maintient un texte warning/état un temps minimum
///      avant de laisser le contenu changer, et laisse passer en direct
///      (sans maintien) les messages critiques (défauts AU/puissance).
///   🛡️ Sécurité : l'action de sécurité reste instantanée — ce FB ne
///      retarde jamais un texte, il ne fait que stabiliser l'affichage.
///      Il n'a aucun effet sur la machine.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_AntiFlickerText
VAR_INPUT
	///--&gt; [CMD] Texte candidat à afficher
	NewText: STRING(120);
	///--&gt; [CMD] TRUE = afficher immédiatement (défaut critique), sans maintien
	ForceInstant: BOOL;
	///--&gt; [CFG] Durée de maintien min avant changement (AF-07 §5.3)
	HoldTime: TIME := TIME#500ms;
END_VAR
VAR_OUTPUT
	///&lt;-- [STAT] Texte stabilisé exposé à l'IHM
	Text: STRING(120);
END_VAR
VAR
	///. [LOC] Temporisation de maintien
	TonHold: TON;
END_VAR
</Single>
