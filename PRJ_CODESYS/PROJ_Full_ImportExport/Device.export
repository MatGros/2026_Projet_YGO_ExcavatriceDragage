          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎮 ST_WinchCmdDemand — Demande de commande treuil (depuis cycle/sequenceur)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-04_Mode_SemiAuto_Sequenceur_v2.0.md
///            DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
///   🎯 Demande de mouvement pour treuil M1 ou M2 (depuis FB_Cycle).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_WinchCmdDemand :
STRUCT
	///TRUE = rampe accélération, FALSE = rampe décélération
	StartStop: BOOL;
	///-1 = Descente, 0 = Arrêt, +1 = Montée
	Direction: INT;
	///Consigne vitesse % (0.0 .. 100.0)
	SpeedPct: REAL;
END_STRUCT
END_TYPE
</Single>
