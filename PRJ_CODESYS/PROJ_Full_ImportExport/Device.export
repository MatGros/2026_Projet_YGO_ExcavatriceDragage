          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ST_TranslationCfg — Configurations et paramètres réglables pour Translation M3
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné au paramétrage depuis l'IHM (RETAIN) — même patron que ST_WinchCfg.
///   📄 Vitesses de ralentissement d'approche réglables depuis l'IHM (RETAIN), même patron que ST_WinchCfg.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_TranslationCfg :
STRUCT
	///🐢 Vitesse réduite d'approche Trémie (Hz), déclenchée par capteur PV, Direction=1
	CfgApproachSpeedTremie_Hz: REAL := 10;
	///🐢 Vitesse réduite d'approche Maintenance (Hz), déclenchée par capteur P1, Direction=-1
	CfgApproachSpeedMaintenance_Hz: REAL := 10;
	///🐢 Vitesse réduite d'approche P1 (Hz), déclenchée par capteur P2, Direction=-1
	CfgApproachSpeedP1_Hz: REAL := 10;
	///Flag restauration boot (défaut FALSE non ambigu) — même patron que ST_WinchCfg
	///🚦 TRUE = config restaurée depuis GVL_PERSISTENT ce boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
