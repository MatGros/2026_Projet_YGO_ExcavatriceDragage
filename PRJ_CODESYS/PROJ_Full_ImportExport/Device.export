      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 ST_fbEncoder_Measurement — Mesures codeur conditionnées (1 sous-DUT par treuil)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Regroupement des mesures et faits de la chaîne codeur d'un treuil (Abs → Scale → Safety → Speed)
///   🔌 Interface : Interface de mesure normalisée pour PRG_02_Acquisition
///   📄 Doc métier : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.4.md
///   =======================================================================
TYPE ST_fbEncoder_Measurement :
STRUCT
	///=== DONNEES BRUTES &amp; STATUT BUS ===
	///Position brute codeur (gelee si EncoderAvailable=FALSE)
	RawPos: UDINT;
	///TRUE = bus/esclave EtherCAT operationnel et disponible
	EncoderAvailable: BOOL;
	///=== MESURES DE POSITION CABLE ===
	///Position cable (m, signee, + enroule)
	CablePosM: REAL;
	///Position cable instantanee validee par EncoderIncoherent (m)
	CablePosMSafe: REAL;
	///TRUE = incoherence redemarrage ou hors bornes
	EncoderIncoherent: BOOL;
	///=== MESURES DE VITESSE CABLE ===
	///Vitesse absolue sur fenetre glissante (m/s)
	Speed_Mps: REAL;
	///Vitesse signee (m/s, + montee, - descente)
	SignedSpeed_Mps: REAL;
	///TRUE si 6 echantillons valides sur au moins 50 ms
	SpeedValid: BOOL;
	///=== STATUTS DES SOUS-FB &amp; REFERENCE ===
	///Défaut FB_Encoder_Homing (état du référencement)
	HomingFault: ST_Fault;
	///Cycle FB_Encoder_Homing (Busy/Done)
	HomingLifecycle: ST_Lifecycle;
	///Défaut FB_Encoder_Abs (état acquisition bus)
	AbsFault: ST_Fault;
	///Reference brute du dernier homing reussi (re-expose)
	HomingRefRaw: UDINT;
END_STRUCT
END_TYPE
</Single>
