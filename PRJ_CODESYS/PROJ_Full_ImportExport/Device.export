      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

T := TIME_TO_REAL(TimeConst) / 1000.0; // ms → s

IF T &lt;= 0.0 OR CycleTimeS &lt;= 0.0 THEN
    ValueOut := ValueIn;
ELSE
    Alpha    := CycleTimeS / (T + CycleTimeS);
    ValueOut := Alpha * ValueIn + (1.0 - Alpha) * ValueOut;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">564cb076-094f-527b-93bc-caad3ea68d7f_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔁 FB_Filter_PT1 — Filtre passe-bas premier ordre (PT1 numérique)
///   ───────────────────────────────────────────────────────────────
///   📄 Extrait depuis le projet CODESYS (Device.export, JOYSTICK/)
///   🎯 Filtre exponentiel discret : y[k] = α·x[k] + (1-α)·y[k-1]
///      où α = CycleTimeS / (T + CycleTimeS), T = TimeConst en secondes.
///   ⚠️ Si TimeConst = 0 ou CycleTimeS = 0, sortie = entrée (pass-through).
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Filter_PT1
VAR_INPUT
	//// Consigne brute entrée
	ValueIn: REAL;
	//// Constante de temps du filtre
	TimeConst: TIME;
	//// Temps de cycle réel en secondes
	CycleTimeS: REAL;
END_VAR
VAR_OUTPUT
	//// Consigne filtrée sortie
	ValueOut: REAL;
END_VAR
VAR
	T: REAL;
	Alpha: REAL;
END_VAR
</Single>
