          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_TranslationState — États et retours IHM pour la Translation M3
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des retours et mesures de la translation M3.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_TranslationState :
STRUCT
	///🚦 États &amp; diagnostics FB_Translation
	///🤖 État de l'automate interne (FB_Translation)
	FBState: E_State;
	///🟢 Translation prêt à fonctionner
	Ready: BOOL;
	///⚙️ Mouvement en cours
	Busy: BOOL;
	///✅ Mouvement terminé avec succès
	Done: BOOL;
	///Translation en défaut
	Error: BOOL;
	///❌ Code du défaut actif
	ErrorId: WORD;
	///🔓 Commande de desserrage du frein (lecture seule, TRUE = desserré)
	BrakeCmd: BOOL;
	///🔌 Retour physique direct : TRUE = frein OUVERT (desserré)
	BrakeFeedback: BOOL;
	///🎯 Capteur de détection de la position cible atteint
	PositionSensorTarget: BOOL;
	///✅ Positionneur : cible sélectionnée atteinte (non mémorisé)
	PositionReached: BOOL;
	///🕹️ Axe X fonctionnel -100..+100 %, 0 = neutre ; animation IHM M3
	JoystickDeflection_Pct: REAL;
	///📈 Fréquence de sortie réelle du variateur (Hz)
	DriveActualFreq_Hz: REAL;
	///⚙️ Mot de commande AC600 réellement appliqué
	DriveControlWord: WORD;
	///🎯 Consigne fréquence réellement appliquée
	DriveFreqRef_Hz: REAL;
	///↔️ Sens arbitré : -1 / 0 / +1
	ActiveDirection: INT;
	///📊 Consigne active après arbitrage
	ActiveSpeedRef_Pct: REAL;
	///🛡️ État final _LD lecture seule
	FinalInterlockState: E_State;
	///🛡️ Cause finale mémorisée
	FinalInterlockReason: E_TranslationFinalInterlockReason;
	///🛡️ Défaut final mémorisé
	FinalInterlockError: BOOL;
	///🛡️ Bitfield final
	FinalInterlockErrorId: WORD;
	///🔌 Contacteur/bobine desserrage confirmé, pas frein mécanique
	BrakeCommandOpenConfirmed: BOOL;
	///⏱️ Écoulé watchdog 500ms
	FinalBrakeTimeoutElapsed: TIME;
	///🔌 Diagnostic variateur EtherCAT (décodé — pas de bit-masking côté IHM)
	///📡 Variateur M3 : communication prête (StatusWord bit7)
	DriveCommReady: BOOL;
	///⚡ Variateur M3 : puissance prête (StatusWord bit0)
	DrivePowerReady: BOOL;
	///📍 Mot capteurs et positions Translation M3
	PositionTremie: BOOL;
	PositionPV: BOOL;
	PositionP2: BOOL;
	PositionP1: BOOL;
	PositionMaintenance: BOOL;
	///: mot EXACT — front franc arrivée/cible (voir PositionXxx ci-dessus = cumulatif zone, réservé ralentissement)
	AtTremie: BOOL;
	AtPV: BOOL;
	AtP2: BOOL;
	AtP1: BOOL;
	AtMaintenance: BOOL;
	///📏 Position continue estimée en mètres (0.0 m Maint -&gt; +X m Trémie) — persistante, survit reboot
	EstimatedPosM3_M: REAL;
	///bit4=Trémie, bit3=PV, bit2=P2, bit1=P1, bit0=Maintenance
	SensorsWord: BYTE;
	SensorWordIncoherent: BOOL;
	LimitSwitchFwd: BOOL;
	LimitSwitchRev: BOOL;
	///Retour disjoncteur thermique moteur/variateur AC600 — diagnostic seul, l'AC600 se protège lui-même
	DriveThermalOk: BOOL;
	///🔓 TRUE = Autorise le déplacement vers la cible 4 (Maintenance) ; actif uniquement en mode MAINT_N2
	MaintenanceTargetEnable: BOOL;
	SimulationModeActive: BOOL;
	///: TRUE = translation bloquée, M1 ou M2 sous la hauteur mini requise
	HeightInterlockBlocking: BOOL;
END_STRUCT
END_TYPE
</Single>
