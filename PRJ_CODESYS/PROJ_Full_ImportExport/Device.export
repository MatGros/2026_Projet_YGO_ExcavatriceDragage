          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926768460280</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

IF RawIn &gt;= Neutral THEN
    Delta := INT_TO_REAL(10000 - Neutral);
    IF Delta &gt; 0.0 THEN
        OutPct := (INT_TO_REAL(RawIn - Neutral) / Delta) * 100.0;
    ELSE
        OutPct := 0.0;
    END_IF;
ELSE
    Delta := INT_TO_REAL(Neutral);
    IF Delta &gt; 0.0 THEN
        OutPct := (INT_TO_REAL(RawIn - Neutral) / Delta) * 100.0;
    ELSE
        OutPct := 0.0;
    END_IF;
END_IF;

IF ABS(OutPct) &lt;= Deadband THEN
    OutPct := 0.0;
END_IF;

// 🛡️ Limitation de plage : une valeur brute hors plage nominale ne doit jamais
// produire une consigne supérieure à ±100 %. Ce garde-fou protège les
// consommateurs en aval, notamment la translation M3.
OutPct := LIMIT(-100.0, OutPct, 100.0);
</Single>
            <Single Name="LineInfoPersistence" Type="string">ffa35cbd-fcf4-4890-9714-e14f901de022_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📐 FB_AxisScale — Mise à l'échelle d'un axe joystick Hall
///   ───────────────────────────────────────────────────────────────
///   📄 Extrait depuis le projet CODESYS (Device.export, JOYSTICK/)
///   🎯 Normalise une valeur brute (0..10000) par rapport au neutre calibré
///      et applique une zone morte en %.
///   Sortie : OutPct ∈ [-100.0 .. +100.0] (0.0 si dans la deadband)
///   ═══════════════════════════════════════════════════════════════
///   📄 Docs : DOC/AF_Partie-08_Fonction_Joystick_v1.3.md
FUNCTION_BLOCK FB_AxisScale
VAR_INPUT
	//// Valeur brute (0..10000)
	RawIn: INT;
	//// Point milieu calibré
	Neutral: INT;
	//// Zone morte en %
	Deadband: REAL;
END_VAR
VAR_OUTPUT
	//// Valeur finale (-100.0..100.0)
	OutPct: REAL;
END_VAR
VAR
	Delta: REAL;
END_VAR
</Single>
