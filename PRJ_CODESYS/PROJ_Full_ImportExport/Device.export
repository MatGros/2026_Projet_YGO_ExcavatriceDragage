            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224114392330382</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// 🛑 1. GATE
IF NOT Enable THEN
    Ready := FALSE; Busy := FALSE; Done := FALSE;
    State := E_State.DISABLED;
    CablePosMSafe := CablePosM;
    EncoderIncoherent := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
State := E_State.READY;

// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);

// 🌐 3. BYPASS GLOBAL
IF BypassGlobal THEN
    ErrorId := 16#0000;
END_IF;

// 🔍 4. SURVEILLANCE BORNAGE PHYSIQUE ABSOLU (bit0)
IF NOT BypassGlobal AND ((CablePosM &lt; PositionMinM) OR (CablePosM &gt; PositionMaxM)) THEN
    ErrorId := ErrorId OR 16#0001;
ELSE
    ErrorId := ErrorId AND 16#FFFE; (* Auto-clearing dès retour dans la plage *)
END_IF;

// 🔍 5. RELAIS INCOHÉRENCE REDÉMARRAGE (bit1)
IF NOT BypassGlobal THEN
    IF HomingSuspect THEN
        ErrorId := ErrorId OR 16#0002;
    ELSE
        ErrorId := ErrorId AND 16#FFFD;
    END_IF;
END_IF;

// 📏 6. TRANSMISSION DE LA MESURE (Toujours réelle, non figée)
CablePosMSafe := CablePosM;

// 📤 7. SORTIES ÉTAT &amp; SÉCURITÉ
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;

EncoderIncoherent := Error;
Busy := FALSE;
Done := FALSE;
</Single>
            <Single Name="LineInfoPersistence" Type="string">0c90e4c1-2f2d-4af3-9e44-92564c7d0e7c_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Encoder_Safety — Bornage physique &amp; surveillance cohérence
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md §3.6/§3.7
///   🎯 Rôle :
///      - Surveillance bornage absolu [-99.00 ; +99.00] m
///      - Relais de HomingSuspect (ErrorId bit1)
///      - Expose EncoderIncoherent (= Error) et transmet CablePosMSafe
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Encoder_Safety
VAR_INPUT
	///Active le bloc
	Enable: BOOL;
	///Acquittement défaut (front)
	Reset: BOOL;
	///Ligne puissance enclenchée
	PowerContactorEngaged: BOOL;
	///Mode d'exploitation
	Mode: E_Mode;
	///Position calculée (FB_Encoder_Scale)
	CablePosM: REAL;
	///Alerte incohérence redémarrage (FB_Encoder_Homing)
	HomingSuspect: BOOL;
	///Bornage physique bas
	PositionMinM: REAL := -99;
	///Bornage physique haut
	PositionMaxM: REAL := 99;
	///Mise en service : neutralise le défaut de bornage
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: Position hors bornes [-99..+99]m ; bit1: Incohérence boot (HomingSuspect)
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///Position câble instantanée (non figée)
	CablePosMSafe: REAL;
	///= Error — consommé par FB_Modes et IHM
	EncoderIncoherent: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
END_VAR
</Single>
