            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_WinchFinalInterlockReason :
(
	///Aucun blocage actif
	NONE := 0,
	///Absence confirmation ouverture frein &gt; 500ms
	BRAKE_COMMAND_NOT_CONFIRMED := 1,
	///Inhibition redemarrage actif
	RESTART_INHIBITED := 2
);
END_TYPE
</Single>
