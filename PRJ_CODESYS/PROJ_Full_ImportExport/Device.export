            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🛡️ FB_Safety_EmergencyManagement — Composite &amp; Façade Publique
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Façade publique, instance unique ; câblage interne Logic/Output &amp; exposition des bus d'état
///   🔒 Polarité : MaintainA/B_RQ en maintien (TRUE = voie saine)
///   🔌 Architecture : Composition interne Logic/Output
///   📄 Doc métier : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.1.md
///   =======================================================================
FUNCTION_BLOCK FB_Safety_EmergencyManagement
VAR_INPUT
	///=== COMMANDES &amp; CONSIGNES ===
	///--&gt; [CMD]  Active la surveillance (TRUE = autorise)
	Enable: BOOL;
	///--&gt; [CMD]  Front acquittement defauts
	Reset: BOOL;
	///--&gt; [CMD]  Demande de rearmement (BtnEmergencyArming)
	ArmRequest: BOOL;
	///--&gt; [SAFE] Requete de coupure logique issue des metiers
	PowerCutOffRequest: BOOL;
	///--&gt; [CMD]  Commande d'ouverture d'urgence depuis l'IHM
	BtnEmergencyCutOff: BOOL;
	///=== RETOURS MATERIELS (HW) ===
	///--&gt; [HW]   Retour physique boucle d'urgence amont contacteur
	EmergencyChainClosed: BOOL;
	///--&gt; [HW]   Confirmation contacteur de puissance principal
	PowerContactorEngaged: BOOL;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///&lt;-- [STAT] Sequence ou lockout en cours
	Busy: BOOL;
	///&lt;-- [STAT] Contacteur puissance confirme engage
	Done: BOOL;
	///=== DIAGNOSTIQUES &amp; ERREURS ===
	///&lt;-- [DIAG] Synthese defaut (TRUE = defaut actif)
	Error: BOOL;
	///&lt;-- [DIAG] Bitfield erreurs (bit0:Redundancy, bit1:Arming, bit3:Startup)
	ErrorId: WORD;
	///=== SORTIES PHYSIQUES (FAIL-SAFE) ===
	///&lt;-- [ACT]  Sortie pilotage canal A (TRUE = voie maintenue)
	MaintainA_RQ: BOOL;
	///&lt;-- [ACT]  Sortie pilotage canal B (TRUE = voie maintenue)
	MaintainB_RQ: BOOL;
	///&lt;-- [ACT]  Impulsion rearmement physique (1s)
	ArmPulse_RQ: BOOL;
	///=== BUS D'ETAT &amp; DIAGNOSTIC ===
	///&lt;-- [STAT] Bus d'etat public
	State: ST_Safety_Emergency_State;
	///&lt;-- [DIAG] Bus de diagnostic public
	Diag: ST_Safety_Emergency_Diag;
	///=== DIAGNOSTICS SCALAIRES (RETROCOMPATIBILITE) ===
	///&lt;-- [DIAG] Etape sequence rearmement (0=IDLE..6=Confirm)
	ArmingSeqStep: INT;
	///&lt;-- [DIAG] Defaut auto-test canal A ou B reste colle
	RedundancyTestFailed: BOOL;
	///&lt;-- [DIAG] Defaut rearmement contacteur puissance (timeout 2s)
	EmergencyArmingFailed: BOOL;
	///&lt;-- [DIAG] Verrouillage temporel 5s entre essais
	EmergencyArmingLockoutActive: BOOL;
END_VAR
VAR
	///=== SOUS-INSTANCES FB ===
	///* [INST] Machinerie d'etat et decision AU
	Logic: FB_Safety_EmergencyManagementLogic;
	///* [INST] Projection fail-safe vers sorties physiques
	Output: FB_Safety_EmergencyManagementOutput;
END_VAR
</Single>
