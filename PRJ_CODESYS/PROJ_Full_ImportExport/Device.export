{attribute 'strict' := ''}
TYPE E_OperatorAxis :
(
	///Aucun axe attendu (étape automatique ou arrêt)
	NONE := 0,
	///Axe X translation attendu
	JOYSTICK_X := 1,
	///Axe Y treuils / plongée attendu
	JOYSTICK_Y := 2,
	///Action bouton attendue (ex: validation, homing)
	BUTTON := 3
);
END_TYPE
</Single>
