            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ ST_fbBucket_Config — Configuration des offsets du benne
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure de paramétrage des décalages et anticipations benne
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   =======================================================================
TYPE ST_fbBucket_Config :
STRUCT
	///Ecart M1/M2 en metres benne ouvert (m)
	OffsetOpenM: REAL;
	///Ecart M1/M2 en metres benne ferme (m)
	OffsetCloseM: REAL;
	///Seuil de detection d'incoherence au boot (m)
	CoherenceLimitM: REAL;
	///Anticipation coupure commande fermeture (m)
	CloseAnticipationM: REAL := 1;
	///Anticipation coupure commande ouverture (m)
	OpenAnticipationM: REAL := 1.3;
END_STRUCT
END_TYPE
</Single>
