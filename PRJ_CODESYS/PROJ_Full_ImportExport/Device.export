            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_ChainContextGlobal :
STRUCT
	///Mode de marche actif (MANUEL, SEMI_AUTO, MAINT_N1, MAINT_N2)
	Idx101_ModeActive: E_Mode;
	///0 = Matériel Réel (Nominal) | 1 = SIMULATION ACTIVE ⚠️
	Idx102_SimulationEnabled: BOOL;
	///1 = Comm CANopen Joystick OK (Sain) | 0 = Perte Comm CAN
	Idx103_JoystickCommOk: BOOL;
	///1 = Pilotage par Joystick Hall | 0 = Pilotage par Boutons IHM
	Idx201_JoystickSelected: BOOL;
	///0 = Comm Réseau OK | 1 = BYPASS RÉSEAU ACTIF ⚠️
	Idx202_BypassNetworkGlobal: BOOL;
	///0 = Capteurs Actifs | 1 = AU MOINS 1 CAPTEUR SHUNTÉ ⚠️
	Idx203_BypassSensorsGlobal: BOOL;
	///1 = Boucle AU Matérielle Fermée (OK) | 0 = AU APPUYÉ
	Idx301_EmergencyChainClosed: BOOL;
	///1 = Puissance Armée | 0 = Puissance Coupée
	Idx302_PowerContactorEngaged: BOOL;
	///0 = Sain | 1 = AU MOINS UN SAFESTOP MÉTIER ACTIF
	Idx303_SafeStopActiveAny: BOOL;
	///0 = Sain | 1 = COUPURE GENERAL COLLAGE ACTIVEE
	Idx304_PowerCutOffActiveAny: BOOL;
	///1 = Liaison IHM Active | 0 = Perte Liaison IHM
	Idx401_HmiHeartbeatOk: BOOL;
	///1 = Séquenceur Auto en Cours | 0 = Repos
	Idx402_CycleAutoBusy: BOOL;
END_STRUCT
END_TYPE
</Single>
