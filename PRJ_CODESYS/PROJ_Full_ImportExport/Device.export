      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// Détection du comportement (Accélération vs Décélération)
// Classification par CÔTÉ DE ZÉRO + sens de déplacement, plus par signe brut de Target seul
// (robuste à une traversée de zéro rapide).
// 🛡️ Garde-fou : la rampe ne sort jamais de la plage normalisée ±100 %.
TargetLimited := LIMIT(-100.0, Target, 100.0);
Current := LIMIT(-100.0, Current, 100.0);

IF (Current &gt;= 0.0 AND TargetLimited &gt;= Current) OR (Current &lt;= 0.0 AND TargetLimited &lt;= Current) THEN
    StepX := AccelRate * CycleTimeS; // S'éloigne du zéro (reste du même côté, va plus loin)
ELSE
    StepX := DecelRate * CycleTimeS; // Retourne vers zéro, ou le traverse vers l'autre signe
END_IF;

// Application de la rampe
IF Current &lt; TargetLimited THEN
    Current := Current + StepX;
    IF Current &gt; TargetLimited THEN Current := TargetLimited; END_IF;
ELSIF Current &gt; TargetLimited THEN
    Current := Current - StepX;
    IF Current &lt; TargetLimited THEN Current := TargetLimited; END_IF;
END_IF;

// 🛡️ Limitation finale : même une valeur d'état déjà corrompue reste bornée.
Current := LIMIT(-100.0, Current, 100.0);
</Single>
            <Single Name="LineInfoPersistence" Type="string">2e0d5247-7675-56fe-94d4-1cdd52e2e6fb_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ FB_Ramp — Rampe d'accélération et décélération asymétrique
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Limitation de variation anti-à-coups (%/s) sur signal analogique
///   🔒 Polarité : Distingue l'éloignement de zéro (Accel) et le retour à zéro (Decel)
///   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.0.md §2
///   =======================================================================
FUNCTION_BLOCK FB_Ramp
VAR_INPUT
	///=== CONSIGNES ET TAUX DE RAMPE ===
	///--&gt; [CMD] Valeur cible visee (-100.0..+100.0 %)
	Target: REAL;
	///--&gt; [CFG] Taux d'acceleration (%/s)
	AccelRate: REAL;
	///--&gt; [CFG] Taux de deceleration (%/s)
	DecelRate: REAL;
	///--&gt; [CFG] Temps de cycle reel en secondes (dt)
	CycleTimeS: REAL;
END_VAR
VAR_OUTPUT
	///=== VALEUR RAMPEE ===
	///&lt;-- [STAT] Valeur courante amortie (-100.0..+100.0 %)
	Current: REAL;
END_VAR
VAR
	///=== CALCULS INTERNES ===
	///. [LOC] Pas de variation pour le cycle courant
	StepX: REAL;
	///. [LOC] Cible bornee a [-100.0, +100.0]
	TargetLimited: REAL;
END_VAR
</Single>
