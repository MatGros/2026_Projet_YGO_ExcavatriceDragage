      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ST_BypassCommun — Bypass maintenance GRANULAIRE, applicable aux 2 treuils à la fois
///   ───────────────────────────────────────────────────────────────
///   🎨 Distinct des bypass individuels M1/M2 (ST_BypassWinch)
///      un OUI ici lève la protection sur LES DEUX treuils simultanément (pilotage "both",
///      GVL_IHM.Commun.BtnWinchBothUp/Down), en OR avec le bypass individuel de chaque instance
///      (PRG_04_Treuils_Benne). Évite de devoir activer 2 fois le même bypass (M1 ET M2) avant un
///      pilotage groupé — SANS retirer les bypass individuels pour le pilotage à l'unité.
///      ⚠️ Ne remplace PAS les bypass individuels : les deux se combinent en OR, jamais l'un
///      n'entraîne la désactivation de l'autre.
///   🔒 Doctrine : actionnable UNIQUEMENT en MAINT_N2, RETAIN, jamais masque
///      les autres défauts du même bloc (voir REGISTRE_ACTIONS_Bypass_v1.0 (archive)).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BypassCommun :
STRUCT
	///🌐 Bypass Global Commun (toutes sécurités communes M1+M2)
	Global: BOOL;
	///⚠️ Bypass capteur mou de câble — capteur unique M1/M2, OR avec bypass individuel
	SlackCable: BOOL;
	///🚧 Bypass fin de course physique haute (capteur, bit5), OR avec bypass individuel
	TopLimitSwitch: BOOL;
	///: Bypass fin de course logiciel haut (position calculée), OR avec bypass individuel
	TopLimitSoftware: BOOL;
	///: Bypass limite basse physique (longueur câble), OR avec bypass individuel
	CableLimitSwitch: BOOL;
	///: Bypass limite légale de profondeur, OR avec bypass individuel
	LimitLegal: BOOL;
	///Initialisé au boot
	Initialized: BOOL;
END_STRUCT
END_TYPE
</Single>
