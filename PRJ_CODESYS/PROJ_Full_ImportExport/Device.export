        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

IF NOT Enable THEN
    PowerCutOff_A_RQ   := FALSE;
    PowerCutOff_B_RQ   := FALSE;
    EmergencyArming_RQ := FALSE;
    RETURN;
END_IF;

// Écriture directe des signaux logiques sur les sorties physiques (fail-safe)
PowerCutOff_A_RQ   := Cmd.PowerCutOff_A_Cmd;
PowerCutOff_B_RQ   := Cmd.PowerCutOff_B_Cmd;
EmergencyArming_RQ := Cmd.EmergencyArming_Cmd;
</Single>
