        <Single Name="Timestamp" Type="long">639224114393163709</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

// 🛑 1. Appels des instances internes
Logic(
    Enable := Enable,
    Reset := Reset,
    ArmRequest := ArmRequest,
    EmergencyChainClosed := EmergencyChainClosed,
    PowerContactorEngaged := PowerContactorEngaged,
    PowerCutOffRequest := PowerCutOffRequest,
    BtnEmergencyCutOff := BtnEmergencyCutOff
);

Output(
    Enable := Enable,
    Cmd := Logic.Cmd,
    ChainOk := EmergencyChainClosed,
    ContactorOk := PowerContactorEngaged,
    ArmingStep := Logic.ArmingSeqStep,
    Armable := Logic.Armable,
    ArmingBusy := Logic.ArmingBusy,
    Error := Logic.Error,
    ErrorId := Logic.ErrorId,
    RedundancyTestFailed := Logic.RedundancyTestFailed,
    ArmFailed := Logic.EmergencyArmingFailed,
    LockoutActive := Logic.EmergencyArmingLockoutActive
);

// 📤 2. Propagation des signaux vers les sorties du bloc parent
Ready := Enable AND NOT Logic.StartupFail;
Busy  := (Logic.ArmingSeqStep &lt;&gt; 0) OR Logic.EmergencyArmingLockoutActive;
Done  := PowerContactorEngaged;
Error := Logic.Error;
ErrorId := Logic.ErrorId;

// ⚡ Sorties physiques
MaintainA_RQ   := Output.MaintainA_RQ;
MaintainB_RQ   := Output.MaintainB_RQ;
ArmPulse_RQ    := Output.ArmPulse_RQ;

// 🚦 Bus publics
State := Output.State;
Diag  := Output.Diag;

// 🩺 Diagnostics scalaires (rétrocompatibilité)
ArmingSeqStep                := Logic.ArmingSeqStep;
RedundancyTestFailed         := Logic.RedundancyTestFailed;
EmergencyArmingFailed        := Logic.EmergencyArmingFailed;
EmergencyArmingLockoutActive := Logic.EmergencyArmingLockoutActive;
</Single>
            <Single Name="LineInfoPersistence" Type="string">f40a3643-3b0e-4f20-bb1e-9d2b35c30cec_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Safety_EmergencyManagement — Composite &amp; Façade Publique
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Façade publique, instance unique ; câblage interne Logic/Output &amp; exposition des bus d'état
///   🧩 Architecture : Câblage interne Logic/Output &amp; exposition des bus d'état
///   📄 Docs : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle/FB_Safety_EmergencyManagement_v1.1.md
///            DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.0.md
///            DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
FUNCTION_BLOCK FB_Safety_EmergencyManagement
VAR_INPUT
	///Active la surveillance
	Enable: BOOL;
	///Front acquittement défauts
	Reset: BOOL;
	///Demande de réarmement (BtnEmergencyArming)
	ArmRequest: BOOL;
	///Retour physique boucle d'urgence amont contacteur
	EmergencyChainClosed: BOOL;
	///Confirmation contacteur de puissance principal
	PowerContactorEngaged: BOOL;
	///Requête de coupure logique issue des métiers
	PowerCutOffRequest: BOOL;
	///Commande d'ouverture d'urgence depuis l'IHM
	BtnEmergencyCutOff: BOOL;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: RedundancyTestFailed, bit1: EmergencyArmingFailed, bit3: StartupFail
	ErrorId: WORD;
	///⚡ Sorties physiques (polarité maintien explicite)
	///Sortie de pilotage canal A (TRUE = voie maintenue, FALSE = coupure)
	MaintainA_RQ: BOOL;
	///Sortie de pilotage canal B (TRUE = voie maintenue, FALSE = coupure)
	MaintainB_RQ: BOOL;
	///Impulsion réarmement physique (1s)
	ArmPulse_RQ: BOOL;
	///🚦 Bus d'état public (AF §8.2)
	///ChainOk, ContactorOk, Step, Armable, ArmingBusy
	State: ST_Safety_Emergency_State;
	///Error, ErrorId, Redundancy, ArmFailed, Lockout
	Diag: ST_Safety_Emergency_Diag;
	///🩺 Diagnostics scalaires (rétrocompatibilité PRG_10/GVL_Global)
	ArmingSeqStep: INT;
	RedundancyTestFailed: BOOL;
	EmergencyArmingFailed: BOOL;
	EmergencyArmingLockoutActive: BOOL;
END_VAR
VAR
	///🧱 Composition interne des sous-blocs
	Logic: FB_Safety_EmergencyManagementLogic;
	Output: FB_Safety_EmergencyManagementOutput;
END_VAR
</Single>
