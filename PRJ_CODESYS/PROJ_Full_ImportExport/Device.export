      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_GrappinHMI — Données d'échange IHM pour le grappin
///   ───────────────────────────────────────────────────────────────
///   🎨 Intègre la configuration, l'état persistant et les commandes.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_GrappinHMI :
STRUCT
	///⚙️ Configurations &amp; Paramètres (Lecture/Écriture RETAIN)
	///🔧 Offsets Open/Close/Coherence
	Config: ST_GrappinConfig;
	///⏱️ Temps max pour l'ouverture/fermeture
	TimeoutDuration: TIME := TIME#30s0ms;
	///🚦 États &amp; Retours (Lecture seule)
	///🚥 État mémorisé (IsOpen, IsClosed, etc.)
	State: ST_GrappinState;
	///🤖 État de l'automate interne (FB_Grappin)
	FBState: E_State;
	///📐 Offset actif injecté dans la synchro
	ActiveOffsetM: REAL;
	///🛗 Commande Start/Stop forcée vers M2
	M2StartStop: BOOL;
	///🛗 Commande direction forcée vers M2
	M2Direction: INT;
	///🐢 Blocage vitesse rapide de M2
	M2ForceSlowSpeed: BOOL;
	///🟢 Bloc opérationnel
	Ready: BOOL;
	///⚙️ Mouvement d'ouverture/fermeture en cours
	Busy: BOOL;
	///✅ Mouvement terminé avec succès
	Done: BOOL;
	///🔴 Grappin en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut grappin
	ErrorId: WORD;
	///📏 REX 2026-07-07 : distance restante avant cible (m),
	RemainingTravelM: REAL;
	///🆕 REX 2026-07-08 : demande de fermeture active (image FB_Grappin) —
	CloseReq: BOOL;
	///🆕 REX 2026-07-08 : demande d'ouverture active (image FB_Grappin), même principe
	OpenReq: BOOL;
	///📊 REX 2026-07-07 : WinchM2.PositionM - ActiveOffsetM —
	M2PositionCorrected: REAL;
	///🪣 Bouton commande ouverture
	CmdOpen: BOOL;
	///🪣 Bouton commande fermeture
	CmdClose: BOOL;
	///🔑 Acquittement défaut grappin
	CmdReset: BOOL;
	///🆕 REX 2026-07-08 : référencement grappin position ouverte (mise en
	CmdConfirmOpenPosition: BOOL;
	///🆕 REX 2026-07-08 : référencement grappin position fermée (mise en
	CmdConfirmClosePosition: BOOL;
END_STRUCT
END_TYPE
</Single>
