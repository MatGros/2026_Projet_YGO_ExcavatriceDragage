            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ ST_Safety_Emergency_Diag — Diagnostic et erreurs de la chaîne AU
///   ───────────────────────────────────────────────────────────────
///   📄 Produit par FB_Safety_EmergencyManagement (sortie Diag).
///      Consommé par PRG_SUPERVISION_CFC et GVL_Troubleshooting.
///   🎯 Champs lecture seule — producteur unique = FB composite.
///   ═══════════════════════════════════════════════════════════════
///    📄 Docs : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.0.md §8.2
///              DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
TYPE ST_Safety_Emergency_Diag :
STRUCT
	///🔴 Synthèse : (ErrorId &lt;&gt; 0)
	Error: BOOL;
	///❌ bit0 = RedundancyTestFailed (auto-test A/B), bit1 = EmergencyArmingFailed (timeout confirm contacteur)
	ErrorId: WORD;
	///🔴 Canal A ou B resté collé/shunté détecté à l'auto-test — Reset requis (cause disparue)
	RedundancyTestFailed: BOOL;
	///🔴 Impulsion envoyée mais contacteur puissance non confirmé sous 2 s — Reset + contacteur engagé requis
	ArmFailed: BOOL;
	///⏳ Verrouillage temporel de 5 s entre tentatives de réarmement échouées
	LockoutActive: BOOL;
END_STRUCT
END_TYPE
</Single>
