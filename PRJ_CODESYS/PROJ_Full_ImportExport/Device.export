        <Single Name="TypeGuid" Type="System.Guid">ffbfa93a-b94d-45fc-a329-229860183b1d</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639223207768265470</Single>
      </Single>
      <Single Name="Object" Type="{ffbfa93a-b94d-45fc-a329-229860183b1d}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 GVL_Simulation — Variables et stimuli de simulation (Banc d'essai)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-13_Fonction_Simulation_v2.1.md
///   📄 Lot L6 : Refonte à 5 flags principaux (1 bit maître + 4 domaines)
///   🎯 Polarité positive : TRUE = simulé, FALSE = réel (par défaut).
///   ═══════════════════════════════════════════════════════════════
{attribute 'qualified_only' := ''}
VAR_GLOBAL
	///🔑 Bit maître — rien n'est simulé si FALSE (machine réelle)
	SimulationModeActive: BOOL := FALSE;
	///🌐 Activation par domaine (simulé si SimulationModeActive AND Sim&lt;Domaine&gt;Active)
	///M1+M2 : codeurs, contacteurs, freins, thermiques, capteur haut, câble tendu
	SimWinchActive: BOOL := FALSE;
	///AC600 : StatusWord/fréquence, 5 capteurs, frein M3
	SimTranslationActive: BOOL := FALSE;
	///Joystick : bus CANopen + RawX/RawY/Button
	SimOperatorActive: BOOL := FALSE;
	///Chaîne AU, contacteur puissance, réarmement, phases, thermiques freins/hydraulique, Kobold
	SimMachineActive: BOOL := FALSE;
	///🖐️ Stimuli de banc — ENTRÉES du modèle, jamais des forçages du programme
	SimM3SensorsWordActive: BOOL := FALSE;
	SimM3SensorsWord: BYTE := 16#01;
	SimJoystickRawX: INT := 5000;
	SimJoystickRawY: INT := 5000;
	SimJoystickRawButton: BOOL := FALSE;
	SimKoboldContactValue: BOOL := FALSE;
	///⚠️ Remis à 1.0 (défaut nominal)
	SimEncoderSpeedFactor: REAL := 1;
	SimSyncDeviationInjectM1: BOOL := FALSE;
	SimSyncDeviationInjectM2: BOOL := FALSE;
	SimSyncDeviationOffset_M: REAL := 0.5;
END_VAR</Single>
