          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🪝 ST_WinchInterPrg — Bus d'échange inter-PRG produit par PRG_04_Treuils_Benne
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Encapsuler les demandes finales M1/M2, les états publics
///      WinchM1/M2State, les sécurités WinchM1/M2Safety, l'état synchro et
///      l'état benne publiés par PRG_04_Treuils_Benne vers les consommateurs
///      (PRG_02/03/06/07).
///   📤 Producteur unique : PRG_04_Treuils_Benne (VAR_OUTPUT Data : ST_WinchInterPrg).
///   📄 Doc : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   🔌 Architecture : Bus de données typé — encapsulation des échanges inter-PRG.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_WinchInterPrg :
STRUCT
	///=== ⚡ Demandes finales M1/M2 (interlocks &amp; consigne vitesse arbitrée) ===
	///🪝 Demande finale et interlocks treuil M1
	WinchM1FinalInterlockRequest: ST_WinchFinalInterlockRequest;
	///🪝 Demande finale et interlocks treuil M2
	WinchM2FinalInterlockRequest: ST_WinchFinalInterlockRequest;
	///📈 Consigne vitesse M1 arbitree (%) — consommee par FB_SimBench (PRG_02)
	M1LogicRequestSpeedCmd_Pct: REAL;
	///📈 Consigne vitesse M2 arbitree (%) — consommee par FB_SimBench (PRG_02)
	M2LogicRequestSpeedCmd_Pct: REAL;
	///🪝 Ordre contacteur capteur fond Kobold (consommé PRG_06)
	KoboldContactorCmdArbitrated: BOOL;
	///=== 📊 États publics des treuils ===
	///🚦 Etat public treuil Retenue M1
	WinchM1State: ST_WinchState;
	///🚦 Etat public treuil Benne M2
	WinchM2State: ST_WinchState;
	///=== 🛡️ Sécurités des treuils ===
	///🛡️ Diagnostic et securites treuil M1
	WinchM1Safety: ST_SafetyWinch;
	///🛡️ Diagnostic et securites treuil M2
	WinchM2Safety: ST_SafetyWinch;
	///=== 🔄 État synchronisation ===
	///🔄 Etat synchronisation treuils M1/M2
	SyncState: ST_SyncState;
	///🚨 Defaut de desynchronisme treuils M1/M2
	WinchSyncError: BOOL;
	///📏 Ecart signe M2 - M1 (m)
	WinchSyncSignedDeltaPosM: REAL;
	///=== 🏗️ État benne ===
	///🏗️ Etat de fonctionnement benne
	BucketState: ST_BucketHMIState;
	///🏗️ Benne consideree fermee (tolerance matiere)
	Benne_IsRoughlyClosed: BOOL;
	///⚙️ Mouvement d'ouverture/fermeture benne en cours
	BucketBusy: BOOL;
	///✅ Mouvement benne termine avec succes
	BucketDone: BOOL;
	///❌ Defaut sur sous-systeme benne
	BucketError: BOOL;
	///=== 🛡️ Permission d'armement homme-mort (Option B — combiné interlock benne) ===
	///🛡️ Permission d'armement homme-mort (consommée PRG_02 → FB_Joystick). TRUE = armement autorisé (NC-100)
	ArmingPermit: BOOL;
	///=== Usage effectif d'un override/bypass de POSITION (consommé PRG_03 → FB_Modes) ===
	///Producteur unique : PRG_04_Treuils_Benne §5. Lecteur : PRG_03_Modes_Cycle (lag 1 scan assumé,
	///même doctrine que les autres échanges PRG_03/PRG_04 de ce bus).
	///TRUE = la limite de position de cet axe est actuellement levée au-delà du nominal :
	///override FDC logiciel N1 maintenu OU bypass N2 effectif de la famille position
	///(TopLimitSwitch / TopLimitSoftware / CableLimitSwitch / LimitLegal / MecaD).
	///Sert à armer le re-homing obligatoire (AF-05 §4bis) — n'est PAS un permis de mouvement.
	///🧭 Treuil M1 — limite de position levée
	PositionLimitOverriddenM1: BOOL;
	///🧭 Treuil M2 — limite de position levée
	PositionLimitOverriddenM2: BOOL;
END_STRUCT
END_TYPE
</Single>
