      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_BucketConfig — Configuration des offsets du benne
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch/FB_Bucket_v1.0.md §4.A
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BucketConfig :
STRUCT
	///Écart M1/M2 en mètres benne ouvert
	OffsetOpenM: REAL;
	///Écart M1/M2 en mètres benne fermé
	OffsetCloseM: REAL;
	///Seuil de détection d'incohérence au boot
	CoherenceLimitM: REAL;
	///🆕 2026-08-07 (20) — retour terrain, demande client : inertie mécanique du benne (M2 continue
	///sur sa lancée après coupure StartStop) -- couper la commande EN AVANCE de la cible pour que
	///l'arrêt réel (après coast-down) tombe proche du vrai offset, au lieu de dépasser. Anticipation
	///distincte par sens (fermeture/ouverture ont des inerties différentes selon retour terrain).
	///Coupe la commande de fermeture 1m avant OffsetCloseM
	CloseAnticipationM: REAL := 1;
	///Coupe la commande d'ouverture 1.3m avant OffsetOpenM
	OpenAnticipationM: REAL := 1.3;
END_STRUCT
END_TYPE
</Single>
