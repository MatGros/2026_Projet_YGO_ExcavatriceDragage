        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔄 PRG_05_Cycle — Séquenceur du Cycle Automatique / Semi-Auto (Grafcet)
///   ───────────────────────────────────────────────────────────────
///   ⚙️ Exécuté par la tâche PLC en position 5.
///   ✅ Gère la machine d'état principale de dragage (FB_Cycle).
///   ═══════════════════════════════════════════════════════════════
///   📄 Docs : DOC/AF_Partie-04_Cycle_Sequenceur_v1.4.md
PROGRAM PRG_05_Cycle
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	///Instance du séquenceur automatique
	instCycle: FB_Cycle;
	///Commandes issues de la supervision (IHM)
	///Lancement cycle automatique
	CmdStartCycle_IHM: BOOL;
	///Pause cycle automatique
	CmdPauseCycle_IHM: BOOL;
	///Abandon / arrêt cycle automatique
	CmdAbortCycle_IHM: BOOL;
	///🔧 REX 2026-07-07 : reset dédié FB_Cycle, jamais mélangé au reset défauts général
	CmdResetCycle_IHM: BOOL;
	///Paramètres cibles réglés par l'opérateur
	///Profondeur de dragage cible (mètres, négative)
	SetDepthM: REAL := -12.5;
	///Décalage cible de fermeture du benne (mètres)
	SetOffsetM: REAL := 1.5;
	///Homme-mort + axe Y actif
	CycleMotionPermit: BOOL;
	///🧪 T43 — paramètres provisoirement désactivés ; à définir avec T45.
	SpeedMismatchThresholdMps: REAL := 0;
	SpeedMismatchTimeout: TIME := TIME#0ms;
END_VAR
</Single>
