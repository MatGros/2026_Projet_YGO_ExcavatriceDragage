      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🌐 ST_CommunHMI — Données d'échange IHM COMMUNES (pas propres à un axe)
///   ───────────────────────────────────────────────────────────────
///   🆕 REX 2026-07-08 (demande utilisateur) : regroupe les signaux qui ne concernent
///   PAS un axe/mécanisme en particulier (1 seul capteur/signal partagé par toute la
///   machine) — évite de les dupliquer ou de les laisser en variables isolées
///   directement dans GVL_IHM. Exemple : TopPositionSensorActive (capteur unique,
///   commun M1+M2), BrakeThermalFault (retour unique, commun M1+M2+M3).
///   ⚠️ Ne pas y mettre HmiInitDone (indicateur interne de séquencement boot, pas une
///   information machine destinée à l'opérateur) — reste seul dans GVL_IHM.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_CommunHMI :
STRUCT
	///⚠️ Capteur de position haute commun M1+M2 détecté
	TopPositionSensorActive: BOOL;
	///🌡️ Défaut/perte thermique frein — retour unique commun M1/M2/M3, escalade PowerCutOff
	BrakeThermalFault: BOOL;
	///🆕 REX 2026-07-08 : rotation de phase incorrecte — retour unique commun M1/M2/M3
	PhaseRotationFault: BOOL;
	///📐 Limite légale de profondeur de dragage atteinte (globale)
	LimitLegalReached: BOOL;
	///🔧 Configuration des paramètres communs machine
	Cfg: ST_CommunCfg;
	///🆕 REX 2026-07-18 : défaut/perte thermique centrale hydraulique
	HydraulicThermalFault: BOOL;
	///🔧 Bypass maintenance de capteurs COMMUNS (voir REGISTRE_ACTIONS_Bypass_v1.0 (archive))
	///🆕 2026-08-07 : granulaire, applique le bypass aux 2 treuils simultanement (pilotage "both") — OR avec le bypass individuel M1/M2 dans PRG_04
	Bypass: ST_BypassCommun;
	///🩺 2026-08-07 : indicateurs diagnostic simulation — PLC→IHM, PAS des bypass operateur
	///       (etaient ecrits par erreur dans Bypass.SlackCable/TopPositionSensor avant ce lot, ce qui
	///       empechait ces champs de servir de vrai bypass RETAIN operateur).
	///🩺 Capteur haut ignore car simulation active
	SimTopSensorBypassActive: BOOL;
	///🩺 Mou de cable ignore car simulation active
	SimSlackCableBypassActive: BOOL;
	///💓 Heartbeat IHM↔PLC — IHM inverse TglHeartbeatIhm toutes les 500 ms.
	///IHM→PLC : toggle périodique, jamais valeur constante
	TglHeartbeatIhm: BOOL;
	///PLC→IHM : clignotant activité PLC
	TglHeartbeatPlc: BOOL;
	///PLC→IHM : front IHM post-boot reçu et timeout absent
	HeartbeatIhmOk: BOOL;
	///PLC→IHM : aucun front IHM depuis 2 s
	HeartbeatIhmTimeout: BOOL;
	///PLC→IHM : temps depuis dernier front IHM
	HeartbeatIhmElapsed: TIME;
	///🆕 Boutons pilotage direct des 2 treuils (communs, remplace SelJoystickWinch en mode boutons)
	///⬆️ Monte les 2 treuils simultanément
	BtnWinchBothUp: BOOL;
	///⬇️ Descend les 2 treuils simultanément
	BtnWinchBothDown: BOOL;
	///🐛 FIX 2026-07-23 : alarme restauration config PERSISTENT (RETAIN invalidé, ex. changement de
	///struct ST_*HMI) — visible et acquittable, jamais de disparition automatique silencieuse
	///(doctrine reset=front, PRG_SUPERVISION_CFC.st §2bis). Vérifier les valeurs avant reprise cycle.
	///⚠️ PLC→IHM : restauration détectée ce boot, à vérifier
	ConfigRestoredFromPersistent: BOOL;
	///🔘 IHM→PLC : acquittement opérateur (front)
	BtnAckConfigRestored: BOOL;
	///🩺 Verdict observateur à l'arrêt — jamais bloquant
	Preflight: ST_PreflightHMI;
	///⚖️ MES-008 : mesures passives M1/M2
	WinchSymmetry: ST_WinchSymmetryHMI;
	///🩺 2026-08-07 (Fiche 05) : diagnostic arrêt auto descente Kobold (pilotage normal)
	///Front Kobold confirmé dans la fenêtre d'immersion
	KoboldImmersionConfirmed: BOOL;
	///Fond détecté, descente bloquée (ForbidDescentM1/M2_Raw)
	KoboldBottomTouchLatched: BOOL;
END_STRUCT
END_TYPE
</Single>
