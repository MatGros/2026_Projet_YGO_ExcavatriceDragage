        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔌 FB_Encoder_Abs — Acquisition codeur absolu (accès bus EtherCAT)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Accès bus EtherCAT, extraction positions brutes et séquence de Preset SDO
///   🔒 Polarité : EncoderAvailable=TRUE si communication bus et esclave OK
///   🔌 Architecture : Module d'acquisition codeur absolu
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md
///   =======================================================================
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Abs) ===
FUNCTION_BLOCK FB_Encoder_Abs
VAR_INPUT
	///=== COMMANDES &amp; AUTORISATIONS ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut (front montant)
	Reset: BOOL;
	///--&gt; [CMD] Demande de preset (front montant)
	PresetRequest: BOOL;
	///=== BUS ETHERCAT &amp; CAPTEUR HW ===
	///--&gt; [HW]  Position brute EtherCAT
	RawPosIn: UDINT;
	///--&gt; [HW]  Codes alarmes bruts EtherCAT
	AlarmsIn: UINT;
	///--&gt; [HW]  Codes avertissements bruts EtherCAT
	WarningsIn: UINT;
	///--&gt; [HW]  Statut esclave EtherCAT operationnel
	SlaveOperational: BOOL;
	///=== PARAMETRES &amp; REGLAGES ===
	///--&gt; [CFG] Resolution codeur (pts/tour)
	PointsPerRev: UDINT := 8192;
	///--&gt; [CFG] Valeur cible de preset
	PresetValue: UDINT;
	///--&gt; [CFG] Temporisation max attente preset
	PresetTimeout: TIME := TIME#2s0ms;
	///--&gt; [CFG] Tolerance relecture post-preset (pts)
	PresetTolerancePts: UDINT := 10;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///🧩 Statut transverse (forme cible) — regroupe Busy/Done/Error/ErrorId/State/StateAtError.
	///ErrorId bit0: "Com", bit1: "Preset Timeout".
	Status: ST_FbStatus;
	///=== MESURES &amp; DONNEES CODEUR ===
	///&lt;-- [DIAG] Position brute gelee si non disponible
	RawPos: UDINT;
	///&lt;-- [STAT] Codeur operationnel et disponible
	EncoderAvailable: BOOL;
	///&lt;-- [DIAG] Angle brut sur un tour (MOD PointsPerRev)
	AngleRaw: UINT;
	///&lt;-- [DIAG] Nombre de tours bruts (RawPos / PointsPerRev)
	TurnCount: UDINT;
	///=== COMMANDES &amp; ECHANGE BUS ETHERCAT ===
	///&lt;-- [STAT] Pulse confirmation preset reussi
	PresetAck: BOOL;
	///&lt;-- [STAT] Pulse refus / timeout preset
	PresetNak: BOOL;
	///&lt;-- [ACT]  Ordre declenchement preset vers PDO Rx
	PresetTriggerCmd: WORD;
	///&lt;-- [ACT]  Ordre sequence code vers PDO Rx
	CodeSeqTriggerCmd: WORD;
	///&lt;-- [ACT]  Valeur de preset transmise au PDO Rx
	PresetValueOut: UDINT;
END_VAR
VAR
	///=== DETECTEURS DE FRONT ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///. [LOC] Detecteur front montant Error
	ErrorEdge: R_TRIG;
	///. [LOC] Detecteur front montant PresetRequest
	PresetReqEdge: R_TRIG;
	///=== TEMPORISATEURS INTERNES ===
	///. [LOC] Temporisateur timeout sequence preset
	PresetTimer: TON;
	///. [LOC] Temporisateur maintien visuel impulsion (500ms)
	PresetTimerVisual: TON;
	///=== VARIABLES INTERNES DE CALCUL &amp; ETAT ===
	///. [LOC] Etape sequence preset (0:IDLE, 1:PULSE/WAIT)
	PresetSeqStep: INT;
	///. [LOC] Ecart signe entre RawPos et PresetValueOut
	RawDiff: DINT;
END_VAR
</Single>
