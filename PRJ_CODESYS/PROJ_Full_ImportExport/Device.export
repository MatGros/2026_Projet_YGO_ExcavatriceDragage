      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// === IMPLEMENTATION ===
StartTrig(CLK := Start);

// Gestion de l'arrêt ou de l'inactivité
IF Abort OR (NOT Running AND NOT StartTrig.Q) THEN
    Running := FALSE;
    OutActive := FALSE;
    OutBool := FALSE;
    OutReal := 0.0;
    Done := FALSE;
    Timer(IN := FALSE);
    SeqTimer(IN := FALSE);
    Ramp(RESET := TRUE, IN := 0.0);
    RETURN;
END_IF;

// Lancement sur front montant de Start
IF StartTrig.Q THEN
    Running := TRUE;
    Done := FALSE;
    OutActive := TRUE;
    ActiveIndex := 1;
    Timer(IN := FALSE);
    SeqTimer(IN := FALSE);
    
    CASE Config.Kind OF
        E_TestStimKind.STIM_PULSE_BOOL:
            OutBool := TRUE;
            Timer(IN := TRUE, PT := Config.PulsePT);
            
        E_TestStimKind.STIM_RAMP_REAL:
            Ramp(RESET := TRUE, IN := Config.StartReal);
            IF Config.RampPT &gt; T#0s THEN
                // Calcul de la vitesse par seconde
                Rate := ABS(Config.TargetReal - Config.StartReal) / (TIME_TO_REAL(Config.RampPT) / 1000.0);
            ELSE
                Rate := ABS(Config.TargetReal - Config.StartReal);
            END_IF;
            Timer(IN := TRUE, PT := Config.RampPT);
            
        E_TestStimKind.STIM_SEQUENCE_REAL:
            IF Config.SeqCount &gt;= 1 THEN
                OutReal := Config.SeqValues[1];
                SeqTimer(IN := TRUE, PT := Config.SeqDwellPT);
            ELSE
                Running := FALSE;
                OutActive := FALSE;
                Done := TRUE;
            END_IF;
    END_CASE;
END_IF;

// Éxecution logique quand le stimulus tourne
IF Running THEN
    CASE Config.Kind OF
        E_TestStimKind.STIM_PULSE_BOOL:
            Timer();
            IF Timer.Q THEN
                OutBool := FALSE;
                Running := FALSE;
                OutActive := FALSE;
                Done := TRUE;
                Timer(IN := FALSE);
            END_IF;
            
        E_TestStimKind.STIM_RAMP_REAL:
            Timer();
            Ramp(RESET := FALSE, IN := Config.TargetReal, ASCEND := Rate, DESCEND := Rate, TIMEBASE := T#1s);
            OutReal := Ramp.OUT;
            IF Timer.Q THEN
                OutReal := Config.TargetReal; // Assure la valeur cible exacte à la fin
                Running := FALSE;
                OutActive := FALSE;
                Done := TRUE;
                Timer(IN := FALSE);
            END_IF;
            
        E_TestStimKind.STIM_SEQUENCE_REAL:
            SeqTimer();
            IF SeqTimer.Q THEN
                SeqTimer(IN := FALSE);
                ActiveIndex := ActiveIndex + 1;
                IF ActiveIndex &gt; Config.SeqCount OR ActiveIndex &gt; GVL_PLC_Tests_Const.MaxSeqValues THEN
                    Running := FALSE;
                    OutActive := FALSE;
                    Done := TRUE;
                ELSE
                    OutReal := Config.SeqValues[ActiveIndex];
                    SeqTimer(IN := TRUE, PT := Config.SeqDwellPT);
                END_IF;
            END_IF;
    END_CASE;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">36e84b15-4171-5dc4-8ebb-16e48bc4ce65_Impl_LineIds</Single>
          </Single>
        </Single>
