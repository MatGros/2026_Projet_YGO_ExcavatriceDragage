      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎚️ ST_fbModes_Autorisations — Bus d'autorisations du mode machine
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-05_Modes_Maintenance_v2.1.md
///                   DOC/AF/AF_Partie-02_Architecture_Programme_v3.2.md §2
///   🎯 Produit par FB_Modes (via PRG_03_Modes_Cycle)
///      Consommé par : Cycle, Safety, Treuils, Translation, Supervision, Acquisition
///   🎯 Producteur unique : FB_Modes (via PRG_03_Modes_Cycle)
///   ═══════════════════════════════════════════════════════════════
TYPE ST_fbModes_Autorisations :
STRUCT
	///Mode arbitré (DISABLE/N1/N2/SEMI_AUTO)
	Mode: E_Mode;
	///Synchro M1/M2 (logique positive)
	SyncEnable: BOOL;
	///Inhibition M1 (MAINT_N2 only)
	InhibitM1: BOOL;
	///Inhibition M2 (MAINT_N2 only)
	InhibitM2: BOOL;
	///0=M1+M2 couplés nominal, 1=M1, 2=M2 (unitaires MAINT_N2)
	JoystickWinchSelectArbitrated: INT;
	///Dépassement butée haut (N2)
	HomingApproachEnable: BOOL;
	///Cible Translation Maintenance (N2 only)
	MaintenanceM3TargetEnable: BOOL;
	///AF-05 §4bis — matrice de maintenance
	///⚠️ Ces trois champs sont des FAITS/DIAGS publiés, pas des autorisations : ils restent
	///vrais même quand le FB est neutralisé par Enable=FALSE (état persistant à remonter à l'IHM).
	///🚦 Demande de changement de mode REFUSÉE : les treuils
	ModeChangePendingBlocked: BOOL;
	///ne sont pas à l'arrêt mécanique confirmé
	///(contacteurs retombés ET frein serré ET |v| &lt; seuil).
	///Le mode courant est maintenu. IHM : « arrêter les
	///treuils avant de changer de mode ».
	///🧭 M1 : re-homing obligatoire avant tout retour SEMI_AUTO
	HomingRequiredM1: BOOL;
	///(usage effectif d'un override/bypass position en maintenance)
	///🧭 M2 : idem
	HomingRequiredM2: BOOL;
END_STRUCT
END_TYPE
</Single>
