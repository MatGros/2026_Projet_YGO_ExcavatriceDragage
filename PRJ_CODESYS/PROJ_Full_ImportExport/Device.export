      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📏 ST_EncoderMeasurement — Mesures codeur qualifiées (1 sous-DUT par treuil)
///   ───────────────────────────────────────────────────────────────
///   📄 Lot M1 · Doc : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.2.md §2ter
///   🎨 Facts de la chaîne de mesure pure : Abs → Scale → Safety → SpeedMeasure.
///   🔗 Producteur : PRG_02_Acquisition_CFC (chaîne codeur du treuil concerné).
///   ✅ Tout BOOL = TRUE état normalisé. Aucun brut EtherCAT (alarmes/warnings,
///      DEVICE_STATE) : ils restent exposés via ST_EncoderHMI (Supervision).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_EncoderMeasurement :
STRUCT
	///Position brute codeur — gelée si EncoderAvailable=FALSE
	RawPos: UDINT;
	///TRUE = bus/esclave opérationnel
	EncoderAvailable: BOOL;
	///Position câble (m, signée, + enroulé)
	CablePosM: REAL;
	///Position câble bornée [-99;+99] m — gelée sur doute
	CablePosMSafe: REAL;
	///TRUE = incohérence redémarrage → refuse SEMI_AUTO
	EncoderIncoherent: BOOL;
	///Vitesse absolue (m/s) — 0.0 si SpeedValid=FALSE
	Speed_Mps: REAL;
	///Vitesse signée (m/s, + montée) — 0.0 si SpeedValid=FALSE
	SignedSpeed_Mps: REAL;
	///TRUE si ≥ 6 éch. couvrant 50 ms
	SpeedValid: BOOL;
END_STRUCT
END_TYPE
</Single>
