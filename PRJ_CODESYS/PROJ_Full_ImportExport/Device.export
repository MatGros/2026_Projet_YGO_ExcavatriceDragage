      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_ModesState — États et diagnostics IHM des modes de marche
///   ═══════════════════════════════════════════════════════════════
TYPE ST_ModesState :
STRUCT
	///🎚️ Mode de marche actuellement actif
	CurrentMode: E_Mode;
	///🛡️ État de la chaîne d'arrêt d'urgence
	PowerContactorEngaged: BOOL;
	///🔴 REX 2026-07-07 : au moins un défaut/alarme actif dans le domaine
	AnyFaultActive: BOOL;
	///🧨 REX 2026-07-07 : au moins un Méca A/B/C (FB_Safety_Winch) ou
	PowerCutOffActive: BOOL;
	///🔗 Boucle AU saine (coup-de-poing relâchés + pas de PowerCutOff PLC actif)
	EmergencyChainOk: BOOL;
	///🔌 Contacteur de puissance confirmé engagé (miroir PowerContactorEngaged)
	PowerContactorOk: BOOL;
	///🟢 Réarmement possible maintenant (chaîne saine, ni séquence ni verrouillage en cours,
	EmergencyArmable: BOOL;
	///⏳ Auto-test A/B, pulse, confirmation OU verrouillage 5s en cours — nouvelle demande ignorée
	EmergencyArmingBusy: BOOL;
	///🔴 Canal A ou B non fonctionnel détecté à l'auto-test — bloque tout réarmement (front Reset requis)
	RedundancyTestFailed: BOOL;
	///🔴 Impulsion envoyée mais contacteur puissance jamais confirmé sous 2s (front Reset + contacteur confirmé requis)
	EmergencyArmingFailed: BOOL;
END_STRUCT
END_TYPE
</Single>
