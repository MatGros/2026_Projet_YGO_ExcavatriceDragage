            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ ST_WinchSpeedConfig — Configuration des plages de vitesse linéaire
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Caractérisation des plages de vitesse mesurée par palier (m/s)
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
///   =======================================================================
TYPE ST_WinchSpeedConfig :
STRUCT
	///Vitesse maximale mesuree de reference (m/s)
	MaxMeasuredSpeedMps: REAL;
	///Plafonds vitesse mesuree par palier (m/s)
	SpeedBandMaxMps: ARRAY[1..5] OF REAL;
	///Hysteresis anti-battement classement vitesse (m/s)
	SpeedBandHysteresisMps: REAL;
END_STRUCT
END_TYPE
</Single>
