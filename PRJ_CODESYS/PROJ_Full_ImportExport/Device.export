      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧲 ST_EncoderCalib — Calibration/référence codeur (1 par treuil, RETAIN)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie10_Fonction_Encoder_Homing_v1.6.md §9
///   🎛️ Une instance RETAIN par treuil (M1_EncoderCalib / M2_EncoderCalib).
///   ⚠️ Ce lot (acquisition + mise à l'échelle) : `HomingRefRaw` reste
///      modifiable MANUELLEMENT (RETAIN, valeur de test) tant que
///      `FB_Encoder_Homing` (qui l'écrit normalement, §5) n'est pas codé —
///      même principe que le stub GVL du lot Winch.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_EncoderCalib :
STRUCT
	///Valeur brute figée au dernier homing réussi
	HomingRefRaw: UDINT;
	///Dernier point brut valide connu (§3.7, continu)
	LastKnownRawPos: UDINT;
	///Tolérance redémarrage (~12% PointsPerRev 8192)
	RestartCoherenceTolerancePts: UDINT := 1000;
	///TRUE dès qu'un référencement a réussi
	Homed: BOOL;
	///TRUE si incohérence détectée au redémarrage (§3.7)
	HomingSuspect: BOOL;
END_STRUCT
END_TYPE
</Single>
