            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_SyncState — États et diagnostics de la synchronisation M1/M2
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SyncState :
STRUCT
	///📊 Écart de position réel mesuré (m)
	DeltaPos_M: REAL;
	///⚖️ Indicateur si surveillance active
	SyncActive: BOOL;
	///⚠️ LED d'alarme écart hors tolérance
	SyncWarn: BOOL;
	///🟢 Bloc de synchro prêt
	Ready: BOOL;
	///🔴 Alarme synchro active
	Error: BOOL;
	///❌ Code défaut synchro
	ErrorId: WORD;
	///🤖 État de l'automate interne (FB_WinchSync) — ex-"State", renommé pour éviter collision avec le sous-struct State
	FBState: E_State;
END_STRUCT
END_TYPE
</Single>
