      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🌐 ST_CommonHMI — Données d'échange IHM COMMUNES (pas propres à un axe)
///   ───────────────────────────────────────────────────────────────
///   🆕 REX 2026-07-08 (demande utilisateur) : regroupe les signaux qui ne concernent
///   PAS un axe/mécanisme en particulier (1 seul capteur/signal partagé par toute la
///   machine) — évite de les dupliquer ou de les laisser en variables isolées
///   directement dans GVL_IHM. Exemple : TopPositionSensorActive (capteur unique,
///   commun M1+M2), BrakeThermalFault (retour unique, commun M1+M2+M3).
///   ⚠️ Ne pas y mettre HmiInitDone (indicateur interne de séquencement boot, pas une
///   information machine destinée à l'opérateur) — reste seul dans GVL_IHM.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_CommonHMI :
STRUCT
	///⚠️ Capteur de position haute commun M1+M2 détecté
	TopPositionSensorActive: BOOL;
	///🌡️ Défaut/perte thermique frein — retour unique commun M1/M2/M3, escalade PowerCutOff
	BrakeThermalFault: BOOL;
	///🆕 REX 2026-07-08 : rotation de phase incorrecte — retour unique commun M1/M2/M3
	PhaseRotationFault: BOOL;
	///📐 Cote min de dragage autorisée (m, négatif)
	LimitLegalDepthMinAllowed: REAL;
	///🟢 Activation de la limite légale
	LimitLegalEnabled: BOOL;
	///📐 Limite légale de profondeur de dragage atteinte (globale)
	LimitLegalReached: BOOL;
	///🆕 REX 2026-07-08 (2) : case IHM — autorise (si MAINT_N2) à dépasser
	HomingApproachEnableRequest: BOOL;
END_STRUCT
END_TYPE
</Single>
