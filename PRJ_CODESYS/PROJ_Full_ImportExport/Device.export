	///Cible Sélectionnée IHM (1=Trémie, 2=P2, 3=P1)
	Idx205_HmiTargetPosition: INT;
	///Cible Sélectionnée par le Cycle Auto
	Idx206_CycleTargetPosition: INT;
	///Mode courant (MANU_N1, AUTO_N1...)
	Idx207_ModeActive: E_Mode;
	///0 = Comm Variateur OK | 1 = Bypass Réseau Actif ⚠️
	Idx208_BypassNetworkActive: BOOL;
	///[%] Consigne finale Vitesse Translation
	Idx209_ArbitratedSpeed_Pct: REAL;
END_STRUCT
END_TYPE
