          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📤 ST_OutputsInterPrg — Bus d'échange inter-PRG produit par PRG_06_Outputs
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Encapsuler les ordres actionneurs finaux (M1/M2/M3, AU) produits
///      par PRG_06_Outputs et rebouclés par FB_SimBench (instancié dans
///      PRG_02_Acquisition) pour le banc de simulation intégré.
///   📤 Producteur unique : PRG_06_Outputs (VAR_OUTPUT Data : ST_OutputsInterPrg).
///   📄 Doc : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.4.md §5
///   🔌 Architecture : Bus de données typé — encapsulation des échanges inter-PRG.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_OutputsInterPrg :
STRUCT
	///=== 🪝 Ordres actionneurs finaux treuil M1 ===
	///🛗 Ordre contacteur montee treuil M1
	M1RelayFwd: BOOL;
	///🛗 Ordre contacteur descente treuil M1
	M1RelayRev: BOOL;
	///🔌 Ordre contacteur palier 1 treuil M1
	M1SpeedContactor1: BOOL;
	///🔌 Ordre contacteur palier 2 treuil M1
	M1SpeedContactor2: BOOL;
	///🔌 Ordre contacteur palier 3 treuil M1
	M1SpeedContactor3: BOOL;
	///🔌 Ordre contacteur palier 4 treuil M1
	M1SpeedContactor4: BOOL;
	///🔓 Ordre desserrage frein M1 (1=Desserrer)
	M1BrakeCmd: BOOL;
	///=== 🪝 Ordres actionneurs finaux treuil M2 ===
	///🛗 Ordre contacteur montee/fermeture treuil M2
	M2RelayFwd: BOOL;
	///🛗 Ordre contacteur descente/ouverture treuil M2
	M2RelayRev: BOOL;
	///🔌 Ordre contacteur palier 1 treuil M2
	M2SpeedContactor1: BOOL;
	///🔌 Ordre contacteur palier 2 treuil M2
	M2SpeedContactor2: BOOL;
	///🔌 Ordre contacteur palier 3 treuil M2
	M2SpeedContactor3: BOOL;
	///🔌 Ordre contacteur palier 4 treuil M2
	M2SpeedContactor4: BOOL;
	///🔓 Ordre desserrage frein M2 (1=Desserrer)
	M2BrakeCmd: BOOL;
	///=== ↔️ Ordre actionneur final translation M3 ===
	///🔓 Demande frein M3 arbitree
	TranslationBrakeCmd: BOOL;
	///=== 🚨 Chaîne réarmement puissance AU ===
	///🔒 Maintien puissance voie A (1=Maintenu)
	PowerKeepAliveACmd: BOOL;
	///🔒 Maintien puissance voie B (1=Maintenu)
	PowerKeepAliveBCmd: BOOL;
	///🎯 Impulsion rearmement puissance AU
	EmergencyArmingCmd: BOOL;
END_STRUCT
END_TYPE
</Single>
