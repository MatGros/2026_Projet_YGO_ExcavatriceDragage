      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestStepResult — Résultat d'une étape de test
///═══════════════════════════════════════════════════════════════
TYPE ST_TestStepResult :
STRUCT
	///L'étape a-t-elle été exécutée ?
	Executed: BOOL;
	///L'étape a-t-elle été validée ?
	Passed: BOOL;
	///Raison de l'échec (FAIL_NONE si OK)
	FailReason: E_TestFailReason;
	///Index du check fautif (0 si aucun)
	FailedCheckIdx: INT;
	///Index de l'invariant violé (0 si aucun)
	FailedInvariantId: INT;
	///Durée mesurée de l'étape
	Duration: TIME;
	///Valeur observée de la sonde BOOL en échec au verdict
	ObservedBool: BOOL;
	///Valeur observée de la sonde DINT en échec au verdict
	ObservedDint: DINT;
	///Valeur observée de la sonde REAL en échec au verdict
	ObservedReal: REAL;
END_STRUCT
END_TYPE
</Single>
