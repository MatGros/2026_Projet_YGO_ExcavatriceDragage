        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 FB_Acquisition_Preflight — Verdict passif machine arrêtée
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Verdict passif de qualification E/S machine arrêtée (16 contrôles)
///   🔒 Polarité : Observateur pur (aucun SafeStop, PowerCutOff ou ordre machine)
///   📄 Doc métier : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.3.md §6
///   =======================================================================
FUNCTION_BLOCK FB_Acquisition_Preflight
VAR_INPUT
	///=== COMMANDES &amp; ETATS MACHINE ===
	///--&gt; [CMD] Lancement du verdict (front montant)
	Execute: BOOL;
	///--&gt; [HW]  Machine a l'arret complet (vitesse nulle)
	MachineIsStill: BOOL;
	///=== ETATS FREINS &amp; CONTACTEURS ===
	///--&gt; [HW]  Frein M1 serre
	M1BrakeApplied: BOOL;
	///--&gt; [HW]  Frein M2 serre
	M2BrakeApplied: BOOL;
	///--&gt; [HW]  Frein M3 serre
	M3BrakeApplied: BOOL;
	///--&gt; [HW]  Contacteurs M1 retombes
	M1ContactorsReleased: BOOL;
	///--&gt; [HW]  Contacteurs M2 retombes
	M2ContactorsReleased: BOOL;
	///=== PROTECTION THERMIQUE &amp; RESEAU ===
	///--&gt; [HW]  Thermique moteur M1 OK
	M1ThermalOk: BOOL;
	///--&gt; [HW]  Thermique moteur M2 OK
	M2ThermalOk: BOOL;
	///--&gt; [HW]  Thermique freins OK
	BrakeThermalOk: BOOL;
	///--&gt; [HW]  Ordre des phases reseau OK
	PhaseRotationOk: BOOL;
	///=== CAPTEURS &amp; CHAINE DE SECURITE ===
	///--&gt; [HW]  Cable M2 tendu (anti-mou)
	SlackCableTensioned: BOOL;
	///--&gt; [HW]  Incoherence mot capteurs M3
	M3SensorWordIncoherent: BOOL;
	///--&gt; [SAFE] Chaine d'arret d'urgence fermee
	EmergencyChainClosed: BOOL;
	///--&gt; [HW]  Contacteur de puissance enclenche
	PowerContactorEngaged: BOOL;
	///=== CODEURS &amp; HOMING ===
	///--&gt; [HW]  Codeur M1 operationnel
	EncoderM1Operational: BOOL;
	///--&gt; [HW]  Codeur M2 operationnel
	EncoderM2Operational: BOOL;
	///--&gt; [HW]  Homing M1 effectue
	HomedM1: BOOL;
	///--&gt; [HW]  Homing M2 effectue
	HomedM2: BOOL;
	///--&gt; [HW]  Position M1 dans les bornes
	M1PositionInBounds: BOOL;
	///--&gt; [HW]  Position M2 dans les bornes
	M2PositionInBounds: BOOL;
END_VAR
VAR_OUTPUT
	///=== ETATS ET DIAGNOSTIC ===
	///&lt;-- [STAT] Verdict preflight OK (aucun defaut)
	PreflightOk: BOOL;
	///&lt;-- [STAT] Verdict preflight termine
	PreflightDone: BOOL;
	///&lt;-- [STAT] Diagnostic preflight en cours
	PreflightBusy: BOOL;
	///&lt;-- [DIAG] Masque de defauts preflight (16 bits)
	PreflightErrorId: WORD;
END_VAR
VAR
	///=== TRIGGERS &amp; ETATS INTERNES ===
	///. [LOC] Trigger front montant Execute
	ExecuteEdge: R_TRIG;
	///. [LOC] Demande preflight initiale au demarrage
	BootPending: BOOL := TRUE;
	///. [LOC] Demande de verdict en attente
	RequestPending: BOOL;
END_VAR
</Single>
