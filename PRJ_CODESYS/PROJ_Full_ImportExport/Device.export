          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   💾 ST_Encoder_Calib — Calibration &amp; référence codeur (1 par treuil, RETAIN)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure de calibration RETAIN par treuil (M1_EncoderCalib / M2_EncoderCalib)
///   💾 Données : Références brutes, état homed et contrôle de cohérence redémarrage
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
///   =======================================================================
TYPE ST_Encoder_Calib :
STRUCT
	///=== DONNEES DE REFERENCE BRUTE (RETAIN) ===
	///Valeur brute figee au dernier homing reussi
	HomingRefRaw: UDINT;
	///Dernier point brut valide connu (continu)
	LastKnownRawPos: UDINT;
	///=== CONFIGURATION &amp; REGLAGES TOLERANCE ===
	///Tolerance redemarrage (pts, ~12% de 8192)
	RestartCoherenceTolerancePts: UDINT := 1000;
	///=== ETATS DE CALIBRATION &amp; SECURITE ===
	///TRUE des qu'un referencement a reussi
	Homed: BOOL;
	///TRUE si incoherence detectee au redemarrage
	HomingSuspect: BOOL;
END_STRUCT
END_TYPE
</Single>
