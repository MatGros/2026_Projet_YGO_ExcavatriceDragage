          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎚️ ST_ModesHMI — Données d'échange IHM pour les modes de marche
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage et à la commande des modes sur l'IHM.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_ModesHMI :
STRUCT
	///🎚️ Mode de marche actuellement actif
	CurrentMode: E_Mode;
	///🖥️ Demande de changement de mode de marche — accès N2 filtré côté IHM (REX 2026-07-07)
	ModeRequest: E_Mode := E_Mode.MAINT_N1;
	///🛡️ État de la chaîne d'arrêt d'urgence
	EmergencyStopOk: BOOL;
	///🔔 Acquittement défauts/alarmes domaine sécurité/métier — JAMAIS Modes/Cycle (REX 2026-07-07, ex-MachineReset)
	FaultMachineReset: BOOL;
	///🔁 Acquittement défaut FB_Modes uniquement (REX 2026-07-07)
	ModeReset: BOOL;
	///🔴 REX 2026-07-07 : au moins un défaut/alarme actif dans le domaine
	AnyFaultActive: BOOL;
	///🧨 REX 2026-07-07 : au moins un Méca A/B/C (FB_Safety_Winch) ou
	PowerCutOffActive: BOOL;
	///🔧 REX 2026-07-07 — Séquence réarmement AU (voir DOC/AF_Partie1 v1.5 §Sécurité électrique)
	///🎮 Commande IHM réarmement contacteur puissance (front) — PAS de réarmement automatique
	CmdEmergencyArming: BOOL;
	///🎮 Commande IHM coupure d'urgence puissance amont (arrêt à distance)
	CmdEmergencyCutOff: BOOL;
	///🔗 Boucle AU saine (coup-de-poing relâchés + pas de PowerCutOff PLC actif)
	EmergencyChainOk: BOOL;
	///🔌 Contacteur de puissance confirmé engagé (miroir EmergencyStopOk)
	PowerContactorOk: BOOL;
	///🟢 Réarmement possible maintenant (chaîne saine, ni séquence ni verrouillage en cours,
	EmergencyArmable: BOOL;
	///⏳ Auto-test A/B, pulse, confirmation OU verrouillage 5s en cours — nouvelle demande ignorée
	EmergencyArmingBusy: BOOL;
	///🔴 Canal A ou B non fonctionnel détecté à l'auto-test — bloque tout réarmement (front Reset requis)
	RedundancyTestFailed: BOOL;
	///🔴 Impulsion envoyée mais contacteur puissance jamais confirmé sous 2s (front Reset + contacteur confirmé requis)
	EmergencyArmingFailed: BOOL;
	///🔧 REX 2026-07-19 : rapatrié depuis GVL_IHM.IHM_MANU (suppression IHM_MANU) — TASK-0001,
	///sélection treuil au joystick, arbitrée par FB_Modes (MAINT_N2 uniquement, forcé à 3=Couplé sinon)
	///🕹️ 1=M1 seul, 2=M2 seul, 3=Couplé — voir FB_Modes.JoystickWinchSelectArbitrated
	JoystickWinchSelect: INT;
END_STRUCT
END_TYPE
</Single>
