            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639237203753834807</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

{region "§1 Causes &amp; Socle Défaut (évalué en continu)"}
// 🔑 1. FRONTS
ResetEdge(CLK := Reset);

IF ResetEdge.Q AND (MeasuredSpeedMps &gt;= 0.0) THEN
    ConfigOrSpeedFault := FALSE;
END_IF;

instCauses[0].Active   := ConfigOrSpeedFault;
instCauses[0].Latching := TRUE;
instCauses[0].Texte    := 'Parametrage ou vitesse estimation charge invalide';

// Appel du socle de défaut
instFault(Enable := Enable, Reset := Reset, Causes := instCauses);
Fault := instFault.Fault;
{endregion}

{region "§2 Gate neutralisation"}
// 🛑 2. GATE
IF NOT Enable OR NOT PowerContactorEngaged THEN
    Ready := FALSE;
    SpeedBand := 0;
    EstimatedLoadPct := 0.0;
    Configured := FALSE;
    Ascending := FALSE;
    HasPreviousBand := FALSE;
    RETURN;
END_IF;

Ready := Enable AND NOT Fault.Latched;
Configured := LoadTable.IsConfigured;
Ascending := (MeasuredSpeedSignedMps &gt; 0.0);
{endregion}

{region "§3 Classement vitesse"}
// 📏 3. CLASSEMENT DE LA VITESSE — hystérésis autour des 4 frontières.
IF (MeasuredSpeedMps &lt; 0.0) OR (SpeedConfig.MaxMeasuredSpeedMps &lt;= 0.0) THEN
    ConfigOrSpeedFault := TRUE;
    SpeedBand := 0;
ELSIF NOT HasPreviousBand THEN
    IF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[1] THEN
        PreviousSpeedBand := 1;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[2] THEN
        PreviousSpeedBand := 2;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[3] THEN
        PreviousSpeedBand := 3;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[4] THEN
        PreviousSpeedBand := 4;
    ELSE
        PreviousSpeedBand := 5;
    END_IF;
    HasPreviousBand := TRUE;
    SpeedBand := PreviousSpeedBand;
ELSE
    IF PreviousSpeedBand &lt; 1 OR PreviousSpeedBand &gt; 5 THEN
        PreviousSpeedBand := 1;
        ConfigOrSpeedFault := TRUE;
    END_IF;

    IF PreviousSpeedBand &lt; 5 THEN
        IF MeasuredSpeedMps &gt; (SpeedConfig.SpeedBandMaxMps[PreviousSpeedBand]
                               + SpeedConfig.SpeedBandHysteresisMps) THEN
            PreviousSpeedBand := PreviousSpeedBand + 1;
        END_IF;
    END_IF;
    IF PreviousSpeedBand &gt; 1 THEN
        IF MeasuredSpeedMps &lt; (SpeedConfig.SpeedBandMaxMps[PreviousSpeedBand - 1]
                               - SpeedConfig.SpeedBandHysteresisMps) THEN
            PreviousSpeedBand := PreviousSpeedBand - 1;
        END_IF;
    END_IF;
    SpeedBand := PreviousSpeedBand;
END_IF;
{endregion}

{region "§4 Lecture table"}
// 📊 4. LECTURE TABLE
EstimatedLoadPct := 0.0;
IF Configured THEN
    IF Ascending THEN
        IF ActiveSpeedStep &gt;= 1 THEN
            IF ActiveSpeedStep &lt;= 5 THEN
                IF SpeedBand &gt;= 1 THEN
                    IF SpeedBand &lt;= 5 THEN
                        SelectedLoadPct := LoadTable.LoadPctByStepAndSpeedBand[ActiveSpeedStep][SpeedBand];
                        IF (SelectedLoadPct &lt; 0.0) OR (SelectedLoadPct &gt; 100.0) THEN
                            ConfigOrSpeedFault := TRUE;
                        ELSE
                            EstimatedLoadPct := SelectedLoadPct;
                        END_IF;
                    END_IF;
                END_IF;
            END_IF;
        END_IF;
    END_IF;
END_IF;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">e066a4f1-6041-4e71-910d-28e221c3e17f_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 FB_WinchLoadEstimator — Estimation empirique de charge treuil
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Estimation informative de la charge par croisement palier/vitesse
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   🔌 Interface : Brique de diagnostic/mesure (1 instance par treuil)
///   🔒 Sécurité : Aucune commande moteur ni action sur SafeStop (information IHM)
///   =======================================================================
FUNCTION_BLOCK FB_WinchLoadEstimator
VAR_INPUT
	///=== COMMANDES ET CONSIGNES ===
	///--&gt; [CMD] Autorisation generale FB
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut sur front
	Reset: BOOL;
	///--&gt; [CMD] Mode d'exploitation actif
	Mode: E_Mode;
	///--&gt; [CMD] Palier commande actif (0..5)
	ActiveSpeedStep: INT;
	///=== SECOURS ET HARDWARE ===
	///--&gt; [SAFE] Chaine AU rearmee et puissance OK
	PowerContactorEngaged: BOOL;
	///--&gt; [HW] Vitesse cable absolue (m/s)
	MeasuredSpeedMps: REAL;
	///--&gt; [HW] Vitesse signee (+: montee, -: descente) (m/s)
	MeasuredSpeedSignedMps: REAL;
	///=== REGLAGES ET TABLES ===
	///--&gt; [CFG] Configuration des plages de vitesse
	SpeedConfig: ST_fbWinchLoadEstimator_SpeedCfg;
	///--&gt; [CFG] Table empirique d'estimation 5x5
	LoadTable: ST_fbWinchLoadEstimator_Table;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC ET SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///🧩 Statut transverse (forme cible ST_Fault)
	Fault: ST_Fault;
	///=== DIAGNOSTICS ET ESTIMATIONS ===
	///&lt;-- [DIAG] Bande de vitesse courante (0..5)
	SpeedBand: INT;
	///&lt;-- [DIAG] Estimation de charge (0..100%)
	EstimatedLoadPct: REAL;
	///&lt;-- [STAT] Table explicitement validee
	Configured: BOOL;
	///&lt;-- [STAT] Montee effective mesuree en cours
	Ascending: BOOL;
END_VAR
VAR
	///=== DETECTEURS ET TIMERS INTERNES ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///=== VARIABLES LOCALES CALCULÉES ===
	///. [LOC] Memoire bande de vitesse cycle precedent
	PreviousSpeedBand: INT;
	///. [LOC] Indicateur premiere bande memorisee
	HasPreviousBand: BOOL;
	///. [LOC] Valeur de charge extraite de la table
	SelectedLoadPct: REAL;
	///. [LOC] Latch défaut configuration / vitesse
	ConfigOrSpeedFault: BOOL;
	///=== SOCLE DEFAUT ===
	///* [INST] Socle défaut transverse
	instFault: FB_FaultCore;
	///. [LOC] Table des causes nommées
	instCauses: ARRAY[0..15] OF ST_FaultCause;
END_VAR
</Single>
