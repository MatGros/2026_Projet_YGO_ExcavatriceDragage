          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ðŸª ST_fbWinch_Cfg â€” Configuration statique d'un treuil
///   â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
///   ðŸŽ¯ RÃ´le : RÃ©glages persistants propres Ã  l'instance treuil (statique)
///   ðŸ“„ Doc mÃ©tier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   ðŸ“¤ Producteur : configuration persistante
///   ðŸ“¥ Consommateur : FB_Winch (statique uniquement)
///   ðŸ”’ Structs cibles + champs conservÃ©s pour garder le dÃ©codage %â†’palier
///      et les deux cadences de rampe DANS FB_Winch (comportement
///      bit-identique). Le champ StepRampDelay est dÃ©clarÃ© mais non
///      consommÃ© (usage aval).
///   =======================================================================
TYPE ST_fbWinch_Cfg :
STRUCT
	///=== TABLE DES PALIERS ===
	///Table de seuils des paliers de vitesse
	SpeedStepTable: ST_SpeedStepTable;
	///=== INTERLOCK CHANGEMENT DE SENS ===
	///Delai interlock changement de sens montee
	DirectionInterlockDelayUp: TIME := TIME#900ms;
	///Delai interlock changement de sens descente
	DirectionInterlockDelayDown: TIME := TIME#400ms;
	///=== CADENCE DE RAMPE PALIER ===
	///[cible] Tempo de rampe palier (usage aval)
	StepRampDelay: TIME := TIME#1000ms;
	///[08a] Cadence palier montee (D10, dedie)
	StepRampDelayAscent: TIME := TIME#1000ms;
	///[08a] Cadence palier descente (D10, dedie)
	StepRampDelayDescente: TIME := TIME#500ms;
	///=== RETOMBÃ‰E CONTACTEURS ===
	///Delai d'attente retombee des contacteurs
	ContactorFeedbackTimeout: TIME := TIME#500ms;
	///=== RALENTISSEMENT BORDURE ===
	///Distance d'approche avant limite pour ralentir (m)
	SlowdownDistance_M: REAL := 1;
	///Plafond palier dans zone de ralentissement (1..5)
	SlowdownMaxStep: INT := 1;
	///=== DÃ‰CODAGE %â†’PALIER (conservÃ©) ===
	///[08a] Marge d'hysteresis palier (%)
	SpeedStepHystMargin: REAL := 2;
END_STRUCT
END_TYPE
</Single>
