        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🛡️ FB_TranslationOutputInterlock — Barrière finale frein / AC600 M3
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Barrière de sécurité finale pour frein et variateur AC600 M3
///   📄 Doc métier : DOC/AF/AF_Partie-11_Fonction_Translation_v2.3.md
///   🔌 Interface : Interlock de sortie (entre FB_Translation et PRG_06_Outputs)
///   🔒 Sécurité : Surveillance feedback frein et watchdog de desserrage
///   =======================================================================
FUNCTION_BLOCK FB_TranslationOutputInterlock
VAR_INPUT
	///=== COMMANDES &amp; ETATS GENERAL ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut sur front
	Reset: BOOL;
	///--&gt; [SAFE] Entree securite pour interface standard
	SafeStop: BOOL;
	///--&gt; [SAFE] Chaine AU rearmee et puissance OK
	PowerContactorEngaged: BOOL;
	///=== DEMANDES DE COMMANDE AMONT ===
	///--&gt; [CMD] Demande de desserrage frein
	BrakeReleaseRequest: BOOL;
	///--&gt; [HW] Confirmation ouverture frein (contacteur/bobine)
	BrakeCommandOpenConfirmed: BOOL;
	///--&gt; [CMD] Mot de commande variateur (0=None, 1=Fwd, 2=Rev, 7=Reset)
	RequestedDriveControlWord: WORD;
	///--&gt; [CMD] Frequence de consigne variateur (Hz)
	RequestedDriveFreqHz: REAL;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner (sortie libre, hors ST_Status)
	Ready: BOOL;
	///🧩 Statut transverse (forme cible ST_Fault)
	Fault: ST_Fault;
	///&lt;-- [DIAG] Cause de blocage
	Reason: E_TranslationFinalInterlockReason;
	///=== ORDRES ACTIONNEURS VALIDES ===
	///&lt;-- [ACT] Mot de commande variateur valide
	DriveControlWord: WORD;
	///&lt;-- [ACT] Frequence de consigne variateur valide (Hz)
	DriveFreqCmd_Hz: REAL;
	///&lt;-- [ACT] Frequence mise a l'echelle registre PDO 0x3100
	DriveFreqCmdWord: WORD;
	///&lt;-- [ACT] Ordre ouverture frein valide
	BrakeCmd: BOOL;
	///=== DIAGNOSTICS &amp; TEMPORISATIONS ===
	///&lt;-- [DIAG] Ecoule temporisation watchdog frein
	BrakeTimeoutElapsed: TIME;
	///&lt;-- [DIAG] Inhibition redemarrage actif
	RestartInhibit: BOOL;
END_VAR
VAR
	///=== DETECTEURS DE FRONTS ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///. [LOC] Detecteur nouvelle occurrence cause timeout
	BrakeTimeoutCauseEdge: R_TRIG;
	///=== TEMPORISATEURS INTERNES ===
	///. [LOC] Temporisateur watchdog desserrage frein
	BrakeTimeout: TON;
	///=== VARIABLES LOCALES INTERNES ===
	///. [LOC] Demande de mouvement active
	MovementRequested: BOOL;
	///. [LOC] Demande neutre (mot 0) observee
	NeutralRequestSeen: BOOL;
	///. [LOC] Front Reset obligatoire avant nouvelle marche
	ResetRequired: BOOL;
	///. [LOC] Cause brute timeout desserrage frein
	BrakeTimeoutCause: BOOL;
	///. [LOC] Accuse operateur (TRUE = pas d'alarme)
	BrakeTimeoutAck: BOOL := TRUE;
	///=== SOCLE DEFAUT ===
	///* [INST] Socle défaut transverse
	instFault: FB_FaultCore;
	///. [LOC] Table des causes nommées
	instCauses: ARRAY[0..15] OF ST_FaultCause;
	///=== ECHELLE &amp; BORNES REGISTRE PDO ===
	///Echelle registre 0x3100 (WORD=5000 -&gt; 50,00 Hz)
	DriveFreqWordScale: REAL := 100;
	///Borne haute anti-debordement WORD (Hz)
	DriveFreqWordMaxHz: REAL := 600;
END_VAR
</Single>
