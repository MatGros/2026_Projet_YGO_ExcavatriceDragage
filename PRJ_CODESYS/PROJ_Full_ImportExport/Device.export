        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🖥️ PRG_09_Supervision — Échanges IHM, Stubs et Initialisation Boot
///   ───────────────────────────────────────────────────────────────
///   ⚙️ Exécuté par la tâche PLC en position 9.
///   ✅ Regroupe tout le mapping bidirectionnel GVL_IHM / GVL_PERSISTENT.
///   ✅ Expose FaultMachineReset_IHM pour tous les programmes du domaine sécurité/métier.
///   🔧 REX 2026-07-07 : séparation des resets — l'ancien MachineReset_IHM (unique, câblé sur
///      TOUT y compris FB_Modes/FB_Cycle) est retiré. FaultMachineReset_IHM ne couvre plus que le
///      domaine sécurité/métier (Winch, Safety, Encodeurs, Benne, Joystick, Translation) ;
///      FB_Modes/FB_Cycle ont chacun leur propre Reset dédié (GVL_IHM.Modes.Cmd.BtnModeReset côté
///      PRG_04_Modes, CmdResetCycle_IHM côté PRG_05_Cycle) — jamais mélangés.
///   ═══════════════════════════════════════════════════════════════
///   📄 Docs : DOC/AF_Partie-07_Interface_IHM_v1.5.md
PROGRAM PRG_09_Supervision
VAR_INPUT
END_VAR
VAR_OUTPUT
	///🔔 Acquittement défauts domaine sécurité/métier (OR des boutons HMI) — jamais Modes/Cycle
	FaultMachineReset_IHM: BOOL;
END_VAR
VAR
	///🧩 Réutilisation lib Util (Partie3 §0) — horloge clignotement système
	instBlink1Hz: BLINK;
	///🔔 Front acquittement opérateur restauration config PERSISTENT (§2bis)
	instAckConfigRestored: R_TRIG;
	///🌉 Pont persistance M1M2Sync.Cfg (Lot 3a, pilote)
	instCfgPersistBridgeSync: FB_CfgPersistBridge_SyncCfg;
	///🌉 Pont persistance Cycle.Cfg (Lot 3b)
	instCfgPersistBridgeCycle: FB_CfgPersistBridge_CycleCfg;
	///🌉 Pont persistance Commun.Cfg (Lot 3b)
	instCfgPersistBridgeCommun: FB_CfgPersistBridge_CommunCfg;
	///🌉 Pont persistance M2TreuilBenne.Bucket.Cfg (Lot 3b)
	instCfgPersistBridgeBucket: FB_CfgPersistBridge_BucketCfg;
	///🌉 Pont persistance M1TreuilRetenue.Cfg (Lot 3d-2)
	instCfgPersistBridgeWinchM1: FB_CfgPersistBridge_WinchCfg;
	///🌉 Pont persistance M2TreuilBenne.Cfg (Lot 3d-2)
	instCfgPersistBridgeWinchM2: FB_CfgPersistBridge_WinchCfg;
	///🐛 FIX 2026-07-23 : passé de VAR simple à VAR RETAIN — en VAR simple, ce flag repassait à
	///FALSE à CHAQUE reset/download (même quand GVL_IHM RETAIN restait intact), re-déclenchant la
	///restauration bypass et pouvant re-forcer un bypass Global que l'opérateur venait de couper.
	///🌐 Flag restauration unique des bypass (boot)
	BypassRestoreDone: BOOL := FALSE;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">7682d59f-1646-4d63-85d5-8f8871f12893_Decl_LineIds</Single>
