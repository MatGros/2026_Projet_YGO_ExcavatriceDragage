            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_Diag_State :
(
	///Désactivé (surveillance non active)
	DISABLED := 0,
	///Opérationnel réel, pas de défaut
	READY := 1,
	///Initialisation / Recherche de réseau
	INIT := 2,
	///Surveillance active (états transitoires)
	MONITORING := 3,
	///Anomalie de communication
	ERROR := 4,
	///Bypass simulation ou bypass réseau IHM — pas le bus réel
	SIMULATED := 5
);
END_TYPE
</Single>
