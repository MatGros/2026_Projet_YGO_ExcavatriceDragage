          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///==============================================================
///   [IHM] ST_Safety_Emergency_HmiState -- Retours d'etat IHM pour chaine AU
///   --------------------------------------------------------------
///   Role : structure d'echange pour les retours d'etat de la
///          chaine d'arret d'urgence (miroir ST_ModesState).
///   Pattern : identique a GVL_IHM.Modes.State dans le projet reel.
///          Le programme ecrit ces champs, l'IHM les lit.
///   ==============================================================
///    Docs : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.0.md
///           DOC/AF/AF_Partie-07_Interface_IHM_v2.0.md
TYPE ST_Safety_Emergency_HmiState :
STRUCT
	///[OK] Etats generaux
	///Boucle AU fermee (saine)
	ChainOk: BOOL;
	///Contacteur puissance engage
	ContactorOk: BOOL;
	///Coupure puissance demandee par une safety metier
	PowerCutOffActive: BOOL;
	///[AU] Sequence de rearmement
	///Pret au rearmement (chain OK + pas de lockout + pas de defaut)
	Armable: BOOL;
	///Sequence armement en cours
	ArmingBusy: BOOL;
	///Etape sequence (0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm)
	Step: INT;
	///[KO] Diagnostics
	///Synthese defaut
	Error: BOOL;
	///bit0=RedundancyTestFailed, bit1=ArmingFailed
	ErrorId: WORD;
	///Auto-test A/B a echoue (canal colle/shunte)
	RedundancyTestFailed: BOOL;
	///Rearmement echoue (timeout confirmation)
	ArmingFailed: BOOL;
	///Verrouillage 5s entre tentatives
	LockoutActive: BOOL;
END_STRUCT
END_TYPE
</Single>
