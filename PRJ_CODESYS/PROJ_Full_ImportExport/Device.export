          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639186932951549072</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Input_Digital) ===

// 1. Inversion NO/NC
ValueRaw := InputRaw XOR InvertLogic;

// 2. Filtrage anti-rebond — ne valide le changement d'état qu'après FilterTime stable
FilterTon(IN := (ValueRaw &lt;&gt; State), PT := FilterTime);
IF FilterTon.Q THEN
    State := ValueRaw;   // Une fois à jour, IN redevient FALSE au cycle suivant (ValueRaw=OutputClean)
END_IF;

// 3. Diagnostic voie/carte
IF NOT ChannelOk THEN
    ErrorId := ErrorId OR 16#0001;
    State := FALSE;   // État sûr forcé (Partie6 §1)
ELSE
    ErrorId := ErrorId AND 16#FFFE;
END_IF;

Error := (ErrorId &lt;&gt; 16#0000);
</Single>
            <Single Name="LineInfoPersistence" Type="string">35be7fa8-eb05-4ee6-a5df-034e1f81c659_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">(* ═══════════════════════════════════════════════════════════════
   📥 FB_Input_Digital — Entrée TOR conditionnée (brique réduite)
   ───────────────────────────────────────────────────────────────
   📄 Doc métier : DOC/AF_Partie6_IO_Conditioning_v1.1.md §1
   🧭 Interface RÉDUITE (Partie3 §1bis) : pas de contrat FB standard
      complet (pas d'Enable/StartStop/Mode/State/StateAtError) — brique
      de conditionnement bas niveau, à instancier en tableau (§3) ou
      composée directement dans un FB métier.
   🔁 Rôle : inversion NO/NC, filtrage anti-rebond, diagnostic voie/carte.
   🔴 INTÉGRATION dans Winch/Translation/etc. : PAS encore décidée (choix
      d'architecture en attente — composition interne vs FB_IO générique
      séparé). Ce fichier ne fait QUE créer la brique elle-même.
   ═══════════════════════════════════════════════════════════════ *)

// === DECLARATION (à coller dans la partie déclaration du POU FB_Input_Digital) ===

FUNCTION_BLOCK PUBLIC FB_Input
VAR_INPUT
    InputRaw    : BOOL;         // Signal brut carte d'entrée
    InvertLogic : BOOL;         // TRUE = NC (logique inversée)
    FilterTime  : TIME;         // Tempo anti-rebond (filtrage)
    ChannelOk   : BOOL := TRUE; // Diag voie/carte OK (§4) — TRUE par défaut si pas de diag dispo
END_VAR
VAR_OUTPUT
    State : BOOL;         // Signal conditionné, prêt à l'emploi
    Error       : BOOL;         // Voie en défaut (ChannelOk faux)
    ErrorId     : WORD;         // bit0 : voie/carte HS
END_VAR
VAR
    FilterTon   : TON;
    ValueRaw    : BOOL;
END_VAR
</Single>
