END_VAR
VAR_OUTPUT
	OutBool: BOOL;
	OutReal: REAL;
	OutActive: BOOL;
	Done: BOOL;
END_VAR
VAR
	StartTrig: R_TRIG;
	Timer: TON;
	SeqTimer: TON;
	Ramp: RAMP_REAL;
	ActiveIndex: INT;
	Running: BOOL;
	Rate: REAL;
END_VAR
</Single>
