        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚖️ FB_Winch_Symmetry — Mesure passive M1/M2
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Observateur de symétrie et de synchronisme des treuils M1/M2
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   🔒 Observateur pur : Aucune ecriture de commande, securite ou mouvement
///   =======================================================================
FUNCTION_BLOCK FB_Winch_Symmetry
VAR_INPUT
	///=== COMMANDES ET CONSIGNES ===
	///--&gt; [CMD] Reinitialisation des mesures sur front
	Reset: BOOL;
	///--&gt; [CMD] Commande active sur treuil M1
	M1CommandActive: BOOL;
	///--&gt; [CMD] Commande active sur treuil M2
	M2CommandActive: BOOL;
	///--&gt; [CMD] Sens commande M1 (-1/0/+1)
	M1Direction: INT;
	///--&gt; [CMD] Sens commande M2 (-1/0/+1)
	M2Direction: INT;
	///=== FEEDBACKS HARWARE ET FREINS ===
	///--&gt; [HW] Ordre ouverture frein M1
	M1BrakeCmd: BOOL;
	///--&gt; [HW] Ordre ouverture frein M2
	M2BrakeCmd: BOOL;
	///--&gt; [HW] Etat frein M1 serre
	M1BrakeApplied: BOOL;
	///--&gt; [HW] Etat frein M2 serre
	M2BrakeApplied: BOOL;
	///=== MESURES POSITIONS ET VITESSES ===
	///--&gt; [HW] Position mesuree M1 (m)
	M1Position_M: REAL;
	///--&gt; [HW] Position mesuree M2 (m)
	M2Position_M: REAL;
	///--&gt; [HW] Vitesse mesuree M1 (m/s)
	M1Speed_Mps: REAL;
	///--&gt; [HW] Vitesse mesuree M2 (m/s)
	M2Speed_Mps: REAL;
	///--&gt; [HW] Ecart instantane synchro (m)
	SyncDeviation_M: REAL;
	///=== CONFIGURATION ===
	///--&gt; [CFG] Configuration des seuils de symetrie
	Config: ST_fbWinch_Symmetry_Cfg;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC ET SYNOPTIQUE ===
	///&lt;-- [STAT] Symetrie globale conforme aux criteres
	SymmetryOk: BOOL;
	///&lt;-- [STAT] Mesure de symetrie valide et calculee
	SymmetryValid: BOOL;
END_VAR
VAR_IN_OUT
	///=== STRUCTURES DE DONNÉES PARTAGÉES ===
	///&lt;-&gt; [BUS] Donnees de mesures de symetrie
	Data: ST_fbWinch_Symmetry_Data;
END_VAR
VAR
	///=== SOUS-INSTANCES FB ===
	///* [INST] Detecteur front reinitialisation
	ResetEdge: R_TRIG;
	///* [INST] Calcul du temps de cycle
	CycleTime: FB_CycleTime;
	///=== TIMERS INTERNES ===
	///. [LOC] Tempo qualification commande stable
	CommandTon: TON;
	///. [LOC] Chronometre de mouvement
	MotionTimer: TON;
	///. [LOC] Chronometre d'arret
	StopTimer: TON;
	///=== VARIABLES LOCALES CALCULÉES ===
	///. [LOC] Conditions de comparaison remplies
	Comparable: BOOL;
	///. [LOC] Phase de mesure qualifiee
	Qualified: BOOL;
	///. [LOC] Etat qualifie cycle precedent
	PreviousQualified: BOOL;
	///. [LOC] Phase d'arret en cours
	Stopping: BOOL;
	///. [LOC] Top depart capture M1
	StartCapturedM1: BOOL;
	///. [LOC] Top depart capture M2
	StartCapturedM2: BOOL;
	///. [LOC] Top arret capture M1
	StopCapturedM1: BOOL;
	///. [LOC] Top arret capture M2
	StopCapturedM2: BOOL;
	///. [LOC] Horodatage d'ouverture M1 (ms)
	StartMsM1: UDINT;
	///. [LOC] Horodatage d'ouverture M2 (ms)
	StartMsM2: UDINT;
	///. [LOC] Temps de desserrage frein M1 (ms)
	ReleaseMsM1: UDINT;
	///. [LOC] Temps de desserrage frein M2 (ms)
	ReleaseMsM2: UDINT;
	///. [LOC] Temps de serrage frein M1 (ms)
	ApplyMsM1: UDINT;
	///. [LOC] Temps de serrage frein M2 (ms)
	ApplyMsM2: UDINT;
	///. [LOC] Horodatage d'arret M1 (ms)
	StopMsM1: UDINT;
	///. [LOC] Horodatage d'arret M2 (ms)
	StopMsM2: UDINT;
	///. [LOC] Position debut d'arret M1 (m)
	StopStartM1_M: REAL;
	///. [LOC] Position debut d'arret M2 (m)
	StopStartM2_M: REAL;
END_VAR
</Single>
