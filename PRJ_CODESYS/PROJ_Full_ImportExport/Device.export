      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
// === IMPLEMENTATION ===
CheckTrig(CLK := CheckRequested);

IF CheckTrig.Q THEN
    IF NOT SimulationModeActive THEN
        FixturePassed := FALSE;
        FixtureFailed := TRUE;
        FailReason := 'Simulation non active (GVL_Simulation.SimulationModeActive=FALSE)';
    ELSIF NOT SimGateOk THEN
        FixturePassed := FALSE;
        FixtureFailed := TRUE;
        FailReason := 'E/S M3 recablees reelles (*IsReal) incompatibles avec le banc de test';
    ELSE
        FixturePassed := TRUE;
        FixtureFailed := FALSE;
        FailReason := '';
    END_IF;
END_IF;
</Single>
