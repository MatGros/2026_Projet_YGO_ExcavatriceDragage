            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⏱️ FB_CycleTime — Mesure du temps de cycle réel de la tâche
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.0.md §2
///      (base de temps utilisée par FB_Filter_PT1, composé dans FB_Joystick)
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_CycleTime
VAR_INPUT
	///Valeur de secours par défaut (ex. 4ms)
	DefaultValueS: REAL := 0.004;
END_VAR
VAR_OUTPUT
	///Temps écoulé réel calculé (secondes)
	CycleTimeS: REAL;
END_VAR
VAR
	///Temps système actuel
	TimeCurrent: TIME;
	///Empreinte de temps du cycle précédent
	TimeLast: TIME;
	///Écart brut calculé (ms)
	DeltaTimeMs: UDINT;
	///Drapeau d'initialisation du premier cycle
	InitDone: BOOL;
END_VAR
</Single>
