            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_TestFailReason :
(
	FAIL_NONE := 0,
	///TimeoutPT écoulé sans pass (couvre "trop tard")
	FAIL_TIMEOUT := 1,
	///CHECK_INSTANT faux, ou NEVER_DURING violé
	FAIL_CHECK := 2,
	///Invariant multi-étapes violé (voir FailedInvariantId)
	FAIL_INVARIANT := 3,
	///Pass survenu AVANT MinPT (réaction trop rapide = anormale)
	FAIL_WINDOW_EARLY := 4,
	///Abort commandé ou gate simulation perdu
	FAIL_ABORTED := 5
);
END_TYPE
</Single>
