        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_AxisScale
VAR_INPUT
    RawIn       : INT;        // Valeur brute (0..10000)
    Neutral     : INT;        // Point milieu calibré
    Deadband    : REAL;       // Zone morte en %
END_VAR
VAR_OUTPUT
    OutPct      : REAL;       // Valeur finale (-100.0..100.0)
END_VAR
VAR
    Delta       : REAL;
END_VAR</Single>
