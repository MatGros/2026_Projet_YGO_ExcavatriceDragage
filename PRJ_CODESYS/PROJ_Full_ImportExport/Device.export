	///Retour défaut électrique crible (NC)
	SifterFaultOk: BOOL;
	///🔗 Divers
	///Commande ouverture grille
	GridOpenCmd: BOOL;
	///Commande fermeture casque
	HelmetCloseCmd: BOOL;
END_VAR
VAR_OUTPUT
END_VAR
