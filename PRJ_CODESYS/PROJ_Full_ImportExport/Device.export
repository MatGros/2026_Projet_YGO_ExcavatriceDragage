      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_WinchHMI — Données d'échange IHM pour un treuil (M1: moteur de retenue / M2: moteur Benne)
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des bargraphes, LEDs, mesures et réglages.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_WinchHMI :
STRUCT
	///⚙️ Paramètres / Calibration (Lecture/Écriture)
	///📐 Position cible du capteur haut (m)
	TopSensorPositionM: REAL := 8.5;
	///🔧 Cible libre Homing unitaire MAINT_N2 [-99..+99 m]
	HomingTargetM: REAL := 0;
	///🛑 Limitation palier vitesse en descente (1..5) — 🔧 REX 2026-07-08 :
	MaxStepDescente: INT := 3;
	///📈 Rampe d'accélération (%/s)
	RampAccelRate: REAL := 50;
	///📉 Rampe de décélération normale (%/s)
	RampDecelNormalRate: REAL := 150;
	///⚡ Rampe de décélération rapide / SafeStop (%/s)
	RampDecelFastRate: REAL := 400;
	///📐 Limite basse physique de descente (m, négatif)
	CableLimitDescentM: REAL := -20;
	///📐 REX 2026-07-15 (6) : limite haute d'exploitation NORMALE (m) —
	CableLimitAscentM: REAL := 8;
	///📏 Distance avant limite pour enclencher le ralentissement (m)
	SlowdownDistanceM: REAL := 1;
	///📉 Vitesse de consigne lente dans la zone de ralentissement (%)
	SlowSpeedPct: REAL := 15;
	///🚦 États &amp; Mesures (Lecture seule)
	///📊 Position actuelle du câble (mètres)
	PositionM: REAL;
	///📏 Vitesse linéaire mesurée du câble (m/s), valeur absolue
	MeasuredSpeedMps: REAL;
	///🔍 Variation de vitesse entre deux scans (m/s)
	SpeedDeltaMps: REAL;
	///🔍 Seuil de variation dépassé sur le scan courant
	SpeedVariationDetected: BOOL;
	///🛡️ Variation confirmée pendant la durée paramétrée
	SpeedVariationConfirmed: BOOL;
	///🟢 Vitesse stable pendant la durée paramétrée
	SpeedStable: BOOL;
	///🔴 Défaut mémorisé du moniteur vitesse
	SpeedMonitorError: BOOL;
	///❌ Bitfield du moniteur vitesse
	SpeedMonitorErrorId: WORD;
	///📊 Estimation empirique, non certifiée
	EstimatedLoadPct: REAL;
	///🟢 Table charge validée pour lecture
	LoadEstimateConfigured: BOOL;
	///🛡️ Palier limité par vitesse réelle
	SpeedGuardLimited: BOOL;
	///📈 Consigne de vitesse finale après rampe (%)
	SpeedRefPct: REAL;
	///🔢 Palier de vitesse actif (0..5)
	StepNumber: INT;
	///🤖 État de l'automate interne (FB_Winch)
	FBState: E_State;
	///🟢 Treuil prêt à fonctionner
	Ready: BOOL;
	///⚙️ Mouvement en cours
	Busy: BOOL;
	///✅ Action terminée
	Done: BOOL;
	///🔴 Treuil en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut treuil
	ErrorId: WORD;
	///🔌 Sorties Physiques / Indicateurs LEDs
	///🛗 Relais Montée activé
	RelayFwd: BOOL;
	///🛗 Relais Descente activé
	RelayRev: BOOL;
	///🔌 Contacteur vitesse palier 1
	Contactor1: BOOL;
	///🔌 Contacteur vitesse palier 2
	Contactor2: BOOL;
	///🔌 Contacteur vitesse palier 3
	Contactor3: BOOL;
	///🔌 Contacteur vitesse palier 4
	Contactor4: BOOL;
	///🔓 Commande frein (TRUE = desserré / libre)
	BrakeCmd: BOOL;
	///🛡️ Sécurités &amp; Diagnostics
	///🎯 Prise d'origine (Homing) validée
	Homed: BOOL;
	///⏳ Référencement en cours
	HomingBusy: BOOL;
	///✅ Pulse de référencement réussi
	HomingDone: BOOL;
	///🔴 Défaut de référencement
	HomingError: BOOL;
	///❌ Bitfield défaut homing
	HomingErrorId: WORD;
	///🤖 État FB_Encoder_Homing
	HomingState: E_State;
	///🧭 État lors du défaut
	HomingStateAtError: E_State;
	///⚠️ Référence à confirmer
	HomingSuspect: BOOL;
	///📐 Référence brute appliquée
	HomingRefRaw: UDINT;
	///🟧 Arrêt rapide activé par la sécurité
	SafeStopActive: BOOL;
	///🚯 Descente interdite (détecteur mou de câble / limites)
	ForbidDescentActive: BOOL;
	///🚯 Montée interdite (fin de course haut)
	ForbidAscentActive: BOOL;
	///⚠️ Mou de câble physiquement détecté
	SlackCableDetected: BOOL;
	///🔥 Défaut surchauffe thermique moteur
	ThermalFault: BOOL;
	///🔌 Perte de liaison ou incohérence codeur
	EncoderFault: BOOL;
	///⚠️ Longueur max de câble atteinte (limite basse physique)
	CableLimitDescentReached: BOOL;
	///⚠️ REX 2026-07-15 (8) : limite haute d'exploitation normale atteinte (CableLimitAscentM)
	CableLimitAscentReached: BOOL;
	///🧲 Données d'échange et diagnostic du codeur
	Encoder: ST_EncoderHMI;
	///🔍 Diagnostics de cohérence contacteurs réutilisés
	///🔌 REX 2026-07-07 : coherence contacteurs sens+vitesse
	ContactorsCheck: ST_ContactorCheck;
	///🔌 Coherence retour frein
	BrakeContactorCheck: ST_ContactorCheck;
	///🎮 Commandes Opérateur (Boutons tactiles)
	///🔑 Demande reset exposée par treuil ; agrégée dans le reset domaine partagé
	CmdReset: BOOL;
	///🎯 Homing nominal si Couplé, unitaire si M1/M2 sélectionné en MAINT_N2
	CmdHome: BOOL;
	///🔓 Confirmation de cohérence au démarrage
	ConfirmCoherence: BOOL;
	///🆕 REX 2026-07-08 : bouton IHM inhibition treuil — mise en service,
	CmdInhibit: BOOL;
	///🐞 Bypasses de Test (Visualisation / Forçage)
	///🔌 Bypass retours contacteurs (banc de test)
	BypassContactorFeedback: BOOL;
	///⚠️ Bypass capteur mou de câble (banc de test)
	BypassSlackCable: BOOL;
	///📐 Bypass capteur position haute (banc de test)
	BypassTopPositionSensor: BOOL;
	///🛡️ Bloc sécurité (Safety) en défaut
	SafetyError: BOOL;
	///❌ Code bitfield du défaut de sécurité
	SafetyErrorId: WORD;
	///🆕 REX 2026-07-08 : miroir lecture seule — confirme que
	InhibitActive: BOOL;
	///🆕 REX 2026-07-08 : dérive mesurée Méca A (m) — réglage UncommandedDriftToleranceM
	MecaADriftM: REAL;
	///🆕 REX 2026-07-08 : dérive mesurée Méca C (m, benne M1) — réglage BenneSlipToleranceM
	MecaCDriftM: REAL;
	///🆕 REX 2026-07-08 : temps écoulé confirmation contacteurs/frein — réglage PostRampTimeout
	MecaBElapsedTime: TIME;
END_STRUCT
END_TYPE
</Single>
