      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 ST_SequencePublicState — État public et synoptique de la séquence
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Expose l'état, l'étape, le cycle de vie et les attentes opérateur du séquenceur
///   📄 Référentiel : DOC/WFLOW/CONTRACTS/INTERPRG_CONTRACT_PRG03_MODES_CYCLE_v1.0.md
///   =======================================================================
TYPE ST_SequencePublicState :
STRUCT
	///Séquenceur disponible
	Ready: BOOL;
	///Cycle de vie IEC 61131-3 (Busy, Done)
	Lifecycle: ST_Lifecycle;
	///Défaut transverse (Error, ErrorId)
	Fault: ST_Fault;
	///Identifiant séquence active
	SequenceId: E_ProgramSequence;
	///Étape active du Grafcet
	Step: E_CycleStep;
	///Étape mémorisée au défaut
	StepAtFault: E_CycleStep;
	///Identifiant action opérateur requise
	OperatorActionId: WORD;
	///Message explicatif pour l'IHM
	OperatorAction: STRING(120);
	///Organe joystick/bouton attendu
	ExpectedAxis: E_OperatorAxis;
	///Sens attendu (-1, 0, +1)
	ExpectedDirection: INT;
	///En attente action opérateur
	WaitingForOperator: BOOL;
	///En attente condition procédé
	WaitingForProcess: BOOL;
	///Demande de mouvement active
	RequestActive: BOOL;
	///Libellé en clair de l'étape
	StepStr: STRING(80);
	///Écart absolu vitesse M1/M2 (m/s)
	SpeedMismatchMps: REAL;
	///Seuil vitesse dépassé
	SpeedMismatchActive: BOOL;
	///Écart vitesse confirmé pendant timeout
	SpeedMismatchConfirmed: BOOL;
	///=== 🤿 ÉTATS ASSISTANTS DE DRAGAGE (CENTRALISÉS PRG_03) ===
	///Assistance plongée prête
	DiveReady: BOOL;
	///Assistance plongée active
	DiveBusy: BOOL;
	///Assistance plongée terminée
	DiveDone: BOOL;
	///Défaut assistance plongée
	DiveError: BOOL;
	///Code défaut plongée
	DiveErrorId: WORD;
	///Phase interne de recherche fond Kobold
	DiveState: E_DiveSearchState;
	///Phase interne mémorisée au défaut plongée
	DiveStepAtFault: E_DiveSearchState;
	///Contact fond Kobold confirmé
	BottomTouchConfirmed: BOOL;
	///Assistance extraction prête
	ExtractionReady: BOOL;
	///Assistance extraction active
	ExtractionBusy: BOOL;
	///Assistance extraction terminée
	ExtractionDone: BOOL;
	///Défaut assistance extraction
	ExtractionError: BOOL;
	///Code défaut extraction
	ExtractionErrorId: WORD;
	///Phase interne séquence extraction
	ExtractionState: E_ExtractionSequenceState;
	///Phase interne mémorisée au défaut extraction
	ExtractionStepAtFault: E_ExtractionSequenceState;
	///Option vidage trémie armée IHM
	DumpAtTremieArmed: BOOL;
	///Assistance vidage trémie active
	DumpAtTremieAssistActive: BOOL;
	///Chariot M3 positionné à la trémie
	DumpAtTremieAtTremie: BOOL;
	///Commande ouverture benne à la trémie
	DumpAtTremieBucketOpenArmed: BOOL;
	///Descente treuil verrouillée à la trémie
	DumpAtTremieDescentLocked: BOOL;
	///Bypass séquence plongée armé
	BypassDiveActive: BOOL;
	///Fond touché sous bypass
	BypassKoboldBottomTouched: BOOL;
END_STRUCT
END_TYPE
</Single>
