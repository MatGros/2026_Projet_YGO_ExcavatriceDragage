      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_CycleStep :
(
	///Début de graphe : à la TRÉMIE, treuils en position HAUTE
	X0_PREPARATION := 0,
	///Vitesses lentes pour chercher capteur top + référencement
	X1_HOMING := 1,
	///Sélection cible Trémie/P1/Maintenance + translation validée
	X2_WORK_POS_SELECT := 2,
	///Ouverture benne (si déjà ouverte -&gt; passe vite)
	X3_OPEN_BUCKET := 3,
	///Plongée benne ouverte, M1+M2 synchro, Kobold mesure ON
	X4_DESCEND_OPEN := 4,
	///Fond validé (FB_DiveSearch) ; arrêt descente
	X5_BOTTOM_CONFIRMED := 5,
	///Fermeture benne — tolérance « à peu près fermé »
	X6_CLOSE_BUCKET := 6,
	///Remontée palier 1 de contrôle
	X7_CTRL_ASCENT := 7,
	///Remontée nominale jusqu'à limite haute
	X8_ASCENT_LOADED := 8,
	///Égouttage temporisé — temps affiché IHM
	X9_DRAIN_PAUSE := 9,
	///Translation vers trémie + avertissements IHM
	X10_TRANSLATE_DUMP := 10,
	///Ouverture benne = vidage ; montée possible, descente ouvre
	X11_OPEN_DUMP := 11,
	///Fin de cycle, synchronisation finale (R4) + compteur
	X13_DONE_SYNC := 13,
	///État d'attente/stabilisation — pas une erreur
	STABILIZING := 14
);
END_TYPE
</Single>
