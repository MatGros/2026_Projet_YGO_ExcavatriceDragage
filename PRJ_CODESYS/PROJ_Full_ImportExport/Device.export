        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639237203754005027</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

IF NOT Enable THEN
    ShapedStep := 0;
    StepDelay(IN := FALSE);
    StepDelayElapsed := T#0s;
    RETURN;
END_IF;

// Temporisation : compte quand la cible est au-dessus du palier courant
StepDelay(
    IN := (TargetStep &gt; ShapedStep) AND (ShapedStep &gt; 0),
    PT := StepRampDelay
);
StepDelayElapsed := StepDelay.ET;

// Cadencement asymetrique : montee +1 cran / StepRampDelay, descente immediate
IF TargetStep = 0 THEN
    ShapedStep := 0;
ELSIF TargetStep &lt; ShapedStep THEN
    ShapedStep := TargetStep;
ELSIF TargetStep &gt; ShapedStep THEN
    IF ShapedStep = 0 THEN
        ShapedStep := 1;
    ELSIF StepDelay.Q THEN
        ShapedStep := ShapedStep + 1;
    END_IF;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">5211abe0-7c8a-48a1-a489-2d414a62ed53_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ FB_WinchStepShaper — Cadencement de palier (montee cadencee)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Cadence la montee de palier (+1 cran / StepRampDelay),
///             descente immediate a 0 (aucune rampe descendante)
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   🔌 Interface : Brique technique (contrat light, pas de defaut)
///   🔒 Sécurité : D10 — StepRampDelay dedie, decouple des delais direction
///   =======================================================================
FUNCTION_BLOCK FB_WinchStepShaper
VAR_INPUT
	///--&gt; [CMD] Autorisation FB (TRUE = actif)
	Enable: BOOL;
	///--&gt; [CMD] Palier cible demande
	TargetStep: INT;
	///--&gt; [CFG] Delai de cadence montee de palier
	StepRampDelay: TIME;
END_VAR
VAR_OUTPUT
	///&lt;-- [DIAG] Palier metier temporise actif
	ShapedStep: INT;
	///&lt;-- [DIAG] Ecoule tempo metier palier
	StepDelayElapsed: TIME;
END_VAR
VAR
	///. [LOC] Temporisation hausse de palier
	StepDelay: TON;
END_VAR
</Single>
