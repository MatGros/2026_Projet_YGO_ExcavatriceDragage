          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧲 ST_AcquisitionInterPrg — Bus d'échange inter-PRG produit par PRG_02_Acquisition
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Encapsuler les mesures câbles/vitesses, les états joystick qualifiés,
///      les positions M3 et les diagnostics DI publiés par PRG_02_Acquisition vers
///      les consommateurs (PRG_03/04/05/07, FB_TroubleshootingView).
///   📤 Producteur unique : PRG_02_Acquisition (VAR_OUTPUT Data : ST_AcquisitionInterPrg).
///   📄 Doc : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.3.md
///   🔌 Architecture : Bus de données typé — encapsulation des échanges inter-PRG.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_AcquisitionInterPrg :
STRUCT
	///=== 🧲 Mesures câbles &amp; vitesses treuils M1/M2 ===
	///📏 Position cable M1 calibree (metres)
	CablePosM1: REAL;
	///📏 Position cable M2 calibree (metres)
	CablePosM2: REAL;
	///📏 Vitesse absolue M1 (m/s)
	M1_Speed_Mps: REAL;
	///📏 Vitesse signee M1 (+:Montee, -:Descente) (m/s)
	M1_SignedSpeed_Mps: REAL;
	///🟢 Validite mesure vitesse M1
	M1_SpeedValid: BOOL;
	///📏 Vitesse absolue M2 (m/s)
	M2_Speed_Mps: REAL;
	///📏 Vitesse signee M2 (+:Montee, -:Descente) (m/s)
	M2_SignedSpeed_Mps: REAL;
	///🟢 Validite mesure vitesse M2
	M2_SpeedValid: BOOL;
	///=== 🕹️ États joystick qualifiés ===
	///🔒 Homme-mort joystick arme (1=Arme)
	JoystickDeadmanArmed: BOOL;
	///🟢 Axe Y joystick au neutre
	JoystickYNeutral: BOOL;
	///🎯 Sens X demande (-1:Gauche, 0:Neutre, 1:Droite)
	JoystickDirectionX: INT;
	///📈 Magnitude deviation axe X en % (0..100)
	JoystickSpeedPctX: REAL;
	///🟢 Axe X joystick au neutre
	JoystickXNeutral: BOOL;
	///=== 🎯 Positions translation M3 (zones cumulatives + points exacts) ===
	///📍 Zone Tremie (1=Present)
	TranslationPosTremie: BOOL;
	///📍 Zone pre-ralentissement PV (1=Present)
	TranslationPosPV: BOOL;
	///📍 Zone P2 (1=Present)
	TranslationPosP2: BOOL;
	///📍 Zone P1 (1=Present)
	TranslationPosP1: BOOL;
	///📍 Zone Maintenance (1=Present)
	TranslationPosMaintenance: BOOL;
	///🎯 Position exacte Tremie (1=Atteint)
	TranslationAtTremie: BOOL;
	///🎯 Position exacte PV (1=Atteint)
	TranslationAtPV: BOOL;
	///🎯 Position exacte P2 (1=Atteint)
	TranslationAtP2: BOOL;
	///🎯 Position exacte P1 (1=Atteint)
	TranslationAtP1: BOOL;
	///🎯 Position exacte Maintenance (1=Atteint)
	TranslationAtMaintenance: BOOL;
	///🛡️ Fin de course avant M3 (1=Actionne)
	M3_LimitSwitchFwd: BOOL;
	///🛡️ Fin de course arriere M3 (1=Actionne)
	M3_LimitSwitchRev: BOOL;
	///❌ Incoherence detectee mot capteurs M3
	M3_SensorWordIncoherent: BOOL;
	///📊 Mot d'etat capteurs M3
	M3_SensorsWord: BYTE;
	///=== 🩺 Diagnostics modules DI &amp; codeurs ===
	///🟢 Module Local_Digital_IO OK
	LocalDigitalIoOk: BOOL;
	///🟢 Module VH_0800END OK
	Vh0800EndOk: BOOL;
	///🟢 Module VH_0808ETP OK
	Vh0808EtpOk: BOOL;
	///❌ Defaut sur au moins un module DI
	InputModuleFault: BOOL;
	///❌ Mesure codeur M1 incoherente
	M1_EncoderIncoherent: BOOL;
	///❌ Mesure codeur M2 incoherente
	M2_EncoderIncoherent: BOOL;
	///❌ Gate fiabilite M1 (NOT Available OR Incoherent, sans Homed)
	M1_EncoderFault: BOOL;
	///❌ Gate fiabilite M2 (NOT Available OR Incoherent, sans Homed)
	M2_EncoderFault: BOOL;
	///✅ Gate strict M3 M1 : dispo ET reference ET pas incoherent
	M1_HomedAndReliable: BOOL;
	///✅ Gate strict M3 M2 : dispo ET reference ET pas incoherent
	M2_HomedAndReliable: BOOL;
	///=== 🧪 Simulation &amp; variateur M3 filtré ===
	///🔀 Impulsion 1 cycle si source Winch bascule (IHM)
	WinchInputSourceChanged: BOOL;
	///📊 Mot d'etat variateur M3 filtre (consommé PRG_05)
	M3_StatusWord_Filtered: UINT;
	///📊 Frequence reelle M3 filtree (consommé PRG_05)
	M3_ActualFrequencyHz_Filtered: UINT;
END_STRUCT
END_TYPE
</Single>
