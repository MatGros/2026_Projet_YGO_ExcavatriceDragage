      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

IF RawIn &gt;= Neutral THEN
    Delta := INT_TO_REAL(10000 - Neutral);
    IF Delta &gt; 0.0 THEN
        OutPct := (INT_TO_REAL(RawIn - Neutral) / Delta) * 100.0;
    ELSE
        OutPct := 0.0;
    END_IF;
ELSE
    Delta := INT_TO_REAL(Neutral);
    IF Delta &gt; 0.0 THEN
        OutPct := (INT_TO_REAL(RawIn - Neutral) / Delta) * 100.0;
    ELSE
        OutPct := 0.0;
    END_IF;
END_IF;

IF ABS(RawIn - Neutral) &lt;= DeadbandRaw THEN
    OutPct := 0.0;
END_IF;

// 🛡️ Limitation de plage : une valeur brute hors plage nominale ne doit jamais
// produire une consigne supérieure à ±100 %. Ce garde-fou protège les
// consommateurs en aval, notamment la translation M3.
OutPct := LIMIT(-100.0, OutPct, 100.0);
</Single>
            <Single Name="LineInfoPersistence" Type="string">f6f4f9cc-9dd2-44c1-a6f6-ff324c344cb3_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ FB_AxisScale — Normalisation et zone morte d'un axe joystick
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Normalise une valeur brute (0..10000) selon le neutre calibré
///             et applique une zone morte en unités brutes (compte ADC).
///   🛡️ Garde-fou : Saturation stricte de la consigne à +/-100.0 %.
///   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.5.md (F08.02)
///   =======================================================================
FUNCTION_BLOCK FB_AxisScale
VAR_INPUT
	///=== ENTRÉES MESURÉES &amp; CONFIGURATION ===
	///--&gt; [HW]  Valeur brute potentiometre/Hall (0..10000)
	RawIn: INT;
	///--&gt; [CFG] Point milieu calibre (compte brut ADC)
	Neutral: INT;
	///--&gt; [CFG] Zone morte en unites brutes ADC (ex: 300)
	DeadbandRaw: INT;
END_VAR
VAR_OUTPUT
	///=== CONSIGNES CALCULÉES ===
	///&lt;-- [STAT] Consigne d'axe mise a l'echelle (-100.0..+100.0 %)
	OutPct: REAL;
END_VAR
VAR
	///=== VARIABLES LOCALES INTERNES ===
	///. [LOC]  Amplitude utile de la demi-plage d'axe
	Delta: REAL;
END_VAR
</Single>
