            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_WinchSymmetryHMI :
STRUCT
	BtnReset: BOOL;
	SymmetryOk: BOOL;
	SymmetryValid: BOOL;
	DeltaStartDelay_Ms: UDINT;
	DeltaBrakeReleaseTime_Ms: UDINT;
