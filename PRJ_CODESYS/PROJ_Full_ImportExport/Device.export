        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔀 FB_SyncContactor — Coherence commandes/contacteurs M1/M2
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Detecter une discordance entre les commandes/contacteurs des
///      2 treuils (sens + paliers). Independante des codeurs — surveillable
///      meme si les codeurs sont bypasses.
///   🔌 Interface : Bloc de surveillance transverse (1 instance)
///   🔒 Polarite : ContactorMismatch = TRUE si discordance confirmee.
///   📄 Doc : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   =======================================================================
FUNCTION_BLOCK FB_SyncContactor
VAR_INPUT
	///=== COMMANDES ET CONSIGNES ===
	///--&gt; [CMD] Validation surveillance globale
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut sur front
	Reset: BOOL;
	///--&gt; [CMD] Autorisation utilisateur synchro
	SyncEnable: BOOL;
	///=== COMMANDES ET FEEDBACKS ACTIONS ===
	///--&gt; [HW] Feedback/Ordre montee M1
	RelayFwdM1: BOOL;
	///--&gt; [HW] Feedback/Ordre montee M2
	RelayFwdM2: BOOL;
	///--&gt; [HW] Feedback/Ordre descente M1
	RelayRevM1: BOOL;
	///--&gt; [HW] Feedback/Ordre descente M2
	RelayRevM2: BOOL;
	///--&gt; [HW] Contacteur palier 1 M1
	Contactor1_M1: BOOL;
	///--&gt; [HW] Contacteur palier 1 M2
	Contactor1_M2: BOOL;
	///--&gt; [HW] Contacteur palier 2 M1
	Contactor2_M1: BOOL;
	///--&gt; [HW] Contacteur palier 2 M2
	Contactor2_M2: BOOL;
	///--&gt; [HW] Contacteur palier 3 M1
	Contactor3_M1: BOOL;
	///--&gt; [HW] Contacteur palier 3 M2
	Contactor3_M2: BOOL;
	///--&gt; [HW] Contacteur palier 4 M1
	Contactor4_M1: BOOL;
	///--&gt; [HW] Contacteur palier 4 M2
	Contactor4_M2: BOOL;
	///=== BYPASSES ET SIMULATION ===
	///--&gt; [TST] Neutralise la surveillance contacteurs
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	///=== RESULTAT ===
	///&lt;-- [SAFE] Discordance commande/contacteurs confirmee
	ContactorMismatch: BOOL;
END_VAR
VAR
	///=== DETECTEURS ET TIMERS INTERNES ===
	///. [LOC] Tempo filtrage incoherence commande
	MismatchTimer: TON;
	///=== VARIABLES LOCALES INTERNES ===
	///. [LOC] Discordance commande active
	MismatchActive: BOOL;
END_VAR
</Single>
