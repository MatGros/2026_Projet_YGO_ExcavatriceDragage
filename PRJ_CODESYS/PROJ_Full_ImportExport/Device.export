          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧲 ST_AcquisitionInterPrg — Bus d'échange inter-PRG produit par PRG_02_Acquisition
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Encapsuler les mesures câbles/vitesses, les états joystick qualifiés,
///      les positions M3 et les diagnostics DI publiés par PRG_02_Acquisition vers
///      les consommateurs (PRG_03/04/05/07, FB_TroubleshootingView).
///   📤 Producteur unique : PRG_02_Acquisition (VAR_OUTPUT Data : ST_AcquisitionInterPrg).
///   📄 Doc : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.4.md
///   🔌 Architecture : Bus de données typé — encapsulation des échanges inter-PRG.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_AcquisitionInterPrg :
STRUCT
	///=== 🛡️ Drapeau de vie &amp; validité globale des données ===
	///🟢 TRUE = PRG_02 a complété son scan et les données sont fraîches et qualifiées
	DataValid: BOOL;
	///=== 📦 Structures qualifiées du bus ===
	///🕹️ Données et commandes joystick qualifiées
	Joystick: ST_AcquisitionJoystickQualified;
	///🔌 Diagnostics réseaux CANopen et EtherCAT
	Network: ST_AcquisitionNetworkDiagnostics;
	///🧲 Façade codeur qualifiée M1 (Retenue)
	EncoderM1: ST_AcquisitionEncoderQualified;
	///🧲 Façade codeur qualifiée M2 (Benne)
	EncoderM2: ST_AcquisitionEncoderQualified;
	///=== 🧲 Mesures codeurs M1/M2 (compatibilité de transition) ===
	///📊 Mesures + statuts codeurs M1/M2 (sous-DUT)
	Encoders: ST_EncoderMeasurements;
	///=== 🛡️ Gates fiabilité codeurs (compatibilité de transition) ===
	///❌ Gate fiabilite M1 (NOT Available OR Incoherent, sans Homed)
	M1_EncoderFault: BOOL;
	///❌ Gate fiabilite M2 (NOT Available OR Incoherent, sans Homed)
	M2_EncoderFault: BOOL;
	///✅ Gate strict M3 M1 : dispo ET reference ET pas incoherent
	M1_HomedAndReliable: BOOL;
	///✅ Gate strict M3 M2 : dispo ET reference ET pas incoherent
	M2_HomedAndReliable: BOOL;
	///=== 🕹️ États joystick qualifiés (compatibilité de transition) ===
	///🔒 Homme-mort joystick arme (1=Arme)
	JoystickDeadmanArmed: BOOL;
	///🟢 Axe Y joystick au neutre
	JoystickYNeutral: BOOL;
	///🎯 Sens X demande (-1:Gauche, 0:Neutre, 1:Droite)
	JoystickDirectionX: INT;
	///📈 Magnitude deviation axe X en % (0..100)
	JoystickSpeedPctX: REAL;
	///🟢 Axe X joystick au neutre
	JoystickXNeutral: BOOL;
	///=== 🩺 Diagnostics modules E/S ===
	///🟢 Module Local_Digital_IO OK (DI8/DO8)
	LocalDigitalIoOk: BOOL;
	///🟢 Module VH_0800END OK (DI8)
	Vh0800EndOk: BOOL;
	///🟢 Module VH_0808ETP OK (DI8/DO8)
	Vh0808EtpOk: BOOL;
	///🟢 Module VH_0008ER OK (DO8 Relais Freins/Kobold)
	Vh0008ErOk: BOOL;
	///🟢 Module VH_0008ER_1 OK (DO8 Relais AU/PowerKeepAlive)
	Vh0008Er1Ok: BOOL;
	///❌ Defaut sur au moins un module E/S
	InputModuleFault: BOOL;
	///=== 🧪 Simulation &amp; variateur M3 filtré ===
	///🔀 Impulsion 1 cycle si source Winch bascule (IHM)
	WinchInputSourceChanged: BOOL;
	///📊 Mot d'etat variateur M3 filtre (consommé PRG_05)
	M3_StatusWord_Filtered: UINT;
	///📊 Frequence reelle M3 filtree (consommé PRG_05)
	M3_ActualFrequencyHz_Filtered: UINT;
END_STRUCT
END_TYPE
</Single>
