            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🏗️ ST_HardwareImage — Structure globale d'image matérielle (Frontière HwIn)
///   ───────────────────────────────────────────────────────────────
///   🎨 Agrège les 4 sous-domaines matériels : Winch, Translation, Operator, Machine.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_HardwareImage :
STRUCT
	///Entrées brutes domaine Treuils M1/M2 + codeurs
	Winch: ST_HwWinch;
	///Entrées brutes domaine Translation M3 + variateur
	Translation: ST_HwTranslation;
	///Entrées brutes domaine Opérateur / Joystick / bus CAN
	Operator: ST_HwOperator;
	///Entrées brutes domaine Sécurités/Communs Machine
	Machine: ST_HwMachine;
END_STRUCT
END_TYPE
</Single>
