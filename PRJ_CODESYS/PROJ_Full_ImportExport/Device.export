            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Translation_Demandes :
STRUCT
	///[pts] Bruts Joystick Axe X
	Idx201_JoyXRaw_ANA: INT;
	///[%] Consigne Joystick Axe X (-100% à +100%)
	Idx202_JoyXScaled_Pct: REAL;
