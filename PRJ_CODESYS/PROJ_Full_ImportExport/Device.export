            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_PlcTestsCmd — Commandes de pilotage du banc de validation
///═══════════════════════════════════════════════════════════════
TYPE ST_PlcTestsCmd :
STRUCT
	///Lance tous les tests
	RunAll: BOOL;
	///&gt;0 : lance uniquement la suite N
	RunSuite: INT;
	///&gt;0 (avec RunSuite) : lance le cas N
	RunCase: INT;
	///Abandonne le test en cours
	Abort: BOOL;
	///Efface les rapports de tests
	ClearReport: BOOL;
END_STRUCT
END_TYPE
</Single>
