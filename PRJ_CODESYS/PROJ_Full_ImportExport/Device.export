          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔧 ST_SyncCfg — Configuration de la synchronisation M1/M2
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SyncCfg :
STRUCT
	///📐 Tolérance max d'écart (m) — Dégradation Palier 1 dès 0.8m
	CfgSyncTolerance_M: REAL := 0.8;
	///🚦 flag restauration boot, ex-CfgInitialized renommé pour cohérence avec ST_WinchCfg
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
