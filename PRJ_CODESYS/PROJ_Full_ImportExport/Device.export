          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_WinchState — États, mesures et diagnostics HMI pour un Treuil M1/M2
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné aux retours d'informations et bargraphes HMI.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_WinchState :
STRUCT
	///🚦 États &amp; Mesures (Lecture seule)
	///📊 Position actuelle du câble (mètres)
	Position_M: REAL;
	///📏 Vitesse linéaire mesurée du câble (m/s), valeur absolue
	MeasuredSpeed_Mps: REAL;
	///🔍 Variation de vitesse entre deux scans (m/s)
	SpeedDelta_Mps: REAL;
	///🔍 Seuil de variation dépassé sur le scan courant
	SpeedVariationDetected: BOOL;
	///🛡️ Variation confirmée pendant la durée paramétrée
	SpeedVariationConfirmed: BOOL;
	///🟢 Vitesse stable pendant la durée paramétrée
	SpeedStable: BOOL;
	///🔴 Défaut mémorisé du moniteur vitesse
	SpeedMonitorError: BOOL;
	///❌ Bitfield du moniteur vitesse
	SpeedMonitorErrorId: WORD;
	///📊 Estimation empirique, non certifiée
	EstimatedLoadPct: REAL;
	///🟢 Table charge validée pour lecture
	LoadEstimateConfigured: BOOL;
	///🛡️ Palier limité par vitesse réelle
	SpeedGuardLimited: BOOL;
	///📈 Consigne de vitesse finale après rampe (%)
	SpeedRef_Pct: REAL;
	///🔢 Palier de vitesse actif (0..5)
	StepNumber: INT;
	///🤖 État de l'automate interne (FB_Winch)
	FBState: E_State;
	///🟢 Treuil prêt à fonctionner
	Ready: BOOL;
	///⚙️ Mouvement en cours
	Busy: BOOL;
	///✅ Action terminée
	Done: BOOL;
	///🔴 Treuil en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut treuil
	ErrorId: WORD;
	///🔌 Sorties Physiques / Indicateurs LEDs
	///🛗 Relais Montée activé
	RelayFwd: BOOL;
	///🛗 Relais Descente activé
	RelayRev: BOOL;
	///🔌 Contacteur vitesse palier 1
	Contactor1: BOOL;
	///🔌 Contacteur vitesse palier 2
	Contactor2: BOOL;
	///🔌 Contacteur vitesse palier 3
	Contactor3: BOOL;
	///🔌 Contacteur vitesse palier 4
	Contactor4: BOOL;
	///🔓 Commande frein (TRUE = desserré / libre)
	BrakeCmd: BOOL;
	///🛡️ État final _LD lecture seule
	FinalInterlockState: E_WinchFinalInterlockState;
	///🛡️ Cause finale mémorisée
	FinalInterlockReason: E_WinchFinalInterlockReason;
	///🛡️ Défaut final mémorisé
	FinalInterlockError: BOOL;
	///🛡️ Bitfield final
	FinalInterlockErrorId: WORD;
	///🔒 Reset + neutre + nouvelle demande obligatoires
	FinalRestartInhibit: BOOL;
	///🔌 Contacteur/bobine desserrage confirmé, pas frein mécanique
	BrakeCommandOpenConfirmed: BOOL;
	///🪜 Palier réellement autorisé
	FinalAuthorizedStep: INT;
	///⏱️ Écoulé watchdog 500ms
	FinalBrakeTimeoutElapsed: TIME;
	///⏱️ Écoulé verrou redémarrage 900ms
	FinalRestartDelayElapsed: TIME;
	///⏱️ Écoulé entre paliers 1s250
	FinalStepDelayElapsed: TIME;
	///🛡️ Sécurités &amp; Diagnostics
	///🧲 Données d'échange et diagnostic du codeur — porte aussi les 9 champs Homing* (déplacés 2026-08, voir ST_EncoderHMI)
	Encoder: ST_EncoderHMI;
	///🔍 Diagnostics de cohérence contacteurs réutilisés
	///🔌 Coherence contacteurs sens+vitesse
	ContactorsCheck: ST_ContactorCheck;
	///🔌 Coherence retour frein
	BrakeContactorCheck: ST_ContactorCheck;
	///🆕 miroir lecture seule — inhibition arbitrée
	InhibitActive: BOOL;
	///🐢 2026-08-07 : ralentissement sur bordure — diagnostic zone/limite active
	///📏 Limite basse active (m) — câble physique OU légale, la plus restrictive
	BottomLimitActiveM: REAL;
	///🐢 Palier plafonné à 1 : approche limite haute
	InTopSlowdownZone: BOOL;
	///🐢 Palier plafonné à 1 : approche limite basse (câble ou légale)
	InBottomSlowdownZone: BOOL;
	///🩺 2026-08-07 : diagnostic retour terrain — délai ressenti à la remontée
	///🩺 Sens interne mémorisé FB_Winch (-1/0/+1)
	CommandedDirection: INT;
	///🩺 Écoulé de l'interlock changement/reprise de sens
	DirectionChangeDelayElapsed: TIME;
	///🩺 TRUE tant que CommandedDirection n'a pas rejoint Direction
	DirectionChangePending: BOOL;
END_STRUCT
END_TYPE
</Single>
