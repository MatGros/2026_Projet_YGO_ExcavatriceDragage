            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639224114393968193</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

IF NOT Enable THEN
    // Prochain démarrage déterministe sur P2, comme l'ancien modèle de banc.
    PositionProgress := CST_PositionAtP2;
    Initialized := FALSE;
    PosTremie := FALSE;
    PosPV := FALSE;
    PosP2 := FALSE;
    PosP1 := FALSE;
    PosMaintenance := FALSE;
    RETURN;
END_IF;

IF NOT Initialized THEN
    PositionProgress := CST_PositionAtP2;
    Initialized := TRUE;
END_IF;

instCycleTime(DefaultValueS := 0.010);
SpeedPctBounded := LIMIT(0.0, ABS(SpeedRefPct), 100.0);

// Une vitesse à 100 % parcourt les cinq segments uniformes pendant FullTravelTimeS.
// Direction sémantique : +1 réduit la progression vers Trémie ; -1 l'augmente vers Maintenance.
IF FullTravelTimeS &gt;= CST_MinFullTravelTimeS THEN
    PositionIncrement := (SpeedPctBounded / 100.0)
                         * (CST_PositionSegmentCount / FullTravelTimeS)
                         * instCycleTime.CycleTimeS;
ELSE
    PositionIncrement := 0.0;
END_IF;

IF Direction = 1 THEN
    PositionProgress := MAX(CST_PositionAtTremie, PositionProgress - PositionIncrement);
ELSIF Direction = -1 THEN
    PositionProgress := MIN(CST_PositionAtMaintenance, PositionProgress + PositionIncrement);
END_IF;

// Réinitialisation explicite : aucune valeur transitoire héritée d'une zone précédente.
PosTremie := FALSE;
PosPV := FALSE;
PosP2 := FALSE;
PosP1 := FALSE;
PosMaintenance := FALSE;

// Chaque intervalle correspond à un seul mot thermomètre valide.
IF PositionProgress &lt;= CST_PositionAtTremie THEN
    PosTremie := TRUE;
    PosPV := TRUE;
    PosP2 := TRUE;
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt;= CST_PositionAtPV THEN
    PosPV := TRUE;
    PosP2 := TRUE;
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt;= CST_PositionAtP2 THEN
    PosP2 := TRUE;
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt;= CST_PositionAtP1 THEN
    PosP1 := TRUE;
    PosMaintenance := TRUE;
ELSIF PositionProgress &lt; CST_PositionAtMaintenance THEN
    PosMaintenance := TRUE;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">1d167895-a168-4833-8257-1f83eb9d5da7_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 FB_Sim_Translation — Progression capteurs simulés M3
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Produit les cinq capteurs de position M3 par progression continue
///      de Trémie vers Maintenance. Le modèle ne publie que les six mots valides
///      de FB_Translation_PositionDecoder : 11111 → 01111 → 00111 → 00011 →
///      00001 → 00000.
///   🔒 Le modèle est une source d'entrée confinée derrière HwIn ; il ne pilote
///      aucune sortie réelle. Un override manuel valide est appliqué par
///      FB_SimBench, pas par ce FB.
///   📄 Docs : DOC/AF/AF_Partie-13_Fonction_Simulation_v2.3.md
///             DOC/AF/AF_Partie-11_Fonction_Translation_v2.2.md
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Sim_Translation
VAR_INPUT
	///TRUE = modèle actif
	Enable: BOOL;
	///+1 = vers Trémie ; -1 = vers Maintenance ; 0 = maintien position
	Direction: INT;
	///Magnitude commande 0..100 %, bornée avant calcul
	SpeedRefPct: REAL;
	///Temps complet Trémie→Maintenance à 100 %, simulation seulement
	FullTravelTimeS: REAL := 8;
END_VAR
VAR_OUTPUT
	///Bit4 du mot capteurs
	PosTremie: BOOL;
	///Bit3 du mot capteurs
	PosPV: BOOL;
	///Bit2 du mot capteurs (point matériel PVP2)
	PosP2: BOOL;
	///Bit1 du mot capteurs
	PosP1: BOOL;
	///Bit0 du mot capteurs
	PosMaintenance: BOOL;
END_VAR
VAR
	instCycleTime: FB_CycleTime;
	///0=Trémie ... 5=Maintenance
	PositionProgress: REAL;
	SpeedPctBounded: REAL;
	PositionIncrement: REAL;
	Initialized: BOOL := FALSE;
	CST_PositionAtTremie: REAL := 0;
	CST_PositionAtPV: REAL := 1;
	CST_PositionAtP2: REAL := 2;
	CST_PositionAtP1: REAL := 3;
	CST_PositionAtMaintenance: REAL := 5;
	CST_PositionSegmentCount: REAL := 5;
	///Protection division : modèle sans dynamique sous ce seuil
	CST_MinFullTravelTimeS: REAL := 0.1;
END_VAR
</Single>
