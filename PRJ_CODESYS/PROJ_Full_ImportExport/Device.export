      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestStepConfig — Configuration d'une étape de test
///═══════════════════════════════════════════════════════════════
TYPE ST_TestStepConfig :
STRUCT
	///Libellé IHM + rapport
	Name: STRING(32);
	///Rattachement au cas de test
	CaseId: INT;
	///Id du stimulus appliqué (0 = neutre)
	StimulusId: INT;
	///Index des checks (0 = vide)
	CheckIdx: ARRAY[1..GVL_PLC_Tests_Const.MaxChecksPerStep] OF INT;
	///Temporisation avant évaluation
	DwellPT: TIME;
	///Fenêtre temporelle minimale
	MinPT: TIME;
	///Temps limite pour réussir l'étape
	TimeoutPT: TIME;
	///Étape suivante en cas de succès (0 = fin)
	NextOnPass: INT;
	///Étape suivante en cas d'échec (souvent teardown, 0 = fin)
	NextOnFail: INT;
	///Action en cas d'échec (continuer ou arrêter la suite)
	FailAction: E_TestFailAction;
END_STRUCT
END_TYPE
</Single>
