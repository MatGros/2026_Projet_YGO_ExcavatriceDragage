        <Single Name="Timestamp" Type="long">639184353125944176</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF RawIn &gt;= Neutral THEN
    Delta := INT_TO_REAL(10000 - Neutral);
    IF Delta &gt; 0.0 THEN
        OutPct := (INT_TO_REAL(RawIn - Neutral) / Delta) * 100.0;
    ELSE
        OutPct := 0.0;
    END_IF;
ELSE
    Delta := INT_TO_REAL(Neutral);
    IF Delta &gt; 0.0 THEN
        OutPct := (INT_TO_REAL(RawIn - Neutral) / Delta) * 100.0;
    ELSE
        OutPct := 0.0;
    END_IF;
END_IF;

IF ABS(OutPct) &lt;= Deadband THEN
    OutPct := 0.0;
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">a16f2475-cdb8-4ae7-a33c-48e50ffe9125_Impl_LineIds</Single>
          </Single>
