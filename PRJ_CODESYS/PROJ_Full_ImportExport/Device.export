          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🕹️ ST_Joystick_AxisCmd — Consigne d'axe normalisée (sortie FB_Joystick)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.0.md
///                   DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
///   🎯 4 champs exactement :
///      - Enable    : Autorisation globale du pipeline
///      - StartStop : RAMPE (TRUE = accélération, FALSE = décélération normale)
///      - SpeedRef  : Consigne vitesse signée (-100.0 .. +100.0 %)
///      - Direction : Sens d'axe (-1 = Rev, 0 = Neutre, +1 = Fwd)
///   ═══════════════════════════════════════════════════════════════
TYPE ST_Joystick_AxisCmd :
STRUCT
	///Autorisation FB (FALSE = neutralisation, sorties coupées)
	Enable: BOOL;
	///TRUE = rampe accélération, FALSE = rampe décélération normale
	StartStop: BOOL;
	///Consigne vitesse SIGNÉE -100..+100 % (signe = sens, cohérent avec Direction)
	SpeedRef: REAL;
	///-1 = Rev, 0 = Neutre, +1 = Fwd
	Direction: INT;
END_STRUCT
END_TYPE
</Single>
