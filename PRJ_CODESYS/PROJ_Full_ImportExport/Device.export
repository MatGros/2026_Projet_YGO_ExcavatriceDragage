            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_ExtractionSequenceState :
(
	///Attente fond Kobold ou attestation opérateur
	WAIT_BOTTOM_CONFIRMATION := 0,
	///Prêt à fermer la benne
	READY_TO_CLOSE := 1,
	///FB_Bucket ferme M2 seul
	CLOSING_BUCKET := 2,
	///M1/M2 synchronisés au palier sans contacteur vitesse
	CONTROL_ASCENT := 3,
	///Montée couplée avec vitesse demandée opérateur
	NOMINAL_ASCENT := 4,
	///Défaut extraction, reprise interdite avant reset
	ERROR_HOLD := 5
);
END_TYPE
</Single>
