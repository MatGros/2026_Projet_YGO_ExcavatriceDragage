      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

T := TIME_TO_REAL(TimeConst) / 1000.0; // ms → s

IF T &lt;= 0.0 OR CycleTimeS &lt;= 0.0 THEN
    ValueOut := ValueIn;
ELSE
    Alpha    := CycleTimeS / (T + CycleTimeS);
    ValueOut := Alpha * ValueIn + (1.0 - Alpha) * ValueOut;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">1dd5319d-9fdd-4275-9aea-d4de7f1c9f13_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ FB_Filter — Filtre passe-bas premier ordre (PT1 numérique)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Filtre exponentiel discret y[k] = a*x[k] + (1-a)*y[k-1]
///             avec a = CycleTimeS / (T + CycleTimeS). Pass-through si T=0 ou Cycle=0.
///   📄 Domaine : CODE/A_COMMUN (fonction de filtrage générale)
///   =======================================================================
FUNCTION_BLOCK FB_Filter
VAR_INPUT
	///=== CONSIGNES DE PILOTAGE &amp; CONFIGURATION ===
	///--&gt; [CMD] Valeur brute a filtrer
	ValueIn: REAL;
	///--&gt; [CFG] Constante de temps du filtre (ex: T#200ms)
	TimeConst: TIME;
	///--&gt; [CFG] Temps de cycle reel de la tache en secondes (ex: 0.02)
	CycleTimeS: REAL;
END_VAR
VAR_OUTPUT
	///=== SORTIES LISSÉES ===
	///&lt;-- [STAT] Valeur lissee par filtre PT1
	ValueOut: REAL;
END_VAR
VAR
	///=== VARIABLES LOCALES INTERNES ===
	///. [LOC]  Constante de temps convertie en secondes
	T: REAL;
	///. [LOC]  Facteur d'attenuation du filtre exponentiel
	Alpha: REAL;
END_VAR
</Single>
