          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_TestCheck
VAR_INPUT
	Config: ST_TestCheckConfig;
	Evaluate: BOOL;
END_VAR
VAR_OUTPUT
	Passed: BOOL;
	Failed: BOOL;
	Pending: BOOL;
	FailReason: E_TestFailReason;
	ObservedBool: BOOL;
	ObservedDint: DINT;
	ObservedReal: REAL;
END_VAR
VAR_IN_OUT
	ProbeBool: ARRAY[1..GVL_PLC_Tests_Const.MaxProbeBool] OF BOOL;
	ProbeDint: ARRAY[1..GVL_PLC_Tests_Const.MaxProbeDint] OF DINT;
	ProbeReal: ARRAY[1..GVL_PLC_Tests_Const.MaxProbeReal] OF REAL;
END_VAR
VAR
	RisingTrig: R_TRIG;
	FallingTrig: F_TRIG;
	StableTimer: TON;
	EvaluateTrig: R_TRIG;
	Cond: BOOL;
	ProbeIdxLocal: INT;
END_VAR
</Single>
