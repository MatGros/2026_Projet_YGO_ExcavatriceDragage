          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔧 ST_CycleCfg — Configuration du cycle semi-automatique
///   🐛 T66 : SetDepth_M/SetOffset_M protégés par persistance GVL_PERSISTENT (voir PRG_SUPERVISION_CFC.st §2/§3)
///   ═══════════════════════════════════════════════════════════════
TYPE ST_CycleCfg :
STRUCT
	///📐 Profondeur de dragage cible (m, négative)
	SetDepth_M: REAL := -12.5;
	///📐 Décalage cible de fermeture de la benne (m)
	SetOffset_M: REAL := 1.5;
	///🚦 flag restauration boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
