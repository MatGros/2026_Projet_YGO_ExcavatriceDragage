            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚡ PRG_08_AuxiliaryControl — Gestion des Auxiliaires (Hydraulique, Crible...)
///   ───────────────────────────────────────────────────────────────
///   ⚙️ Exécuté par la tâche PLC en position 8.
///   ✅ Regroupe toutes les commandes et logiques hors-axes.
///   ═══════════════════════════════════════════════════════════════
PROGRAM PRG_08_AuxiliaryControl
VAR_INPUT
	///🌡️ Groupe Hydraulique
	///Commande démarrage centrale hydraulique
	HydraulicPumpRunCmd: BOOL;
	///Retour défaut groupe hydraulique (NC)
	HydraulicFaultOk: BOOL;
	///🌾 Crible (Sifter / Sieve)
	///Commande marche crible
