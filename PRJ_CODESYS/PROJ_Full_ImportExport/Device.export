      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Scale) ===

// 🧮 Écart signé sûr : conversion DINT AVANT soustraction (§3.1) — jamais l'inverse
RawDiff := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(HomingRefRaw);

// 📏 Formule fixe points → mètres (Partie10 §2)
IF PointsPerRev &gt; 0 THEN
    CablePosM := DINT_TO_REAL(RawDiff) * (CableM_PerRev / UDINT_TO_REAL(PointsPerRev));
ELSE
    CablePosM := 0.0;   // Garde division par zéro (PointsPerRev mal configuré)
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">ccb7d973-53c2-5255-9462-8b4a7dc68cd6_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📏 FB_Encoder_Scale — Mise à l'échelle points → mètres (1 par treuil)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md §2/§3.1
///                   DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
///   🎯 Formule : CablePosM = (RawPos - HomingRefRaw) × (CableM_PerRev / PointsPerRev)
///   🧮 Arithmétique signée sûre : conversion en DINT avant la soustraction.
///   ═══════════════════════════════════════════════════════════════
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Scale) ===
FUNCTION_BLOCK FB_Encoder_Scale
VAR_INPUT
	///Position brute (sortie FB_Encoder_Abs, déjà gelée sur doute)
	RawPos: UDINT;
	///Référence brute figée au dernier homing (ST_Encoder_Calib)
	HomingRefRaw: UDINT;
	///Câble déroulé par tour (périmètre tambour confirmé 2026-07-02, réglable site)
	CableM_PerRev: REAL := 2;
	///Résolution codeur confirmée (Partie10 §3.3)
	PointsPerRev: UDINT := 8192;
END_VAR
VAR_OUTPUT
	///Position câble en mètres, signée (+ enroulé, − sous l'eau)
	CablePosM: REAL;
END_VAR
VAR
	///Écart signé RawPos - HomingRefRaw (§3.1)
	RawDiff: DINT;
END_VAR
</Single>
