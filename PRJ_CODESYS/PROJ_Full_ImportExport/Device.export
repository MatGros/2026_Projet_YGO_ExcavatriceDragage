        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926770748972</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Homing) ===

// 🛑 1. GATE — neutralisation ; on continue toutefois d'exposer le dernier état RETAIN connu
// (FB_Encoder_Scale a besoin de HomingRefRaw même si ce FB est désactivé)
IF NOT Enable OR NOT EmergencyStopOk THEN
    PresetRequest := FALSE;
    PresetValue := 0;
    State := E_State.DISABLED;
    Ready := FALSE; Busy := FALSE; Done := FALSE;
    InitDone := FALSE;   // Force un nouveau contrôle §3.7 à la prochaine activation
    Homed := Calib.Homed;
    HomingSuspect := Calib.HomingSuspect;
    HomingRefRaw := Calib.HomingRefRaw;
    RETURN;
END_IF;

Ready := TRUE;

// 🔑 2. FRONTS
ResetEdge(CLK := Reset);
HomeEdge(CLK := Home);
ConfirmCoherenceEdge(CLK := BtnConfirmCoherence);

// 🔍 3. COHÉRENCE AU REDÉMARRAGE (§3.7) — une fois par session Enable, dès que le codeur répond
IF NOT InitDone THEN
    State := E_State.INIT;
    IF EncoderAvailable THEN
        RawDiffRestart := UDINT_TO_DINT(RawPos) - UDINT_TO_DINT(Calib.LastKnownRawPos);
        IF Calib.Homed AND (ABS(RawDiffRestart) &gt; UDINT_TO_DINT(Calib.RestartCoherenceTolerancePts)) THEN
            Calib.HomingSuspect := TRUE;
            ErrorId := ErrorId OR 16#0200;   // bit9 : incohérence codeur au redémarrage
        END_IF;
        InitDone := TRUE;
    END_IF;
ELSE
    IF State = E_State.INIT THEN State := E_State.READY; END_IF;
END_IF;

// ✅ 4. LEVÉE DU DOUTE (BtnConfirmCoherence, §3.7) — indépendant du Reset générique
IF ConfirmCoherenceEdge.Q AND (Mode = E_Mode.MAINT_N1 OR Mode = E_Mode.MAINT_N2) THEN
    Calib.HomingSuspect := FALSE;
    ErrorId := ErrorId AND 16#FDFF;   // efface bit9
END_IF;

// 🎯 5. DEMANDE DE RÉFÉRENCEMENT (flux nominal)
// 🛡️ Les cibles nominale et unitaire sont rejetées hors du domaine codeur sûr [-99.00;+99.00] m.
// 🔧 REX 2026-07-07 : FwdRevSpeedFeedbackOff remplace (NOT ContactorFeedbackFwd) AND (NOT ContactorFeedbackRev)
// 🌐 BypassGlobal = TRUE → on saute la vérification d'arrêt (mise en service)
ArretConfirme := BypassGlobal OR (FwdRevSpeedFeedbackOff AND BrakeFeedback);

PresetRequest := FALSE;   // Défaut chaque cycle — repose uniquement sur le front HomeEdge ci-dessous
IF HomeEdge.Q AND (State &lt;&gt; E_State.BUSY) THEN
    IF UnitaryMode THEN
        TargetPositionM := CfgHomingTargetM;
    ELSE
        TargetPositionM := CfgTopSensorPosM;
    END_IF;

    // ✅ Homing autorisé en MAINT_N1 et MAINT_N2 — interdit en SEMI_AUTO et en cycle AUTO
    // 🌐 BypassGlobal = TRUE → saute TOUTES les vérifications, force le homing
    IF BypassGlobal THEN
        // Force homing sans condition
        PresetValueCalc := (PointsPerRev * MultiTurnRevsMax) / 2;
        TargetPoints := REAL_TO_DINT(TargetPositionM * UDINT_TO_REAL(PointsPerRev) / CableM_PerRev);
        PresetValue := PresetValueCalc;
        PresetRequest := TRUE;
        State := E_State.BUSY;
    ELSIF (Mode &lt;&gt; E_Mode.MAINT_N1) AND (Mode &lt;&gt; E_Mode.MAINT_N2) THEN
        ErrorId := ErrorId OR 16#0001;        // bit0 : mode non autorisé (seulement MAINT N1/N2)
    ELSIF UnitaryMode AND (Mode &lt;&gt; E_Mode.MAINT_N2) THEN
        ErrorId := ErrorId OR 16#0001;
    ELSIF UnitaryMode AND NOT WinchSelected THEN
        ErrorId := ErrorId OR 16#0002;        // bit1 : mauvais treuil sélectionné
    ELSIF NOT EncoderAvailable THEN
        ErrorId := ErrorId OR 16#0008;        // bit3 : codeur indisponible
    ELSIF NOT ArretConfirme THEN
        ErrorId := ErrorId OR 16#0004;        // bit2 : arrêt non confirmé (contacteurs/frein)
    ELSIF (TargetPositionM &lt; -99.0) OR (TargetPositionM &gt; 99.0) THEN
        ErrorId := ErrorId OR 16#0010;        // bit4 : cible nominale/unitaire hors limites
    ELSIF NOT BypassGlobal AND NOT UnitaryMode AND (TargetPositionM &lt;&gt; 0.0) AND TopPositionSensor THEN
        ErrorId := ErrorId OR 16#0010;        // bit4 : capteur position haute non confirmé
    ELSE
        // ✅ Toutes conditions réunies : calcul de la cible brute et déclenchement
        ErrorId := ErrorId AND 16#FFC0;       // Nettoie les erreurs de rejet 0..5
        PresetValueCalc := (PointsPerRev * MultiTurnRevsMax) / 2;               // Centre exact (§3.3)
        TargetPoints := REAL_TO_DINT(TargetPositionM * UDINT_TO_REAL(PointsPerRev) / CableM_PerRev);
        PresetValue := PresetValueCalc;
        PresetRequest := TRUE;                // Pulse 1 cycle — FB_Encoder_Abs détecte le front lui-même
        State := E_State.BUSY;
    END_IF;
END_IF;

// ⏳ 6. SUIVI DE LA SÉQUENCE (BUSY → confirmation)
Done := FALSE;
IF State = E_State.BUSY THEN
    IF PresetAck THEN
        Calib.HomingRefRaw := DINT_TO_UDINT(UDINT_TO_DINT(PresetValueCalc) - TargetPoints);
        Calib.Homed := TRUE;
        Calib.HomingSuspect := FALSE;
        Calib.LastKnownRawPos := PresetValueCalc;
        Done := TRUE;
        State := E_State.READY;
        // 🔧 REX 2026-07-24 : Un homing réussi efface l'intégralité de ErrorId (y compris les anciens rejets 0..5 et le bit9)
        ErrorId := 16#0000;
    ELSIF PresetNak THEN
        ErrorId := ErrorId OR 16#0020;        // bit5 : preset refusé/timeout (voir FB_Encoder_Abs)
        State := E_State.READY;
    END_IF;
END_IF;

// 🧾 7. RESET (front) — efface les bits « dernière tentative rejetée » (pas de cause persistante
// à revérifier ici : le prochain Home réévalue toutes les conditions de zéro, voir §5)
IF ResetEdge.Q THEN
    ErrorId := ErrorId AND 16#FFC0;   // efface bits 0..5 (garde bit9, levé seulement par BtnConfirmCoherence/Home)
END_IF;

// 📤 8. SORTIES ÉTAT
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;

// Mise à jour continue du point brut valide connu (hors séquence de homing elle-même)
IF EncoderAvailable AND (State &lt;&gt; E_State.BUSY) THEN
    Calib.LastKnownRawPos := RawPos;
END_IF;

Busy := (State = E_State.BUSY);
Homed := Calib.Homed AND NOT Calib.HomingSuspect; // 🆕 REX 2026-07-08 : Perd l'état homed si suspect (démarrage ou fonctionnement), restauré après BtnConfirmCoherence
HomingSuspect := Calib.HomingSuspect;
HomingRefRaw := Calib.HomingRefRaw;
</Single>
            <Single Name="LineInfoPersistence" Type="string">9bdf9b92-21ae-470d-9bce-af0e1383cec2_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎯 FB_Encoder_Homing — Référencement codeur nominal ou unitaire MAINT_N2
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie-10_Fonction_Encoder_Homing_v1.10.md §1/§5/§7bis
///   ⚠️ PÉRIMÈTRE : flux nominal (capteur haut + cible paramétrable) ou
///      unitaire MAINT_N2 (treuil sélectionné + cible libre). Aucun mouvement
///      moteur n'est piloté ici.
///   🔌 PAS un FB de mouvement (Partie3 §1bis) : il n'écrit qu'une valeur
///      de calibration, le treuil étant déjà à l'arrêt confirmé. Pas de
///      `StartStop`/`SafeStop`.
///   🧮 Calcul (généralise le cas historique cible=0.00, Partie10 §3.2/§3.3) :
///      - `PresetValue` = `HomingRefTargetNominal` = (PointsPerRev × MultiTurnRevsMax) / 2
///        (constante, TOUJOURS la même — centre exact de la plage, marge anti-débordement)
///      - `HomingRefRaw` = `PresetValue` − round(`CfgTopSensorPosM` × PointsPerRev / CableM_PerRev)
///        (ainsi `CablePosM` = `CfgTopSensorPosM` exactement au moment du homing)
///      ⚠️ ÉVOLUTION vs interface §5 d'origine : `HomingRefRaw` est ajouté en sortie explicite
///      (le document original supposait implicitement `HomingRefRaw := PresetValue`, valable
///      uniquement pour une cible à 0.00 — ne fonctionne plus avec une cible non nulle ≈8.50 m).
///   🧊 `ST_EncoderCalib` géré en interne (`VAR RETAIN`) — expose `Homed`/`HomingSuspect`/
///      `HomingRefRaw` en sortie pour les consommateurs (`FB_Encoder_Scale`).
///   🔴 SIMPLIFICATIONS assumées pour ce lot (à documenter/lever plus tard si besoin) :
///      - Les 2 instances (M1/M2) sont autonomes : le même bouton IHM pilote les deux `Home`
///        simultanément (câblage PRG_MAIN), mais chacune valide/rejette SES PROPRES conditions
///        indépendamment (pas d'attente mutuelle ni de synchro de déclenchement).
///      - `BtnConfirmCoherence`/§3.7 (incohérence redémarrage) : implémenté a minima (bit9), mais
///        non testé en conditions réelles de coupure secteur — à revalider.
///   ═══════════════════════════════════════════════════════════════
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Homing) ===
FUNCTION_BLOCK FB_Encoder_Homing
VAR_INPUT
	///Standard
	Enable: BOOL;
	///Acquittement défaut (front) — bits 0/2/3/4/5 (voir §ErrorId)
	Reset: BOOL;
	///Standard
	EmergencyStopOk: BOOL;
	///MAINT_N1 requis pour le flux nominal
	Mode: E_Mode;
	///Demande de référencement (front, bouton IHM UNIQUE)
	Home: BOOL;
	///TRUE = flux unitaire à cible libre (MAINT_N2 uniquement)
	UnitaryMode: BOOL;
	///TRUE = cette instance est le treuil sélectionné
	WinchSelected: BOOL;
	///Cible libre unitaire, limitée à [-99.0 ; +99.0] m
	CfgHomingTargetM: REAL;
	///Front — lève le doute §3.7 (bit9), sans réhoming complet
	BtnConfirmCoherence: BOOL;
	///🔧 2026-07-02 : capteur position haute UNIQUE, COMMUN aux 2 treuils
	TopPositionSensor: BOOL;
	///(les 2 câbles hissent ensemble le même ensemble mécanique) — câblé
	///IDENTIQUEMENT sur les instances M1 ET M2 (PAS un capteur par treuil),
	///voir PRG_MAIN.st
	///Cible homing nominal (RETAIN site, voir Partie10 §7bis)
	CfgTopSensorPosM: REAL := 8.5;
	///🔧 REX 2026-07-07 : retour unique "tous contacteurs sens+vitesse
	FwdRevSpeedFeedbackOff: BOOL;
	///retombés" CE TREUIL — arrêt confirmé (remplace ContactorFeedbackFwd/Rev)
	///Retour contacteur frein CE TREUIL (TRUE = relâché, FALSE = collé)
	BrakeFeedback: BOOL;
	///Sortie FB_Encoder_Abs (déjà gelée sur doute)
	RawPos: UDINT;
	///Sortie FB_Encoder_Abs
	EncoderAvailable: BOOL;
	///Pulse — sortie FB_Encoder_Abs (écriture confirmée)
	PresetAck: BOOL;
	///Pulse — sortie FB_Encoder_Abs (écriture refusée/timeout)
	PresetNak: BOOL;
	///Confirmé fiche technique (Partie10 §3.3)
	PointsPerRev: UDINT := 8192;
	///Confirmé fiche technique (Partie10 §3.3)
	MultiTurnRevsMax: UDINT := 4096;
	///Confirmé terrain 2026-07-02 (Partie10 §2)
	CableM_PerRev: REAL := 2;
	///🌐 Ignore arrêt confirmé et capteur haut (mise en service)
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	///Pulse 1 cycle — référencement réussi (miroir PresetAck)
	Done: BOOL;
	Error: BOOL;
	///Voir table de bits en en-tête de fichier / doc §5
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///Pulse → FB_Encoder_Abs.PresetRequest
	PresetRequest: BOOL;
	///→ FB_Encoder_Abs.PresetValue (= HomingRefTargetNominal)
	PresetValue: UDINT;
	///RETAIN interne, miroir Calib.Homed
	Homed: BOOL;
	///RETAIN interne, miroir Calib.HomingSuspect
	HomingSuspect: BOOL;
	///RETAIN interne, miroir Calib.HomingRefRaw → FB_Encoder_Scale
	HomingRefRaw: UDINT;
END_VAR
VAR_IN_OUT
	///Référence vers l'état persistant global (survit aux téléchargements)
	Calib: ST_EncoderCalib;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	HomeEdge: R_TRIG;
	ConfirmCoherenceEdge: R_TRIG;
	///Contrôle cohérence §3.7 fait une fois par session Enable
	InitDone: BOOL;
	ArretConfirme: BOOL;
	///= HomingRefTargetNominal (constant tant que PointsPerRev/MultiTurnRevsMax fixes)
	PresetValueCalc: UDINT;
	///Écart signé CfgTopSensorPosM → points, figé pendant la séquence
	TargetPoints: DINT;
	///Cible retenue : nominale ou unitaire
	TargetPositionM: REAL;
	///Écart |RawPos - LastKnownRawPos| au redémarrage (§3.7)
	RawDiffRestart: DINT;
END_VAR
</Single>
