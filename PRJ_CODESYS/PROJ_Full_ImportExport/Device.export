            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Translation_Control :
STRUCT
	///1 = Mouvement Translation Autorisé | 0 = Bloqué
	Idx401_MotionAllowed: BOOL;
	///[Hz] Consigne Fréquence Calculée
	Idx402_SetpointFreq_Hz: REAL;
	///Mot de Commande Calculé Variateur AC600
	Idx403_DriveControlWord: WORD;
	///🛡️ État frontière _LD
	Idx404_FinalInterlockState: E_State;
	///🛡️ Cause mémorisée
	Idx405_FinalInterlockReason: E_TranslationFinalInterlockReason;
	///🔌 Contacteur/bobine, pas frein mécanique
	Idx406_BrakeCommandOpenConfirmed: BOOL;
	///⏱️ Watchdog 500ms écoulé
	Idx407_BrakeTimeoutElapsed: TIME;
END_STRUCT
END_TYPE
