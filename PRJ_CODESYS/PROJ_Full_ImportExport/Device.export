            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_State :
(
	///Enable faux, neutralisé
	DISABLED := 0,
	///Démarrage / vérifs
	INIT := 1,
	///Prêt, attend ordre
	READY := 2,
	///Action en cours
	BUSY := 3,
	///Action terminée
	DONE := 4,
	///Décél rampe avant arrêt (StartStop=FALSE ou SafeStop=TRUE)
	STOPPING := 5
);
END_TYPE
</Single>
