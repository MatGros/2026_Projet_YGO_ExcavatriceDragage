      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ ST_SafetyChecklist — Diagnostic chronologique réarmement chaîne de sécurité / AU
///   ───────────────────────────────────────────────────────────────
///   🎨 Permet d'identifier immédiatement pourquoi la puissance / AU ne réarme pas.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SafetyChecklist :
STRUCT
	///1. Intégrité matérielle &amp; modules E/S
	///TRUE = Les 3 cartes E/S physiques sont RUNNING ➔ En simu : GVL_Simulation.SimMachineActive=1
	Step1_InputModulesOk: BOOL;
	///TRUE = Pas d'appui AU ➔ Déverrouiller le BP coup-de-poing physique ou IHM : GVL_IHM.Modes.Cmd.BtnEmergencyCutOff
	Step2_EmergencyBtnNotCut: BOOL;
	///TRUE = Boucle physique AU fermée (EmergencyChainClosed_DI)
	Step3_EmergencyChainClosed: BOOL;
	///2. Conditions de réarmement
	///TRUE = Test de redondance contacteurs OK ➔ Attendre la retombée complète des contacteurs
	Step4_ContactorRedundancyOk: BOOL;
	///TRUE = Machine armable ➔ Appuyer sur BP Reset IHM : GVL_IHM.Modes.Cmd.BtnFaultReset
	Step5_ArmingAllowed: BOOL;
	///3. Séquence de réarmement
	///TRUE = Impulsion d'armement 500ms en cours
	ArmingPulseActive: BOOL;
	///TRUE = Contacteur principal sous tension (PowerContactorEngaged_DI)
	PowerContactorEngaged: BOOL;
	///TRUE = Chaîne de sécurité OK et puissance engagée
	AllConditionsMet: BOOL;
	///4. Erreurs
	///TRUE = Défaut sécurité actif ➔ Acquitter via : GVL_IHM.Modes.Cmd.BtnFaultReset
	SafetyError: BOOL;
	///TRUE = Défaut test de redondance contacteurs
	RedundancyTestFailed: BOOL;
	///TRUE = Échec de la séquence d'armement
	ArmingFailed: BOOL;
END_STRUCT
END_TYPE
</Single>
