      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ST_CommunCfg — Configuration des paramètres communs machine
///   ═══════════════════════════════════════════════════════════════
TYPE ST_CommunCfg :
STRUCT
	///Blocage instantané à 0m : sans défaut explicite,
	///ce champ vaut 0.0 tant qu'il n'a pas été réglé côté IHM -- "CablePosM &lt;= 0.0" se déclenche
	///dès la position de référence, avant tout réglage réel de la cote légale. Défaut -999.0
	///(jamais atteint en pratique) : LimitLegalEnabled=TRUE sans réglage ne bloque plus rien par
	///erreur -- il faut régler la vraie cote pour que la protection devienne active.
	///📐 Cote min de dragage autorisée (m, négatif)
	LimitLegalDepthMinAllowed_M: REAL := -999;
	///🟢 Activation de la limite légale
	LimitLegalEnabled: BOOL;
	///🔌 Case IHM : autorise le dépassement butée haute pour homing (si MAINT_N2)
	SelHomingApproachEnable: BOOL;
	///🛑 Limitation palier vitesse en descente (1..5), commun M1/M2
	WinchMaxStepDescente: INT := 3;
	///🚀 Limitation palier vitesse en montée (1..5), commun M1/M2
	WinchMaxStepAscent: INT := 5;
	///📏 Distance avant limite pour enclencher le ralentissement (m), commun M1/M2
	WinchSlowdownDistance_M: REAL := 1;
	///: WinchSlowSpeed_Pct (%) retiré — un treuil ne connaît que des paliers (1..5),
	///pas une vitesse continue.
	///: Plafond palier dans la zone de ralentissement (1..5), commun M1/M2
	WinchSlowdownMaxStep: INT := 1;
	///📐 Limite haute d'exploitation NORMALE (m), commun M1/M2
	CfgCableLimitAscent_M: REAL := 7.5;
	///: Arrêt auto descente sur détection fond Kobold (pilotage normal)
	TglEnableKoboldAutoStopDescent: BOOL := FALSE;
	///Coupe-circuit d'urgence pour le séquencement auto benne.
	///Défaut FALSE = mouvement M1/M2 synchro jamais
	///gouverné par instBucket.Busy sauf action MANUELLE benne/DumpAtTremie/ExtractionSequence).
	TglEnableCoupledBucketSequencing: BOOL := FALSE;
	///🚦 flag restauration boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
