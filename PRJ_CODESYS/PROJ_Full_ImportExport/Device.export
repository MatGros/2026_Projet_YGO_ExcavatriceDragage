        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   💾 FB_WinchSpeedLearning — Collecteur passif vitesse par palier
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Apprentissage passif des vitesses reelles par palier (RETAIN)
///   📄 Doc metier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   🔒 Collecteur pur : aucune commande moteur, aucune surveillance survitesse
///   =======================================================================
FUNCTION_BLOCK FB_WinchSpeedLearning
VAR_INPUT
	///=== CONTRAT LIGHT (Enable) ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Bit IHM lancer apprentissage
	LearnStart: BOOL;
	///--&gt; [CMD] Axe cible (1=M1, 2=M2)
	WinchId: INT;
	///--&gt; [HW] Sens mesure (-1 descente, 0 stop, +1 montee)
	Direction: INT;
	///--&gt; [HW] Palier actif (1..5)
	StepNumber: INT;
	///--&gt; [HW] Vitesse mesuree (m/s)
	MeasuredSpeedMps: REAL;
	///--&gt; [HW] Mesure exploitable
	MeasuredSpeedValid: BOOL;
	///--&gt; [HW] Charge presente (TRUE=charge, FALSE=vide)
	LoadPresent: BOOL;
	///--&gt; [HW] Conditions stables pour apprentissage
	StableForLearn: BOOL;
	///=== REGLAGES &amp; CONFIGURATION ===
	///--&gt; [CFG] Enveloppes de plausibilite par palier
	Config: ST_fbWinchSpeedLearning_Cfg;
END_VAR
VAR_OUTPUT
	///=== CONTRAT LIGHT (Ready) ===
	///&lt;-- [STAT] FB pret (Enable)
	Ready: BOOL;
	///=== ETATS &amp; DIAGNOSTIC ===
	///&lt;-- [STAT] Collecte en cours
	Learning: BOOL;
	///&lt;-- [STAT] Table charge ET vide complete
	TableComplete: BOOL;
	///&lt;-- [STAT] Voyant IHM apprentissage
	LampLearn: BOOL;
	///&lt;-- [DIAG] Nombre de cellules validees
	CellsFilled: INT;
	///&lt;-- [DIAG] Nombre total de cellules
	CellsTotal: INT;
END_VAR
VAR_IN_OUT
	///=== STRUCTURES DE DONNEES PARTAGEES ===
	///&lt;-&gt; [BUS] Table RETAIN apprentissage
	Table: ST_fbWinchSpeedLearning_Table;
END_VAR
VAR
	///=== VARIABLES LOCALES CALCULEES ===
	///. [LOC] Bit IHM + Enable
	LearnRequested: BOOL;
	///. [LOC] Mesure valide + conditions stables
	MeasureUsable: BOOL;
	///. [LOC] Sens non nul
	SensActive: BOOL;
	///. [LOC] Palier dans 1..5
	StepInRange: BOOL;
	///. [LOC] Axe dans 1..2
	AxeInRange: BOOL;
	///. [LOC] Sens, palier et axe dans le domaine
	ContextValid: BOOL;
	///. [LOC] Conditions de collecte reunies
	CollectAllowed: BOOL;
	///. [LOC] Vitesse dans l'enveloppe du palier
	SpeedPlausible: BOOL;
	///. [LOC] Index sens (1=montee, 2=descente)
	SensIdx: INT;
	///. [LOC] Index charge (1=vide, 2=charge)
	ChargeIdx: INT;
	///. [LOC] Cellule courante
	CurrentCell: ST_fbWinchSpeedLearning_Cell;
	///. [LOC] Index axe boucle
	AxeIdx: INT;
	///. [LOC] Index sens boucle
	SensLoopIdx: INT;
	///. [LOC] Index charge boucle
	ChargeLoopIdx: INT;
	///. [LOC] Index palier boucle
	PalierIdx: INT;
	///Nombre d'axes (M1, M2)
	CST_AxeCount: INT := 2;
	///Nombre de sens (montee, descente)
	CST_SensCount: INT := 2;
	///Nombre d'etats de charge (vide, charge)
	CST_ChargeCount: INT := 2;
	///Nombre de paliers (1..5)
	CST_PalierCount: INT := 5;
	///Index sens montee
	CST_IdxMontee: INT := 1;
	///Index sens descente
	CST_IdxDescente: INT := 2;
	///Index charge vide
	CST_IdxVide: INT := 1;
	///Index charge presente
	CST_IdxCharge: INT := 2;
END_VAR
</Single>
