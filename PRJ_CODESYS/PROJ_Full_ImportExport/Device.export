      <Single Name="Object" Type="{ffbfa93a-b94d-45fc-a329-229860183b1d}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 GVL_Simulation — Variables et stimuli de simulation (Banc d'essai)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-13_Fonction_Simulation_v2.3.md
///   🎯 Polarité positive : TRUE = simulé/stimulus actif ; FALSE = réel/repos.
///   🔒 Consommée à la frontière PRG_02_Acquisition, par le banc, et par PRG_04_Treuils_Benne
///   🔒 (SimulationBypassActive : n'arme les bypass de sécurité QUE si SimulationModeActive
///   🔒  ET SimWinchActive — strictement inopérant sur machine réelle).
///   ═══════════════════════════════════════════════════════════════
{attribute 'qualified_only' := ''}
VAR_GLOBAL
	///🔑 Bit maître — rien n'est simulé si FALSE (machine réelle)
	SimulationModeActive: BOOL := FALSE;
	///🎭 Master Bypass Essais Banc — arme les bypass Meca (Safety/Process) en mode MAINT
	///(inopérant sur machine réelle). ❗ N'arme PLUS les limites réelles (TopLimitSwitch /
	///TopLimitSoftware / LimitLegal) : la protection de montée/descente reste active au banc.
	///Défaut TRUE : pré-arme le bypass banc dès le boot (n'agit que si SimulationModeActive AND SimWinchActive).
	///Permet de travailler en banc sans faux blocage Meca au homing sans mouvement.
	SimulationBypassActive: BOOL := TRUE;
	///🌐 Activation par domaine (simulé si SimulationModeActive AND Sim&lt;Domaine&gt;Active)
	///M1+M2 : codeurs, contacteurs, freins, thermiques, capteur haut, câble tendu
	SimWinchActive: BOOL := FALSE;
	///M3 : AC600, fréquence, 5 capteurs et frein
	SimTranslationActive: BOOL := FALSE;
	///Joystick : bus CANopen, axes RawX/RawY et homme-mort brut
	SimOperatorActive: BOOL := FALSE;
	///AU, contacteur puissance, phases, thermiques, Kobold et auxiliaires communs
	SimSafetyActive: BOOL := FALSE;
	///↔️ STIMULI TRANSLATION M3 — override manuel du mot capteurs, sinon modèle dynamique.
	///Bit4=Trémie, bit3=PV, bit2=PVP2, bit1=P1, bit0=Maintenance ; 16#07 = position P2 (00111).
	///TRUE = SimM3SensorsWord remplace le modèle ; réserver aux injections ciblées
	SimM3SensorsWordOverrideActive: BOOL := FALSE;
	///Mot manuel valide nominal : P2
	SimM3SensorsWord: BYTE := 16#07;
	///🕹️ STIMULI OPÉRATEUR — les boutons directionnels imposent 0/5000/10000 ; combinaison = neutre.
	///Translation M3 Arrière vers Trémie (RawX=0, RawY=5000)
	SimJoystickLeft_Rev_TREMIE_Active: BOOL := FALSE;
	///Translation M3 Avant vers Maintenance (RawX=10000, RawY=5000)
	SimJoystickRight_Fwd_MAINT_Active: BOOL := FALSE;
	///Treuils Montée M1/M2 / Fermeture Benne M2 (RawX=5000, RawY=10000)
	SimJoystickFwd_Up_Close_Active: BOOL := FALSE;
	///Treuils Descente M1/M2 / Ouverture Benne M2 (RawX=5000, RawY=0)
	SimJoystickRev_Down_Open_Active: BOOL := FALSE;
	///Stimulus analogique avancé 0..10000, utilisé sans bouton directionnel
	SimJoystickRawX: INT := 5000;
	///Stimulus analogique avancé 0..10000, utilisé sans bouton directionnel
	SimJoystickRawY: INT := 5000;
	///Homme-mort brut : TRUE = bouton joystick appuyé
	SimJoystickRawButton: BOOL := FALSE;
	///TRUE = dépassement de montée au-delà de 100% (défaut capteur hors plage)
	SimJoystickOvershoot_Active: BOOL := FALSE;
	///TRUE = bagotement au relâchement (petit balancement autour du neutre)
	SimJoystickBagotement_Active: BOOL := FALSE;
	///🪝 STIMULI TREUILS — paramètres du modèle codeur et injection ponctuelle d'un défaut synchro.
	///Multiplicateur vitesse codeurs simulés ; 1.0 = nominal
	SimEncoderSpeedFactor: REAL := 1;
	///Front montant : ajoute SimSyncDeviationOffset_M à la position M1 simulée
	SimSyncDeviationInjectM1: BOOL := FALSE;
	///Front montant : ajoute SimSyncDeviationOffset_M à la position M2 simulée
	SimSyncDeviationInjectM2: BOOL := FALSE;
	///Écart signé injecté, mètres ; persiste dans la position simulée jusqu'au reset/preset
	SimSyncDeviationOffset_M: REAL := 0.5;
	///🛡️ STIMULI SAFETY — fait capteur amont, jamais une sortie de commande forcée.
	///TRUE = Kobold détecte un contact fond simulé
	SimKoboldContactValue: BOOL := FALSE;
END_VAR</Single>
