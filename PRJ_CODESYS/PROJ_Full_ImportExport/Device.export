        <Single Name="TypeGuid" Type="System.Guid">2db5746d-d284-4425-9f7f-2663a34b0ebc</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639237203759370733</Single>
      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🕹️ ST_fbJoystick_AxisCmd — Consigne d'axe normalisée (sortie FB_Joystick)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure de consigne d'axe produite par FB_Joystick.
///   📤 Champs : Enable, StartStop, SpeedTgt + direction en bits (DirectionPositive/Negative, AtNeutral).
///   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.5.md
///   =======================================================================
TYPE ST_fbJoystick_AxisCmd :
STRUCT
	///=== CONSIGNES DE PILOTAGE AXE ===
	///--&gt; [CMD] Autorisation globale pipeline (FALSE=neutralisation, sorties coupees)
	Enable: BOOL;
	///--&gt; [CMD] Validation de mouvement (TRUE=acceleration, FALSE=deceleration/arret)
	StartStop: BOOL;
	///--&gt; [CMD] Vitesse cible non signee (0...100 %, signe/sens donné par Direction)
	SpeedTgt: REAL;
	///--&gt; [CMD] Direction joystick ou intension de gestuelle
	DirectionNegative: BOOL;
	///--&gt; [CMD] Direction joystick ou intension de gestuelle
	DirectionPositive: BOOL;
	///--&gt; [CMD] TRUE si axes en zone morte (position centrale)
	AtNeutral: BOOL;
	///=== MONITORING IHM (derive des bits ci-dessus, jamais lu en interlock) ===
	///&lt;-- [STAT] Sens -1=Rev / 0=Neutre / +1=Fwd (anim IHM fleche ; lu aussi logique treuils PRG_04)
	Direction: INT;
	///&lt;-- [STAT] Deflexion signee -100..+100 % (anim IHM jauge/barre)
	Deflection: INT;
END_STRUCT
END_TYPE
</Single>
