      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_BucketHMIState — États et diagnostics IHM de la benne (M2)
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BucketHMIState :
STRUCT
	///🚥 État mécanique mémorisé (IsOpen, IsClosed...) — ex-champ "State", renommé pour éviter collision de nom avec ce sous-struct
	MechState: ST_BucketState;
	///🤖 État de l'automate interne (FB_Bucket)
	FBState: E_State;
	///📐 Offset actif injecté dans la synchro
	ActiveOffset_M: REAL;
	///🛗 Commande Start/Stop forcée vers M2
	M2StartStop: BOOL;
	///🛗 Commande direction forcée vers M2
	M2Direction: INT;
	///🐢 Blocage vitesse rapide de M2
	M2ForceSlowSpeed: BOOL;
	///🟢 Bloc opérationnel
	Ready: BOOL;
	///⚙️ Mouvement d'ouverture/fermeture en cours
	Busy: BOOL;
	///✅ Mouvement terminé avec succès
	Done: BOOL;
	///🔴 Benne en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut benne
	ErrorId: WORD;
	///📏 Distance restante avant cible (m)
	RemainingTravel_M: REAL;
	///📏 Écart réel signé M2 - M1 (mètres) pour jauge/bargraphe IHM
	DeltaPosition_M: REAL;
	///🆕 Demande de fermeture active (image FB_Bucket)
	CloseActive: BOOL;
	///🆕 Demande d'ouverture active (image FB_Bucket)
	OpenActive: BOOL;
	///📊 WinchM2.PositionM - ActiveOffset_M, affichage bargraphe
	M2PositionCorrected: REAL;
	///⚙️ Séquencement automatique benne en cours (ouverture/fermeture auto)
	AutoBucketSeqActive: BOOL;
	///🆕 2026-08-07 : Ouverture auto armée (descente couplée demandée, benne pas ouverte)
	CoupledDiveOpenArmed: BOOL;
	///🆕 2026-08-07 : Fermeture auto armée (montée couplée demandée, benne pas fermée)
	CoupledAscentCloseArmed: BOOL;
	///🆕 2026-08-07 : Phase vitesse contrôlée montée en cours (post-fermeture auto)
	ControlAscentActive: BOOL;
	///🔴 2026-08-07 : Mouvement couplé bloqué -- auto-séquencement armé mais benne pas Busy (défaut/précondition)
	CoupledMotionBlockedByBucket: BOOL;
END_STRUCT
END_TYPE
</Single>
