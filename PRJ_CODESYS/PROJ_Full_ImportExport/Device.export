          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_BucketHMI — Données d'échange IHM pour le benne
///   ───────────────────────────────────────────────────────────────
///   🎨 Intègre la configuration, l'état persistant et les commandes.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BucketHMI :
STRUCT
	///⚙️ Configurations &amp; Paramètres (Lecture/Écriture RETAIN)
	///🔧 Offsets Open/Close/Coherence
	Config: ST_BucketConfig;
	///⏱️ Temps max pour l'ouverture/fermeture
	TimeoutDuration: TIME := TIME#30s0ms;
	///🚦 États &amp; Retours (Lecture seule)
	///🚥 État mémorisé (IsOpen, IsClosed, etc.)
	State: ST_BucketState;
	///🤖 État de l'automate interne (FB_Bucket)
	FBState: E_State;
	///📐 Offset actif injecté dans la synchro
	ActiveOffsetM: REAL;
	///🛗 Commande Start/Stop forcée vers M2
	M2StartStop: BOOL;
	///🛗 Commande direction forcée vers M2
	M2Direction: INT;
	///🐢 Blocage vitesse rapide de M2
	M2ForceSlowSpeed: BOOL;
	///🟢 Bloc opérationnel
	Ready: BOOL;
	///⚙️ Mouvement d'ouverture/fermeture en cours
	Busy: BOOL;
	///✅ Mouvement terminé avec succès
	Done: BOOL;
	///🔴 Benne en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut benne
	ErrorId: WORD;
	///📏 REX 2026-07-07 : distance restante avant cible (m),
	RemainingTravelM: REAL;
	///🆕 REX 2026-07-08 : demande de fermeture active (image FB_Bucket) —
	CloseReq: BOOL;
	///🆕 REX 2026-07-08 : demande d'ouverture active (image FB_Bucket), même principe
	OpenReq: BOOL;
	///📊 REX 2026-07-07 : WinchM2.PositionM - ActiveOffsetM —
	M2PositionCorrected: REAL;
	///🪣 Bouton commande ouverture
	CmdOpen: BOOL;
	///🪣 Bouton commande fermeture
	CmdClose: BOOL;
	///🔑 Acquittement défaut benne
	CmdReset: BOOL;
	///🆕 REX 2026-07-08 : référencement benne position ouverte (mise en
	CmdConfirmOpenPosition: BOOL;
	///🆕 REX 2026-07-08 : référencement benne position fermée (mise en
	CmdConfirmClosePosition: BOOL;
END_STRUCT
END_TYPE
</Single>
