            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔌 ST_WinchCmdDemand — Structure de demande de commande treuil
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Regroupement des consignes de mouvement treuil (StartStop, Direction, Vitesse)
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
///   =======================================================================
TYPE ST_WinchCmdDemand :
STRUCT
	///Ordre marche/arret mouvement (TRUE=Marche)
	StartStop: BOOL;
	///Sens de marche (-1: Descente, 0: Stop, 1: Montee)
	Direction: INT;
	///Consigne vitesse (0.0 a 100.0 %)
	SpeedPct: REAL;
END_STRUCT
END_TYPE
</Single>
