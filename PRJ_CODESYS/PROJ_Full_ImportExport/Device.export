      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎮 ST_ModesCmd — Commandes IHM pour les modes de marche
///   ═══════════════════════════════════════════════════════════════
TYPE ST_ModesCmd :
STRUCT
	///🖥️ Demande de changement de mode de marche — accès N2 filtré côté IHM ()
	SelMode: E_Mode := E_Mode.MAINT_N1;
	///🔔 Acquittement défauts/alarmes domaine sécurité/métier — jamais Modes/Cycle
	BtnFaultReset: BOOL;
	///🔁 Acquittement défaut FB_Modes uniquement ()
	BtnModeReset: BOOL;
	///— Séquence réarmement AU (voir DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.1.md §5)
	///🎮 Commande IHM réarmement contacteur puissance (front) — PAS de réarmement automatique
	BtnEmergencyArming: BOOL;
	///🎮 Commande IHM coupure d'urgence puissance amont (arrêt à distance)
	BtnEmergencyCutOff: BOOL;
	///Sélection treuil au joystick, arbitrée par FB_Modes (0=couplé nominal, 1/2 unitaires MAINT_N2 uniquement)
	///🕹️ 0=M1+M2 couplés (nominal), 1=M1 seul, 2=M2 seul — unitaires MAINT_N2 uniquement
	SelJoystickWinch: INT := 0;
	///— bascule UNIQUEMENT la SOURCE du signal StartStop/Direction/
	///SpeedTgt_Pct (joystick vs boutons IHM) — SelJoystickWinch ci-dessus reste l'unique autorité de
	///sélection treuil (M1/M2/Couplé), appliquée IDENTIQUEMENT quelle que soit la source.
	///🔀 Switch machine unique — pilote aussi Translation M3.
	///🕹️ TRUE (défaut) = joystick pilote Winch M1/M2 ET Translation M3 ; FALSE = boutons IHM (BtnUp/BtnDown, BtnFwd/BtnRev)
	TglJoystickMaster: BOOL := TRUE;
END_STRUCT
END_TYPE
</Single>
