          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926771508527</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Input) ===

// 1. Inversion NO/NC
ValueRaw := InputRaw XOR InvertLogic;

// 2. Initialisation premier scan &amp; Filtrage anti-rebond
// Au premier scan post-boot, State prend directement la valeur saine brute sans attendre le délai de 20ms,
// ce qui évite d'émettre des fausses alarmes transitoires au démarrage de l'automate.
IF NOT FirstScanDone THEN
    State := ValueRaw;
    FirstScanDone := TRUE;
ELSE
    FilterTon(IN := (ValueRaw &lt;&gt; State), PT := FilterTime);
    IF FilterTon.Q THEN
        State := ValueRaw;   // Une fois à jour, IN redevient FALSE au cycle suivant (ValueRaw=State)
    END_IF;
END_IF;

// 3. Diagnostic voie/carte
IF NOT ChannelOk THEN
    ErrorId := ErrorId OR 16#0001;
    State := FALSE;   // État sûr forcé (Partie6 §1)
ELSE
    ErrorId := ErrorId AND 16#FFFE;
END_IF;

Error := (ErrorId &lt;&gt; 16#0000);
</Single>
            <Single Name="LineInfoPersistence" Type="string">9c78cf44-7c29-4a9e-9f54-39dd47e2f913_Impl_LineIds</Single>
