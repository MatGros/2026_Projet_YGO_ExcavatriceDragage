	StartEvent: BOOL;
	StopEvent: BOOL;
	ExpectedMinMs: DINT;
	ExpectedMaxMs: DINT;
END_VAR
VAR_OUTPUT
	ElapsedMs: DINT;
	Done: BOOL;
	InWindow: BOOL;
END_VAR
VAR
	StartTrig: R_TRIG;
	StopTrig: R_TRIG;
	Running: BOOL;
	CycleCount: UDINT;
END_VAR
</Single>
