            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🏗️ ST_HwOperator — Image matérielle brute des entrées Opérateur / Joystick
///   ───────────────────────────────────────────────────────────────
///   🎨 Regroupe les signaux physiques d'entrée bruts du joystick CANopen JOY1.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_HwOperator :
STRUCT
	///Valeur brute analogique axe X (Translation)
	JoyXRaw_ANA1: INT;
	///Valeur brute analogique axe Y (Levage)
	JoyYRaw_ANA2: INT;
	///Bouton brut joystick (Homme-Mort)
	JoyBtnRaw: BOOL;
	///État bus CANopen (CANbus.GetBusState)
	CanBusState: INT;
	///État device JOY1 (GetDeviceState)
	JOY1_DeviceState: DEVICE_STATE;
END_STRUCT
END_TYPE
