        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639237203752152545</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

{region "§1 Reset (front, toujours effectif)"}
// Front Reset : efface tous les latches. Jamais conditionné, agit même Enable=FALSE (§9).
Ready := Enable;
ResetEdge(CLK := Reset);
IF ResetEdge.Q THEN
    FOR i := 0 TO 15 DO Latch[i] := FALSE; END_FOR;
END_IF;
{endregion}

{region "§2 Vue LIVE — Error / ErrorId"}
// Bitfield des causes présentes MAINTENANT. Retombe seule à 0 quand les causes disparaissent.
// Non évaluée si Enable=FALSE (pas de lecture de cause hors autorisation).
Fault.ErrorId := 0;
IF Enable THEN
    FOR i := 0 TO 15 DO
        IF Causes[i].Active THEN
            Fault.ErrorId := Fault.ErrorId OR SHL(WORD#1, INT_TO_DWORD(i));
        END_IF;
    END_FOR;
END_IF;
Fault.Error := (Fault.ErrorId &lt;&gt; 0);
{endregion}

{region "§3 Armement des latches (causes à acquitter)"}
// Une cause Active ET Latching arme son bit ; le bit reste jusqu'au front Reset (§1),
// même si la cause disparaît. Réapparition =&gt; ré-armement (ré-alarme).
IF Enable THEN
    FOR i := 0 TO 15 DO
        IF Causes[i].Active AND Causes[i].Latching THEN
            Latch[i] := TRUE;
        END_IF;
    END_FOR;
END_IF;
{endregion}

{region "§4 Vue LATCHÉE — Latched / LatchedId"}
// Toujours publiée, y compris Enable=FALSE : un défaut non acquitté reste visible.
Fault.LatchedId := 0;
FOR i := 0 TO 15 DO
    IF Latch[i] THEN
        Fault.LatchedId := Fault.LatchedId OR SHL(WORD#1, INT_TO_DWORD(i));
    END_IF;
END_FOR;
Fault.Latched := (Fault.LatchedId &lt;&gt; 0);
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">e4a0a880-9fa1-46d0-aa7b-1e30754bee7e_Impl_LineIds</Single>
