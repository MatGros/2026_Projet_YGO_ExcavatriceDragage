        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🕵️♂️ FB_TroubleshootingView — Mise en forme lecture seule pour dépannage
///   ───────────────────────────────────────────────────────────────
///   📄 Doc : DOC/AF/AF_Partie-14_Fonction_Troubleshooting/FB_TroubleshootingView_v1.2.md
///   🔗 Producteur unique de GVL_Troubleshooting.* — instancié UNE SEULE FOIS,
///      dans PRG_07_Supervision, après §3 Projections IHM.
///   🔒 Lecture seule stricte : aucune VAR_OUTPUT de commande, aucun calcul métier,
///      aucune fusion de source — pure recopie de faits déjà publiés ailleurs.
///   ⚠️ WinchM2 est typé ST_WinchBenneHMI (pas ST_WinchHMI comme WinchM1) : ce lot
///      (LOT_TROUBLESHOOTING_VIEW_ET_WINCHHMI) a introduit ST_WinchBenneHMI pour porter
///      Bucket côté M2 uniquement (GVL_IHM.M2TreuilBenne) — adaptation du port fiche §3
///      nécessaire suite à AC5 (Bucket retiré de ST_WinchHMI commun M1/M2).
///   Écriture GVL directe : seule exception au principe "pas de GVL comme bus de
///      commande" (AF_Partie-03 §5) — GVL_Troubleshooting n'est jamais relue par un FB
///      métier, uniquement par Watch CODESYS / export SCADA dépannage (fiche §3/§7).
///   ⚠️ Idx201_JoystickSelected (ContexteMachineGlobal) lit GVL_IHM.Modes.Cmd.TglJoystickMaster
///      directement (variable globale IEC 61131-3, visible sans passage par VAR_INPUT) — ce
///      port n'est pas dans la table fiche §3 mais le producteur exact est documenté fiche §5.1.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_TroubleshootingView
VAR_INPUT
	///--&gt; [CMD] TRUE en permanence — fiche §3, aucune condition de scan
	Enable: BOOL;
	///📡 PRG_02_Acquisition
	///--&gt; [HW] Image entrées qualifiées
	HwIn: ST_HardwareImage;
	///--&gt; [HW] Image entrées réelles
	HwReal: ST_HardwareImage;
	///--&gt; [HW] Défaut module d'entrée
	InputModuleFault: BOOL;
	///--&gt; [HW] Mirroir Network.InputModules — pas de champ ST_Chain* dédié ce lot
	LocalDigitalIoOk: BOOL;
	///--&gt; [HW] idem
	Vh0800EndOk: BOOL;
	///--&gt; [HW] idem
	Vh0808EtpOk: BOOL;
	///🎚️ PRG_03_Modes_Cycle
	///--&gt; [SAFE] Autorisations machine
	Auth: ST_Modes_Autorisations;
	///🛗 PRG_04_Treuils_Benne — demandes publiques déjà arbitrées
	///--&gt; [CMD] Consigne vitesse M1
	M1LogicRequestSpeedRef_Pct: REAL;
	///--&gt; [CMD] Sens M1
	M1LogicRequestDirection: INT;
	///--&gt; [CMD] Consigne vitesse M2
	M2LogicRequestSpeedRef_Pct: REAL;
	///--&gt; [CMD] Sens M2
	M2LogicRequestDirection: INT;
	///--&gt; [CMD] Direction couplée
	CoupledUserRequestDirection: INT;
	///--&gt; [CMD] Demande couplée active
	CoupledUserRequestActive: BOOL;
	///--&gt; [HW] Cycle auto actif
	CycleAutoBusy: BOOL;
	///--&gt; [CMD] Consigne cycle M1
	CycleM1SpeedRef_Pct: REAL;
	///--&gt; [CMD] Consigne cycle M2
	CycleM2SpeedRef_Pct: REAL;
	///--&gt; [HW] Benne ouverte cycle
	CycleBucketOpen: BOOL;
	///--&gt; [CMD] Cible cycle
	CycleTargetPosition: INT;
	///🎭 GVL_Simulation
	///--&gt; [TST] Mode simulation
	SimulationModeActive: BOOL;
	///--&gt; [TST] Sim treuils
	SimWinchActive: BOOL;
	///--&gt; [TST] Sim translation
	SimTranslationActive: BOOL;
	///--&gt; [TST] Sim opérateur
	SimOperatorActive: BOOL;
	///--&gt; [TST] Sim sécurité
	SimSafetyActive: BOOL;
	///🛗 GVL_IHM — images publiques déjà produites
	///--&gt; [HW] GVL_IHM.M1TreuilRetenue
	WinchM1: ST_WinchHMI;
	///--&gt; [HW] GVL_IHM.M2TreuilBenne — porte Bucket
	WinchM2: ST_WinchBenneHMI;
	///--&gt; [HW] GVL_IHM.M1M2Sync
	Sync: ST_SyncHMI;
	///--&gt; [HW] GVL_IHM.TranslationM3
	Translation: ST_TranslationHMI;
	///--&gt; [HW] GVL_IHM.Commun
	Commun: ST_CommunHMI;
	///--&gt; [HW] GVL_IHM.Network
	Network: ST_NetworkDiagHMI;
	///--&gt; [HW] GVL_IHM.DredgingAssist
	DredgingAssist: ST_DredgingAssistHMI;
	///--&gt; [HW] GVL_IHM.JOY1Joystick
	JoystickHMI: ST_JoystickHMI;
	///🛡️ Sorties publiques AU produites par PRG_06_Outputs
	///--&gt; [SAFE] État AU
	EmergencyState: ST_Safety_Emergency_State;
	///--&gt; [SAFE] Diagnostic AU
	EmergencyDiag: ST_Safety_Emergency_Diag;
	///--&gt; [SAFE] Coupure puissance
	PowerCutOffActive: BOOL;
	///--&gt; [SAFE] Impulsion réarmement
	ArmingPulseActive: BOOL;
	///--&gt; [SAFE] Maintien canal A
	MaintainAActive: BOOL;
	///--&gt; [SAFE] Maintien canal B
	MaintainBActive: BOOL;
	///🔄 Séquenceur de cycle semi-automatique
	///--&gt; [STAT] Séquenceur prêt
	CycleReady: BOOL;
	///--&gt; [STAT] Séquenceur terminé
	CycleDone: BOOL;
	///--&gt; [STAT] Séquenceur en erreur
	CycleError: BOOL;
	///--&gt; [DIAG] Code erreur séquenceur
	CycleErrorId: WORD;
	///--&gt; [STAT] Étape courante
	CycleStep: E_CycleStep;
	///--&gt; [STAT] Libellé étape
	CycleStepStr: STRING(40);
	///--&gt; [DIAG] Étape au défaut
	CycleStepAtError: E_CycleStep;
	///--&gt; [CMD] Demande Start
	CycleStartRequest: BOOL;
	///--&gt; [CMD] Demande Abort
	CycleAbortRequest: BOOL;
	///--&gt; [CFG] Profondeur consigne
	CycleTargetDepth_M: REAL;
	///--&gt; [HW] Contact fond
	CycleKoboldBottomTouch: BOOL;
	///--&gt; [DIAG] Écart vitesse M1/M2
	CycleSpeedMismatchActive: BOOL;
	///--&gt; [SAFE] Limite légale atteinte
	CycleLimitLegalReached: BOOL;
	///--&gt; [SAFE] Erreur synchro treuils
	CycleWinchSyncError: BOOL;
	///--&gt; [CMD] Homme-mort armé
	JoystickDeadmanArmed: BOOL;
	///--&gt; [HW] Joystick au neutre
	JoystickAtNeutral: BOOL;
	///--&gt; [HW] Codeur M1 référencé
	HomedM1: BOOL;
	///--&gt; [HW] Codeur M2 référencé
	HomedM2: BOOL;
	///📐 Config effective limite haute — source _CommunCfgPersist (≠ copie IHM)
	///--&gt; [CFG] Limite haute active (m) = CfgCableLimitAscent_M
	CfgTopLimitM: REAL;
END_VAR
VAR_OUTPUT
	///&lt;-- [STAT] Diagnostic interne minimal — fiche §3
	Ready: BOOL;
END_VAR
</Single>
