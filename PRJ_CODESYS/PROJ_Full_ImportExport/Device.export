      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ ST_SafetyWinch — Diagnostics de sécurité pour un treuil
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des défauts de sécurité d'un treuil.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SafetyWinch :
STRUCT
	///🛡️ Bloc sécurité (Safety) en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut de sécurité
	ErrorId: WORD;
	///🟧 Arrêt rapide activé par la sécurité
	SafeStop: BOOL;
	///🟢 Descente autorisée (TRUE = OK | FALSE = mou de câble / limite basse)
	DescendPermit: BOOL;
	///🟢 Montée autorisée (TRUE = OK | FALSE = fin de course haut)
	AscentPermit: BOOL;
	///⚠️ Mou de câble physiquement détecté
	SlackCable: BOOL;
	///🔥 Surchauffe thermique moteur
	ThermalFault: BOOL;
	///🔌 Perte de liaison ou incohérence codeur
	EncoderFault: BOOL;
	///Bypass codeur effectivement accepté, uniquement MAINT_N2
	BypassActive: BOOL;
	///⚠️ Longueur max de câble atteinte (limite basse physique)
	CableLimitDescent: BOOL;
	///⚠️ Limite haute d'exploitation normale atteinte
	CableLimitAscent: BOOL;
	///📐 Dérive mesurée Méca A (m)
	MecaADrift_M: REAL;
	///📐 Dérive mesurée Méca C (m)
	MecaCDrift_M: REAL;
	///⏳ Temps écoulé confirmation contacteurs/frein
	MecaBElapsedTime: TIME;
	///🧨 Coupure puissance amont activée
	PowerCutOff: BOOL;
	///🚫 Synthèse globale : actionneur bloqué par la sécurité (PowerCutOff OU SafeStop/Error)
	BlockedBySafety: BOOL;
	///🧨 Synthèse sécurités critiques entraînant une coupure puissance
	PowerCutOffSafety: BOOL;
	///🛡️ Synthèse défauts entraînant un SafeStop / Rampe rapide
	SafeStopSafety: BOOL;
	///🔍 Décomposition individuelle des défauts de sécurité (bits ErrorId)
	///🎮 Perte communication opérateur : joystick CAN ou heartbeat IHM (bit0)
	ErrorOperatorComm: BOOL;
	///🔌 Perte de liaison ou incohérence codeur (bit1)
	ErrorEncoder: BOOL;
	///⚡ Mauvaise rotation de phases électriques (bit4)
	ErrorPhaseRotation: BOOL;
	///🌡️ Surchauffe thermique frein commun M1/M2/M3 (bit10)
	ErrorBrakeThermal: BOOL;
	///🔄 Mouvement non commandé / roue libre (Méca A - bit7)
	ErrorMecaA: BOOL;
	///🛑 Absence confirmation arrêt sans commande (Méca B - bit8)
	ErrorMecaB: BOOL;
	///🏋️ Glissement M1 pendant cycle benne (Méca C - bit9)
	ErrorMecaC: BOOL;
	///🚧 Non-arrêt sur capteur haut (Méca D - bit11)
	ErrorMecaD: BOOL;
	///🔄 Écart de synchronisation critique M1/M2 (Méca E - bit12/13)
	ErrorMecaE: BOOL;
	///🧭 Sens réel opposé au sens commandé (bit14)
	ErrorOppositeDir: BOOL;
	///⏱️ Absence de mouvement malgré commande (bit15)
	ErrorNoMovement: BOOL;
END_STRUCT
END_TYPE
</Single>
