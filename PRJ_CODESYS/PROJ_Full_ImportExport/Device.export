            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Winch_Safety :
STRUCT
	///1 = Boucle Urgence OK (Armé) | 0 = Arrêt d'Urgence Appuyé
	Idx301_EmergencyChainClosed: BOOL;
	///0 = Sain (Autorisé) | 1 = Arrêt Rapide Métier Actif
	Idx302_SafeStopActive: BOOL;
	///0 = Puissance OK | 1 = Coupure Puissance Sécurité
	Idx303_PowerCutOffActive: BOOL;
	///1 = Capteur Haut Libre (Sain) | 0 = Butée Haute Atteinte
	Idx304_TopSensorPhysical_DI: BOOL;
	///0 = Capteur Actif | 1 = Capteur Haut Shunté IHM ⚠️
	Idx305_TopSensorBypassActive: BOOL;
	///1 = Montée Autorisée | 0 = MONTÉE BLOQUÉE
	Idx306_AscentPermitEffective: BOOL;
	///1 = Câble Tendu (Sain) | 0 = Mou de Câble Détecté
	Idx307_SlackCablePhysical_DI: BOOL;
	///0 = Capteur Actif | 1 = Mou de Câble Shunté IHM ⚠️
	Idx308_SlackCableBypassActive: BOOL;
	///1 = Descente Autorisée | 0 = DESCENTE BLOQUÉE
	Idx309_DescendPermitEffective: BOOL;
	///Défauts safety déchiffrés (bits ErrorId) — visibles individuellement à l'IHM
	///bit0 Perte communication opérateur (joystick CAN / heartbeat IHM)
	Idx310_ErrorOperatorComm: BOOL;
	///bit1 Perte codeur de ce treuil
	Idx311_ErrorEncoder: BOOL;
	///bit4 Mauvaise rotation de phases
	Idx312_ErrorPhaseRotation: BOOL;
	///bit7 Mouvement non commandé / roue libre
	Idx313_ErrorMecaA: BOOL;
	///bit8 Absence confirmation arrêt sans commande
	Idx314_ErrorMecaB: BOOL;
	///bit9 Glissement M1 pendant cycle benne
	Idx315_ErrorMecaC: BOOL;
	///bit11 Non-arrêt sur capteur haut
	Idx316_ErrorMecaD: BOOL;
	///bit12/13 Écart synchro critique M1/M2
	Idx317_ErrorMecaE: BOOL;
	///bit10 Surchauffe thermique frein commun
	Idx318_ErrorBrakeThermal: BOOL;
	///bit14 Sens réel opposé au sens commandé
	Idx319_ErrorOppositeDir: BOOL;
	///bit15 Absence de mouvement malgré commande
	Idx320_ErrorNoMovement: BOOL;
	///⛔ Bloc "Pourquoi la montée ne s'arrête pas à la limite haute ?" — diagnostic ordonné
	///       (lecture maintenance) : config + position → butée atteinte → bypass actifs.
	///📐 Limite haute effective active (m) = CfgCableLimitAscent_M
	Idx321_CfgTopLimitM: REAL;
	///📐 Position câble courante (m)
	Idx322_CablePosM: REAL;
	///1 = position &gt;= limite haute (hors homing) | 0 = en dessous
	Idx323_TopLimitReached: BOOL;
	///1 = montée réellement coupée par la butée logicielle (AscentPermit=0) | 0 = limitée non bloquante (bypass ?)
	Idx324_AscentBlockedByTopLimit: BOOL;
	///⚠️ 1 = butée logicielle shunétee IHM (individuel)
	Idx325_BypassTopLimitSoftware: BOOL;
	///⚠️ 1 = butée logicielle shunétee (commun)
	Idx326_BypassTopLimitSoftCommun: BOOL;
	///⚠️ 1 = capteur fin de course haut shuné IHM (individuel)
	Idx327_BypassTopLimitSwitch: BOOL;
	///⚠️ 1 = capteur fin de course haut shuné (commun)
	Idx328_BypassTopLimitSwitchCommun: BOOL;
	///⚠️ 1 = bypass global treuil (individuel)
	Idx329_BypassGlobal: BOOL;
	///⚠️ 1 = bypass global (commun)
	Idx330_BypassGlobalCommun: BOOL;
END_STRUCT
END_TYPE
</Single>
