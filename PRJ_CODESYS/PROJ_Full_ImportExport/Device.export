      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_ChainBucket :
STRUCT
	///1 = Benne Mécaniquement Ouvert | 0 = Non Confirmé
	Idx101_BucketIsOpen: BOOL;
	///1 = Benne Mécaniquement Fermé | 0 = Non Confirmé
	Idx102_BucketIsClosed: BOOL;
	///[mètres] Écart d'Ouverture Câble M1/M2
	Idx103_OffsetPos_M: REAL;
	///: 1 = Séquencement auto (ouverture/fermeture armée par mouvement couplé) en cours
	Idx104_AutoSeqActive: BOOL;
	///: 1 = État ouvert/fermé INCONNU (ni IsOpen ni IsClosed fiable) -- cause fréquente de blocage
	Idx105_StateIncoherent: BOOL;
	///: État machine FB_Bucket (READY/BUSY/DONE/DISABLED)
	Idx106_FBState: E_State;
	///: Dernière position M2 mémorisée "ouvert"
	Idx107_LastPosM2Open_M: REAL;
	///: Dernière position M2 mémorisée "fermé"
	Idx108_LastPosM2Close_M: REAL;
	///⚠️ Dépassement ouverture : Delta &lt; OffsetOpen - Tolerance (Enrouler M2)
	Idx109_BucketTooOpen: BOOL;
	///⚠️ Dépassement fermeture : Delta &gt; OffsetClose + Tolerance (Dérouler M2)
	Idx110_BucketTooClosed: BOOL;
	///↔️ Position intermédiaire (entrebâillée entre ouvert et fermé)
	Idx111_BucketIsIntermediate: BOOL;
	///📏 Écart réel signé M2 - M1 (mètres) en direct
	Idx112_DeltaPosition_M: REAL;
	///1 = Demande Ouverture IHM | 0 = Relâché
	Idx201_HmiCmd_BtnOpen: BOOL;
	///1 = Demande Fermeture IHM | 0 = Relâché
	Idx202_HmiCmd_BtnClose: BOOL;
	///1 = Demande Ouverture par le Cycle Auto
	Idx203_CycleCmd_Open: BOOL;
	///: 1 = Ouverture auto armée (descente couplée demandée, benne pas ouverte)
	Idx204_CoupledDiveOpenArmed: BOOL;
	///: 1 = Fermeture auto armée (montée couplée demandée, benne pas fermée)
	Idx205_CoupledAscentCloseArmed: BOOL;
	///: 1 = Fermeture mémorisée/en cours (instBucket.CloseReq -- reste à 1 si recul partiel non terminé)
	Idx206_CloseReqActive: BOOL;
	///: 1 = Ouverture mémorisée/en cours (instBucket.OpenReq -- idem)
	Idx207_OpenReqActive: BOOL;
	///: 1 = Mouvement couplé BLOQUÉ (auto-séquencement armé mais benne pas Busy -- vérifier Idx306_ErrorIdRaw)
	Idx208_MotionBlockedByBucket: BOOL;
	///1 = Boucle Urgence OK | 0 = AU Appuyé
	Idx301_EmergencyChainClosed: BOOL;
	///0 = Sain | 1 = Défaut Mouvement Benne
	Idx302_BucketFaultActive: BOOL;
	///1 = Toggle IHM arrêt auto descente actif
	Idx303_KoboldAutoStopEnabled: BOOL;
	///: 1 = Immersion confirmée (front Kobold dans la fenêtre)
	Idx304_KoboldImmersionConfirmed: BOOL;
	///: 1 = Fond détecté, descente bloquée (ProcessPermitM1/M2_Descend)
	Idx305_KoboldBottomTouchLatched: BOOL;
	///: bitfield brut FB_Bucket (bit0 timeout, bit1 incohérence, bit2 limites, bit3 codeur non référencé, bit4 glissement M1)
	Idx306_ErrorIdRaw: WORD;
	///1 = Mouvement Mâchoires en cours | 0 = Repos
	Idx401_BucketBusy: BOOL;
	///1 = Position Cible Atteinte | 0 = En cours
	Idx402_BucketDone: BOOL;
	///: 1 = Phase vitesse contrôlée montée en cours (post-fermeture auto)
	Idx403_ControlAscentActive: BOOL;
	///1 = Relais Action Benne M2 ON
	Idx501_M2_CmdRev_DQ: BOOL;
END_STRUCT
END_TYPE
</Single>
