            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎮 ST_CycleCmd — Commandes IHM pour le cycle semi-automatique
///   ═══════════════════════════════════════════════════════════════
TYPE ST_CycleCmd :
STRUCT
	///▶️ Lancement cycle automatique
	BtnStart: BOOL;
	///⏸️ Pause cycle automatique
	BtnPause: BOOL;
	///⏹️ Abandon / arrêt cycle automatique
	BtnAbort: BOOL;
	///🔁 Reset dédié FB_Cycle, jamais mélangé au reset défauts général (REX 2026-07-07)
	BtnReset: BOOL;
END_STRUCT
END_TYPE
