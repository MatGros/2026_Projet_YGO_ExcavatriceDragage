            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestCaseConfig — Configuration d'un cas de test
///═══════════════════════════════════════════════════════════════
TYPE ST_TestCaseConfig :
STRUCT
	///Libellé (ex. 'TC-01 Armement nominal')
	Name: STRING(32);
	///Première étape (SETUP) du cas de test
	FirstStep: INT;
END_STRUCT
END_TYPE
