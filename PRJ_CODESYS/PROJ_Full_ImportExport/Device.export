            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestSuiteReport — Rapport d'une suite de tests
///═══════════════════════════════════════════════════════════════
TYPE ST_TestSuiteReport :
STRUCT
	///Nom de la suite de tests
	Name: STRING(32);
	///Exécution en cours ?
	InProgress: BOOL;
	///Tous les tests de la suite ont réussi ?
	AllPassed: BOOL;
	///Au moins un échec détecté ?
	AnyFailed: BOOL;
	///Suite abandonnée ?
	Aborted: BOOL;
	///🛡️ Fin explicite, aucune attente implicite sur Done
	TerminalState: E_TestTerminalState;
	///Code d'erreur de configuration/exécution
	ErrorCode: INT;
	///Diagnostic court exploitable IHM/log
	ErrorMessage: STRING(160);
	///Premier cas de test en échec (0 si aucun)
	FailedTestCase: INT;
	///🏷️ TOUS les cas en échec en 1 ligne lisible (ex. 'TC-01 (step 15): FAIL_CHECK | TC-03 (step 30): FAIL_TIMEOUT') — évite de parcourir Cases[] un par un
	FailureSummary: STRING(255);
	///Étape en cours d'exécution
	CurrentStepId: INT;
	///Cas de test en cours d'exécution
	CurrentCaseId: INT;
	///Durée totale du run de la suite
	Duration: TIME;
	///Compteur de runs depuis le démarrage
	RunCounter: UDINT;
	Steps: ARRAY[1..GVL_PLC_Tests_Const.MaxSteps] OF ST_TestStepResult;
	Cases: ARRAY[1..GVL_PLC_Tests_Const.MaxTestCases] OF ST_TestCaseResult;
END_STRUCT
END_TYPE
</Single>
