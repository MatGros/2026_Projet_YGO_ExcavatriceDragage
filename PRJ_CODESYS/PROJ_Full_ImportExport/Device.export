      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔌 ST_EncoderHw — Frontière hardware codeur (IN/OUT)
///   ───────────────────────────────────────────────────────────────
///   🎯 Regroupe les entrées/sorties hardware d'un codeur absolu EtherCAT
///      pour exposer l'interface physique de FB_Encoder de façon testable.
///   🔌 Producteur/consommateur : PRG_02_Acquisition câble ce bus vers le device.
///   📄 Doc : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md
///   ═══════════════════════════════════════════════════════════════
TYPE ST_EncoderHw :
STRUCT
	///=== ENTREES BUS ETHERCAT (vers le codeur) ===
	///Position brute EtherCAT (in)
	RawPosIn: UDINT;
	///Codes alarmes bruts EtherCAT
	AlarmsIn: UINT;
	///Codes avertissements bruts EtherCAT
	WarningsIn: UINT;
	///Esclave EtherCAT operationnel
	SlaveOperational: BOOL;
	///Pulse confirmation preset reussi
	PresetAck: BOOL;
	///Pulse echec / timeout preset
	PresetNak: BOOL;
	///=== SORTIES BUS (vers le codeur) ===
	///Ordre declenchement preset vers PDO Rx
	PresetTriggerCmd: WORD;
	///Ordre sequence code vers PDO Rx
	CodeSeqTriggerCmd: WORD;
	///Valeur de preset transmise au PDO Rx
	PresetValueOut: UDINT;
END_STRUCT
END_TYPE
</Single>
