          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ ST_SafetyWinch — Diagnostics de sécurité pour un treuil
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des défauts de sécurité d'un treuil.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SafetyWinch :
STRUCT
	///🛡️ Bloc sécurité (Safety) en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut de sécurité
	ErrorId: WORD;
	///🟧 Arrêt rapide activé par la sécurité
	SafeStop: BOOL;
	///🚯 Descente interdite (détecteur mou de câble / limites)
	ForbidDescent: BOOL;
	///🚯 Montée interdite (fin de course haut)
	ForbidAscent: BOOL;
	///⚠️ Mou de câble physiquement détecté
	SlackCable: BOOL;
	///🔥 Surchauffe thermique moteur
	ThermalFault: BOOL;
	///🔌 Perte de liaison ou incohérence codeur
	EncoderFault: BOOL;
	///🔧 Bypass codeur effectivement accepté, uniquement MAINT_N2
	BypassActive: BOOL;
	///⚠️ Longueur max de câble atteinte (limite basse physique)
	CableLimitDescent: BOOL;
	///⚠️ Limite haute d'exploitation normale atteinte
	CableLimitAscent: BOOL;
	///📐 Dérive mesurée Méca A (m)
	MecaADrift_M: REAL;
	///📐 Dérive mesurée Méca C (m)
	MecaCDrift_M: REAL;
	///⏳ Temps écoulé confirmation contacteurs/frein
	MecaBElapsedTime: TIME;
	///🧨 Coupure puissance amont activée
	PowerCutOff: BOOL;
	///⏱️ Défaut watchdog confirmation ouverture/fermeture frein
	BrakeTimeoutFault: BOOL;
	///📐 Dépassement des bornes physiques haute/basse du câble
	CableOutOfBoundsFault: BOOL;
END_STRUCT
END_TYPE
</Single>
