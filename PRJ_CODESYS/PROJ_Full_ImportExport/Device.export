            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_TestCaseResult — Résultat d'un cas de test
///═══════════════════════════════════════════════════════════════
TYPE ST_TestCaseResult :
STRUCT
	///🏷️ Libellé lisible (copié de CaseTable[i].Name) — identifie le cas sans chercher l'index
	Name: STRING(32);
	///Le cas de test a-t-elle été exécuté (ex. non exécuté si setup précédent abort)
	Executed: BOOL;
	///Succès global du cas de test
	Ok: BOOL;
	///Index de la première étape en échec (0 si aucune)
	FailedStepId: INT;
	///Cause de l'échec global du cas de test
	FailReason: E_TestFailReason;
	///Durée totale du cas de test
	Duration: TIME;
END_STRUCT
END_TYPE
</Single>
