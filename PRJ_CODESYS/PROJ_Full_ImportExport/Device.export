        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📥 FB_Input — Entrée TOR conditionnée (brique réduite)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie-06_IO_Conditioning_v1.6.md §1
///   🧭 Interface RÉDUITE (Partie3 §1bis) : pas de contrat FB standard
///      complet (pas d'Enable/StartStop/Mode/State/StateAtError) — brique
///      de conditionnement bas niveau, à instancier en tableau (§3) ou
///      composée directement dans un FB métier.
///   🔁 Rôle : inversion NO/NC, filtrage anti-rebond, diagnostic voie/carte.
///   🔴 INTÉGRATION dans Winch/Translation/etc. : PAS encore décidée (choix
///      d'architecture en attente — composition interne vs FB_IO générique
///      séparé). Ce fichier ne fait QUE créer la brique elle-même.
///   ═══════════════════════════════════════════════════════════════
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Input) ===
FUNCTION_BLOCK FB_Input
VAR_INPUT
	///Signal brut carte d'entrée
	InputRaw: BOOL;
	///TRUE = NC (logique inversée)
	InvertLogic: BOOL;
	///Tempo anti-rebond (filtrage)
	FilterTime: TIME;
	///Diag voie/carte OK (§4) — TRUE par défaut si pas de diag dispo
	ChannelOk: BOOL := TRUE;
END_VAR
VAR_OUTPUT
	///Signal conditionné, prêt à l'emploi
	State: BOOL;
	///Voie en défaut (ChannelOk faux)
	Error: BOOL;
	///bit0: "Défaut matériel entrée (Carte HS)" - voie/carte HS
	ErrorId: WORD;
END_VAR
VAR
	FilterTon: TON;
	ValueRaw: BOOL;
	FirstScanDone: BOOL;
END_VAR
</Single>
