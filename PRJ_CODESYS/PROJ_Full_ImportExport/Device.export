        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🔒 FB_Safety_EmergencyManagementOutput — Projection Physique Fail-Safe
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Enable gate + copie consignes logiques vers sorties physiques
///   🔒 Polarité : MaintainA/B_RQ en maintien (TRUE = voie saine)
///   📄 Docs : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle/FB_Safety_EmergencyManagement_v1.1.md
///            DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.0.md
///            DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
FUNCTION_BLOCK FB_Safety_EmergencyManagementOutput
VAR_INPUT
	///Active le pilote (FALSE = toutes sorties à FALSE)
	Enable: BOOL;
	///Ordres logiques reçus du bloc logique
	Cmd: ST_Safety_Emergency_InternalCmd;
	///Miroir EmergencyChainClosed (pour bus State)
	ChainOk: BOOL;
	///Miroir PowerContactorEngaged (pour bus State)
	ContactorOk: BOOL;
	///Miroir ArmingSeqStep (pour bus State)
	ArmingStep: INT;
	///Calculé par Logic (pour bus State)
	Armable: BOOL;
	///Calculé par Logic (pour bus State)
	ArmingBusy: BOOL;
	///Miroir Error (pour bus Diag)
	Error: BOOL;
	///Miroir ErrorId (pour bus Diag)
	ErrorId: WORD;
	///Miroir (pour bus Diag)
	RedundancyTestFailed: BOOL;
	///Miroir (pour bus Diag)
	ArmFailed: BOOL;
	///Miroir (pour bus Diag)
	LockoutActive: BOOL;
END_VAR
VAR_OUTPUT
	///⚡ Sorties physiques terminales
	///Vers relais maintien canal A — TRUE = voie maintenue, FALSE = coupure
	MaintainA_RQ: BOOL;
	///Vers relais maintien canal B — TRUE = voie maintenue, FALSE = coupure
	MaintainB_RQ: BOOL;
	///Vers contacteur impulsion réarmement — TRUE = pulse actif
	ArmPulse_RQ: BOOL;
	///🚦 Bus d'état public
	State: ST_Safety_Emergency_State;
	Diag: ST_Safety_Emergency_Diag;
END_VAR
</Single>
