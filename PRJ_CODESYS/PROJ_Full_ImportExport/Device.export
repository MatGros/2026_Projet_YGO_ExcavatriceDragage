      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ↔️ ST_TranslationHMI — Données d'échange IHM pour le Translation M3
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des états, commandes et diagnostics du translation.
///   📄 Migration des champs manuels ex-ST_IHM_MANU terminée (2026-07-19, suppression IHM_MANU) —
///      doc métier : DOC/AF_Partie-11_Fonction_Translation_v1.8.md
///   ═══════════════════════════════════════════════════════════════
TYPE ST_TranslationHMI :
STRUCT
	///🎮 Commandes opérateur (manuel / maintenance)
	///🔢 Numéro de la cible de position sélectionnée
	SelectedTargetNum: INT;
	///↔️ Requête marche avant manuelle (bouton IHM, pas encore arbitrée)
	ReqFwd: BOOL;
	///↔️ Requête marche arrière manuelle (bouton IHM, pas encore arbitrée)
	ReqRev: BOOL;
	///🎯 Consigne fréquence manuelle [Hz], limitée par PRG_10_Outputs
	FreqSetpointHz: REAL;
	///🕹️ TRUE = joystick, FALSE = boutons ReqFwd/ReqRev
	JoystickSelect: BOOL;
	///🚦 États &amp; diagnostics FB_Translation
	///🤖 État de l'automate interne (FB_Translation)
	FBState: E_State;
	///🟢 Translation prêt à fonctionner
	Ready: BOOL;
	///⚙️ Mouvement en cours
	Busy: BOOL;
	///✅ Mouvement terminé avec succès
	Done: BOOL;
	///🔴 Translation en défaut
	Error: BOOL;
	///❌ Code du défaut actif
	ErrorId: WORD;
	///🔓 Commande de desserrage du frein (lecture seule, TRUE = desserré)
	BrakeCmd: BOOL;
	///🔌 Retour physique de l'état du frein
	BrakeFeedback: BOOL;
	///🎯 Capteur de détection de la position cible atteint
	PositionSensorTarget: BOOL;
	///📈 Fréquence de sortie réelle du variateur (Hz)
	DriveActualFreqHz: REAL;
	///⚙️ Mot de commande AC600 réellement appliqué
	DriveControlWord: WORD;
	///🎯 Consigne fréquence réellement appliquée
	DriveFreqRefHz: REAL;
	///↔️ Sens arbitré : -1 / 0 / +1
	ActiveDirection: INT;
	///📊 Consigne active après arbitrage
	ActiveSpeedRefPct: REAL;
	///🔌 Diagnostic variateur EtherCAT (décodé — pas de bit-masking côté IHM)
	///📡 Variateur M3 : communication prête (StatusWord bit7)
	DriveCommReady: BOOL;
	///⚡ Variateur M3 : puissance prête (StatusWord bit0)
	DrivePowerReady: BOOL;
	///🐞 Bypass diag (banc de test — auto-calculé depuis GVL_Simulation)
	///🔌 Activation du bypass des retours contacteurs (sens + frein)
	BypassContactorFeedback: BOOL;
	///📍 Mot capteurs et positions Translation M3
	PositionTremie: BOOL;
	PositionPV: BOOL;
	PositionP2: BOOL;
	PositionP1: BOOL;
	PositionMaintenance: BOOL;
	///bit4=Trémie, bit3=PV, bit2=P2, bit1=P1, bit0=Maintenance
	SensorsWord: BYTE;
	SensorWordIncoherent: BOOL;
	LimitSwitchFwd: BOOL;
	LimitSwitchRev: BOOL;
	MaintenanceTargetEnable: BOOL;
	SimulationModeActive: BOOL;
	///🧪 Commandes de test Translation, actives uniquement sur banc
	TestSensorsWordActive: BOOL;
	TestSensorsWord: BYTE;
	TestAtTremie: BOOL;
	TestBrakeStuckOpen: BOOL;
	TestPhantomFreq: BOOL;
	///🛡️ Sécurité (FB_Safety_Translation)
	///🛡️ Bloc sécurité (Safety) en défaut
	SafetyError: BOOL;
	///❌ Code bitfield du défaut de sécurité
	SafetyErrorId: WORD;
	///🎮 Perte joystick CANopen (bit0)
	SafetyErrorJoystick: BOOL;
	///📡 Perte communication EtherCAT variateur (bit1)
	SafetyErrorDriveComm: BOOL;
	///⚡ Mauvaise rotation de phases électriques (bit2)
	SafetyErrorPhaseRotation: BOOL;
	///🌡️ Surchauffe thermique frein commun (bit3)
	SafetyErrorBrakeThermal: BOOL;
	///🛑 Absence confirmation arrêt (Méca B - bit4)
	SafetyErrorMecaB: BOOL;
	///🔄 Mouvement non commandé (Méca A - bit5)
	SafetyErrorMecaA: BOOL;
	///🚧 Limite extrême Translation atteinte (bit6)
	SafetyErrorLimitSwitch: BOOL;
	///🧭 Mot capteurs M3 incohérent (bit7)
	SafetyErrorSensorIncoherent: BOOL;
	///🛡️ Décélération de sécurité demandée
	SafetySafeStop: BOOL;
	///🧨 Coupure puissance demandée
	SafetyPowerCutOff: BOOL;
END_STRUCT
END_TYPE
</Single>
