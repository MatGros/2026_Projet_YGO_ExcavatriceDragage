      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_MotionChecklist — Diagnostic chronologique de commande de mouvement
///   ───────────────────────────────────────────────────────────────
///   🎨 Permet de voir en un coup d'œil pourquoi un ordre de mouvement ne fait pas coller les relais.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_MotionChecklist :
STRUCT
	///1. Puissance &amp; Mode
	///TRUE = Contacteur principal sous tension (PowerContactorEngaged_DI) ➔ Armer puissance via Reset
	Step1_PowerEngaged: BOOL;
	///TRUE = Mode MAINT_N1 ou N2 actif (pas DISABLE) ➔ Commutateur Mode IHM
	Step2_ModeAuthorized: BOOL;
	///TRUE = Pas d'autre séquence en cours (Homing, Benne busy, etc.)
	Step3_NotBusyOtherTask: BOOL;
	///1bis. Entrées physiques directes HwIn (vérité terrain)
	///Contacteur puissance principal issu de HwIn.Machine
	HwIn_PowerContactorEngaged_DI: BOOL;
	///Retour fin de course frein (1 = ouvert) issu de HwIn
	HwIn_BrakeIsOpen_DI: BOOL;
	///Ordre de commande d'ouverture de frein généré par l'automate
	Cmd_BrakeRelease: BOOL;
	///2. Intention &amp; Demande
	///TRUE = Demande active (Bouton IHM ou Joystick) ➔ Si IHM : TglJoystickMaster doit être à 0 !
	Step4_MotionRequested: BOOL;
	///+1 = Montée, -1 = Descente, 0 = Repos
	RequestedDirection: INT;
	///0..100 % consigne demandée
	RequestedSpeedPct: REAL;
	///3. Chaîne de Sécurité &amp; Verrous
	///TRUE = Pas de SafeStop ni AU actif sur cet axe
	Step5_NoSafetyFault: BOOL;
	///TRUE = Sens autorisé (AscentPermit/DescendPermit)
	Step6_DirectionAllowed: BOOL;
	///TRUE = Commande frein activée &amp; retour frein OK
	Step7_BrakeReleased: BOOL;
	///TRUE = Étage de sortie LD débloqué (pas d'interlock actif)
	Step8_OutputInterlockOk: BOOL;
	///4. Bilan &amp; Exécution Physiques
	///🟢 TRUE = TOUTES LES CONDITIONS SONT REMPLIES, LES RELAIS DOIVENT COLLER !
	AllConditionsMet: BOOL;
	///🛗 Relais Montée physiquement commandé
	RelayFwdActive: BOOL;
	///🛗 Relais Descente physiquement commandé
	RelayRevActive: BOOL;
	///🔌 Contacteur de vitesse Palier 1 commandé
	SpeedContactor1Active: BOOL;
END_STRUCT
END_TYPE
</Single>
