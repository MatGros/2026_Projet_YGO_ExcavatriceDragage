        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 FB_Diag_Ethercat — Diagnostic bus EtherCAT &amp; Esclaves (M3, COD1, COD2)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Surveillance bus EtherCAT master, variateur M3 et codeurs M1/M2
///   🔌 Architecture : Publication ST_Diag_Device par esclave &amp; E_Diag_State
///   📄 Doc métier : DOC/AF/AF_Partie-12_Fonction_Diagnostic_v1.4.md
///   =======================================================================
FUNCTION_BLOCK FB_Diag_Ethercat
VAR_INPUT
	///=== COMMANDES &amp; CONTROLE ===
	///--&gt; [CMD] Active la surveillance EtherCAT
	Enable: BOOL;
	///--&gt; [CMD] Front d'acquittement des defauts
	Reset: BOOL;
	///=== ETATS BRUTS MATERIEL &amp; BYPASS VARIATEUR M3 ===
	///--&gt; [HW]  Valeur brute AC600_ECAT_Drive.GetDeviceState()
	DeviceVariateurStateRaw: DEVICE_STATE;
	///--&gt; [TST] TRUE = simulation active variateur M3
	DeviceVariateurSimBypass: BOOL;
	///=== ETATS BRUTS MATERIEL &amp; BYPASS ENCODEUR M1 ===
	///--&gt; [HW]  Valeur brute COD1_CODEUR.GetDeviceState()
	DeviceEncoderM1StateRaw: DEVICE_STATE;
	///--&gt; [TST] TRUE = simulation active encodeur M1
	DeviceEncoderM1SimBypass: BOOL;
	///=== ETATS BRUTS MATERIEL &amp; BYPASS ENCODEUR M2 ===
	///--&gt; [HW]  Valeur brute COD2_CODEUR.GetDeviceState()
	DeviceEncoderM2StateRaw: DEVICE_STATE;
	///--&gt; [TST] TRUE = simulation active encodeur M2
	DeviceEncoderM2SimBypass: BOOL;
	///=== BYPASS RESEAU IHM &amp; GRANULAIRES ===
	///--&gt; [TST] TRUE = bypass reseau global IHM
	NetworkBypassActive: BOOL;
	///--&gt; [TST] TRUE = bypass specifique bus EtherCAT maître
	EcatBusBypassActive: BOOL;
	///--&gt; [TST] TRUE = bypass specifique esclave variateur M3
	VariateurBypassActive: BOOL;
	///--&gt; [TST] TRUE = bypass specifique esclave codeur M1
	EncoderM1BypassActive: BOOL;
	///--&gt; [TST] TRUE = bypass specifique esclave codeur M2
	EncoderM2BypassActive: BOOL;
END_VAR
VAR_OUTPUT
	///=== ETAT DU BLOC ===
	///&lt;-- [STAT] Logique de surveillance active
	Ready: BOOL;
	///=== DIAGNOSTICS STRUCTURES PAR EQUIPEMENT ===
	///&lt;-- [DIAG] Diagnostics bus EtherCAT
	DeviceEthercatMaster: ST_Diag_Device;
	///&lt;-- [DIAG] Diagnostics esclave AC600
	DeviceVariateur: ST_Diag_Device;
	///&lt;-- [DIAG] Diagnostics esclave COD1
	DeviceEncoderM1: ST_Diag_Device;
	///&lt;-- [DIAG] Diagnostics esclave COD2
	DeviceEncoderM2: ST_Diag_Device;
END_VAR
VAR
	///=== SOUS-INSTANCES FB ===
	///* [INST] Detecteur front de reset
	ResetEdge: R_TRIG;
	///=== CALCULS ET ETATS INTERNES ===
	///. [LOC]  GetDeviceState() = RUNNING, hors tout bypass
	VariateurOnlineReal: BOOL;
	///. [LOC]  GetDeviceState() = RUNNING, hors tout bypass
	EncoderM1OnlineReal: BOOL;
	///. [LOC]  GetDeviceState() = RUNNING, hors tout bypass
	EncoderM2OnlineReal: BOOL;
	///. [LOC]  Simulation OU bypass reseau IHM variateur
	VariateurBypass: BOOL;
	///. [LOC]  Simulation OU bypass reseau IHM encodeur M1
	EncoderM1Bypass: BOOL;
	///. [LOC]  Simulation OU bypass reseau IHM encodeur M2
	EncoderM2Bypass: BOOL;
	///. [LOC]  Online effectif (reel OU bypass)
	VariateurOnlineEff: BOOL;
	///. [LOC]  Online effectif (reel OU bypass)
	EncoderM1OnlineEff: BOOL;
	///. [LOC]  Online effectif (reel OU bypass)
	EncoderM2OnlineEff: BOOL;
END_VAR
</Single>
