            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_CycleState — États et diagnostics IHM du cycle semi-automatique
///   ═══════════════════════════════════════════════════════════════
TYPE ST_CycleState :
STRUCT
	///🟢 Séquenceur prêt
	Ready: BOOL;
	///⚙️ Cycle en cours
	Busy: BOOL;
	///✅ Cycle terminé
	Done: BOOL;
	///🔴 Défaut cycle
	Error: BOOL;
	///❌ Code défaut cycle
	ErrorId: WORD;
	///🔄 Étape courante du Grafcet
	CycleStep: E_CycleStep;
	///📝 Libellé texte de l'étape courante
	CycleStateStr: STRING(80);
	///🎯 Miroir lecture seule de GVL_IHM.TranslationM3.Cmd.SelTarget
	SelTarget: INT;
	///🔌 Retour physique réel capteur contact de fond Kobold
	KoboldContactFond: BOOL;
	///🔌 Commande contacteur Kobold (calculée par FB_Cycle)
	KoboldContactorCmd: BOOL;
	///📐 Miroir de GVL_IHM.Commun.LimitLegalReached
	LimitLegalReached: BOOL;
	///📐 Miroir de GVL_IHM.Commun.Cfg.LimitLegalDepthMinAllowed_M
	LimitLegalDepth_M: REAL;
	///⚖️ Miroir de l'erreur synchro M1/M2
	WinchSyncError: BOOL;
	///⚖️ Miroir de l'écart synchro M1/M2
	WinchSyncDelta_M: REAL;
	///🐢 Écart de vitesse mesuré (T43/T45)
	SpeedMismatch_Mps: REAL;
	///🐢 Écart de vitesse détecté
	SpeedMismatchActive: BOOL;
	///🐢 Écart de vitesse confirmé
	SpeedMismatchConfirmed: BOOL;
	///📊 Position câble M1
	M1Position_M: REAL;
	///📊 Position câble M2
	M2Position_M: REAL;
	///🔫 Homme-mort joystick armé
	DeadmanArmed: BOOL;
	///🕹️ Mouvement joystick actif
	JoystickMotionActive: BOOL;
	///🟢 Homme-mort + axe Y actif (CycleMotionPermit)
	MotionPermit: BOOL;
END_STRUCT
END_TYPE
</Single>
