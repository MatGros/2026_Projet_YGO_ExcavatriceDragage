            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_WinchFinalInterlockState :
(
	///Desactive / Hors service
	DISABLED := 0,
	///Pret / Etat nominal
	READY := 1,
	///Attente confirmation feedback frein
	WAIT_BRAKE_COMMAND_CONFIRMATION := 2,
	///Temporisation changement de palier
	WAIT_STEP_DELAY := 3,
	///Temporisation anti-court-cycle redemarrage
	WAIT_RESTART_DELAY := 4,
	///Etat de defaut
	FAULT := 5,
	///Maintien §3bis du contacteur de sens (AC6/AC7)
	WAIT_SENSE_DROP_CONFIRM := 6
);
END_TYPE
</Single>
