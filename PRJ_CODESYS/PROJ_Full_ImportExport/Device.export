        <Single Name="TypeGuid" Type="System.Guid">2db5746d-d284-4425-9f7f-2663a34b0ebc</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639197103386381664</Single>
      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_CycleStep :
(
	///Vérifs cohérence états + sécurités, mise en position init
	INIT := 0,
	///Choix opérateur pos travail 1/2 + déplacement validé joystick
	WORK_POS_SELECT := 1,
	///Plongée grappin déjà ouvert, M1+M2 synchro
	DESCENDING_OPEN := 2,
	///Attente info BOOL capteur "fond touché"
	BOTTOM_TOUCH_WAIT := 3,
	///Désynchro M2 petite vitesse (offset X) → fermeture grappin
	SYNCHRO_ADJUST := 4,
	///Remontée lente de contrôle (vérification fermeture)
	CTRL_ASCENDING := 5,
	///Remontée pleine vitesse charge
	ASCENDING_LOADED := 6,
	///Égouttage temporisé (durée RETAIN)
	DRAINING_PAUSE := 7,
	///Déplacement chariot M3 vers trémie
	CHARIOT_MOVE := 8,
	///Descente de vidage + ouverture grappin
	DESCENDING_OPEN_DUMP := 9,
	///Retour position travail (remontée synchro)
	RETURN_WORK_POS := 10,
	///Cycle terminé, prêt à reboucler
	READY := 11,
	///Arrêt sûr figé sur défaut (SafeStop)
	ERROR_HOLD := 12
);
END_TYPE
</Single>
