      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_PlcTestsStatus — États et progression des tests
///═══════════════════════════════════════════════════════════════
TYPE ST_PlcTestsStatus :
STRUCT
	RunState: E_TestRunState;
	///TRUE si la simulation automate est active
	SimulationActive: BOOL;
	///ID de la suite en cours (ex: 1)
	ActiveSuiteId: INT;
	///ID du cas en cours
	ActiveCaseId: INT;
	///ID de l'étape en cours
	ActiveStepId: INT;
	///Nom de la suite active
	ActiveSuiteName: STRING(32);
	///Nom du cas active
	ActiveCaseName: STRING(32);
	///Nom de l'étape active
	ActiveStepName: STRING(32);
	///Temps écoulé dans l'étape active
	StepElapsed: TIME;
	///Timeout de l'étape active
	StepTimeoutPT: TIME;
	///Nombre total de cas à jouer
	CasesTotal: INT;
	///Nombre de cas réussis
	CasesPassed: INT;
	///Nombre de cas en échec
	CasesFailed: INT;
	///Clignotant d'activité (3 pulses sur transition)
	Heartbeat: BOOL;
	///🏷️ Détail des défauts du dernier run, TOUTES suites confondues (remonte Report.FailureSummary de chaque suite exécutée) — lisible sans creuser Suite*Validation
	FailureSummary: STRING(255);
	TerminalState: E_TestTerminalState;
	ErrorCode: INT;
	ErrorMessage: STRING(160);
	SuiteElapsed: TIME;
	SuiteWatchdogExpired: BOOL;
END_STRUCT
END_TYPE
</Single>
