          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🚦 ST_fbBucket_State — État mémorisé et diagnostic du benne
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure d'état physique mémorisé et de diagnostic du benne
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   =======================================================================
TYPE ST_fbBucket_State :
STRUCT
	///Benne ouvert memorise
	IsOpen: BOOL;
	///Benne ferme memorise
	IsClosed: BOOL;
	///Depassement ouverture (Delta &lt; OffsetOpen - Tolerance)
	TooOpen: BOOL;
	///Depassement fermeture (Delta &gt; OffsetClose + Tolerance)
	TooClosed: BOOL;
	///Position intermediaire (entre Ouvert et Ferme)
	IsIntermediate: BOOL;
	///Derniere position M2 memorisee ouvert (m)
	LastPosM2Open: REAL;
	///Derniere position M2 memorisee ferme (m)
	LastPosM2Close: REAL;
	///Validite offset actif calcule a jour
	ActiveOffsetValid: BOOL;
	///Etat non sur (divergence boot/reel)
	StateIncoherent: BOOL;
END_STRUCT
END_TYPE
</Single>
