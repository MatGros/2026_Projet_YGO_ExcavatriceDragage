            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧲 ST_AcquisitionEncoderQualified — Façade codeur qualifiée
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Encapsuler les mesures métriques, statuts de référencement,
///      défauts et signaux hardware produits par FB_Encoder dans PRG_02_Acquisition.
///   📤 Producteur unique : PRG_02_Acquisition (Data.EncoderM1 / Data.EncoderM2).
///   📄 Doc : DOC/AF/AF_Partie-06_Acquisition_Qualification_IO_v2.4.md
///   ═══════════════════════════════════════════════════════════════
TYPE ST_AcquisitionEncoderQualified :
STRUCT
	///📊 Mesure métrique (CablePosM, SpeedMps, etc.)
	Measurement: ST_fbEncoder_Measurement;
	///🟢 Façade codeur prête
	Ready: BOOL;
	///❌ Diagnostic défaut codeur
	Fault: ST_Fault;
	///🎯 Codeur référencé
	Homed: BOOL;
	///⚠️ Référencement suspect
	HomingSuspect: BOOL;
	///❌ Défaut fiabilité (indisponible ou incohérent)
	EncoderFault: BOOL;
	///✅ Référencé ET fiable (sans incohérence)
	HomedAndReliable: BOOL;
	///❌ Échec confirmation preset
	PresetConfirmationFailed: BOOL;
	///📡 Commandes hardware de preset (lecture seule)
	HwOut: ST_fbEncoder_HwOut;
END_STRUCT
END_TYPE
</Single>
