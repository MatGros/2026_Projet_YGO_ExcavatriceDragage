            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Safety_EmergencyManagement — Bloc Safety Composite (Parent)
///   ───────────────────────────────────────────────────────────────
///   📄 Rôle : Bloc de sécurité principal de la boucle d'arrêt d'urgence.
///   🧩 Encapsule la Logique (FB_Safety_EmergencyManagementLogic) et le 
///      Pilote Physique (FB_Safety_EmergencyManagementOutput) par composition.
///   ═══════════════════════════════════════════════════════════════
///   📄 Docs : DOC/AF_Partie-01_Analyse_Fonctionnelle_v1.6.md ; DOC/AF_Partie-03_Template_FB_Commun_v1.3.md
FUNCTION_BLOCK FB_Safety_EmergencyManagement
VAR_INPUT
	///Active la surveillance
	Enable: BOOL;
	///Front acquittement défauts
	Reset: BOOL;
	///Demande de réarmement (BtnEmergencyArming)
	ArmRequest: BOOL;
	///Retour physique boucle d'urgence amont contacteur
	EmergencyChain: BOOL;
	///Confirmation contacteur de puissance principal
	EmergencyStopOk: BOOL;
	///Requête de coupure logique issue des métiers
	PowerCutOffRequest: BOOL;
	///Commande d'ouverture d'urgence depuis l'IHM
	BtnEmergencyCutOff: BOOL;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: RedundancyTestFailed, bit1: EmergencyArmingFailed
	ErrorId: WORD;
	///Sortie de pilotage canal A (maintenu à TRUE, fail-safe)
	PowerCutOff_A_RQ: BOOL;
	///Sortie de pilotage canal B (maintenu à TRUE, fail-safe)
	PowerCutOff_B_RQ: BOOL;
	///Impulsion réarmement physique (1s)
	EmergencyArming_RQ: BOOL;
	///Étape de diagnostic : 0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm
	ArmingSeqStep: INT;
	///Canal A ou B resté collé/shunté détecté à l'auto-test
	RedundancyTestFailed: BOOL;
	///Contacteur de puissance n'a pas confirmé l'armement
	EmergencyArmingFailed: BOOL;
	///Verrouillage temporel de 5s entre les essais
	EmergencyArmingLockoutActive: BOOL;
END_VAR
VAR
	///🧱 Composition interne des sous-blocs
	Logic: FB_Safety_EmergencyManagementLogic;
	Output: FB_Safety_EmergencyManagementOutput;
END_VAR
</Single>
