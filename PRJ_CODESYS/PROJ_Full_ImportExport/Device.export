            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ ST_SafetyTranslation — Diagnostics de sécurité pour la Translation M3
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des défauts de sécurité du translation.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SafetyTranslation :
STRUCT
	///🛡️ Bloc sécurité (Safety) en défaut
	Error: BOOL;
	///❌ Code bitfield du défaut de sécurité
	ErrorId: WORD;
	///🎮 Perte communication opérateur : joystick CAN ou heartbeat IHM (bit0)
	ErrorOperatorComm: BOOL;
	///📡 Perte communication EtherCAT variateur (bit1)
	ErrorDriveComm: BOOL;
	///⚡ Mauvaise rotation de phases électriques (bit2)
	ErrorPhaseRotation: BOOL;
	///🌡️ Surchauffe thermique frein commun (bit3)
	ErrorBrakeThermal: BOOL;
	///🛑 Absence confirmation arrêt (Méca B - bit4)
	ErrorMecaB: BOOL;
	///🔄 Mouvement non commandé (Méca A - bit5)
	ErrorMecaA: BOOL;
	///🚧 Limite extrême Translation atteinte (bit6)
	ErrorLimitSwitch: BOOL;
	///🧭 Mot capteurs M3 incohérent (bit7)
	ErrorSensorIncoherent: BOOL;
	///🛡️ Décélération de sécurité demandée
	SafeStop: BOOL;
	///🧨 Coupure puissance demandée
	PowerCutOff: BOOL;
END_STRUCT
END_TYPE
</Single>
