            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Winch_Demandes :
STRUCT
	///[pts] Bruts convertisseur (-2048 à +2048)
	Idx201_JoyRawPhysical_ANA: INT;
	///[%] Consigne Joystick (-100% à +100%)
	Idx202_JoyScaledPhysical_Pct: REAL;
	///1 = Appui Bouton Montée IHM | 0 = Relâché
	Idx203_HmiManualCmd_BtnUp: BOOL;
	///1 = Appui Bouton Descente IHM | 0 = Relâché
	Idx204_HmiManualCmd_BtnDown: BOOL;
	///[%] Consigne auto envoyée par le Cycle
	Idx205_CycleAutoCmd_Pct: REAL;
	///Mode courant (MANU_N1, AUTO_N1, MAINT_N2...)
	Idx206_ModeActive: E_Mode;
	///0 = Comm Normale OK | 1 = Bypass Réseau Actif ⚠️
	Idx207_BypassOperatorComm: BOOL;
	///[%] Consigne finale retenue après arbitrage
	Idx208_ArbitratedSpeed_Pct: REAL;
	///+1 = Montée | 0 = Neutre | -1 = Descente
	Idx209_ArbitratedDirection: INT;
END_STRUCT
END_TYPE
</Single>
