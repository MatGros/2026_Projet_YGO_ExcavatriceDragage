          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎚️ ST_Modes_Autorisations — Bus d'autorisations du mode machine
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-05_Modes_Maintenance_v2.0.md
///                   DOC/AF/AF_Partie-02_Architecture_Programme_v3.1.md §2
///   🎯 Produit par FB_Modes (via PRG_MODES_CFC)
///      Consommé par : Cycle, Safety, Treuils, Translation, Supervision, Acquisition
///   🎯 Producteur unique : FB_Modes (via PRG_MODES_CFC)
///   ═══════════════════════════════════════════════════════════════
TYPE ST_Modes_Autorisations :
STRUCT
	///Mode arbitré (DISABLE/N1/N2/SEMI_AUTO)
	Mode: E_Mode;
	///Synchro M1/M2 (logique positive)
	SyncEnable: BOOL;
	///Inhibition M1 (MAINT_N2 only)
	InhibitM1: BOOL;
	///Inhibition M2 (MAINT_N2 only)
	InhibitM2: BOOL;
	///0=M1+M2 couplés nominal, 1=M1, 2=M2 (unitaires MAINT_N2)
	JoystickWinchSelectArbitrated: INT;
	///Dépassement butée haut (N2)
	HomingApproachEnable: BOOL;
	///Cible Translation Maintenance (N2 only)
	MaintenanceM3TargetEnable: BOOL;
END_STRUCT
END_TYPE
</Single>
