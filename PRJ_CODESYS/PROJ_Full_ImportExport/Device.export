      </Single>
      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚨 ST_IHM_MANU — Table d'échange IHM provisoire (mise en service URGENCE)
///   ───────────────────────────────────────────────────────────────
///   🎨 Pilotage manuel DIRECT des sorties physiques (relais, contacteurs
///      vitesse, freins) et du variateur M3 (EtherCAT, mot de commande) —
///      programme fonctionnel normal bypassé en sortie (PRG_10_Outputs
///      uniquement), aucune sécurité logicielle métier active.
///   ⚠️ DANGER : seuls les interlocks Fwd/Rev (couplé/individuel mutuellement
///      exclusifs, voir PRG_10_Outputs) protègent, plus la chaîne AU/PowerCutOff
///      (toujours active, non bypassée). Pas de limites logicielles, pas de synchro.
///   🔧 REX 2026-07-09 : M3_CommandWord (registre 0x3101 côté carte EtherCAT, PAS le
///      0x3001 natif variateur) = 0 arrêt / 1 marche avant / 2 marche arrière (recette
///      fournisseur) — ⚠️ non vérifié sur banc au moment du codage, à confirmer.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_IHM_MANU :
STRUCT
	///🔑 Activation — logique INVERSÉE volontaire (REX 2026-07-09)
	///🔴 FALSE (défaut, y compris à CHAQUE démarrage/download automate,
	ModeDisable: BOOL;
	///🔌 TRUE = Joystick CANopen | FALSE = Boutons IHM
	JoystickSelect: BOOL;
	///🛗 1 = M1, 2 = M2, 3 = Couplé
	JoystickWinchSelect: INT;
	///🪝 Treuil M1
	///📊 [m] Position brute codeur M1
	PositionM_M1: REAL;
	///🛗 Commande montée M1 + frein
	M1_RelayFwd: BOOL;
	///🛗 Commande descente M1 + frein
	M1_RelayRev: BOOL;
	///🎯 Front = référencement codeur M1 (OR avec GVL_IHM.WinchM1.CmdHome existant)
	HomingEncoder_M1: BOOL;
	///🪝 Treuil M2
	///📊 [m] Position brute codeur M2
	PositionM_M2: REAL;
	///🛗 Commande montée M2 + frein
	M2_RelayFwd: BOOL;
	///🛗 Commande descente M2 + frein
	M2_RelayRev: BOOL;
	///🎯 Front = référencement codeur M2 (OR avec GVL_IHM.WinchM2.CmdHome existant)
	HomingEncoder_M2: BOOL;
	///🔗 Commande couplée M1+M2
	///🔗 Commande montée M1 et M2 + frein
	M1_M2_RelayFwd: BOOL;
	///🔗 Commande descente M1 et M2 + frein
	M1_M2_RelayRev: BOOL;
	///⚡ Vitesse M1 et M2
	M1_M2_Contactor1: BOOL;
	///⚡ Vitesse M1 et M2
	M1_M2_Contactor2: BOOL;
	///⚡ Vitesse M1 et M2
	M1_M2_Contactor3: BOOL;
	///⚡ Vitesse M1 et M2
	M1_M2_Contactor4: BOOL;
	///↔️ Chariot M3 (variateur AC600)
	///↔️ Commande frein + envoi valeur dans mot de commande
	M3_RelayFwd: BOOL;
	///↔️ Commande frein + envoi valeur dans mot de commande
	M3_RelayRev: BOOL;
	///🎯 Consigne fréquence variateur [Hz]
	M3_FreqSetpoint: REAL;
	///📊 Retour fréquence mesurée [Hz]
	M3_FreqActual: REAL;
	///🌾 Auxiliaires Hydrauliques (HMI maintained action)
	///🌾 Commande ouverture grille
	GridOpenCmd: BOOL;
	///🌾 Commande fermeture grille
	GridCloseCmd: BOOL;
	///🪖 Commande ouverture casque
	HelmetOpenCmd: BOOL;
	///🪖 Commande fermeture casque
	HelmetCloseCmd: BOOL;
	///📊 Fins de Course Virtuels Grappin (delta M1 - M2)
	///🎚️ Activer FDC Ouvert (stop M2 descente si delta &gt;= 0.0m)
	FdcGrappinOpenEnable: BOOL;
	///🎚️ Activer FDC Fermé (stop M2 montée si delta &lt;= -10.0m)
	FdcGrappinCloseEnable: BOOL;
	///⚠️ OBSOLÈTE (visu) — alias de FdcGrappinOpenEnable
	FdcGrappinOpen: BOOL;
	///⚠️ OBSOLÈTE (visu) — alias de FdcGrappinCloseEnable
	FdcGrappinClose: BOOL;
	///📊 [m] Écart M1-M2 en temps réel
	GrappinDelta: REAL;
	///🚨 Limite basse M2 atteinte (descente coupée)
	FdcGrappinOpenActive: BOOL;
	///🚨 Limite haute M2 atteinte (montée coupée)
	FdcGrappinCloseActive: BOOL;
	///🔍 Diagnostics Variateur M3
	///🔍 Mot de commande envoyé au variateur
	M3_CommandWordMonitor: WORD;
	///🔍 Mot d'état reçu du variateur
	M3_StatusWordMonitor: WORD;
	///🔍 Variateur M3 : communication prête (bit 7)
	M3_CommReady: BOOL;
	///🔍 Variateur M3 : puissance prête (bit 0)
	M3_PowerReady: BOOL;
	///⚡ Réglages dynamiques des limites de vitesse (paliers max)
	///⚡ Palier max en montée (1..5, défaut 5)
	WinchMaxStepFwd: INT;
	///⚡ Palier max en descente (1..5, défaut 2)
	WinchMaxStepRev: INT;
END_STRUCT
END_TYPE
</Single>
