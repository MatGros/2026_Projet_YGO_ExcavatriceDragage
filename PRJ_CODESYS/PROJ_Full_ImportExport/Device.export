            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🪣 ST_ProgramBucketRequest — Demande de mouvement benne par le programme
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Regroupe les demandes logiques de manœuvre benne et mesure Kobold
///   📄 Référentiel : DOC/WFLOW/CONTRACTS/INTERPRG_CONTRACT_PRG03_MODES_CYCLE_v1.0.md
///   =======================================================================
TYPE ST_ProgramBucketRequest :
STRUCT
	///Demande ouverture benne
	ReqOpen: BOOL;
	///Demande fermeture benne
	ReqClose: BOOL;
	///Demande activation mesure/contacteur Kobold
	ReqKoboldMeasureEnable: BOOL;
	///Autorisation de descente conditionnée benne ouverte (DiveSearch)
	DescendPermitDiveBucketOpen: BOOL;
	///Plafond palier 1 pendant la montée contrôlée
	ExtractionControlActive: BOOL;
	///Palier plancher de descente imposé pendant la plongée (FB_DiveSearch, 0 = aucun)
	MinStepDown: INT;
END_STRUCT
END_TYPE
</Single>
