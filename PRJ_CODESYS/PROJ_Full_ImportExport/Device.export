        </Array>
        <Single Name="Timestamp" Type="long">639237203751623537</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_DriftGuard) ===

IF Arm THEN
    IF NOT WasArmed THEN
        RefPosM := PositionM;   // Capture au 1er cycle armé uniquement
        WasArmed := TRUE;
    END_IF;
    DriftM := ABS(PositionM - RefPosM);
    Violation := DriftM &gt; ToleranceM;
ELSE
    WasArmed := FALSE;
    DriftM := 0.0;
    Violation := FALSE;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">923e17a0-9c99-44d6-9241-9d627ee41076_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📐 FB_DriftGuard — Détection de dérive de position sous armement
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Capture position de référence et détection de dérive anormale
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.1.md
///   🔌 Interface : Brique interne de sécurité (compose FB_Safety_Winch)
///   🔒 Sécurité : Détection de mouvement non commandé et glissement
///   =======================================================================
FUNCTION_BLOCK FB_DriftGuard
VAR_INPUT
	///=== COMMANDES ET SEUILS ===
	///--&gt; [CMD] Condition d'armement de la surveillance
	Arm: BOOL;
	///--&gt; [HW] Position courante a surveiller (m)
	PositionM: REAL;
	///--&gt; [CFG] Tolerance de derive maximale autorisee (m)
	ToleranceM: REAL;
END_VAR
VAR_OUTPUT
	///=== MESURES ET ETATS ===
	///&lt;-- [DIAG] Position de reference capturee a l'armement (m)
	RefPosM: REAL;
	///&lt;-- [DIAG] Derive absolue courante (m)
	DriftM: REAL;
	///&lt;-- [STAT] Alarme derive maximale depassee
	Violation: BOOL;
END_VAR
VAR
	///=== VARIABLES LOCALES INTERNES ===
	///. [LOC] Memoire etat armement cycle precedent
	WasArmed: BOOL;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">923e17a0-9c99-44d6-9241-9d627ee41076_Decl_LineIds</Single>
          </Single>
