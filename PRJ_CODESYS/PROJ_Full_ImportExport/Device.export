            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 ST_Diag_Device — Structure diagnostic d'un esclave ou bus
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure de donnees d'état, diagnostic et alarme d'un equipement réseau
///   📄 Doc métier : DOC/AF/AF_Partie-12_Fonction_Diagnostic_v1.4.md
///   =======================================================================
TYPE ST_Diag_Device :
STRUCT
	///Esclave visible sur le bus
	Online: BOOL;
	///Esclave en mode OP (opérationnel)
	Operational: BOOL;
	///Signal de défaut actif pour cet esclave
	Error: BOOL;
	///Code défaut détaillé
	ErrorId: WORD;
	///Phase courante du cycle de diagnostic
	State: E_Diag_State;
	///Instantané de la phase lors de l'anomalie
	StateAtError: E_Diag_State;
END_STRUCT
END_TYPE
</Single>
