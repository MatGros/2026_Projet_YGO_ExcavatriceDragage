          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639186736195512554</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Modes) ===

// 🛑 1. GATE — repli sur le mode le plus contraint/surveillé (MAINT_N1), jamais SEMI_AUTO/MANUEL
// par défaut si la surveillance elle-même n'est pas garantie
IF NOT Enable OR NOT EmergencyStopOk THEN
    Mode := E_Mode.MAINT_N1;
    OverrideSync := FALSE;
    Ready := FALSE; Busy := FALSE; Done := FALSE;
    State := E_State.DISABLED;
    RETURN;
END_IF;

Ready := TRUE;
State := E_State.READY;

// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);

// 🔍 3. GARDE-FOUS
// bit0 : SEMI_AUTO demandé mais défaut codeur présent → refusé, repli MAINT_N1
IF (ModeRequest = E_Mode.SEMI_AUTO) AND EncoderFaultPresent THEN
    ErrorId := ErrorId OR 16#0001;
ELSIF ResetEdge.Q THEN
    ErrorId := ErrorId AND 16#FFFE;
END_IF;

// bit1 : MAINT_N2 demandé sans mot de passe → refusé, repli MAINT_N1
IF (ModeRequest = E_Mode.MAINT_N2) AND NOT PasswordOk THEN
    ErrorId := ErrorId OR 16#0002;
ELSIF ResetEdge.Q THEN
    ErrorId := ErrorId AND 16#FFFD;
END_IF;

// 📤 4. ARBITRAGE DU MODE
IF (ModeRequest = E_Mode.SEMI_AUTO) AND EncoderFaultPresent THEN
    Mode := E_Mode.MAINT_N1;
ELSIF (ModeRequest = E_Mode.MAINT_N2) AND NOT PasswordOk THEN
    Mode := E_Mode.MAINT_N1;
ELSE
    Mode := ModeRequest;
END_IF;

// 📤 5. OVERRIDE SYNC — actionnable UNIQUEMENT en MAINT_N2 (Partie5 §2)
OverrideSync := (Mode = E_Mode.MAINT_N2) AND OverrideSyncRequest;

// 📤 6. SORTIES ÉTAT
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;

Busy := FALSE;
Done := FALSE;
</Single>
            <Single Name="LineInfoPersistence" Type="string">6b5e0b46-d463-4411-9ed4-5f70e2d30a5e_Impl_LineIds</Single>
