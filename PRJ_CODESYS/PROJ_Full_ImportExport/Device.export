            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_TestCheckKind :
(
	///ProbeBool[i] = ExpectedBool
	BOOL_EQUAL := 0,
	///Front montant de ProbeBool[i]
	BOOL_RISING := 1,
	///Front descendant de ProbeBool[i]
	BOOL_FALLING := 2,
	///ProbeDint[i] = ExpectedDint
	DINT_EQUAL := 3,
	///ProbeDint[i] &lt;&gt; ExpectedDint
	DINT_NOT_EQUAL := 4,
	///ExpectedMin &lt;= ProbeDint[i] &lt;= ExpectedMax
	DINT_IN_RANGE := 5,
	///(DINT_TO_WORD(ProbeDint[i]) AND Mask) = Mask
	WORD_MASK_ALL := 6,
	///(DINT_TO_WORD(ProbeDint[i]) AND Mask) &lt;&gt; 0
	WORD_MASK_ANY := 7,
	///(DINT_TO_WORD(ProbeDint[i]) AND Mask) = 0
	WORD_MASK_NONE := 8,
	///RealMin &lt;= ProbeReal[i] &lt;= RealMax
	REAL_IN_RANGE := 9
);
END_TYPE
</Single>
