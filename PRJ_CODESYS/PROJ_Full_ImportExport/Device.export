        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 FB_Encoder_SpeedMonitor — Détection variation brusque vitesse câble
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Surveillance et détection de variation brusque de vitesse câble
///   🔒 Polarité : SpeedVariationConfirmed=TRUE si variation &gt; seuil pendant timeout
///   📊 Diagnostic : Brique de surveillance diagnostic sans actionneur direct
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md
///   =======================================================================
FUNCTION_BLOCK FB_Encoder_SpeedMonitor
VAR_INPUT
	///=== COMMANDES &amp; AUTORISATIONS ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut (front montant)
	Reset: BOOL;
	///=== CONTEXTE &amp; ETAT PUISSANCE ===
	///--&gt; [HW]  Ligne puissance enclenchee
	PowerContactorEngaged: BOOL;
	///--&gt; [CMD] Mode d'exploitation actif
	Mode: E_Mode;
	///=== MESURES &amp; CONSIGNES SURVEILLANCE ===
	///--&gt; [HW]  Vitesse lineaire absolue mesuree (m/s)
	SpeedMps: REAL;
	///--&gt; [CFG] Seuil de variation minimale a surveiller (m/s)
	SpeedVariationThresholdMps: REAL;
	///--&gt; [CFG] Duree minimale de confirmation variation
	SpeedVariationTimeout: TIME;
	///--&gt; [CFG] Duree sans variation avant vitesse stable
	SpeedStabilityTimeout: TIME;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///🧩 Statut transverse (forme cible) — regroupe Busy/Done/Error/ErrorId/State/StateAtError.
	///ErrorId bit0: "variation vitesse confirmée".
	Status: ST_FbStatus;
	///=== RESULTATS &amp; MESURES DIAGNOSTIC ===
	///&lt;-- [DIAG] Ecart absolu entre deux mesures (m/s)
	SpeedDeltaMps: REAL;
	///&lt;-- [DIAG] Seuil depasse sur le cycle courant
	SpeedVariationDetected: BOOL;
	///&lt;-- [DIAG] Seuil depasse pendant la duree requise
	SpeedVariationConfirmed: BOOL;
	///&lt;-- [STAT] Vitesse stable pendant SpeedStabilityTimeout
	SpeedStable: BOOL;
END_VAR
VAR
	///=== DETECTEURS DE FRONT ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///. [LOC] Detecteur front montant Error
	ErrorEdge: R_TRIG;
	///=== TEMPORISATEURS INTERNES ===
	///. [LOC] Temporisateur de confirmation de variation
	VariationTimer: TON;
	///. [LOC] Temporisateur de confirmation de stabilite
	StabilityTimer: TON;
	///=== VARIABLES ET MEMOIRES INTERNES ===
	///. [LOC] Vitesse mesuree au cycle precedent (m/s)
	PreviousSpeedMps: REAL;
	///. [LOC] Premiere mesure enregistree
	HasPreviousSpeed: BOOL;
	///. [LOC] Condition de depassement de seuil active
	VariationActive: BOOL;
END_VAR
</Single>
