        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Safety_Translation — Bloc Safety pour le Translation M3 (EtherCAT)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : ARCHIVES/Doc/AF_Partie-11_Fonction_Translation_v2.0.md
///   🔁 Rôle : Surveillance joystick, bus EtherCAT, rotation de phases, 
///      thermique frein commun, Méca A (vitesse non commandée à l'arrêt), 
///      Méca B (frein/variateur en mouvement à l'arrêt), et Fdc extrêmes.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Safety_Translation
VAR_INPUT
	///Active la surveillance
	Enable: BOOL;
	///Front acquittement défauts
	Reset: BOOL;
	///Chaîne AU réarmée + conditions globales OK
	PowerContactorEngaged: BOOL;
	///Mode courant
	Mode: E_Mode;
	///instDiagCanOpen.DeviceJoystick.Online
	JoystickOnline: BOOL;
	///instDiagCanOpen.DeviceJoystick.Operational
	JoystickOperational: BOOL;
	///💓 IHM↔PLC : TRUE après front post-boot, FALSE = perte communication opérateur
	HeartbeatIhmOk: BOOL;
	///PRG_02_Acquisition.HwIn.Machine.PhaseRotationOk_DI (TRUE = OK)
	PhaseRotationOk: BOOL;
	///Thermique frein commun M1/M2/M3 (NC, TRUE = surchauffe/perte)
	BrakeThermalFeedback: BOOL;
	///🔌 Spécifique EtherCAT &amp; Capteurs réels
	///Status diagnostic communication EtherCAT (Online)
	DriveOnline: BOOL;
	///Status diagnostic communication EtherCAT (Operational)
	DriveOperational: BOOL;
	///Mot d'état variateur AC600
	DriveStatusWord: WORD;
	///Vitesse réelle variateur (Hz)
	DriveActualFreqHz: REAL;
	///Retour d'état bobine frein (TRUE = ouvert/desserré — révocation 2026-08-03)
	BrakeFeedback: BOOL;
	///Commande frein
	BrakeCmd: BOOL;
	///Direction commandée
	Direction: INT;
	///Fin de course extrême avant
	LimitSwitchFwd: BOOL;
	///Fin de course extrême arrière
	LimitSwitchRev: BOOL;
	///🆕 REX 2026-07-18 : mot des 5 capteurs position hors combinaisons valides (FB_Translation_PositionDecoder.Incoherent)
	SensorWordIncoherent: BOOL;
	///🔧 Bypass des surveillances (GVL_IHM.TranslationM3.Bypass)
	///🌐 Bypass GLOBAL : ignore TOUTES les surveillances ci-dessous (prioritaire)
	BypassGlobal: BOOL := FALSE;
	///🎮 Bypass perte communication opérateur
	BypassOperatorComm: BOOL := FALSE;
	///📡 Bypass perte communication drive
	BypassDriveComm: BOOL := FALSE;
	///⚡ Bypass défaut rotation phases
	BypassPhaseRotation: BOOL := FALSE;
	///🌡️ Bypass surchauffe frein
	BypassBrakeThermal: BOOL := FALSE;
	///🛑 Bypass Méca B
	BypassMecaB: BOOL := FALSE;
	///🔄 Bypass Méca A
	BypassMecaA: BOOL := FALSE;
	///🚧 Bypass butées extrêmes
	BypassLimitSwitch: BOOL := FALSE;
	///🧭 Bypass incohérence mot capteurs
	BypassSensorIncoherent: BOOL := FALSE;
	///🛡️ Bypass groupé PowerCutOff (BrakeThermal/MecaB/MecaA/LimitSwitch/SensorIncoherent)
	BypassSafety: BOOL := FALSE;
	///⚙️ Bypass groupé SafeStop seul (OperatorComm/DriveComm/PhaseRotation/ContactorFeedback)
	BypassProcess: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: "Perte communication opérateur" - joystick CAN ou heartbeat IHM absent ; bit1: "Perte communication EtherCAT" - perte com EtherCAT ; bit2: "Défaut Rotation Phases" - rotation phases ; bit3: "Surchauffe Frein Translation" - thermique frein ; bit4: "Absence confirmation arrêt (Méca B)" - Méca B (incohérence arrêt) ; bit5: "Mouvement non commandé (Méca A)" - Méca A (mouvement non commandé) ; bit6: "Limite extrême Translation atteinte" - Fdc extrême atteint ; bit7: "Incohérence mot capteurs position" - combinaison des 5 capteurs Trémie/PV/P2/P1/Maintenance hors table valide
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///🟧 Décélération rapide (PLC)
	SafeStop: BOOL;
	///🧨 Coup de poing / coupure puissance amont
	PowerCutOff: BOOL;
	///🎮 Perte communication opérateur : joystick CAN ou heartbeat IHM (bit0)
	ErrorOperatorComm: BOOL;
	///📡 Perte communication EtherCAT variateur (bit1)
	ErrorDriveComm: BOOL;
	///⚡ Mauvaise rotation de phases (bit2)
	ErrorPhaseRotation: BOOL;
	///🌡️ Surchauffe thermique frein commun (bit3)
	ErrorBrakeThermal: BOOL;
	///🛑 Absence confirmation arrêt (Méca B - bit4)
	ErrorMecaB: BOOL;
	///🔄 Mouvement non commandé (Méca A - bit5)
	ErrorMecaA: BOOL;
	///🚧 Limite extrême Translation atteinte (bit6)
	ErrorLimitSwitch: BOOL;
	///🧭 Incohérence mot capteurs position (bit7)
	ErrorSensorIncoherent: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	///Sécurité à l'arrêt (Méca B)
	TonMecaB: TON;
	///Sécurité mouvement non commandé (Méca A)
	TonMecaA: TON;
	///🆕 Surveillance poussée anormale / escalade fin de course
	TonLimitSwitchOverrun: TON;
	OverrunCondition: BOOL;
	PostRampTimeout: TIME := TIME#3S;
	UncommandedActiveB: BOOL;
	UncommandedActiveA: BOOL;
	FirstScanDone: BOOL;
	///⏱️ Inhibition 3s au boot + effacement auto coms
	TonStartupWarmup: TON;
END_VAR
</Single>
