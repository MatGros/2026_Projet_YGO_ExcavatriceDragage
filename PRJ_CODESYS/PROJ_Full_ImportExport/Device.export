        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 FB_Diag_CanOpen — Diagnostic bus CANopen &amp; Esclave Joystick
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Surveillance bus CANopen master et esclave Joystick (Online/Op)
///   🔌 Architecture : Publication ST_Diag_Device &amp; E_Diag_State
///   📄 Doc métier : DOC/AF/AF_Partie-12_Fonction_Diagnostic_v1.0.md
///   =======================================================================
FUNCTION_BLOCK FB_Diag_CanOpen
VAR_INPUT
	///=== COMMANDES &amp; CONTROLE ===
	///--&gt; [CMD] Active la surveillance CAN
	Enable: BOOL;
	///--&gt; [CMD] Front d'acquittement des defauts
	Reset: BOOL;
	///=== ETATS BRUTS MATERIEL ===
	///--&gt; [HW]  Valeur brute CANbus.GetBusState() (2 = ACTIVE)
	CANbusStateRaw: INT;
	///--&gt; [HW]  Valeur brute JOY1.GetDeviceState()
	DeviceJoystickStateRaw: DEVICE_STATE;
	///=== BYPASS &amp; SIMULATION ===
	///--&gt; [TST] TRUE = simulation active pour ce device
	SimBypassActive: BOOL;
	///--&gt; [TST] TRUE = bypass reseau global IHM
	NetworkBypassActive: BOOL;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; CONFORMITE ===
	///&lt;-- [STAT] Logique de surveillance active
	Ready: BOOL;
	///&lt;-- [STAT] Non utilise (conformite interface)
	Busy: BOOL;
	///&lt;-- [STAT] Non utilise
	Done: BOOL;
	///&lt;-- [STAT] Phase courante (INIT/SIMULATED/READY/ERROR)
	State: E_Diag_State;
	///=== DIAGNOSTICS &amp; ALARMES ===
	///&lt;-- [DIAG] Presence anomalie de communication
	Error: BOOL;
	///&lt;-- [DIAG] Code defaut global resume
	ErrorId: WORD;
	///&lt;-- [DIAG] Phase figee a l'apparition de l'erreur
	StateAtError: E_Diag_State;
	///&lt;-- [DIAG] Diagnostics bus CANopen
	DeviceCanOpenMaster: ST_Diag_Device;
	///&lt;-- [DIAG] Diagnostics esclave Joystick
	DeviceJoystick: ST_Diag_Device;
	///=== MIROIRS BRUTS MATERIEL ===
	///&lt;-- [DIAG] Miroir brut status CANbus
	CANbusStateRawOut: INT;
	///&lt;-- [DIAG] Miroir brut status Joystick
	DeviceJoystickStateRawOut: DEVICE_STATE;
END_VAR
VAR
	///=== SOUS-INSTANCES FB ===
	///* [INST] Detecteur front de reset
	ResetEdge: R_TRIG;
	///=== CALCULS ET ETATS INTERNES ===
	///. [LOC]  Bus reellement actif, hors tout bypass
	CANbusOnlineReal: BOOL;
	///. [LOC]  Joystick reellement RUNNING, hors tout bypass
	DeviceJoystickOnlineReal: BOOL;
	///. [LOC]  Simulation OU bypass reseau IHM
	BypassActive: BOOL;
	///. [LOC]  Online effectif (reel OU bypass)
	CANbusOnlineEff: BOOL;
	///. [LOC]  Operational effectif (reel OU bypass)
	DeviceJoystickOnlineEff: BOOL;
END_VAR
</Single>
