            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639230302277400524</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

{region "§1 Gate"}
// 🛑 1. GATE — aucune estimation lorsque le bloc est désactivé ou l'AU absent.
IF NOT Enable OR NOT PowerContactorEngaged THEN
    Ready := FALSE;
    Status.Busy := FALSE;
    Status.Done := FALSE;
    Status.Error := FALSE;
    Status.ErrorId := 16#0000;
    Status.State := E_State.DISABLED;
    SpeedBand := 0;
    EstimatedLoadPct := 0.0;
    Configured := FALSE;
    Ascending := FALSE;
    HasPreviousBand := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
Status.Busy := FALSE;
Status.Done := FALSE;
Status.State := E_State.READY;
ResetEdge(CLK := Reset);
Configured := LoadTable.IsConfigured;
// 📈 L'estimation de charge n'a de sens qu'en montée.
// La bande de vitesse reste calculée pour le diagnostic et le garde-fou de palier,
// mais EstimatedLoadPct est forcée à zéro à l'arrêt et en descente.
Ascending := (MeasuredSpeedSignedMps &gt; 0.0);
{endregion}

{region "§2 Classement vitesse"}
// 📏 2. CLASSEMENT DE LA VITESSE — hystérésis autour des 4 frontières.
IF (MeasuredSpeedMps &lt; 0.0) OR (SpeedConfig.MaxMeasuredSpeedMps &lt;= 0.0) THEN
    Status.ErrorId := Status.ErrorId OR 16#0001;
    SpeedBand := 0;
ELSIF NOT HasPreviousBand THEN
    IF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[1] THEN
        PreviousSpeedBand := 1;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[2] THEN
        PreviousSpeedBand := 2;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[3] THEN
        PreviousSpeedBand := 3;
    ELSIF MeasuredSpeedMps &lt;= SpeedConfig.SpeedBandMaxMps[4] THEN
        PreviousSpeedBand := 4;
    ELSE
        PreviousSpeedBand := 5;
    END_IF;
    HasPreviousBand := TRUE;
    SpeedBand := PreviousSpeedBand;
ELSE
    // 🔒 Valider l'état mémorisé avant toute indexation dynamique.
    IF PreviousSpeedBand &lt; 1 OR PreviousSpeedBand &gt; 5 THEN
        PreviousSpeedBand := 1;
        Status.ErrorId := Status.ErrorId OR 16#0001;
    END_IF;

    // CODESYS ne garantit pas le court-circuit des expressions AND :
    // chaque borne est donc testée dans une branche séparée avant accès.
    IF PreviousSpeedBand &lt; 5 THEN
        IF MeasuredSpeedMps &gt; (SpeedConfig.SpeedBandMaxMps[PreviousSpeedBand]
                               + SpeedConfig.SpeedBandHysteresisMps) THEN
            PreviousSpeedBand := PreviousSpeedBand + 1;
        END_IF;
    END_IF;
    IF PreviousSpeedBand &gt; 1 THEN
        IF MeasuredSpeedMps &lt; (SpeedConfig.SpeedBandMaxMps[PreviousSpeedBand - 1]
                               - SpeedConfig.SpeedBandHysteresisMps) THEN
            PreviousSpeedBand := PreviousSpeedBand - 1;
        END_IF;
    END_IF;
    SpeedBand := PreviousSpeedBand;
END_IF;
{endregion}

{region "§3 Lecture table"}
// 📊 3. LECTURE TABLE — bornes séparées avant l'accès au tableau 5x5.
EstimatedLoadPct := 0.0;
IF Configured THEN
    IF Ascending THEN
        IF ActiveSpeedStep &gt;= 1 THEN
            IF ActiveSpeedStep &lt;= 5 THEN
                IF SpeedBand &gt;= 1 THEN
                    IF SpeedBand &lt;= 5 THEN
                        SelectedLoadPct := LoadTable.LoadPctByStepAndSpeedBand[ActiveSpeedStep][SpeedBand];
                        IF (SelectedLoadPct &lt; 0.0) OR (SelectedLoadPct &gt; 100.0) THEN
                            Status.ErrorId := Status.ErrorId OR 16#0001;
                        ELSE
                            EstimatedLoadPct := SelectedLoadPct;
                        END_IF;
                    END_IF;
                END_IF;
            END_IF;
        END_IF;
    END_IF;
END_IF;
{endregion}

{region "§4 Sorties et acquittement"}
// 📤 4. SORTIES D'ÉTAT ET ACQUITTEMENT.
IF ResetEdge.Q AND (Status.ErrorId &lt;&gt; 16#0000) AND (MeasuredSpeedMps &gt;= 0.0) THEN
    Status.ErrorId := 16#0000;
END_IF;
Status.Error := (Status.ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Status.Error);
IF ErrorEdge.Q THEN
    Status.StateAtError := Status.State;
END_IF;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">1ca57a3d-7abe-5417-80b9-b0b83cdad590_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 FB_WinchLoadEstimator — Estimation empirique de charge treuil
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Estimation informative de la charge par croisement palier/vitesse
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
///   🔌 Interface : Brique de diagnostic/mesure (1 instance par treuil)
///   🔒 Sécurité : Aucune commande moteur ni action sur SafeStop (information IHM)
///   =======================================================================
FUNCTION_BLOCK FB_WinchLoadEstimator
VAR_INPUT
	///=== COMMANDES ET CONSIGNES ===
	///--&gt; [CMD] Autorisation generale FB
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut sur front
	Reset: BOOL;
	///--&gt; [CMD] Mode d'exploitation actif
	Mode: E_Mode;
	///--&gt; [CMD] Palier commande actif (0..5)
	ActiveSpeedStep: INT;
	///=== SECOURS ET HARDWARE ===
	///--&gt; [SAFE] Chaine AU rearmee et puissance OK
	PowerContactorEngaged: BOOL;
	///--&gt; [HW] Vitesse cable absolue (m/s)
	MeasuredSpeedMps: REAL;
	///--&gt; [HW] Vitesse signee (+: montee, -: descente) (m/s)
	MeasuredSpeedSignedMps: REAL;
	///=== REGLAGES ET TABLES ===
	///--&gt; [CFG] Configuration des plages de vitesse
	SpeedConfig: ST_WinchSpeedConfig;
	///--&gt; [CFG] Table empirique d'estimation 5x5
	LoadTable: ST_WinchLoadEstimateTable;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC ET SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///🧩 Statut transverse (forme cible) — regroupe Busy/Done/Error/ErrorId/State/StateAtError.
	///ErrorId bit0: "entrée/table invalide".
	Status: ST_FbStatus;
	///=== DIAGNOSTICS ET ESTIMATIONS ===
	///&lt;-- [DIAG] Bande de vitesse courante (0..5)
	SpeedBand: INT;
	///&lt;-- [DIAG] Estimation de charge (0..100%)
	EstimatedLoadPct: REAL;
	///&lt;-- [STAT] Table explicitement validee
	Configured: BOOL;
	///&lt;-- [STAT] Montee effective mesuree en cours
	Ascending: BOOL;
END_VAR
VAR
	///=== DETECTEURS ET TIMERS INTERNES ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///. [LOC] Detecteur front montant Erreur
	ErrorEdge: R_TRIG;
	///=== VARIABLES LOCALES CALCULÉES ===
	///. [LOC] Memoire bande de vitesse cycle precedent
	PreviousSpeedBand: INT;
	///. [LOC] Indicateur premiere bande memorisee
	HasPreviousBand: BOOL;
	///. [LOC] Valeur de charge extraite de la table
	SelectedLoadPct: REAL;
END_VAR
</Single>
