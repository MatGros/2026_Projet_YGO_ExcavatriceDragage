///   ⚙️ Exécuté par la tâche PLC en position 4.
///   ═══════════════════════════════════════════════════════════════
PROGRAM PRG_04_Modes
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	///Arbitrage du mode machine (DISABLE, MAINT, SEMI_AUTO, etc.)
	instModes: FB_Modes;
	///🆕 Mémoire d'état M1
	PrevInhibitM1: BOOL;
	///🆕 Mémoire d'état M2
	PrevInhibitM2: BOOL;
END_VAR
</Single>
