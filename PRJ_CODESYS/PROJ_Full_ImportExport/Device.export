      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

{region "§1 Gate"}
// 🛑 Sans Enable, aucune valeur mémorisée ne peut déclarer l'IHM valide.
IF NOT Enable THEN
    HeartbeatIhmOk := FALSE;
    HeartbeatIhmTimeout := TRUE;
    TglHeartbeatPlc := FALSE;
    TimeSinceIhmEdge := T#0s;
    LastIhmToggle := TglHeartbeatIhm;
    IhmEdgeSeen := FALSE;
    IhmTimeoutTon(IN := FALSE, PT := IhmTimeout);
    PlcToggleTon(IN := FALSE, PT := PlcTogglePeriod);
    RETURN;
END_IF;
{endregion}

{region "§2 Front IHM"}
// 📥 Front par comparaison : l'IHM écrit un BOOL toggle, pas une impulsion courte.
IhmEdgeDetected := (TglHeartbeatIhm &lt;&gt; LastIhmToggle);
LastIhmToggle := TglHeartbeatIhm;
IF IhmEdgeDetected THEN
    IhmEdgeSeen := TRUE;
END_IF;
{endregion}

{region "§3 Timeout IHM"}
// ⏱️ Le timer repart à chaque front. Au boot, il atteint le timeout au bout de IhmTimeout.
// HeartbeatIhmOk reste TRUE tant que le timeout n'est pas expiré (boot propre sans alarme au scan 1).
IhmTimeoutTon(IN := NOT IhmEdgeDetected, PT := IhmTimeout);
TimeSinceIhmEdge := IhmTimeoutTon.ET;
HeartbeatIhmTimeout := IhmTimeoutTon.Q;
HeartbeatIhmOk := NOT HeartbeatIhmTimeout;
{endregion}

{region "§4 Clignotant PLC"}
// 💡 Clignotant PLC indépendant : information de vie pour l'IHM, jamais signal Signal Safety autonome.
PlcToggleTon(IN := NOT PlcToggleTon.Q, PT := PlcTogglePeriod);
IF PlcToggleTon.Q THEN
    TglHeartbeatPlc := NOT TglHeartbeatPlc;
END_IF;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">7e9589ba-412d-5501-80d5-184905e87d23_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 FB_Diag_IhmHeartbeat — Surveillance bidirectionnelle Heartbeat IHM/PLC
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Surveillance toggle IHM, generation toggle PLC et diagnostic timeout
///   🛡️ Protection : FB de diagnostic autonome (sans action directe sur AU)
///   📄 Doc métier : DOC/AF/AF_Partie-12_Fonction_Diagnostic_v1.0.md
///   =======================================================================
FUNCTION_BLOCK FB_Diag_IhmHeartbeat
VAR_INPUT
	///=== COMMANDES &amp; REGLAGES ===
	///--&gt; [CMD] Active la surveillance (FALSE = IHM invalide)
	Enable: BOOL;
	///--&gt; [HW]  Toggle IHM, inversion attendue toutes les 500 ms
	TglHeartbeatIhm: BOOL;
	///--&gt; [CFG] Absence maximale de front IHM
	IhmTimeout: TIME := TIME#2s0ms;
	///--&gt; [CFG] Periode du clignotant PLC
	PlcTogglePeriod: TIME := TIME#500ms;
END_VAR
VAR_OUTPUT
	///=== ETATS &amp; DIAGNOSTICS IHM ===
	///&lt;-- [STAT] TRUE apres front IHM post-boot et avant timeout
	HeartbeatIhmOk: BOOL;
	///&lt;-- [DIAG] TRUE = aucun front IHM depuis IhmTimeout
	HeartbeatIhmTimeout: BOOL;
	///&lt;-- [STAT] Clignotant PLC a superviser cote IHM
	TglHeartbeatPlc: BOOL;
	///&lt;-- [DIAG] Temps ecoule depuis le dernier front IHM
	TimeSinceIhmEdge: TIME;
END_VAR
VAR
	///=== SOUS-INSTANCES FB ===
	///* [INST] Timer de surveillance timeout IHM
	IhmTimeoutTon: TON;
	///* [INST] Timer clignotant heartbeat PLC
	PlcToggleTon: TON;
	///=== CALCULS ET ETATS INTERNES ===
	///. [LOC]  Memoire du dernier etat toggle IHM
	LastIhmToggle: BOOL;
	///. [LOC]  Verrou front vu (interdit RETAIN au boot)
	IhmEdgeSeen: BOOL;
	///. [LOC]  Front de changement toggle IHM detecte
	IhmEdgeDetected: BOOL;
END_VAR
</Single>
