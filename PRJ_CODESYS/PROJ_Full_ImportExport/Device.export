	///+1 = Montée | 0 = Neutre | -1 = Descente
	Idx210_CoupledUserRequestDirection: INT;
	///1 = demande utilisateur couplée active
	Idx211_CoupledUserRequestActive: BOOL;
END_STRUCT
END_TYPE
