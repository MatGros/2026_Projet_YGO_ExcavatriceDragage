        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639223207767292696</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

IF NOT Enable THEN
    Recalibrated := FALSE;
    RecalibratedSensorId := -1;
    RETURN;
END_IF;

IF ColdStart THEN
    PositionEstimatedM := PersistedPositionM;
    Initialized := PersistedInitialized;
    ColdStart := FALSE;
END_IF;

CycleTimeCalc(DefaultValueS := 0.010);
Recalibrated := FALSE;

// 1. Détection des fronts montants sur franchissement des capteurs fixes
TrigTremie(CLK := SensorTremie);
TrigPV(CLK := SensorPV);
TrigP2(CLK := SensorP2);
TrigP1(CLK := SensorP1);
TrigMaintenance(CLK := SensorMaintenance);

// 2. Recalage absolu prioritaire sur contact capteur
IF TrigMaintenance.Q THEN
    PositionEstimatedM := PosMaintenanceM;
    Recalibrated := TRUE;
    RecalibratedSensorId := 0;
ELSIF TrigP1.Q THEN
    PositionEstimatedM := PosP1M;
    Recalibrated := TRUE;
    RecalibratedSensorId := 1;
ELSIF TrigP2.Q THEN
    PositionEstimatedM := PosP2M;
    Recalibrated := TRUE;
    RecalibratedSensorId := 2;
ELSIF TrigPV.Q THEN
    PositionEstimatedM := PosPVM;
    Recalibrated := TRUE;
    RecalibratedSensorId := 3;
ELSIF TrigTremie.Q THEN
    PositionEstimatedM := PosTremieM;
    Recalibrated := TRUE;
    RecalibratedSensorId := 4;
ELSE
    // Initialisation au tout premier démarrage sur le premier capteur actif vu
    IF NOT Initialized THEN
        IF SensorTremie THEN PositionEstimatedM := PosTremieM; Initialized := TRUE;
        ELSIF SensorPV THEN PositionEstimatedM := PosPVM; Initialized := TRUE;
        ELSIF SensorP2 THEN PositionEstimatedM := PosP2M; Initialized := TRUE;
        ELSIF SensorP1 THEN PositionEstimatedM := PosP1M; Initialized := TRUE;
        ELSIF SensorMaintenance THEN PositionEstimatedM := PosMaintenanceM; Initialized := TRUE;
        END_IF;
    END_IF;

    // 3. Intégration temporelle continue (Odométrie cycle par cycle)
    // dX = Direction * (FreqHz * Gain) * dt
    IF Direction &lt;&gt; 0 AND DriveActualFreqHz &gt; 0.1 THEN
        PositionEstimatedM := PositionEstimatedM + (INT_TO_REAL(Direction) * DriveActualFreqHz * GainMetersPerHzSec * CycleTimeCalc.CycleTimeS);
    END_IF;
END_IF;

// Bornage de sécurité pour éviter la dérive infinie hors rail
PositionEstimatedM := LIMIT(PosMaintenanceM - 0.5, PositionEstimatedM, PosTremieM + 0.5);
</Single>
            <Single Name="LineInfoPersistence" Type="string">17c88093-da61-51d7-ad4f-b07c5ebb2eb5_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ↔️ FB_Translation_PositionEstimator — Estimateur de Position Continue M3
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-11_Fonction_Translation_v2.1.md §3
///   🎯 Rôle : Calculer par odométrie (intégration temporelle vitesse/fréquence Hz * sens)
///      la position estimée continue en mètres (0.0 m à la Maintenance -&gt; +X m à la Trémie),
///      avec re-calage absolu automatique instantané sur le franchissement des 5 capteurs fixes.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Translation_PositionEstimator
VAR_INPUT
	///Active le calcul
	Enable: BOOL;
	///Front d'acquittement / réinitialisation
	Reset: BOOL;
	///Fréquence réelle variateur en Hz (ex: 5.0 Hz)
	DriveActualFreqHz: REAL;
	///Sens effectif : +1 = Fwd (vers Trémie), -1 = Rev (vers Maint), 0 = Arrêt
	Direction: INT;
	///5 Capteurs de position fixes
	///Capteur 0 : Maintenance (0.0 m)
	SensorMaintenance: BOOL;
	///Capteur 1 : P1 (ex: 6.0 m)
	SensorP1: BOOL;
	///Capteur 2 : P2 (ex: 14.0 m)
	SensorP2: BOOL;
	///Capteur 3 : PV (ex: 21.0 m)
	SensorPV: BOOL;
	///Capteur 4 : Trémie (ex: 25.0 m)
	SensorTremie: BOOL;
	///Positions de référence calibrées (mètres) depuis GVL_PERSISTENT
	PosMaintenanceM: REAL := 0;
	PosP1M: REAL := 6;
	PosP2M: REAL := 14;
	PosPVM: REAL := 21;
	PosTremieM: REAL := 25;
	///Gain de vitesse : mètres parcourus par Hz par seconde (ex: 50 Hz = 0.416 m/s =&gt; Gain = 0.008333 m/Hz.s)
	GainMetersPerHzSec: REAL := 0.008333;
	///🆕 2026-08-06 : reprise après reboot — l'appelant recopie en continu PositionEstimatedM/
	///       Initialized vers GVL_PERSISTENT (pas de bridge dédié, simple recopie comme _TranslationSetFreq_Hz)
	///       et réinjecte ici au redémarrage, pour ne pas perdre l'estimation odométrique à chaque coupure.
	PersistedPositionM: REAL := 0;
	PersistedInitialized: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	///Position continue estimée en mètres
	PositionEstimatedM: REAL;
	///🆕 exposé pour recopie persistante côté appelant
	Initialized: BOOL;
	///Pulse 1 cycle lors d'un recalage sur capteur
	Recalibrated: BOOL;
	///0=Maint, 1=P1, 2=P2, 3=PV, 4=Trémie, -1=Aucun
	RecalibratedSensorId: INT;
END_VAR
VAR
	TrigTremie: R_TRIG;
	TrigPV: R_TRIG;
	TrigP2: R_TRIG;
	TrigP1: R_TRIG;
	TrigMaintenance: R_TRIG;
	CycleTimeCalc: FB_CycleTime;
	///🆕 seed unique depuis Persisted* au premier scan utile
	ColdStart: BOOL := TRUE;
END_VAR
</Single>
