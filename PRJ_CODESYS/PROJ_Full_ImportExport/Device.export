      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🚦 ST_JoystickState — États et diagnostics IHM du Joystick
///   ═══════════════════════════════════════════════════════════════
TYPE ST_JoystickState :
STRUCT
	///🕹️ Axe X brut du joystick (0..10000)
	RawX: INT;
	///🕹️ Axe Y brut du joystick (0..10000)
	RawY: INT;
	///🔘 Bouton homme-mort brut
	RawButton: BOOL;
	///⚙️ Consigne d'axe X normalisée (sortie FB_Joystick)
	AxisCmdX: ST_Joystick_AxisCmd;
	///⚙️ Consigne d'axe Y normalisée (sortie FB_Joystick)
	AxisCmdY: ST_Joystick_AxisCmd;
	///🎯 Neutre X calibré actuel (lecture seule)
	NeutralXAct: INT;
	///🎯 Neutre Y calibré actuel (lecture seule)
	NeutralYAct: INT;
	///🔫 Geste homme-mort armé (FB_Joystick.DeadmanArmed)
	DeadmanArmed: BOOL;
	///🆕 2026-08-07 : TRUE si les 2 axes sont en zone morte (position centrale)
	AtNeutral: BOOL;
	///📡 Liaison CAN joystick active
	Online: BOOL;
	///🟢 Joystick opérationnel
	Operational: BOOL;
	///🔴 Joystick en défaut
	Error: BOOL;
	///❌ Code défaut joystick
	ErrorId: WORD;
END_STRUCT
END_TYPE
</Single>
