            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_MultiStage_Relay
VAR_INPUT
    Cmd_Pct   : REAL; // Consigne finale de l'axe (ex: Y_Pct_Ramped, entre -100.0 et 100.0)
    Stage1    : REAL; // Seuil d'activation Vitesse 1 (ex: 15.0)
    Stage2    : REAL; // Seuil d'activation Vitesse 2 (ex: 40.0)
    Stage3    : REAL; // Seuil d'activation Vitesse 3 (ex: 70.0)
    Stage4    : REAL; // Seuil d'activation Vitesse 4 (ex: 90.0)
END_VAR
VAR_OUTPUT
    Q1        : BOOL; // Sortie physique Relais Vitesse 1
    Q2        : BOOL; // Sortie physique Relais Vitesse 2
    Q3        : BOOL; // Sortie physique Relais Vitesse 3
    Q4        : BOOL; // Sortie physique Relais Vitesse 4
END_VAR
VAR
    AbsCmd    : REAL; // Variable de travail interne (Valeur absolue)
END_VAR</Single>
