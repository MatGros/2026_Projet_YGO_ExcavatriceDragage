        </Array>
        <Single Name="Timestamp" Type="long">639197103388938985</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// 🛑 1. GATE : Désactivation logique si Enable = FALSE
IF NOT Enable THEN
    Ready := FALSE;
    State := E_DiagState.DISABLED;
    Joystick.State := E_DiagState.DISABLED;
    Joystick.Online := FALSE;
    Joystick.Operational := FALSE;
    Joystick.Error := FALSE;
    Joystick.ErrorId := 16#0000;
    Error := FALSE;
    ErrorId := 16#0000;
    RETURN;
END_IF;

Ready := TRUE;

// 🔑 2. RESET FRONT — Efface les défauts si la cause a disparu
ResetEdge(CLK := Reset);
IF ResetEdge.Q THEN
    IF (CanOnline AND CanOperational) THEN
        Joystick.ErrorId := 16#0000;
        StateAtError := E_DiagState.DISABLED;
    END_IF;
END_IF;

// 🔍 3. DIAGNOSTIC JOYSTICK
// Bit 0 : Perte de communication CAN
IF NOT CanOnline THEN
    Joystick.ErrorId := 16#0001;  (* Perte liaison CAN joystick *)
    Joystick.Online := FALSE;
ELSE
    Joystick.Online := TRUE;
    IF ResetEdge.Q THEN
        Joystick.ErrorId := Joystick.ErrorId AND 16#FFFE;
    END_IF;
END_IF;

// Bit 1 : Mode non-opérationnel (esclave CANopen en pré-op ou défaut)
IF NOT CanOperational THEN
    Joystick.ErrorId := Joystick.ErrorId OR 16#0002;  (* Joystick pas opérationnel *)
    Joystick.Operational := FALSE;
ELSE
    Joystick.Operational := TRUE;
    IF ResetEdge.Q THEN
        Joystick.ErrorId := Joystick.ErrorId AND 16#FFFD;
    END_IF;
END_IF;

// 🚦 4. MACHINE D'ÉTAT JOYSTICK
IF Joystick.ErrorId &lt;&gt; 0 THEN
    Joystick.State := E_DiagState.ERROR;
    IF StateAtError = E_DiagState.DISABLED THEN
        StateAtError := State;
    END_IF;
ELSIF NOT (Joystick.Online AND Joystick.Operational) THEN
    Joystick.State := E_DiagState.INIT;
else
    Joystick.State := E_DiagState.READY;
END_IF;

State := Joystick.State;

// 📤 5. SORTIES GLOBALES
Joystick.Error := (Joystick.ErrorId &lt;&gt; 0);
Error := Joystick.Error;
ErrorId := Joystick.ErrorId;

busCanOpen.Operational := CanOnline;
busCanOpen.Online := CanOnline;

// Briques génériques pour conformité standard
Busy := FALSE;
Done := FALSE;
</Single>
            <Single Name="LineInfoPersistence" Type="string">94985939-6432-5df4-8717-0ad1efb0fdb4_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📡 FB_DiagCanOpen — Diagnostic de communication bus CANopen / Joystick
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_DiagCanOpen
VAR_INPUT
	///Active la surveillance CAN
	Enable: BOOL;
	///Front d'acquittement des défauts
	Reset: BOOL;
	///Trame joystick reçue (TRUE = OK)
	CanOnline: BOOL;
	///Joystick en mode opérationnel (TRUE = OK)
	CanOperational: BOOL;
END_VAR
VAR_OUTPUT
	///Logique de surveillance active
	Ready: BOOL;
	///Non utilisé (conformité interface)
	Busy: BOOL;
	///Non utilisé
	Done: BOOL;
	///Présence anomalie de communication
	Error: BOOL;
	///Code défaut global résumé
	ErrorId: WORD;
	///Phase courante du cycle de diag
	State: E_DiagState;
	///Phase figée à l'apparition de l'erreur
	StateAtError: E_DiagState;
	///Diagnostics bus CANopen
	busCanOpen: ST_DeviceDiag;
	///Diagnostics esclave Joystick
	Joystick: ST_DeviceDiag;
END_VAR
VAR
	///Détecteur front de reset
	ResetEdge: R_TRIG;
END_VAR
</Single>
