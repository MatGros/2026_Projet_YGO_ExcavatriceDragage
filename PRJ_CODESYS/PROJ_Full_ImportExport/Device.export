      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   ⚙️ ST_fbJoystick_Cfg — Réglages regroupés de FB_Joystick
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : porter en un bloc les 5 paramètres de conditionnement du geste
///      (zone morte, temporisations homme-mort, marge défaut capteur).
///      Passé à FB_Joystick via l'entrée `Cfg` — échange bloc IHM / persistant.
///   🧬 Pattern cfg : aligné sur ST_CycleCfg / ST_WinchCfg (préfixe ST_&lt;Domaine&gt;Cfg,
///      instance persistante dans GVL_PERSISTENT, pont FB_CfgPersistBridge_* à venir).
///   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.5.md (§5bis)
///   =======================================================================
TYPE ST_fbJoystick_Cfg :
STRUCT
	///Zone morte en points ADC bruts (0..10000)
	DeadbandRaw: INT := 300;
	///Maintien continu au neutre avant désarmement homme-mort
	NeutralHoldTime: TIME := TIME#100MS;
	///Appui continu bouton requis pour armer le geste
	DeadmanArmHoldTime: TIME := TIME#100MS;
	///Délai de grâce post-armement avant désarmement neutre
	DeadmanArmGraceTime: TIME := TIME#3S;
	///Marge ADC autour des bornes [0..10000] avant défaut capteur (AF08 §5bis)
	RawOutOfRangeMargin: INT := 500;
	///🚦 Flag restauration boot (interne pont FB_CfgPersistBridge_fbJoystick_Cfg)
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
