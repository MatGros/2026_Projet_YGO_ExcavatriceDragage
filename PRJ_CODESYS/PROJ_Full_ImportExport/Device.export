                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639223207765664628</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// 🛑 1. GATE — désactivation ou AU non réarmé : aucune alarme persistante.
IF NOT Enable OR NOT PowerContactorEngaged THEN
    Ready := FALSE;
    Busy := FALSE;
    Done := FALSE;
    Error := FALSE;
    ErrorId := 16#0000;
    State := E_State.DISABLED;
    SpeedDeltaMps := 0.0;
    SpeedVariationDetected := FALSE;
    SpeedVariationConfirmed := FALSE;
    SpeedStable := FALSE;
    VariationActive := FALSE;
    HasPreviousSpeed := FALSE;
    VariationTimer(IN := FALSE, PT := SpeedVariationTimeout);
    StabilityTimer(IN := FALSE, PT := SpeedStabilityTimeout);
    RETURN;
END_IF;

Ready := TRUE;
Busy := FALSE;
Done := FALSE;
State := E_State.READY;

// 🔑 2. RESET FRONT — l'acquittement n'efface le défaut que si la cause a disparu.
ResetEdge(CLK := Reset);

// 📏 3. CALCUL DE L'ÉCART DE VITESSE — première mesure utilisée comme référence.
IF NOT HasPreviousSpeed THEN
    PreviousSpeedMps := SpeedMps;
    HasPreviousSpeed := TRUE;
    SpeedDeltaMps := 0.0;
ELSE
    SpeedDeltaMps := ABS(SpeedMps - PreviousSpeedMps);
    PreviousSpeedMps := SpeedMps;
END_IF;

// 🔍 4. DÉTECTION BRUTE + FILTRE TEMPOREL — pas de déclenchement si la durée vaut zéro.
VariationActive := HasPreviousSpeed
                   AND (SpeedVariationThresholdMps &gt;= 0.0)
                   AND (SpeedVariationTimeout &gt; T#0ms)
                   AND (SpeedDeltaMps &gt; SpeedVariationThresholdMps);
SpeedVariationDetected := VariationActive;

VariationTimer(IN := VariationActive, PT := SpeedVariationTimeout);
SpeedVariationConfirmed := VariationTimer.Q;
StabilityTimer(IN := HasPreviousSpeed AND NOT VariationActive AND (SpeedStabilityTimeout &gt; T#0ms), PT := SpeedStabilityTimeout);
SpeedStable := StabilityTimer.Q;

IF SpeedVariationConfirmed THEN
    ErrorId := ErrorId OR 16#0001;
ELSIF ResetEdge.Q AND NOT VariationActive THEN
    ErrorId := ErrorId AND 16#FFFE;
END_IF;

// 📤 5. SORTIES D'ÉTAT — diagnostic standard, aucune commande mouvement.
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">c1cd7624-9491-50e0-9332-6845d97ac927_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════════════════════
///   🔍 FB_Encoder_SpeedMonitor — Détection de variation brusque de vitesse câble
///   ═══════════════════════════════════════════════════════════════════════════════
///   📄 Brique standard de diagnostic — aucun pilotage moteur, aucun SafeStop.
///   🎯 Compare deux mesures successives de vitesse linéaire câble en m/s.
///   🧩 Le seuil et la durée de confirmation sont fournis par l'appelant :
///      aucun réglage métier n'est figé dans cette brique.
///   🛡️ Une variation confirmée pose ErrorId bit0. Le défaut reste mémorisé
///      jusqu'à disparition de la cause et acquittement par front Reset.
///   ═══════════════════════════════════════════════════════════════════════════════
///   📄 Docs : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md
FUNCTION_BLOCK FB_Encoder_SpeedMonitor
VAR_INPUT
	///Autorise la surveillance
	Enable: BOOL;
	///Acquittement par front
	Reset: BOOL;
	///Contexte sécurité global valide
	PowerContactorEngaged: BOOL;
	///Contexte de fonctionnement
	Mode: E_Mode;
	///Vitesse linéaire absolue mesurée (m/s)
	SpeedMps: REAL;
	///Variation minimale à surveiller (m/s)
	SpeedVariationThresholdMps: REAL;
	///Durée minimale de confirmation
	SpeedVariationTimeout: TIME;
	///Durée sans variation avant vitesse stable
	SpeedStabilityTimeout: TIME;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0 : variation vitesse confirmée
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///Écart absolu entre deux mesures (m/s)
	SpeedDeltaMps: REAL;
	///Seuil dépassé sur le cycle courant
	SpeedVariationDetected: BOOL;
	///Seuil dépassé pendant la durée requise
	SpeedVariationConfirmed: BOOL;
	///Vitesse stable pendant SpeedStabilityTimeout
	SpeedStable: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	VariationTimer: TON;
	StabilityTimer: TON;
	PreviousSpeedMps: REAL;
	HasPreviousSpeed: BOOL;
	VariationActive: BOOL;
END_VAR
</Single>
