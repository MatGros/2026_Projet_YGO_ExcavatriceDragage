{attribute 'strict' := ''}
TYPE E_DiveSearchState :
(
	///Attente benne ouverte, positions et Kobold au repos
	WAIT_PRECONDITIONS := 0,
	///Prêt à assister une demande de descente
	READY_TO_DESCEND := 1,
	///Descente : attente front 0→1 dans fenêtre eau
	SEARCHING_IMMERSION := 2,
	///Immersion validée : attente front 1→0 au fond
	SEARCHING_BOTTOM := 3,
	///Fond validé ; extraction peut être demandée
	BOTTOM_CONFIRMED := 4,
	///Séquence invalide, descente assistée interdite
	ERROR_HOLD := 5
);
END_TYPE
</Single>
