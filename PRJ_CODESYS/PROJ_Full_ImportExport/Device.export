          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639199740618158779</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// 1. ACQUISITION DU TEMPS SYSTÈME
TimeCurrent := TIME();

// 2. INITIALISATION UNIQUE AU PREMIER CYCLE
IF NOT InitDone THEN
    TimeLast := TimeCurrent;
    InitDone := TRUE;
    CycleTimeS := DefaultValueS;
    RETURN;
END_IF;

// 3. CALCUL DU DELTA EN MILLISECONDES
DeltaTimeMs := TIME_TO_UDINT(TimeCurrent - TimeLast);

// 4. CONVERSION ET CHARGE DE SECOURS
IF DeltaTimeMs &gt; 0 THEN
    CycleTimeS := UDINT_TO_REAL(DeltaTimeMs) / 1000.0;
ELSE
    CycleTimeS := DefaultValueS;
END_IF;

// 5. ARCHIVAGE POUR LE PROCHAIN CYCLE
TimeLast := TimeCurrent;
</Single>
            <Single Name="LineInfoPersistence" Type="string">ac308017-0ba5-51da-b58a-b5951d04dc0f_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⏱️ FB_CycleTime — Mesure du temps de cycle réel de la tâche
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie-08_Fonction_Joystick_v1.3.md §2
///      (base de temps utilisée par FB_Filter_PT1, composé dans FB_Joystick)
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_CycleTime
VAR_INPUT
	///Valeur de secours par défaut (ex. 4ms)
	DefaultValueS: REAL := 0.004;
END_VAR
VAR_OUTPUT
	///Temps écoulé réel calculé (secondes)
	CycleTimeS: REAL;
END_VAR
VAR
	///Temps système actuel
	TimeCurrent: TIME;
	///Empreinte de temps du cycle précédent
	TimeLast: TIME;
	///Écart brut calculé (ms)
	DeltaTimeMs: UDINT;
	///Drapeau d'initialisation du premier cycle
	InitDone: BOOL;
END_VAR
</Single>
