          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">TYPE ST_Chain_Translation_Safety :
STRUCT
	///1 = Boucle Urgence OK | 0 = Arrêt d'Urgence Appuyé
	Idx301_EmergencyChainClosed: BOOL;
	///0 = Sain (Autorisé) | 1 = Arrêt Rapide Translation
	Idx302_SafeStopActive: BOOL;
	///0 = Puissance OK | 1 = Coupure Puissance
	Idx303_PowerCutOffActive: BOOL;
	///0 = Sain | 1 = Fin de Course Extrême Avance
	Idx304_LimitSwitchFwdActive: BOOL;
	///0 = Sain | 1 = Fin de Course Extrême Recul
	Idx305_LimitSwitchRevActive: BOOL;
	///0 = Fins de course actives | 1 = Shuntés IHM ⚠️
	Idx306_BypassLimitSwitch: BOOL;
	///0 = Décodage 5 Capteurs OK | 1 = Incohérence Position
	Idx307_PositionDecoderIncoherent: BOOL;
	///: 0 = M1 ET M2 ≥ hauteur mini (ou bypass) | 1 = Translation bloquée (risque collision)
	Idx308_HeightInterlockBlocking: BOOL;
	///Défauts safety déchiffrés (bits ErrorId) — visibles individuellement à l'IHM
	///bit0 Perte communication opérateur (joystick CAN / heartbeat IHM)
	Idx309_ErrorOperatorComm: BOOL;
	///bit1 Perte communication EtherCAT variateur
	Idx310_ErrorDriveComm: BOOL;
	///bit2 Mauvaise rotation de phases
	Idx311_ErrorPhaseRotation: BOOL;
	///bit3 Surchauffe thermique frein commun
	Idx312_ErrorBrakeThermal: BOOL;
	///bit4 Absence confirmation arrêt
	Idx313_ErrorMecaB: BOOL;
	///bit5 Mouvement non commandé
	Idx314_ErrorMecaA: BOOL;
	///bit6 Limite extrême atteinte
	Idx315_ErrorLimitSwitch: BOOL;
	///bit7 Mot capteurs position incohérent
	Idx316_ErrorSensorIncoherent: BOOL;
END_STRUCT
END_TYPE
</Single>
