      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">Logique API</Single>
        <Single Type="string">Application</Single>
        <Single Type="string">SYSTEM</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">268197d6-ad0a-5ec3-82c7-3a1f88f6bae6</Single>
        <Single Name="ParentGuid" Type="System.Guid">103fbab6-1b12-4ccb-9cc6-6c66cad0e1cb</Single>
        <Single Name="Name" Type="string">FB_DiagEthercat</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">24568a24-c491-472c-a21f-ee5d33859fab</Single>
            </Key>
            <Value>
              <Single Type="{24568a24-c491-472c-a21f-ee5d33859fab}" Method="IArchivable">
                <Single Name="MemoryReserveForOnlineChange" Type="int">0</Single>
                <Single Name="ExcludeFromBuild" Type="bool">False</Single>
                <Single Name="External" Type="bool">False</Single>
                <Single Name="EnableSystemCall" Type="bool">False</Single>
                <Single Name="CompilerDefines" Type="string"></Single>
                <Single Name="LinkAlways" Type="bool">False</Single>
                <Array Name="Undefines" Type="string" />
              </Single>
            </Value>
          </Entry>
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">0675b632-643d-49b3-8aca-bcf824c81b3b</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639197103389058996</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// 🛑 1. GATE : Désactivation si Enable = FALSE
IF NOT Enable THEN
    Ready := FALSE;
    State := E_DiagState.DISABLED;
    Variateur.State := E_DiagState.DISABLED;
    EncoderM1.State := E_DiagState.DISABLED;
    EncoderM2.State := E_DiagState.DISABLED;
    Variateur.Online := FALSE;
    EncoderM1.Online := FALSE;
    EncoderM2.Online := FALSE;
    Variateur.Operational := FALSE;
    EncoderM1.Operational := FALSE;
    EncoderM2.Operational := FALSE;
    Variateur.Error := FALSE;
    EncoderM1.Error := FALSE;
    EncoderM2.Error := FALSE;
    Error := FALSE;
    ErrorId := 16#0000;
    RETURN;
END_IF;

Ready := TRUE;

// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);

// 🔍 3. DIAGNOSTIC VARIATEUR (AC600_ECAT_Drive / Translation M3)
Variateur.Online := NOT VariateurWcState;
Variateur.Operational := Variateur.Online AND (VariateurSlaveState = 8);

IF NOT Variateur.Online THEN
    Variateur.ErrorId := 16#0010;  (* Perte liaison physique variateur *)
ELSE
    IF ResetEdge.Q THEN
        Variateur.ErrorId := Variateur.ErrorId AND 16#FFEF;
    END_IF;
END_IF;

IF NOT Variateur.Operational AND Variateur.Online THEN
    Variateur.ErrorId := Variateur.ErrorId OR 16#0011;  (* Variateur pré-opérationnel *)
ELSE
    IF ResetEdge.Q THEN
        Variateur.ErrorId := Variateur.ErrorId AND 16#FFEE;
    END_IF;
END_IF;

// 🔍 4. DIAGNOSTIC ENCODEUR M1 (COD1_CODEUR / WinchM1)
EncoderM1.Online := NOT EncoderM1WcState;
EncoderM1.Operational := EncoderM1.Online AND (EncoderM1SlaveState = 8);

IF NOT EncoderM1.Online THEN
    EncoderM1.ErrorId := 16#0020;  (* Perte liaison encodeur M1 *)
ELSE
    IF ResetEdge.Q THEN
        EncoderM1.ErrorId := EncoderM1.ErrorId AND 16#FFDF;
    END_IF;
END_IF;

IF NOT EncoderM1.Operational AND EncoderM1.Online THEN
    EncoderM1.ErrorId := EncoderM1.ErrorId OR 16#0021;  (* Encodeur M1 pré-opérationnel *)
ELSE
    IF ResetEdge.Q THEN
        EncoderM1.ErrorId := EncoderM1.ErrorId AND 16#FFDE;
    END_IF;
END_IF;

// 🔍 5. DIAGNOSTIC ENCODEUR M2 (COD2_CODEUR / WinchM2)
EncoderM2.Online := NOT EncoderM2WcState;
EncoderM2.Operational := EncoderM2.Online AND (EncoderM2SlaveState = 8);

IF NOT EncoderM2.Online THEN
    EncoderM2.ErrorId := 16#0030;  (* Perte liaison encodeur M2 *)
ELSE
    IF ResetEdge.Q THEN
        EncoderM2.ErrorId := EncoderM2.ErrorId AND 16#FFCF;
    END_IF;
END_IF;

IF NOT EncoderM2.Operational AND EncoderM2.Online THEN
    EncoderM2.ErrorId := EncoderM2.ErrorId OR 16#0031;  (* Encodeur M2 pré-opérationnel *)
ELSE
    IF ResetEdge.Q THEN
        EncoderM2.ErrorId := EncoderM2.ErrorId AND 16#FFCE;
    END_IF;
END_IF;

// 🚦 6. STATE MACHINES DE CHAQUE APPAREIL
IF Variateur.ErrorId &lt;&gt; 0 THEN
    Variateur.State := E_DiagState.ERROR;
ELSIF NOT Variateur.Online THEN
    Variateur.State := E_DiagState.INIT;
ELSIF Variateur.Operational THEN
    Variateur.State := E_DiagState.READY;
ELSE
    Variateur.State := E_DiagState.MONITORING;
END_IF;

IF EncoderM1.ErrorId &lt;&gt; 0 THEN
    EncoderM1.State := E_DiagState.ERROR;
ELSIF NOT EncoderM1.Online THEN
    EncoderM1.State := E_DiagState.INIT;
ELSIF EncoderM1.Operational THEN
    EncoderM1.State := E_DiagState.READY;
ELSE
    EncoderM1.State := E_DiagState.MONITORING;
END_IF;

IF EncoderM2.ErrorId &lt;&gt; 0 THEN
    EncoderM2.State := E_DiagState.ERROR;
ELSIF NOT EncoderM2.Online THEN
    EncoderM2.State := E_DiagState.INIT;
ELSIF EncoderM2.Operational THEN
    EncoderM2.State := E_DiagState.READY;
ELSE
    EncoderM2.State := E_DiagState.MONITORING;
END_IF;

// Fige la phase du diagnostic global sur le premier défaut
IF (Variateur.ErrorId &lt;&gt; 0 OR EncoderM1.ErrorId &lt;&gt; 0 OR EncoderM2.ErrorId &lt;&gt; 0) THEN
    IF StateAtError = E_DiagState.DISABLED THEN
        StateAtError := State;
    END_IF;
END_IF;

// 📤 7. RÉSUMÉ ET DÉFAUTS
Variateur.Error := (Variateur.ErrorId &lt;&gt; 0);
EncoderM1.Error := (EncoderM1.ErrorId &lt;&gt; 0);
EncoderM2.Error := (EncoderM2.ErrorId &lt;&gt; 0);

Error := (Variateur.Error OR EncoderM1.Error OR EncoderM2.Error);

ErrorId := 16#0000;
IF Variateur.Error THEN
    ErrorId := ErrorId OR 16#00F0;
END_IF;
IF EncoderM1.Error THEN
    ErrorId := ErrorId OR 16#0F00;
END_IF;
IF EncoderM2.Error THEN
    ErrorId := ErrorId OR 16#F000;
END_IF;

IF Error THEN
    State := E_DiagState.ERROR;
ELSIF NOT (Variateur.Operational AND EncoderM1.Operational AND EncoderM2.Operational) THEN
    State := E_DiagState.MONITORING;
ELSE
    State := E_DiagState.READY;
END_IF;

BusEthercat.Online := Variateur.Online AND EncoderM1.Online AND EncoderM2.Online;
BusEthercat.Operational := Variateur.Operational AND EncoderM1.Operational AND EncoderM2.Operational;

Busy := FALSE;
Done := FALSE;
</Single>
            <Single Name="LineInfoPersistence" Type="string">268197d6-ad0a-5ec3-82c7-3a1f88f6bae6_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📡 FB_DiagEthercat — Diagnostic de communication bus EtherCAT (3 esclaves)
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_DiagEthercat
VAR_INPUT
	///Active la surveillance EtherCAT
	Enable: BOOL;
	///Front d'acquittement des défauts
	Reset: BOOL;
	///Variateur M3 (AC600_ECAT_Drive)
	///Working Counter variateur (FALSE = OK)
	VariateurWcState: BOOL;
	///État esclave variateur (8 = OP)
	VariateurSlaveState: WORD;
	///Encodeur M1 (COD1_CODEUR)
	///Working Counter M1 (FALSE = OK)
	EncoderM1WcState: BOOL;
	///État esclave M1 (8 = OP)
	EncoderM1SlaveState: WORD;
	///Encodeur M2 (COD2_CODEUR)
	///Working Counter M2 (FALSE = OK)
	EncoderM2WcState: BOOL;
	///État esclave M2 (8 = OP)
	EncoderM2SlaveState: WORD;
END_VAR
VAR_OUTPUT
	///Logique de surveillance active
	Ready: BOOL;
	///Non utilisé (conformité)
	Busy: BOOL;
	///Non utilisé
	Done: BOOL;
	///Résumé anomalie de communication bus
	Error: BOOL;
	///Code défaut global résumé
	ErrorId: WORD;
	///Phase courante du diagnostic global
	State: E_DiagState;
	///Phase figée à l'apparition de l'erreur
	StateAtError: E_DiagState;
	///Diagnostics bus EtherCAT
	BusEthercat: ST_DeviceDiag;
	///Diagnostics esclave AC600
	Variateur: ST_DeviceDiag;
	///Diagnostics esclave COD1
	EncoderM1: ST_DeviceDiag;
	///Diagnostics esclave COD2
	EncoderM2: ST_DeviceDiag;
END_VAR
VAR
	///Détecteur front de reset
	ResetEdge: R_TRIG;
END_VAR
</Single>
