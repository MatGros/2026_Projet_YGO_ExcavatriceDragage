        <Single Name="Guid" Type="System.Guid">c9125322-40ab-590a-8c7b-ddeec3eeeb70</Single>
        <Single Name="ParentGuid" Type="System.Guid">103fbab6-1b12-4ccb-9cc6-6c66cad0e1cb</Single>
        <Single Name="Name" Type="string">FB_Brake</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">24568a24-c491-472c-a21f-ee5d33859fab</Single>
            </Key>
            <Value>
              <Single Type="{24568a24-c491-472c-a21f-ee5d33859fab}" Method="IArchivable">
                <Single Name="MemoryReserveForOnlineChange" Type="int">0</Single>
                <Single Name="ExcludeFromBuild" Type="bool">False</Single>
                <Single Name="External" Type="bool">False</Single>
                <Single Name="EnableSystemCall" Type="bool">False</Single>
                <Single Name="CompilerDefines" Type="string"></Single>
                <Single Name="LinkAlways" Type="bool">False</Single>
                <Array Name="Undefines" Type="string" />
              </Single>
            </Value>
          </Entry>
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">dc467824-12f5-4623-bca1-1049a9e1f614</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639223207763550809</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Brake) ===

// 🛑 1. GATE — pas d'Enable = frein collé (sécurité positive), aucune temporisation en cours
IF NOT Enable THEN
    TonMagnetise(IN := FALSE, PT := DelayMagnetise + DelayContactClose);
    TonDecel(IN := FALSE, PT := DelayMotorDecel);
    BrakeCmd := FALSE;
    State := E_State.DISABLED;
    Ready := FALSE; Busy := FALSE; Done := FALSE;
    RETURN;
END_IF;

Ready := TRUE;

// 🔑 2. RESET FRONT — efface le bit dont la cause a disparu
ResetEdge(CLK := Reset);
BypassEdge(CLK := BypassContactorCheck);

// 🛠️ 3. SÉQUENCE TEMPORISÉE (démarrage vs arrêt)
IF MovementRequested THEN
    TonDecel(IN := FALSE, PT := DelayMotorDecel);
    TonMagnetise(IN := TRUE, PT := DelayMagnetise + DelayContactClose);
    IF TonMagnetise.Q THEN
        BrakeCmd := TRUE;              // ✅ Contacteur + magnétisation acquis → relâche
        State := E_State.DONE;
    ELSE
        BrakeCmd := FALSE;             // ⏳ Encore collé pendant la magnétisation
        State := E_State.BUSY;
    END_IF;
ELSE
    // 🆕 REX 2026-07-08 : Sécurité positive - fermeture immédiate du frein (collé) dès que les contacteurs de sens s'ouvrent
    TonMagnetise(IN := FALSE, PT := DelayMagnetise + DelayContactClose);
    TonDecel(IN := FALSE, PT := DelayMotorDecel);
    BrakeCmd := FALSE;                 // Fermeture immédiate
    State := E_State.READY;
END_IF;

Busy := (State = E_State.BUSY);
Done := (State = E_State.DONE);

// 🔍 4. DOUBLE VÉRIFICATION RETOUR CONTACTEUR (ST_ContactorCheck)
ContactorCheck.Command := BrakeCmd;
ContactorCheck.Feedback := ContactorFeedback;

// 🆕 REX 2026-08-03 (révocation 2026-07-26) : `ContactorFeedback` est maintenant dans le MÊME sens
// que `BrakeCmd` (TRUE = relâché = frein ouvert). En marche saine les deux sont ÉGAUX → c'est leur
// DIFFÉRENCE qui signale l'incohérence (contacteur collé).
// ⚠️ Le test repasse en `&lt;&gt;` (retour à la logique d'origine pré-2026-07-26).
TonFeedback(IN := (BrakeCmd &lt;&gt; ContactorFeedback), PT := FeedbackTimeout);
IF NOT BypassContactorCheck THEN
    IF TonFeedback.Q THEN
        ContactorCheck.StuckClosed := (BrakeCmd AND NOT ContactorFeedback);            // relâche commandée (BrakeCmd=TRUE), frein reste serré (ContactorFeedback=FALSE)
        ContactorCheck.StuckOpen   := (NOT BrakeCmd AND ContactorFeedback);             // serrage commandé (BrakeCmd=FALSE), frein reste ouvert (ContactorFeedback=TRUE)
        ErrorId := ErrorId OR 16#0001;
    ELSIF ResetEdge.Q THEN
        ContactorCheck.StuckClosed := FALSE;
        ContactorCheck.StuckOpen   := FALSE;
        ErrorId := ErrorId AND 16#FFFE;
    END_IF;
ELSE
    ContactorCheck.StuckClosed := FALSE;
    ContactorCheck.StuckOpen   := FALSE;
    ErrorId := ErrorId AND 16#FFFE;   // Bypass actif : efface/maintient à 0 le bit 0
    IF BypassEdge.Q THEN
        StateAtError := E_State.DISABLED; // Front activation bypass : débloque l'état figé
    END_IF;
END_IF;

// 🧾 5. ARBITRAGE ERROR / STATEATERROR (figé jusqu'à acquittement)
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;

// 🛡️ 6. SORTIE SÛRE SUR DÉFAUT
IF Error THEN
    BrakeCmd := FALSE;
END_IF;

// 📤 7. CONFIRMATION OUVERTURE FREIN (même sens que ContactorFeedback, ou image de BrakeCmd si BypassContactorCheck=TRUE)
IF BypassContactorCheck THEN
    BrakeCommandOpenConfirmed := BrakeCmd;
ELSE
    BrakeCommandOpenConfirmed := ContactorFeedback;  (* TRUE = frein ouvert = desserrage confirmé *)
END_IF;
</Single>
            <Single Name="LineInfoPersistence" Type="string">c9125322-40ab-590a-8c7b-ddeec3eeeb70_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛑 FB_Brake — Séquence frein à manque de courant (temps physiques)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md §3
///                   (règles issues de DOC/AF/AF_Partie-04_Mode_SemiAuto_Sequenceur_v2.0.md §4)
///   🛠️ Frein à manque de courant : colle au repos (sécurité positive).
///   📥 MovementRequested : mouvement demandé par FB_Winch (sens+palier &gt; 0)
///   📤 BrakeCmd          : commande bobine frein — TRUE = relâché (alimenté)
///   ⏱️ Séquence démarrage : attend fermeture contacteur + magnétisation
///      moteur AVANT de relâcher (sinon charge retombe → à-coup).
///   ⏱️ Séquence arrêt     : attend décélération/ouverture contacteur AVANT
///      de coller (sinon usure/casse mécanique en plein mouvement).
///   🔍 Double vérification retour contacteur bobine (ST_ContactorCheck) :
///      incohérence commande/retour au-delà de FeedbackTimeout → ErrorId.
///   🆕 REX 2026-08-03 (révocation 2026-07-26) : le retour câblé est l'image du CONTACTEUR DE COMMANDE
///      (DI = 1 ⟺ frein ouvert). Plus d'inversion à la frontière : ce FB reçoit maintenant un
///      signal dans le MÊME sens que `BrakeCmd` en marche saine (TRUE = relâché = ouvert) → le test d'incohérence est `&lt;&gt;`, pas `=`.
///      ⚠️ Ce retour n'est PAS une mesure du frein : il détecte un contacteur/bobine défaillant, mais
///      pas un frein usé ou qui patine. Le patinage reste couvert par Méca A (dérive codeur,
///      FB_Safety_Winch bit7) — pas par ce bloc.
///   ═══════════════════════════════════════════════════════════════
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Brake) ===
FUNCTION_BLOCK FB_Brake
VAR_INPUT
	///Contexte général (comme tout FB) — FALSE = frein collé (sûr)
	Enable: BOOL;
	///Acquittement défaut (front)
	Reset: BOOL;
	///TRUE = FB_Winch demande un mouvement (sens+palier actifs)
	MovementRequested: BOOL;
	///Retour frein (`PRG_02_Acquisition.HwIn`) : TRUE = frein OUVERT (desserré)
	ContactorFeedback: BOOL;
	///🆕 REX 2026-08-03 : même sens que BrakeCmd (TRUE = relâché)
	///→ en marche normale les deux sont ÉGAUX ; c'est leur
	///DIFFÉRENCE qui trahit un contacteur collé (voir §4).
	///Temps de fermeture contacteur de puissance
	DelayContactClose: TIME := TIME#100ms;
	///Délai magnétisation moteur avant ouverture frein
	DelayMagnetise: TIME := TIME#300ms;
	///Délai décélération/ouverture contacteur avant collage frein
	DelayMotorDecel: TIME := TIME#500ms;
	///Délai max cohérence commande/retour frein
	FeedbackTimeout: TIME := TIME#1s0ms;
	///🧪 TRUE = désactive StuckClosed/StuckOpen (axe simulé,
	BypassContactorCheck: BOOL;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: "Défaut engagement frein" - incohérence commande/retour frein (collage ou non-relâche)
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///Commande sortie bobine frein : TRUE = relâché
	BrakeCmd: BOOL;
	///TRUE = frein ouvert = commande ouverture confirmée (même sens que ContactorFeedback)
	BrakeCommandOpenConfirmed: BOOL;
	///Diag détaillé (IHM / FB_Safety_Winch)
	ContactorCheck: ST_ContactorCheck;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	///🔑 REX 2026-07-24 : Front montant activation bypass pour réarmement immédiat
	BypassEdge: R_TRIG;
	///Temporisation avant relâche
	TonMagnetise: TON;
	///Temporisation avant collage
	TonDecel: TON;
	///Timeout cohérence commande/retour
	TonFeedback: TON;
END_VAR
</Single>
