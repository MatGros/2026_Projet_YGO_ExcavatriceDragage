            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Filter_PT1
VAR_INPUT
    ValueIn     : REAL;       // Consigne brute entrée
    TimeConst   : TIME;       // Constante de temps du filtre
    CycleTimeS  : REAL;       // Temps de cycle réel en secondes
END_VAR
VAR_OUTPUT
    ValueOut    : REAL;       // Consigne filtrée sortie
END_VAR
VAR
    T           : REAL;
    Alpha       : REAL;
END_VAR</Single>
