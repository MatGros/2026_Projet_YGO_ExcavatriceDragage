            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ST_DredgingAssistCfg — Réglages persistants assistants prélèvement
///   📄 Doc : DOC/AF/AF_Partie-04_Mode_SemiAuto_Sequenceur_v2.3.md §3ter
///   ═══════════════════════════════════════════════════════════════
TYPE ST_DredgingAssistCfg :
STRUCT
	///Position mini M1/M2 avant plongée
	DiveStartMin_M: REAL := 1;
	///Borne haute fenêtre front immersion
	ImmersionUpper_M: REAL := 0.5;
	///Borne basse fenêtre front immersion
	ImmersionLower_M: REAL := -0.5;
	///Remontée palier 1 avant accélération
	ExtractionControlDistance_M: REAL := 2;
	///Mode assistance plongée mémorisé
	TglEnableDiveSearch: BOOL := FALSE;
	///Mode assistance extraction mémorisé
	TglEnableExtractionSequence: BOOL := FALSE;
	///Mode assistance vidage trémie mémorisé
	TglEnableDumpAtTremie: BOOL := FALSE;
	///Pont persistance/IHM initialisé
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
