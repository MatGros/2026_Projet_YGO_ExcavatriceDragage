            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📋 ST_ProgramRequest — Ensemble des demandes de mouvements du programme
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Regroupe les demandes formulées vers PRG_04 (Treuils/Benne) et PRG_05 (Translation)
///   📄 Référentiel : DOC/WFLOW/CONTRACTS/INTERPRG_CONTRACT_PRG03_MODES_CYCLE_v1.0.md
///   =======================================================================
TYPE ST_ProgramRequest :
STRUCT
	///Demande programme treuil M1
	ReqWinchM1: ST_ProgramWinchRequest;
	///Demande programme treuil M2
	ReqWinchM2: ST_ProgramWinchRequest;
	///Demande programme translation M3
	ReqTranslation: ST_ProgramTranslationRequest;
	///Demande programme benne
	ReqBucket: ST_ProgramBucketRequest;
	///Intention couplée continue opérateur (joystick/boutons), TOUS modes
	OperatorCoupledIntent: ST_OperatorCoupledIntent;
END_STRUCT
END_TYPE
</Single>
