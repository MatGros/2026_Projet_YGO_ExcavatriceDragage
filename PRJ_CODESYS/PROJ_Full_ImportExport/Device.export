      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🌐 ST_BypassNetwork — Bypass général du diagnostic réseau
///   ───────────────────────────────────────────────────────────────
///   🔒 Permet de forcer les esclaves réseau (CAN, EtherCAT) à "online"
///      pour le diagnostic, sans devoir toucher à chaque bit individuel.
///      Jamais actif en production.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BypassNetwork :
STRUCT
	///📡 1. Communication &amp; Systèmes esclaves
	///🕹️ Bypass diagnostic esclave CANopen Joystick
	Joystick: BOOL;
	///🧲 Bypass diagnostic esclave EtherCAT COD1 (M1 codeur)
	EncoderM1: BOOL;
	///🧲 Bypass diagnostic esclave EtherCAT COD2 (M2 codeur)
	EncoderM2: BOOL;
	///↔️ Bypass diagnostic esclave EtherCAT AC600 (M3 drive)
	VariateurM3: BOOL;
	///💓 Bypass du bit de vie IHM (défaut TRUE = sécurisé si pas d'IHM)
	IhmHeartbeat: BOOL := TRUE;
	///🛡️ 2. Hiérarchie &amp; Restauration
	///🌐 Bypass Global : tous les esclaves réseau à la fois
	Global: BOOL;
	///Flag restauration boot dédié (défaut FALSE non ambigu, contrairement à une valeur métier)
	///🚦 TRUE = bypass restauré depuis GVL_BypassRetain ce boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
