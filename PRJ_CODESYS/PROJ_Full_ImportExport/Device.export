      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ ST_SafetyChecklist — Diagnostic chronologique réarmement chaîne de sécurité / AU
///   ───────────────────────────────────────────────────────────────
///   🎨 Permet d'identifier immédiatement pourquoi la puissance / AU ne réarme pas.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_SafetyChecklist :
STRUCT
	///0. Aiguillage source — dit QUELLE entree alimente les steps 1-3 ci-dessous.
	///       Absent jusqu'ici : diagnostiquer un blocage AU en full simu obligeait a rouvrir
	///       GVL_Simulation dans un Watch separe (, banc sans HW).
	///TRUE = bit maitre simu actif (GVL_Simulation.SimulationModeActive)
	SimulationModeActive: BOOL;
	///TRUE = domaine Safety simule ➔ Step1-3 lisent FB_Sim_Safety, pas les DI/comm reelles
	SimSafetyActive: BOOL;
	///0bis. Entrées physiques directes HwIn (vérité terrain)
	///Boucle AU physique ou simulée issue de HwIn.Machine
	HwIn_EmergencyChainClosed_DI: BOOL;
	///Retour contacteur de puissance issu de HwIn.Machine
	HwIn_PowerContactorEngaged_DI: BOOL;
	///Commande coupure AU IHM
	HwIn_EmergencyBtnCut_HMI: BOOL;
	///1. Intégrité matérielle &amp; modules E/S
	///TRUE = Les 3 cartes E/S physiques sont RUNNING ➔ En simu : GVL_Simulation.SimSafetyActive=1
	Step1_InputModulesOk: BOOL;
	///TRUE = Pas d'appui AU ➔ Déverrouiller le BP coup-de-poing physique ou IHM : GVL_IHM.Modes.Cmd.BtnEmergencyCutOff
	Step2_EmergencyBtnNotCut: BOOL;
	///TRUE = Boucle physique AU fermée (EmergencyChainClosed_DI)
	Step3_EmergencyChainClosed: BOOL;
	///2. Conditions de réarmement
	///TRUE = Contacteur relâché ; précondition AF01 avant réarmement
	Step4_ContactorReleased: BOOL;
	///TRUE = Armable ; acquitter si nécessaire puis générer un front BtnEmergencyArming
	Step5_ArmingAllowed: BOOL;
	///3. Séquence de réarmement
	///0=IDLE, 1=TestA, 2=RestoreA, 3=TestB, 4=RestoreB, 5=Pulse, 6=Confirm
	ArmingStep: INT;
	///TRUE = Impulsion d'armement en cours
	ArmingPulseActive: BOOL;
	///TRUE = séquence de réarmement ou verrouillage en cours
	ArmingBusy: BOOL;
	///TRUE = verrouillage temporel entre tentatives
	LockoutActive: BOOL;
	///TRUE = Contacteur principal sous tension (PowerContactorEngaged_DI)
	PowerContactorEngaged: BOOL;
	///TRUE = demande de coupure safety active
	PowerCutOffActive: BOOL;
	///TRUE = demande de coupure AU (entrée instSafetyEmergencyManagement)
	PowerCutOffRequest: BOOL;
	///TRUE = maintien voie A demandé
	MaintainAActive: BOOL;
	///TRUE = maintien voie B demandé
	MaintainBActive: BOOL;
	///TRUE = état final : chaîne OK et puissance engagée
	AllConditionsMet: BOOL;
	///4. Erreurs
	///TRUE = Défaut sécurité actif
	SafetyError: BOOL;
	///bit0 redondance ; bit1 échec confirmation contacteur
	ArmingErrorId: WORD;
	///TRUE = Défaut test de redondance contacteurs
	RedundancyTestFailed: BOOL;
	///TRUE = Échec de la séquence d'armement
	ArmingFailed: BOOL;
END_STRUCT
END_TYPE
</Single>
