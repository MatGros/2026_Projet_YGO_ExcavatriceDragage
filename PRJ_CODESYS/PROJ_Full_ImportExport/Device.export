          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎮 ST_TranslationCmd — Commandes IHM pour la Translation M3
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné au pilotage de la translation M3 depuis l'IHM.
///   📄 2026-07-24 : Initialized protège SetFreq_Hz (seul réglage à survivre au reboot),
///      sans pont générique pour ne jamais persister BtnFwd/BtnRev.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_TranslationCmd :
STRUCT
	///🎯 TRUE = positionneur sur SelTarget ; FALSE = jog libre
	SelPositioning: BOOL;
	///🔢 Numéro de la cible de position sélectionnée
	SelTarget: INT;
	///↔️ Requête marche avant (→ Trémie), pilotage IHM exclusif
	BtnFwd: BOOL;
	///↔️ Requête marche arrière (→ Maintenance), pilotage IHM exclusif
	BtnRev: BOOL;
	///🎯 Consigne fréquence manuelle [Hz], limitée par PRG_10_Outputs
	SetFreq_Hz: REAL;
	///🕹️ TRUE = joystick, FALSE = boutons BtnFwd/BtnRev
	TglJoystickMaster: BOOL;
	///🔄 TRUE = inverse Fwd→Maintenance / Rev→Trémie (mise en service)
	InvertDirection: BOOL;
	///🚦 TRUE = SetFreq_Hz restauré depuis GVL_PERSISTENT ce boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
