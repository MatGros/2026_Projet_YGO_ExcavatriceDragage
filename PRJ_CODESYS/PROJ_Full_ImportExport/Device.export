        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ FB_Translation — Directeur de l'axe transversal M3 (variateur AC600)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-11_Fonction_Translation_v2.3.md
///   🔌 FB DE MOUVEMENT : porte StartStop + SafeStop en plus de l'interface
///      standard. Précédence Enable &gt; SafeStop &gt; StartStop.
///   Pilotage exclusivement ETHERCAT nominal (mot de commande, consigne fréquence).
///   🧩 Compose FB_Brake (réutilisé TEL QUEL depuis COMMUN).
///   🎯 Invariant : toute inversion de sens force la cible de rampe à 0.0 tant que le
///      changement de sens est en attente, pour garantir le croisement du seuil d'arrêt
///      qui autorise l'interlock de changement de sens (§5).
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Translation
VAR_INPUT
	///--&gt; [CMD] Active le FB. FALSE = neutralisation totale (sorties coupées)
	Enable: BOOL;
	///--&gt; [CMD] Acquittement défaut (front)
	Reset: BOOL;
	///--&gt; [SAFE] Chaîne AU réarmée + conditions globales OK
	PowerContactorEngaged: BOOL;
	///--&gt; [CMD] Mode courant
	Mode: E_Mode;
	///--&gt; [CMD] TRUE = rampe accélération, FALSE = rampe décélération NORMALE
	StartStop: BOOL;
	///--&gt; [SAFE] Sortie FB_Safety_Translation : TRUE = rampe décélération RAPIDE (Enable maintenu)
	SafeStop: BOOL;
	///--&gt; [CMD] -1 = Rev, 0 = Neutre, +1 = Fwd (source d'autorité du sens)
	Direction: INT;
	///--&gt; [CMD] Magnitude de la consigne (de 0 à 100%)
	SpeedTgt_Pct: REAL;
	///--&gt; [HW] Capteur position cible courante
	PositionSensorTarget: BOOL;
	///--&gt; [HW] Capteur PV — ralentissement avant Trémie (Direction=1)
	SlowdownSensorTremie: BOOL;
	///--&gt; [HW] Capteur P1 — ralentissement avant Maintenance (Direction=-1)
	SlowdownSensorMaintenance: BOOL;
	///--&gt; [HW] Capteur P2 — ralentissement avant P1 (Direction=-1)
	SlowdownSensorP1: BOOL;
	///--&gt; [HW] Fin de course extrême avant
	LimitSwitchFwd: BOOL;
	///--&gt; [HW] Fin de course extrême arrière
	LimitSwitchRev: BOOL;
	///🔌 Spécifique ETHERCAT
	///--&gt; [HW] Mot d'état AC600 lu depuis l'image d'entrée EtherCAT
	DriveStatusWord: WORD;
	///--&gt; [HW] Fréquence réelle mesurée (Hz)
	DriveActualFreqHz: REAL;
	///--&gt; [TST] TRUE = désactive StuckClosed/StuckOpen pour le frein (simulation)
	BypassContactorCheck: BOOL;
	///--&gt; [TST] TRUE = ignore les fins de course extrêmes
	BypassLimitSwitch: BOOL;
	///--&gt; [HW] Retour physique direct : TRUE = frein OUVERT (desserré)
	BrakeFeedback: BOOL;
	InvertDriveDirection: BOOL;
	///Réglages rampe
	///--&gt; [CFG] %/s — accélération
	CfgRampAccelRate: REAL := 20;
	///--&gt; [CFG] %/s — décélération normale
	CfgRampDecelNormalRate: REAL := 40;
	///--&gt; [CFG] %/s — décélération RAPIDE
	CfgRampDecelFastRate: REAL := 100;
	///--&gt; [CFG] Délai avant d'autoriser un changement de sens à l'arrêt
	DirectionInterlockDelay: TIME := TIME#200ms;
	///Réglages ETHERCAT
	///--&gt; [CFG] Vitesse réduite d'approche Trémie en Hz
	ApproachSpeedTremieHz: REAL := 10;
	///--&gt; [CFG] Vitesse réduite d'approche Maintenance en Hz
	ApproachSpeedMaintenanceHz: REAL := 10;
	///--&gt; [CFG] Vitesse réduite d'approche P1 en Hz
	ApproachSpeedP1Hz: REAL := 10;
	///--&gt; [CFG] Échelle 0..100 % → MaxHz
	DriveFreqScaleMaxHz: REAL := 60;
	///Réglages communs
	///--&gt; [CFG] Filtrage capteur de position cible
	CaptorDebounce: TIME := TIME#100ms;
	///--&gt; [CFG] Voir FB_Brake
	BrakeDelayContactClose: TIME := TIME#100ms;
	///--&gt; [CFG] Voir FB_Brake
	BrakeDelayMagnetise: TIME := TIME#300ms;
	///--&gt; [CFG] Voir FB_Brake
	BrakeDelayMotorDecel: TIME := TIME#500ms;
	///--&gt; [CFG] Strictement sous watchdog final 500 ms
	BrakeFeedbackTimeout: TIME := TIME#300ms;
END_VAR
VAR_OUTPUT
	///&lt;-- [STAT] FB prêt (sortie libre, hors ST_Status)
	Ready: BOOL;
	///🧩 Statut transverse (forme cible ST_Fault)
	Fault: ST_Fault;
	///&lt;-- [STAT] Capteur position cible
	TargetReached: BOOL;
	///&lt;-- [ACT] Demande métier AC600, arbitrée par FB_TranslationOutputInterlock
	RequestedDriveControlWord: WORD;
	///&lt;-- [ACT] Demande métier fréquence, arbitrée par FB_TranslationOutputInterlock
	RequestedDriveFreqHz: REAL;
	///&lt;-- [ACT] Demande métier desserrage, issue de FB_Brake
	BrakeReleaseRequest: BOOL;
	///&lt;-- [STAT] TRUE = frein ouvert = commande ouverture confirmée (depuis FB_Brake)
	BrakeCommandOpenConfirmed: BOOL;
	///&lt;-- [DIAG] Diag contacteur frein
	BrakeContactorCheck: ST_ContactorCheck;
END_VAR
VAR
	///* [INST] Séquence frein
	Brake: FB_Brake;
	///* [INST] Mesure temps de cycle
	CycleTimeCalc: FB_CycleTime;
	///* [INST] Rampe de vitesse logicielle (PLC)
	SpeedRamp: FB_Ramp;
	///. [LOC] Front Reset
	ResetEdge: R_TRIG;
	///. [LOC] Interlock changement de sens
	DirectionChangeDelay: TON;
	///. [LOC] Sens réellement appliqué
	CommandedDirection: INT;
	///. [LOC] Force la rampe à 0 pendant une inversion de sens en attente
	DirectionChangePending: BOOL;
	///. [LOC] CommandedDirection compensé câblage
	PhysicalDriveDirection: INT;
	///. [LOC] Cible rampe en %
	RampTargetPct: REAL;
	///. [LOC] Debounce capteur cible
	CaptorDebounceTon: TON;
	///. [LOC] Front arrivée sur capteur
	ArrivalEdge: R_TRIG;
	///. [LOC] Sens d'arrivée mémorisé
	DirectionAtArrival: INT;
	///. [LOC] Arrêt exact sur capteur cible
	ArrivalLock: BOOL;
	///. [LOC] Pilote FB_Brake
	MovementRequested: BOOL;
	///. [LOC] Initialisation premier scan
	FirstScanDone: BOOL;
	TonBrakeRealFreqTimeout: TON;
	///Défauts
	///. [LOC] Latch défaut variateur
	DriveFaultLatching: BOOL;
	///* [INST] Socle défaut transverse
	instFault: FB_FaultCore;
	///. [LOC] Table des causes nommées
	instCauses: ARRAY[0..15] OF ST_FaultCause;
END_VAR
</Single>
