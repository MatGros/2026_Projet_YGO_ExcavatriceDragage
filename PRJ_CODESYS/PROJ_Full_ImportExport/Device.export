        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639197103391665892</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===
IF NOT Enable THEN
    SimChainOk     := FALSE;
    SimContactorOk := FALSE;
    ContactorLatch := FALSE;
    RETURN;
END_IF;

// 1. La chaîne AU est saine si le PLC maintient les deux relais de coupure de puissance
// (on simule que les boutons AU physiques coup-de-poing sont toujours au repos/relâchés)
SimChainOk := PowerCutOff_A AND PowerCutOff_B;

// 2. Logique d'auto-maintien (latch) du contacteur avec priorité à la coupure
IF NOT SimChainOk THEN
    ContactorLatch := FALSE;
ELSIF EmergencyArming THEN
    ContactorLatch := TRUE;
END_IF;

// Recopie vers la sortie
SimContactorOk := ContactorLatch;
</Single>
            <Single Name="LineInfoPersistence" Type="string">9ab5b810-a798-5ced-ad58-9e4d01ab66eb_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 FB_Sim_Safety — Simulation de la chaîne d'AU et du contacteur de puissance
///   ───────────────────────────────────────────────────────────────
///   📥 Enable          : activation de la simulation (SimulationModeActive AND NOT EmergencyStopChain_IsReal)
///   📥 PowerCutOff_A   : demande de coupure PLC canal A (maintenu à TRUE en marche normale)
///   📥 PowerCutOff_B   : demande de coupure PLC canal B (maintenu à TRUE en marche normale)
///   📥 EmergencyArming : impulsion de réarmement (EmergencyArming_RQ)
///   
///   📤 SimChainOk      : simulation de la boucle AU (boutons relâchés et coupures PLC inactives)
///   📤 SimContactorOk  : simulation du contacteur engagé (EmergencyStopOk)
///   
///   ⚙️ Logique physique :
///      - La chaîne d'AU (SimChainOk) est saine si les deux relais PLC de coupure sont maintenus fermés (TRUE).
///      - Le contacteur s'engage (SimContactorOk) lors d'une impulsion de réarmement (EmergencyArming) 
///        et s'auto-maintient tant que la chaîne reste saine (SimChainOk).
///      - Toute coupure de la chaîne (SimChainOk = FALSE) fait retomber immédiatement le contacteur.
///   ═══════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_Sim_Safety
VAR_INPUT
	///Activation de la simulation
	Enable: BOOL;
	///Commande coupure canal A (TRUE = OK/fermé)
	PowerCutOff_A: BOOL;
	///Commande coupure canal B (TRUE = OK/fermé)
	PowerCutOff_B: BOOL;
	///Impulsion de réarmement (TRUE = pulse)
	EmergencyArming: BOOL;
END_VAR
VAR_OUTPUT
	///Boucle AU simulée saine
	SimChainOk: BOOL;
	///Contacteur simulé engagé
	SimContactorOk: BOOL;
END_VAR
VAR
	///Mémorisation de l'auto-maintien du contacteur
	ContactorLatch: BOOL;
END_VAR
</Single>
