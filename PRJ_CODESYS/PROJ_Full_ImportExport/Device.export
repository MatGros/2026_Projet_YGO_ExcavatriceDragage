            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_CycleTime
VAR_INPUT
    DefaultValueS : REAL := 0.004; // Valeur de secours (Ex: MainTask = 20ms -&gt; 0.020)
END_VAR
VAR_OUTPUT
    CycleTimeS    : REAL;          // Temps écoulé réel (Secondes)
END_VAR
VAR
    TimeCurrent   : TIME;          // Temps système actuel
    TimeLast      : TIME;          // Empreinte du cycle précédent
    DeltaTimeMs   : UDINT;         // Écart brut calculé
    InitDone      : BOOL;          // Drapeau d'initialisation
END_VAR</Single>
