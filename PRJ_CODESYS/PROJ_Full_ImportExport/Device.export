      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// 🛡️ 1. GATE GENERAL (D-A11, C1) — PAS de Homed : non-reference ≠ incoherent.
//    Ce gate sert a la fiabilite de la mesure (vitesse, mouvements, PositionsValid).
EncoderFault := (NOT EncoderAvailable) OR EncoderIncoherent;

// 🎯 2. GATE STRICT — reserve a l'interlock hauteur M3 (C1) : on ne translate pas
//    si la hauteur est inconnue (jamais home) ou douteuse.
HomedAndReliable := EncoderAvailable AND Homed AND (NOT EncoderIncoherent);
</Single>
            <Single Name="LineInfoPersistence" Type="string">35cfbd1a-e7fe-458a-bb4a-ad017b438f47_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🛡️ FB_EncoderReliability — Gates de fiabilite de la chaine codeur
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Synthetise les gates de fiabilite d'un treuil a partir des
///      faits produits par la chaine codeur (Abs/Homing/Safety), pur calcul
///      combinatoire, sans memoire ni machine d'etat.
///   🔒 Polarité :
///      EncoderFault     = NOT EncoderAvailable OR EncoderIncoherent   (gate GENERAL, SANS Homed)
///      HomedAndReliable = EncoderAvailable AND Homed AND NOT EncoderIncoherent (gate STRICT M3)
///   🧩 Responsabilite scindee (D-A2bis) : Homing = referencement, Safety = coherence,
///      ce FB = « le codeur est fiable ». Aucune recomposition chez les consommateurs.
///   📄 Doc : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
///   =======================================================================
FUNCTION_BLOCK FB_EncoderReliability
VAR_INPUT
	///=== FAITS DE LA CHAINE CODEUR ===
	///--&gt; [HW]  Codeur operationnel sur bus (FB_Encoder_Abs)
	EncoderAvailable: BOOL;
	///--&gt; [STAT] Codeur reference (FB_Encoder_Homing)
	Homed: BOOL;
	///--&gt; [SAFE] Incoherence ou hors bornes (FB_Encoder_Safety)
	EncoderIncoherent: BOOL;
END_VAR
VAR_OUTPUT
	///=== GATES DE FIABILITE ===
	///&lt;-- [SAFE] Gate general fiabilite (SANS Homed) — vitesse/mouvements
	EncoderFault: BOOL;
	///&lt;-- [STAT] Gate strict M3 : disponible ET reference ET pas incoherent
	HomedAndReliable: BOOL;
END_VAR
</Single>
