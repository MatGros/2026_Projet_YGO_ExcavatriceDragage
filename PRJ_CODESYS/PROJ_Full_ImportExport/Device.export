      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// 🛑 1. GATE AUTOMATE
IF NOT Enable THEN
    Ready := FALSE;
    SafeStop := TRUE;             // Sécurité par défaut : arrêt forcé
    SafetyOk := FALSE;
    RETURN;
END_IF;

Ready := TRUE;

// 🔑 2. RESET DÉFAUTS
IF Reset AND Error THEN
    Error := FALSE;
    ErrorId := 16#0000;
END_IF;

// 🛡️ 3. LOGIQUE FAIL-SAFE (Perte de signal = Danger)
IF NOT EStopArmed THEN
    ErrorId := 16#0001;           // Code : Arrêt d'urgence activé
ELSIF NOT CanOnline OR NOT CanOperational THEN
    ErrorId := 16#0002;           // Code : Liaison Joystick perdue
ELSIF NOT EthercatOk THEN
    ErrorId := 16#0004;           // Code : Bus EtherCAT en faute
END_IF;

// 📤 4. ARBITRAGE DES SORTIES TRANSVERSES
Error := (ErrorId &lt;&gt; 16#0000);

// SafeStop est l'actionneur logiciel (TRUE = On coupe tout)
SafeStop := Error;

// SafetyOk est le feu vert (TRUE = Tout est sain)
SafetyOk := NOT Error;</Single>
            <Single Name="LineInfoPersistence" Type="string">ae8cf596-3b07-456b-876e-68529c263a0c_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Safety
VAR_INPUT
    Enable          : BOOL;       // Active la surveillance
    Reset           : BOOL;       // Front d'acquittement des défauts
    EStopArmed      : BOOL;       // Entrée TOR fail-safe (TRUE = OK, FALSE = Déclenché)
    CanOnline       : BOOL;       // Trame com active (TRUE = OK)
    CanOperational  : BOOL;       // Nœud en marche (TRUE = OK)
    EthercatOk      : BOOL;       // Bus EtherCAT sain (TRUE = OK)
END_VAR
VAR_OUTPUT
    Ready           : BOOL;       // Logique de sécurité opérationnelle
    SafeStop        : BOOL;       // Ordre d'arrêt absolu (TRUE = STOP IMMÉDIAT)
    SafetyOk        : BOOL;       // Feu vert global (TRUE = Autorisation de bouger)
    Error           : BOOL;       // Présence anomalie sécurité
    ErrorId         : WORD;       // Code bitfield de la cause du déclenchement
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">ae8cf596-3b07-456b-876e-68529c263a0c_Decl_LineIds</Single>
          </Single>
        </Single>
