      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION ===

{region "§1 Causes &amp; Socle Défaut (évalué en continu)"}
// 🔑 1. RESET FRONT
ResetEdge(CLK := Reset);

// 🔍 2. SURVEILLANCE BORNAGE &amp; INCOHÉRENCE BOOT
instCauses[0].Active   := NOT BypassGlobal AND ((CablePosM &lt; PositionMinM) OR (CablePosM &gt; PositionMaxM));
instCauses[0].Latching := FALSE;
instCauses[0].Texte    := 'Depassement bornes physiques absolues cable';

instCauses[1].Active   := NOT BypassGlobal AND HomingSuspect;
instCauses[1].Latching := FALSE;
instCauses[1].Texte    := 'Incoherence position au redemarrage';

// Appel du socle de défaut
instFault(Enable := Enable, Reset := Reset, Causes := instCauses);
Fault := instFault.Fault;
{endregion}

{region "§2 Gate neutralisation"}
// 🛑 2. GATE
IF NOT Enable THEN
    Ready := FALSE;
    CablePosMSafe := CablePosM;
    EncoderIncoherent := FALSE;
    RETURN;
END_IF;

Ready := Enable AND NOT Fault.Latched;
{endregion}

{region "§3 Transmission mesure et sécurité"}
// 📏 3. TRANSMISSION DE LA MESURE &amp; SÉCURITÉ
CablePosMSafe := CablePosM;
EncoderIncoherent := Fault.Error;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">22098ff7-9f50-4fa4-86f5-054de5bf7d80_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🛡️ FB_Encoder_Safety — Bornage physique &amp; surveillance cohérence
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Bornage physique absolu [-99; +99]m et relais d'incohérence redémarrage
///   🔒 Polarité : EncoderIncoherent=TRUE en cas de hors bornes ou HomingSuspect
///   🛡️ Sécurité : Verrouillage de la position câble sûre
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.3.md
///   =======================================================================
FUNCTION_BLOCK FB_Encoder_Safety
VAR_INPUT
	///=== COMMANDES &amp; AUTORISATIONS ===
	///--&gt; [CMD] Autorisation generale FB (TRUE=Autorise)
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut (front montant)
	Reset: BOOL;
	///=== MESURES &amp; ALERTE HOMING ===
	///--&gt; [HW]  Position calculee (m, sortie FB_Encoder_Scale)
	CablePosM: REAL;
	///--&gt; [SAFE] Alerte incoherence redemarrage (FB_Encoder_Homing)
	HomingSuspect: BOOL;
	///=== REGLAGES &amp; BORNES PHYSIQUES ===
	///--&gt; [CFG] Plafond bornage physique bas (m)
	PositionMinM: REAL := -99;
	///--&gt; [CFG] Plafond bornage physique haut (m)
	PositionMaxM: REAL := 99;
	///=== TESTS &amp; BYPASS ===
	///--&gt; [TST] Neutralisation defaut de bornage pour mise en service
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	///=== ETATS IEC &amp; SYNOPTIQUE ===
	///&lt;-- [STAT] FB pret a fonctionner
	Ready: BOOL;
	///🧩 Statut transverse (forme cible ST_Fault)
	Fault: ST_Fault;
	///=== MESURES SURE &amp; SECURITE ===
	///&lt;-- [DIAG] Position cable instantanee transmise (m)
	CablePosMSafe: REAL;
	///&lt;-- [SAFE] Incoherence ou hors bornes (TRUE = defaut)
	EncoderIncoherent: BOOL;
END_VAR
VAR
	///=== DETECTEURS DE FRONT ===
	///. [LOC] Detecteur front montant Reset
	ResetEdge: R_TRIG;
	///=== SOCLE DEFAUT (FB_FaultCore) ===
	///* [INST] Socle défaut transverse
	instFault: FB_FaultCore;
	///. [LOC] Table des causes nommées
	instCauses: ARRAY[0..15] OF ST_FaultCause;
END_VAR
</Single>
