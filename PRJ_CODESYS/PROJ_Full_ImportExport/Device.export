            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎚️ PRG_04_Modes — Gestion et Arbitrage du Mode Machine
///   ───────────────────────────────────────────────────────────────
///   ⚙️ Exécuté par la tâche PLC en position 4.
///   ═══════════════════════════════════════════════════════════════
///   📄 Docs : DOC/AF_Partie-05_Modes_Maintenance_v1.6.md
PROGRAM PRG_04_Modes
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	///Arbitrage du mode machine (DISABLE, MAINT, SEMI_AUTO, etc.)
	instModes: FB_Modes;
	///🆕 Mémoire d'état M1
	PrevInhibitM1: BOOL;
	///🆕 Mémoire d'état M2
