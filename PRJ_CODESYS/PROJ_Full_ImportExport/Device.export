            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639204926771988237</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Output) ===

// 1. Inversion NO/NC
State := Command XOR InvertLogic;

// 2. Option blink 1 Hz (diagnostic/visualisation) — modulation à 500ms ON/500ms OFF
IF Blink1Hz AND State THEN
    BlinkTimer(IN := NOT BlinkTimer.Q, PT := T#500ms);
    IF BlinkTimer.Q THEN
        BlinkState := NOT BlinkState;
    END_IF;
    State := BlinkState;
ELSE
    BlinkTimer(IN := FALSE, PT := T#500ms);
    BlinkState := FALSE;
END_IF;

// 3. Double vérification commande/retour (contacteur collé/ne colle pas)
IF UseFeedback THEN
    FeedbackTon(IN := (State &lt;&gt; FeedbackRaw), PT := FeedbackTimeout);
    IF FeedbackTon.Q THEN
        ErrorId := ErrorId OR 16#0001;
        FeedbackOk := FALSE;
    ELSE
        ErrorId := ErrorId AND 16#FFFE;
        FeedbackOk := TRUE;
    END_IF;
ELSE
    FeedbackTon(IN := FALSE, PT := FeedbackTimeout);
    FeedbackOk := TRUE;   // Pas de contrôle demandé — pas d'incohérence à signaler
END_IF;

// 4. Diagnostic voie/carte
IF NOT ChannelOk THEN
    ErrorId := ErrorId OR 16#0002;
ELSE
    ErrorId := ErrorId AND 16#FFFD;
END_IF;

Error := (ErrorId &lt;&gt; 16#0000);
</Single>
            <Single Name="LineInfoPersistence" Type="string">0880b4b3-9864-4961-8dcd-1a1467a11a64_Impl_LineIds</Single>
