            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_DiagState :
(
	///Désactivé (surveillance non active)
	DISABLED := 0,
	///Prêt (opérationnel, pas de défaut)
	READY := 1,
	///Initialisation en cours / Recherche de réseau
	INIT := 2,
	///Surveillance active (états transitoires)
	MONITORING := 3,
	///Présence anomalie de communication
	ERROR := 4
);
END_TYPE
</Single>
