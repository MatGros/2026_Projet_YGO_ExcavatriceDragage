          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ↔️ ST_TranslationInterPrg — Bus d'échange inter-PRG produit par PRG_05_Translation
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Encapsuler la demande finale M3, l'état public TranslationState
///      et le diagnostic TranslationSafety publiés par PRG_05_Translation vers
///      les consommateurs (PRG_03/06/07).
///   📤 Producteur unique : PRG_05_Translation (VAR_OUTPUT Data : ST_TranslationInterPrg).
///   📄 Doc : DOC/AF/AF_Partie-11_Fonction_Translation_v2.3.md
///   🔌 Architecture : Bus de données typé — encapsulation des échanges inter-PRG.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_TranslationInterPrg :
STRUCT
	///=== ⚡ Demande finale M3 ===
	///↔️ Demande finale et interlocks translation M3
	TranslationFinalInterlockRequest: ST_TranslationFinalInterlockRequest;
	///=== 📊 État public translation ===
	///🚦 Etat public translation M3
	TranslationState: ST_TranslationState;
	///=== 🛡️ Sécurité translation ===
	///🛡️ Diagnostic et securites translation M3
	TranslationSafety: ST_SafetyTranslation;
	///=== 🎯 Faits decodeur position M3 (produits par PRG_05, AF-02 TBD §8 #5) ===
	///📍 Zone Tremie (1=Present)
	TranslationPosTremie: BOOL;
	///📍 Zone pre-ralentissement PV (1=Present)
	TranslationPosPV: BOOL;
	///📍 Zone P2 (1=Present)
	TranslationPosP2: BOOL;
	///📍 Zone P1 (1=Present)
	TranslationPosP1: BOOL;
	///📍 Zone Maintenance (1=Present)
	TranslationPosMaintenance: BOOL;
	///🎯 Position exacte Tremie (1=Atteint)
	TranslationAtTremie: BOOL;
	///🎯 Position exacte PV (1=Atteint)
	TranslationAtPV: BOOL;
	///🎯 Position exacte P2 (1=Atteint)
	TranslationAtP2: BOOL;
	///🎯 Position exacte P1 (1=Atteint)
	TranslationAtP1: BOOL;
	///🎯 Position exacte Maintenance (1=Atteint)
	TranslationAtMaintenance: BOOL;
	///🛡️ Fin de course avant M3 (1=Actionne)
	M3_LimitSwitchFwd: BOOL;
	///🛡️ Fin de course arriere M3 (1=Actionne)
	M3_LimitSwitchRev: BOOL;
	///❌ Incoherence detectee mot capteurs M3
	M3_SensorWordIncoherent: BOOL;
	///📊 Mot d'etat capteurs M3
	M3_SensorsWord: BYTE;
	///=== ⚙️ États dynamiques &amp; positions stables translation M3 ===
	///⚙️ Translation M3 en mouvement effectif
	TranslationBusy: BOOL;
	///✅ Cible translation atteinte et confirmee
	TranslationDone: BOOL;
	///🎯 M3 positionne stable a la Tremie
	M3_AtTremieStable: BOOL;
	///🎯 M3 positionne stable au Point 1
	M3_AtP1Stable: BOOL;
	///🎯 M3 positionne stable en zone Maintenance
	M3_AtMaintenanceStable: BOOL;
END_STRUCT
END_TYPE
</Single>
