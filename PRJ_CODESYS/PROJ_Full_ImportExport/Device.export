            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔌 ST_ProgramWinchRequest — Demande de mouvement treuil par le programme
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Regroupe les demandes logiques de treuil formulées par le séquenceur
///   📄 Référentiel : DOC/WFLOW/CONTRACTS/INTERPRG_CONTRACT_PRG03_MODES_CYCLE_v1.0.md
///   =======================================================================
TYPE ST_ProgramWinchRequest :
STRUCT
	///Ordre marche/arrêt demandé par le programme (TRUE=Marche)
	ReqStartStop: BOOL;
	///Sens demandé (-1: Descente, 0: Stop, 1: Montée)
	ReqDirection: INT;
	///Consigne de vitesse cible demandée (0.0 à 100.0 %)
	SpeedTgtPct: REAL;
END_STRUCT
END_TYPE
</Single>
