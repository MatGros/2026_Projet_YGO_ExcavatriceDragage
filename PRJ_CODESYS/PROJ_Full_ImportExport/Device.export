            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ⚙️ ST_BucketHMI — Données d'échange IHM pour la benne (M2)
///   ───────────────────────────────────────────────────────────────
///   📄 Structuration en Cmd / State / Cfg / Bypass , homogène avec ST_WinchHMI.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_BucketHMI :
STRUCT
