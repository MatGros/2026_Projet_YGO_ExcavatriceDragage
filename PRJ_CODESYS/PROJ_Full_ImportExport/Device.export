        <Single Name="Name" Type="string">GVL_PERSISTENT</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">261bd6e6-249c-4232-bb6f-84c2fbeef430</Single>
