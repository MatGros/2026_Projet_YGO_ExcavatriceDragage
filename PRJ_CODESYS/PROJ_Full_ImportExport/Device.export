        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Encoder_Safety — Bornage physique &amp; relais incohérence redémarrage
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF/AF_Partie-09_Fonction_Encoder_v2.1.md §3.6/§3.7
///                   DOC/AF/AF_Partie-03_Contrats_Composants_v2.1.md
///   🎯 Rôle :
///      - Bornage absolu [-99.00 ; +99.00] m (CablePosMSafe gelée sur dernière valeur plausible).
///      - Relais de HomingSuspect (ErrorId bit1).
///      - Expose EncoderIncoherent (= Error) consommé par FB_Modes.
///   ═══════════════════════════════════════════════════════════════
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Safety) ===
FUNCTION_BLOCK FB_Encoder_Safety
VAR_INPUT
	///Standard
	Enable: BOOL;
	///Acquittement défaut (front) — bit0 uniquement (bit1 suit HomingSuspect, voir §7bis)
	Reset: BOOL;
	///Standard
	PowerContactorEngaged: BOOL;
	///Standard (contexte, pas encore exploité ce lot)
	Mode: E_Mode;
	///Sortie FB_Encoder_Scale DE CE TREUIL
	CablePosM: REAL;
	///Sortie FB_Encoder_Homing DE CE TREUIL (§3.7, déjà calculé)
	HomingSuspect: BOOL;
	///Bornage physique dur (Partie10 §3.6)
	PositionMinM: REAL := -99;
	PositionMaxM: REAL := 99;
	///🌐 Force ErrorId=0, ignore bornage (mise en service)
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0: "Position câble hors plage" - position hors plage physique ; bit1: "Incohérence position boot" - incohérence redémarrage (miroir HomingSuspect)
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///CablePosM gelée sur dernière valeur plausible si hors plage
	CablePosMSafe: REAL;
	///= Error — consommé par FB_Modes (refuse SEMI_AUTO)
	EncoderIncoherent: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	LastPlausibleCablePosM: REAL;
END_VAR
</Single>
