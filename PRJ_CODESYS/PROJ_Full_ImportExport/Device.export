            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🏗️ ST_HwWinch — Image matérielle brute des entrées Treuils M1 / M2
///   ───────────────────────────────────────────────────────────────
///   📄 Lot L5 (Frontière unique HwIn)
///   🎨 Regroupe les signaux physiques d'entrée bruts des treuils M1 et M2.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_HwWinch :
STRUCT
	///Retours contacteurs M1 retombés
	M1_ContactorsReleased_DI: BOOL;
	///Thermique moteur M1 OK
	M1_ThermalOk_DI: BOOL;
	///Retour frein M1 (1 = ouvert)
	M1_BrakeIsOpen_DI: BOOL;
	///Retours contacteurs M2 retombés
	M2_ContactorsReleased_DI: BOOL;
	///Thermique moteur M2 OK
	M2_ThermalOk_DI: BOOL;
	///Retour frein M2 (1 = ouvert)
	M2_BrakeIsOpen_DI: BOOL;
	///Capteur position haute commun M1/M2 libre
	M1M2_TopPositionFree_DI: BOOL;
	///Capteur mou de câble M2 (câble tendu)
	M2_TensionedCable_DI: BOOL;
	///Valeur brute position codeur COD1 (M1)
	COD1_PosValue: UDINT;
	///Alarmes brutes COD1
	COD1_Alarms: UINT;
	///Avertissements bruts COD1
	COD1_Warnings: UINT;
	///État device COD1 (GetDeviceState)
	COD1_DeviceState: DEVICE_STATE;
	///Valeur brute position codeur COD2 (M2)
	COD2_PosValue: UDINT;
	///Alarmes brutes COD2
	COD2_Alarms: UINT;
	///Avertissements bruts COD2
	COD2_Warnings: UINT;
	///État device COD2 (GetDeviceState)
	COD2_DeviceState: DEVICE_STATE;
END_STRUCT
END_TYPE
</Single>
