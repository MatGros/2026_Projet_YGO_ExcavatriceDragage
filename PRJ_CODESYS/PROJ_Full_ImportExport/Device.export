            <Single Name="TextBlobForSerialisation" Type="string">
// === IMPLEMENTATION ===
TrigRising(CLK := Signal);
TrigFalling(CLK := Signal);

IF NOT Arm THEN
    Count := 0;
    InRange := FALSE;
    RETURN;
END_IF;

IF CountRising AND TrigRising.Q THEN
    Count := Count + 1;
ELSIF NOT CountRising AND TrigFalling.Q THEN
    Count := Count + 1;
END_IF;

InRange := (Count &gt;= ExpectedMin AND Count &lt;= ExpectedMax);
</Single>
