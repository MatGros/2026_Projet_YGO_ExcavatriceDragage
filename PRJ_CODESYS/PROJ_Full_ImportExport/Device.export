      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   ST_WinchCfg — Configurations et paramètres réglables pour un Treuil M1/M2
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné au paramétrage et calibration depuis l'IHM (RETAIN).
///   ═══════════════════════════════════════════════════════════════
TYPE ST_WinchCfg :
STRUCT
	///📐 Position cible du capteur haut (m)
	CfgTopSensorPos_M: REAL := 8.5;
	///Cible libre Homing unitaire MAINT_N2 [-99..+99 m]
	CfgHomingTarget_M: REAL := 0;
	///📈 Rampe d'accélération (%/s)
	CfgRampAccelRate: REAL := 50;
	///📉 Rampe de décélération normale (%/s)
	CfgRampDecelNormalRate: REAL := 150;
	///⚡ Rampe de décélération rapide / SafeStop (%/s)
	CfgRampDecelFastRate: REAL := 400;
	///📐 Limite basse physique de descente (m, négatif)
	CfgCableLimitDescent_M: REAL := -20;
	///🚦 Flag restauration boot — défaut FALSE non ambigu
	///🚦 TRUE = config restaurée depuis GVL_PERSISTENT ce boot
	Initialized: BOOL := FALSE;
END_STRUCT
END_TYPE
</Single>
