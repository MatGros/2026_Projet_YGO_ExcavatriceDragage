        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639230302276975956</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

{region "§1 Gate neutralisation"}
// 🛑 1. GATE
IF NOT Enable THEN
    ContactorMismatch := FALSE;
    MismatchActive := FALSE;
    MismatchTimer(IN := FALSE);
    RETURN;
END_IF;
{endregion}

{region "§2 Detection discordance"}
// 🔍 2. COHÉRENCE DES COMMANDES SÉCURITÉ — verifie que les commandes envoyees
// aux deux treuils sont identiques (sens et contacteurs).
// Filtre de 500ms pour tolerer les transitions et rampes.
IF NOT BypassGlobal THEN
    MismatchActive := SyncEnable AND (
        (RelayFwdM1 &lt;&gt; RelayFwdM2) OR
        (RelayRevM1 &lt;&gt; RelayRevM2) OR
        (Contactor1_M1 &lt;&gt; Contactor1_M2) OR
        (Contactor2_M1 &lt;&gt; Contactor2_M2) OR
        (Contactor3_M1 &lt;&gt; Contactor3_M2) OR
        (Contactor4_M1 &lt;&gt; Contactor4_M2)
    );
    MismatchTimer(IN := MismatchActive, PT := T#500ms);
    ContactorMismatch := MismatchTimer.Q;
ELSE
    ContactorMismatch := FALSE;
    MismatchActive := FALSE;
    MismatchTimer(IN := FALSE);
END_IF;
{endregion}
</Single>
            <Single Name="LineInfoPersistence" Type="string">afd229de-316d-5899-8a37-8c30dbfd06db_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🔀 FB_SyncContactor — Coherence commandes/contacteurs M1/M2
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Detecter une discordance entre les commandes/contacteurs des
///      2 treuils (sens + paliers). Independante des codeurs — surveillable
///      meme si les codeurs sont bypasses.
///   🔌 Interface : Bloc de surveillance transverse (1 instance)
///   🔒 Polarite : ContactorMismatch = TRUE si discordance confirmee.
///   📄 Doc : DOC/AF/AF_Partie-10_Fonction_Winch_v2.0.md
///   =======================================================================
FUNCTION_BLOCK FB_SyncContactor
VAR_INPUT
	///=== COMMANDES ET CONSIGNES ===
	///--&gt; [CMD] Validation surveillance globale
	Enable: BOOL;
	///--&gt; [CMD] Acquittement defaut sur front
	Reset: BOOL;
	///--&gt; [CMD] Autorisation utilisateur synchro
	SyncEnable: BOOL;
	///=== COMMANDES ET FEEDBACKS ACTIONS ===
	///--&gt; [HW] Feedback/Ordre montee M1
	RelayFwdM1: BOOL;
	///--&gt; [HW] Feedback/Ordre montee M2
	RelayFwdM2: BOOL;
	///--&gt; [HW] Feedback/Ordre descente M1
	RelayRevM1: BOOL;
	///--&gt; [HW] Feedback/Ordre descente M2
	RelayRevM2: BOOL;
	///--&gt; [HW] Contacteur palier 1 M1
	Contactor1_M1: BOOL;
	///--&gt; [HW] Contacteur palier 1 M2
	Contactor1_M2: BOOL;
	///--&gt; [HW] Contacteur palier 2 M1
	Contactor2_M1: BOOL;
	///--&gt; [HW] Contacteur palier 2 M2
	Contactor2_M2: BOOL;
	///--&gt; [HW] Contacteur palier 3 M1
	Contactor3_M1: BOOL;
	///--&gt; [HW] Contacteur palier 3 M2
	Contactor3_M2: BOOL;
	///--&gt; [HW] Contacteur palier 4 M1
	Contactor4_M1: BOOL;
	///--&gt; [HW] Contacteur palier 4 M2
	Contactor4_M2: BOOL;
	///=== BYPASSES ET SIMULATION ===
	///--&gt; [TST] Neutralise la surveillance contacteurs
	BypassGlobal: BOOL := FALSE;
END_VAR
VAR_OUTPUT
	///=== RESULTAT ===
	///&lt;-- [SAFE] Discordance commande/contacteurs confirmee
	ContactorMismatch: BOOL;
END_VAR
VAR
	///=== DETECTEURS ET TIMERS INTERNES ===
	///. [LOC] Tempo filtrage incoherence commande
	MismatchTimer: TON;
	///=== VARIABLES LOCALES INTERNES ===
	///. [LOC] Discordance commande active
	MismatchActive: BOOL;
END_VAR
</Single>
