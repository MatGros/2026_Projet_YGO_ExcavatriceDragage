      <Single Name="Object" Type="{ffbfa93a-b94d-45fc-a329-229860183b1d}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 GVL_PLC_Tests — Variables globales du banc de validation
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure de données pour l'IHM et rapports de tests
///      conformément à la spécification v1.2 de l'AF Partie 14.
///   ═══════════════════════════════════════════════════════════════
{attribute 'qualified_only' := ''}
VAR_GLOBAL
	///🎮 Commandes de pilotage des tests
	Cmd: ST_PlcTestsCmd;
	///🚦 Progression et statut des tests
	Status: ST_PlcTestsStatus;
	EventLog: ARRAY[1..GVL_PLC_Tests_Const.MaxTestEvents] OF ST_TestEvent;
	EventCount: INT;
	EventSequence: UDINT;
	EventOverflow: BOOL;
	///📊 Rapports par suite — 1 variable NOMMÉE par suite (pas de tableau générique,
	///choix utilisateur 2026-07-16) : chaque nouvelle suite ajoute SA variable ici
	///(ex. SuiteWinchValidation à venir), jamais un index à retenir.
	///Rapport de la suite Safety
	SuiteSafetyValidation: ST_TestSuiteReport;
	///Rapport de la suite Translation M3
	SuiteTranslationValidation: ST_TestSuiteReport;
	///Rapport de la suite Bucket
	SuiteBucketValidation: ST_TestSuiteReport;
	///Rapport de la suite Codeurs/Homing nominal
	SuiteEncoderValidation: ST_TestSuiteReport;
	///Rapport de la suite Modes/Homme-mort (post-IHM_MANU)
	SuiteModesValidation: ST_TestSuiteReport;
	///⚡ Surcharges (overrides) physiques lues par PRG_00_Inputs — chaîne Safety AU
	///Force la boucle AU à TRUE
	OverrideChainTrue: BOOL;
	///Force la boucle AU à FALSE
	OverrideChainFalse: BOOL;
	///Force le retour contacteur à FALSE
	OverrideContactorFalse: BOOL;
	///⚡ Surcharges (overrides) physiques lues par PRG_00_Inputs — Translation M3
	///(niveau capteur amont uniquement, jamais une sortie de commande calculée — voir
	///AF_Partie-14 §7.3.2/§7.5.5)
	///Force TranslationPosTremie (Fdc extrême avant) à TRUE
	OverrideM3AtTremie: BOOL;
	///Force M3BrakeFeedback (retour bobine) à TRUE (desserré) — simule Méca B
	OverrideM3BrakeStuckOpen: BOOL;
	///Force M3_ActualFrequencyHz_Filtered à 1.00Hz malgré arrêt commandé — simule Méca A
	OverrideM3PhantomFreq: BOOL;
	///🆕 REX 2026-07-18 : force directement les 5 capteurs position M3 depuis un mot de test —
	///seul moyen de tester les 6 mots valides ET les combinaisons incohérentes indépendamment
	///du temps de trajet simulé (FB_Sim_Translation). bit4=Trémie,bit3=PV,bit2=P2,bit1=P1,bit0=Maintenance.
	///TRUE = force les 5 capteurs depuis OverrideM3SensorsWord
	OverrideM3SensorsWordActive: BOOL;
	///Mot de test (voir FB_Translation_PositionDecoder)
	OverrideM3SensorsWord: BYTE;
	///⚡ Surcharges (overrides) physiques — Bucket
	///Simule glissement modéré M1 (1.5m)
	OverrideM1Slip: BOOL;
	///Simule glissement critique M1 (2.5m)
	OverrideM1SlipCritical: BOOL;
	///Simule blocage mécanique M2 (position figée)
	OverrideM2Stuck: BOOL;
	///Simule dérive position M2 au démarrage (Boot)
	OverrideM2BootDrift: BOOL;
	///⚡ Surcharges (overrides) — Joystick (SUITE_MODES, 2026-07-19, voir FB_Sim_Joystick)
	///TRUE = RawX/Y/Button pilotés par les 3 champs suivants
	OverrideJoystickActive: BOOL;
	///Débattement axe X simulé (5000=neutre, 10000=fond)
	OverrideJoystickRawX: INT;
	///Débattement axe Y simulé (5000=neutre, 10000=fond)
	OverrideJoystickRawY: INT;
	///Appui homme-mort simulé
	OverrideJoystickRawButton: BOOL;
END_VAR</Single>
