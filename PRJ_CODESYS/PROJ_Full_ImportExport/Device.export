          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   📡 ST_NetworkDiagHMI — Données d'échange IHM pour les diagnostics réseau
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage des diagnostics CANopen et EtherCAT.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_NetworkDiagHMI :
STRUCT
	///📡 Diagnostics bus CANopen
	BusCanOpen: ST_DeviceDiag;
	///🕹️ Diagnostics esclave Joystick
	Joystick: ST_DeviceDiag;
	///⚠️ Anomalie CANopen
	CanError: BOOL;
	///❌ Code anomalie CANopen
	CanErrorId: WORD;
	///📡 Diagnostics bus EtherCAT
	BusEthercat: ST_DeviceDiag;
	///🧲 Diagnostics esclave COD1
	EncoderM1: ST_DeviceDiag;
	///🧲 Diagnostics esclave COD2
	EncoderM2: ST_DeviceDiag;
	///↔️ Diagnostics esclave AC600
	VariateurM3: ST_DeviceDiag;
	///⚠️ Anomalie EtherCAT
	EcatError: BOOL;
	///❌ Code anomalie EtherCAT
	EcatErrorId: WORD;
END_STRUCT
END_TYPE
</Single>
