        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639183899232095590</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// 1. Filtrage de la vitesse brute pour éviter les déclenchements intempestifs sur pic de com
Filter(ValueIn := INT_TO_REAL(RawSpeed), TimeConst := SpeedFilterTime, CycleTimeS := CycleTimeS);
FilteredSpeed := Filter.ValueOut;

// 2. Surveillance du seuil critique (survitesse positive ou négative)
IF ABS(FilteredSpeed) &gt;= INT_TO_REAL(MaxSpeedLimit) THEN
    OverspeedTrip := TRUE; // Interlock / Trip à verrouiller dans votre sécurité machine
ELSE
    OverspeedTrip := FALSE;
END_IF</Single>
            <Single Name="LineInfoPersistence" Type="string">04b798f6-14ef-4194-a8bf-4a7a0caac245_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK FB_Encoder_Safety
VAR_INPUT
    RawSpeed        : INT;  // Vitesse brute du bus (%IW6)
    MaxSpeedLimit   : INT;  // Seuil critique de survitesse (en pts de vitesse)
    SpeedFilterTime : TIME := T#100ms;
    CycleTimeS      : REAL;
END_VAR
VAR_OUTPUT
    OverspeedTrip   : BOOL; // Ordre d'arrêt d'urgence / Freinage d'urgence
    FilteredSpeed   : REAL; // Vitesse lissée pour monitoring IHM
END_VAR
VAR
    Filter          : FB_Filter_PT1; // Réutilisation du filtre POO
END_VAR</Single>
