    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">69c17808-0a2e-5cda-8135-4bc53222fe41</Single>
        <Single Name="ParentGuid" Type="System.Guid">103fbab6-1b12-4ccb-9cc6-6c66cad0e1cb</Single>
        <Single Name="Name" Type="string">FB_Encoder_Safety</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties">
          <Entry>
            <Key>
              <Single Type="System.Guid">24568a24-c491-472c-a21f-ee5d33859fab</Single>
            </Key>
            <Value>
              <Single Type="{24568a24-c491-472c-a21f-ee5d33859fab}" Method="IArchivable">
                <Single Name="MemoryReserveForOnlineChange" Type="int">0</Single>
                <Single Name="ExcludeFromBuild" Type="bool">False</Single>
                <Single Name="External" Type="bool">False</Single>
                <Single Name="EnableSystemCall" Type="bool">False</Single>
                <Single Name="CompilerDefines" Type="string"></Single>
                <Single Name="LinkAlways" Type="bool">False</Single>
                <Array Name="Undefines" Type="string" />
              </Single>
            </Value>
          </Entry>
          <Entry>
            <Key>
              <Single Type="System.Guid">829a18f2-c514-4f6e-9634-1df173429203</Single>
            </Key>
            <Value>
              <Single Type="{829a18f2-c514-4f6e-9634-1df173429203}" Method="IArchivable">
                <Dictionary Type="{fa2ee218-a39b-4b6d-b249-49dbddbd168a}" Name="ParentObjects">
                  <Entry>
                    <Key>
                      <Single Type="System.Guid">d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84</Single>
                    </Key>
                    <Value>
                      <Single Type="System.Guid">9d6f36eb-f02d-4639-b32c-834e4caacd50</Single>
                    </Value>
                  </Entry>
                </Dictionary>
              </Single>
            </Value>
          </Entry>
        </Dictionary>
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639197103389659747</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Encoder_Safety) ===

// 🛑 1. GATE — expose la dernière valeur plausible connue même désactivé
IF NOT Enable THEN
    Ready := FALSE; Busy := FALSE; Done := FALSE;
    State := E_State.DISABLED;
    CablePosMSafe := LastPlausibleCablePosM;
    EncoderIncoherent := FALSE;
    RETURN;
END_IF;

Ready := TRUE;
State := E_State.READY;

// 🔑 2. RESET FRONT
ResetEdge(CLK := Reset);

// 🔍 3. BORNAGE PHYSIQUE ABSOLU (§3.6) — bit0
IF (CablePosM &lt; PositionMinM) OR (CablePosM &gt; PositionMaxM) THEN
    ErrorId := ErrorId OR 16#0001;
ELSIF ResetEdge.Q THEN
    ErrorId := ErrorId AND 16#FFFE;
END_IF;

// 🔍 4. RELAIS INCOHÉRENCE REDÉMARRAGE (§3.7, calculée par FB_Encoder_Homing) — bit1
// Pas d'acquittement ici : la levée se fait via ConfirmCoherence/nouveau Home côté
// FB_Encoder_Homing (source), ce FB ne fait QUE relayer l'information pour FB_Modes.
IF HomingSuspect THEN
    ErrorId := ErrorId OR 16#0002;
ELSE
    ErrorId := ErrorId AND 16#FFFD;
END_IF;

// 🧊 5. GELER SUR DOUTE (§6) — CablePosMSafe ne suit PAS CablePosM si hors plage
IF (ErrorId AND 16#0001) = 16#0000 THEN
    LastPlausibleCablePosM := CablePosM;
END_IF;
CablePosMSafe := LastPlausibleCablePosM;

// 📤 6. SORTIES ÉTAT
Error := (ErrorId &lt;&gt; 16#0000);
ErrorEdge(CLK := Error);
IF ErrorEdge.Q THEN
    StateAtError := State;
END_IF;

EncoderIncoherent := Error;
Busy := FALSE;
Done := FALSE;
</Single>
            <Single Name="LineInfoPersistence" Type="string">69c17808-0a2e-5cda-8135-4bc53222fe41_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🛡️ FB_Encoder_Safety — Bornage physique + relais incohérence redémarrage (1 par treuil)
///   ───────────────────────────────────────────────────────────────
///   📄 Doc métier : DOC/AF_Partie10_Fonction_Encoder_Homing_v1.6.md §3.6/§3.7
///   🔌 FB STANDARD (Partie3 §1bis) : pas un FB de mouvement, pas de StartStop/SafeStop.
///   🎯 PÉRIMÈTRE CE LOT (répond à l'incident CablePosM≈4096m après reset RETAIN) :
///      - §3.6 Bornage absolu [-99.00 ; +99.00] m : `CablePosM` hors plage → valeur
///        jugée IMPOSSIBLE, sortie `CablePosMSafe` GELÉE sur dernière valeur plausible
///        (principe « geler sur doute », §6), ErrorId bit0.
///      - §3.7 Relais de `HomingSuspect` (déjà détecté par `FB_Encoder_Homing`, jamais
///        consommé nulle part avant ce lot) : ErrorId bit1.
///      - `EncoderIncoherent` (= Error) → consommé par `FB_Modes` pour REFUSER
///        `SEMI_AUTO` (reste possible de travailler en MAINT_N1/N2 pour re-référencer,
///        voir échange utilisateur — PAS de SafeStop ici, ne bloque jamais le mouvement).
///   🔴 HORS PÉRIMÈTRE CE LOT (Partie10 §3.5, reporté) : détection de saut EN COURS
///      D'EXPLOITATION (plausibilité vitesse codeur, calcul sur cycles EtherCAT 4ms) —
///      lot dédié à part entière, pas fait ici.
///   ═══════════════════════════════════════════════════════════════
///=== DECLARATION (à coller dans la partie déclaration du POU FB_Encoder_Safety) ===
FUNCTION_BLOCK FB_Encoder_Safety
VAR_INPUT
	///Standard
	Enable: BOOL;
	///Acquittement défaut (front) — bit0 uniquement (bit1 suit HomingSuspect, voir §7bis)
	Reset: BOOL;
	///Standard
	EmergencyStopOk: BOOL;
	///Standard (contexte, pas encore exploité ce lot)
	Mode: E_Mode;
	///Sortie FB_Encoder_Scale DE CE TREUIL
	CablePosM: REAL;
	///Sortie FB_Encoder_Homing DE CE TREUIL (§3.7, déjà calculé)
	HomingSuspect: BOOL;
	///Bornage physique dur (Partie10 §3.6)
	PositionMinM: REAL := -99;
	PositionMaxM: REAL := 99;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0 : position hors plage physique ; bit1 : incohérence redémarrage (miroir HomingSuspect)
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///CablePosM gelée sur dernière valeur plausible si hors plage
	CablePosMSafe: REAL;
	///= Error — consommé par FB_Modes (refuse SEMI_AUTO)
	EncoderIncoherent: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	LastPlausibleCablePosM: REAL;
END_VAR
</Single>
