      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">

// === IMPLEMENTATION (à coller dans le corps ST du POU FB_Input) ===

// 1. Inversion NO/NC
ValueRaw := InputRaw XOR InvertLogic;

// 2. Filtrage anti-rebond — ne valide le changement d'état qu'après FilterTime stable
FilterTon(IN := (ValueRaw &lt;&gt; State), PT := FilterTime);
IF FilterTon.Q THEN
    State := ValueRaw;   // Une fois à jour, IN redevient FALSE au cycle suivant (ValueRaw=State)
END_IF;

// 3. Diagnostic voie/carte
IF NOT ChannelOk THEN
    ErrorId := ErrorId OR 16#0001;
    State := FALSE;   // État sûr forcé (Partie6 §1)
ELSE
    ErrorId := ErrorId AND 16#FFFE;
END_IF;

Error := (ErrorId &lt;&gt; 16#0000);
</Single>
            <Single Name="LineInfoPersistence" Type="string">8edb8169-fe96-5561-81ca-d3258d6bba57_Impl_LineIds</Single>
