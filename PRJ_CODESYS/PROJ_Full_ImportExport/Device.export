      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🕹️ ST_JoystickHMI — Données d'échange IHM pour le Joystick
///   ───────────────────────────────────────────────────────────────
///   🎨 Destiné à l'affichage et au contrôle du joystick depuis l'IHM.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_JoystickHMI :
STRUCT
	///🕹️ Axe X brut du joystick (0..10000)
	RawX: INT;
	///🕹️ Axe Y brut du joystick (0..10000)
	RawY: INT;
	///🔘 Bouton homme-mort brut
	RawButton: BOOL;
	///⚙️ Consigne d'axe X normalisée
	CmdX: ST_AxisCmd;
	///⚙️ Consigne d'axe Y normalisée
	CmdY: ST_AxisCmd;
	///📡 Liaison CAN joystick active
	Online: BOOL;
	///🟢 Joystick opérationnel
	Operational: BOOL;
	///🎯 Demande de recalage au neutre
	Calibrate: BOOL;
	///🔴 Joystick en défaut
	Error: BOOL;
	///❌ Code défaut joystick
	ErrorId: WORD;
END_STRUCT
END_TYPE
</Single>
