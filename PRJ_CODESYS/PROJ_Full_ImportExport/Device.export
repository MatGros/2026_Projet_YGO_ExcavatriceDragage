            <Single Name="TextBlobForSerialisation" Type="string">{attribute 'qualified_only' := ''}
{attribute 'strict' := ''}
TYPE E_DiagState :
(
	///Désactivé (surveillance non active)
	DISABLED := 0,
	///Prêt (opérationnel réel, pas de défaut)
	READY := 1,
	///Initialisation en cours / Recherche de réseau
	INIT := 2,
	///Surveillance active (états transitoires)
	MONITORING := 3,
	///Présence anomalie de communication
	///🆕 REX 2026-07-24 (demande utilisateur, mise en service) : distingue explicitement "bypassé
	///par simulation/bypass réseau IHM" de READY (réellement online) — évite la confusion vue en
	///mise en service (PLC affichait Operational=1 sans indiquer que c'était un bypass, pas le bus réel).
	ERROR := 4,
	///Bypass simulation (Bus&lt;Device&gt;IsReal=FALSE) ou bypass réseau IHM actif — pas le bus réel
	SIMULATED := 5
);
END_TYPE
</Single>
