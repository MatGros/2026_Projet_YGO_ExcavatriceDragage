            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///🧪 ST_PlcTestsCmd — Commandes de pilotage du banc de validation
///═══════════════════════════════════════════════════════════════
TYPE ST_PlcTestsCmd :
STRUCT
	///Commandes unitaires : une seule suite manuelle à la fois.
	///Lance la suite Safety
	RunSafety: BOOL;
	///Lance la suite Translation
	RunTranslation: BOOL;
	///Lance la suite Benne
	RunBucket: BOOL;
	///Lance la suite Codeurs/Homing
	RunEncoder: BOOL;
	///Lance la suite Modes/Homme-mort
	RunModes: BOOL;
	///Lance la suite Heartbeat IHM↔PLC
	RunHeartbeat: BOOL;
	///Lance la suite Supervision/Persistance config
	RunSupervision: BOOL;
	///Lance l'autotest indépendant du framework
	RunFramework: BOOL;
	///Lance Safety→Translation→Bucket→Encoder→Modes→Heartbeat
	RunAll: BOOL;
	///Compatibilité : &gt;0 lance une suite manuelle
	RunSuite: INT;
	///Cas de la commande unitaire sélectionnée
	RunCase: INT;
	///Abandonne le test en cours
	Abort: BOOL;
	///Efface les rapports de tests
	ClearReport: BOOL;
END_STRUCT
END_TYPE
</Single>
