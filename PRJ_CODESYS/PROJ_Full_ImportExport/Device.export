      <Single Name="Object" Type="{ffbfa93a-b94d-45fc-a329-229860183b1d}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🎛️ GVL_IHM — Variables globales d'échange pour l'IHM
///   ───────────────────────────────────────────────────────────────
///   📄 Lot A : Mise en service et calibration de la machine de dragage.
///   💾 Déclaré en RETAIN pour la persistance des configurations opérateur.
///   ═══════════════════════════════════════════════════════════════
VAR_GLOBAL RETAIN
	///🛗 Variables d'échange IHM Treuil Retenue (M1)
	M1TreuilRetenue: ST_WinchHMI;
	///🛞️ Variables d'échange IHM Treuil Benne (M2) — type dédié avec Bucket (2026-08)
	M2TreuilBenne: ST_WinchBenneHMI;
	///⚖️ Variables d'échange IHM Surveillance de synchro
	M1M2Sync: ST_SyncHMI;
	///🕹️ Variables d'échange IHM Joystick (noeud CANopen JOY1)
	JOY1Joystick: ST_JoystickHMI;
	///🎚️ Variables d'échange IHM Modes de marche
	Modes: ST_ModesHMI;
	///↔️ Variables d'échange IHM Translation M3
	TranslationM3: ST_TranslationHMI;
	///🔄 Commandes, états et diagnostic cycle semi-automatique
	Cycle: ST_CycleHMI;
	///🪨 Assistance plongée/extraction MAINT_N1/N2
	DredgingAssist: ST_DredgingAssistHMI;
	///🖥️ Bandeau d'information et messages opérateur à 4 champs (AF-07 §4)
	Banner: ST_HmiBanner;
	///🎮 Unique consigne conduite, arbitré en supervision
	OperatorAction: ST_OperatorAction;
	///📡 Variables d'échange IHM Diagnostics réseau
	Network: ST_NetworkDiagHMI;
	///🌐 REX 2026-07-08 : signaux communs, pas propres à un axe (TopPositionSensorActive, BrakeThermalFault, LimitLegal)
	Commun: ST_CommunHMI;
	///🔧 REX 2026-07-19 : IHM_MANU (ST_IHM_MANU) supprimé définitivement — dispositif dérogatoire
	///de mise en service urgence (2026-07-09), remplacé par MAINT_N1/MAINT_N2 + joystick homme-mort.
	///Historique complet : ARCHIVES/Doc/IHM_MANU_Journal_Modifications.md.
	///🚩 Indicateur d'initialisation IHM depuis PERSISTENT
	HmiInitDone: BOOL;
END_VAR</Single>
