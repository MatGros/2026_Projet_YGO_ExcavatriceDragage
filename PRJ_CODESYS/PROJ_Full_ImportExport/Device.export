          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   🕹️ ST_Joystick_AxisCmd — Consigne d'axe normalisée (sortie FB_Joystick)
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure de consigne d'axe produite par FB_Joystick.
///   📤 Champs : Enable, StartStop, SpeedRef + direction en bits (DirectionPositive/Negative, AtNeutral).
///   📄 Doc métier : DOC/AF/AF_Partie-08_Fonction_Joystick_v2.0.md
///   =======================================================================
TYPE ST_Joystick_AxisCmd :
STRUCT
	///=== CONSIGNES DE PILOTAGE AXE ===
	///--&gt; [CMD] Autorisation globale pipeline (FALSE=neutralisation, sorties coupees)
	Enable: BOOL;
	///--&gt; [CMD] Validation de mouvement (TRUE=acceleration, FALSE=deceleration/arret)
	StartStop: BOOL;
	///--&gt; [CMD] Consigne vitesse non signee (0...100 %, signe/sens donné par Direction)
	SpeedRef: REAL;
	///--&gt; [CMD] Direction joystick ou intension de gestuelle
	DirectionNegative: BOOL;
	///--&gt; [CMD] Direction joystick ou intension de gestuelle
	DirectionPositive: BOOL;
	///--&gt; [CMD] TRUE si axes en zone morte (position centrale)
	AtNeutral: BOOL;
END_STRUCT
END_TYPE
</Single>
