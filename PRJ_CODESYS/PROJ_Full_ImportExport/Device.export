            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🧪 GVL_PLC_Tests_Const — Constantes de dimensionnement
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Définit les tailles limites des tables de tests
///      pour l'orchestrateur et le moteur de tests.
///   ═══════════════════════════════════════════════════════════════
{attribute 'qualified_only' := ''}
VAR_GLOBAL CONSTANT
	///par suite
	MaxTestCases: INT := 8;
	///par suite, table PLATE ; tous les StepId doivent rester &lt;= 64
	MaxSteps: INT := 64;
	///CheckTable par suite
	MaxChecks: INT := 64;
	MaxChecksPerStep: INT := 4;
	///actifs en parallèle
	MaxInvariants: INT := 4;
	MaxProbeBool: INT := 32;
	///INT/WORD/étapes séquenceur → conversion au câblage (WORD_TO_DINT)
	MaxProbeDint: INT := 16;
	///analogiques + TIME → REAL ms
	MaxProbeReal: INT := 16;
	///instances FB_TestStimulus par suite
	MaxAnalogStims: INT := 4;
	///plus gros poste mémoire par stim
	MaxSeqValues: INT := 8;
	///MainTask — base des mesures en cycles
	TaskCycleMs: INT := 10;
	///🛡️ garde-fou orchestrateur : 3 min maximum par suite
	MaxSuiteDurationMs: DINT := 180000;
	///journal circulaire des événements
	MaxTestEvents: INT := 32;
	///index de suite (Cmd.RunSuite)
	SuiteSafety: INT := 1;
	///index de suite Translation M3 (Cmd.RunSuite)
	SuiteTranslation: INT := 2;
	///index de suite Bucket (Cmd.RunSuite)
	SuiteBucket: INT := 3;
	///index de suite Codeurs/Homing nominal (Cmd.RunSuite)
	SuiteEncoder: INT := 4;
	///index de suite Modes/Homme-mort, post-suppression IHM_MANU (Cmd.RunSuite)
	SuiteModes: INT := 5;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">da9df60c-4ce8-5d19-b222-9ace41b88863_Decl_LineIds</Single>
          </Single>
        </Single>
