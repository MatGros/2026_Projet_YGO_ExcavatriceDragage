      <Single Name="Object" Type="{2db5746d-d284-4425-9f7f-2663a34b0ebc}" Method="IArchivable">
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///=======================================================================
///   📊 ST_Safety_Emergency_Diag — Diagnostic et erreurs de la chaîne AU
///   ───────────────────────────────────────────────────────────────
///   🎯 Rôle : Structure de diagnostic et erreurs de la chaîne d'arrêt d'urgence
///   🔌 Interface : Produit par FB_Safety_EmergencyManagement, consommé par Supervision/Troubleshooting
///   📄 Doc métier : DOC/AF/AF_Partie-01_Analyse_Fonctionnelle_v2.1.md
///   =======================================================================
TYPE ST_Safety_Emergency_Diag :
STRUCT
	///Synthese defaut active : (ErrorId &lt;&gt; 0)
	Error: BOOL;
	///Bitfield erreurs : bit0=Redundancy, bit1=Arming, bit3=Startup
	ErrorId: WORD;
	///Canal A ou B reste colle/shunte detecte a l'auto-test (Reset requis)
	RedundancyTestFailed: BOOL;
	///Impulsion envoyee mais contacteur puissance non confirme sous 2s (Reset requis)
	ArmFailed: BOOL;
	///Verrouillage temporel de 5s entre tentatives de rearmement echouees
	LockoutActive: BOOL;
	///Etape de la sequence AU lors du dernier abandon (0 a 6)
	LastAbortStep: INT;
	///Bitfield cause abandon : 16#0001=Cut IHM, 16#0002=Chute chaine pulse/confirm, 16#0004=Timeout A, 16#0008=Timeout B, 16#0010=PowerCutOff metier
	LastAbortCause: WORD;
END_STRUCT
END_TYPE
</Single>
