        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK PUBLIC FB_DiagEthercat
VAR_INPUT
    Enable          : BOOL;        // Active la surveillance EtherCAT
    Reset           : BOOL;        // Front acquittement défauts
    // Variateur M3 (AC600_ECAT_Drive)
    VariateurWcState : BOOL;       // Working Counter variateur (FALSE = OK)
    VariateurSlaveState : WORD;    // État esclave variateur (8 = OP)
    // Encodeur M1 (COD1_CODEUR)
    EncoderM1WcState : BOOL;       // Working Counter M1
    EncoderM1SlaveState : WORD;    // État esclave M1
    // Encodeur M2 (COD2_CODEUR)
    EncoderM2WcState : BOOL;       // Working Counter M2
    EncoderM2SlaveState : WORD;    // État esclave M2
END_VAR
VAR_OUTPUT
    Ready           : BOOL;        // Logique active
    Busy            : BOOL;        // Non utilisé
    Done            : BOOL;        // Non utilisé
    Error           : BOOL;        // Résumé anomalie bus
    ErrorId         : WORD;        // Code défaut résumé
    State           : E_DiagState; // Phase courante
    StateAtError    : E_DiagState; // Snapshot figé
	BusEthercat       : ST_DeviceDiag;  // Bus Ethercat
    // Sorties par device
    Variateur       : ST_DeviceDiag;  // AC600_ECAT_Drive (Translation/M3)
    EncoderM1       : ST_DeviceDiag;  // COD1_CODEUR (WinchM1)
    EncoderM2       : ST_DeviceDiag;  // COD2_CODEUR (WinchM2)
END_VAR
VAR
    ResetEdge       : R_TRIG;      // Détecteur front Reset
END_VAR</Single>
