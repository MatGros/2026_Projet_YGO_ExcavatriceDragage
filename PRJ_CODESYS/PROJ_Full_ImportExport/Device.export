            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════
///   🏗️ ST_HwMachine — Image matérielle brute des entrées communes Machine
///   ───────────────────────────────────────────────────────────────
///   📄 Lot L5 (Frontière unique HwIn)
///   🎨 Regroupe les signaux physiques d'entrée bruts communs à la machine.
///   ═══════════════════════════════════════════════════════════════
TYPE ST_HwMachine :
STRUCT
	///Confirm. contacteur puissance engagé
	PowerContactorEngaged_DI: BOOL;
	///Boucle AU fermée (coup-de-poing + contact PLC)
	EmergencyChainClosed_DI: BOOL;
	///Contrôle rotation phases élec. OK
	PhaseRotationOk_DI: BOOL;
	///Thermique frein M1/M2/M3 commun OK — 🆕 2026-08-12 : renommé depuis BrakeThermalOk_DI (Device_IO_20260812)
	M1_M2_M3_BrakeThermalOk_DI: BOOL;
	///Retour détecteur fond Kobold — 🆕 2026-08-12 : renommé depuis M1_M2_KoboldContactFond_DI (Device_IO_20260812)
	M1_M2_KoboldBottomTouch_DI: BOOL;
	///Thermique centrale hydraulique OK
	HydraulicThermalOk_DI: BOOL;
	///Autorisation démarrage crible (dépôt gravats)
	ConveyorInfeedReady_DI: BOOL;
	///🆕 2026-08-12 : Trémie pleine OU grille levée — pas encore câblé électriquement,
	HopperFull_OR_GateRaised_DI: BOOL;
END_STRUCT
END_TYPE
</Single>
