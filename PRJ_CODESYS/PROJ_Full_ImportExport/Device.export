        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">///═══════════════════════════════════════════════════════════════════════════════
///   📊 FB_WinchLoadEstimator — Estimation empirique de charge treuil
///   ═══════════════════════════════════════════════════════════════════════════════
///   🧩 Brique de diagnostic/information, sans commande moteur et sans SafeStop.
///   🎯 Croise le palier commandé et la bande de vitesse mesurée pour lire une
///      estimation dans ST_WinchLoadEstimateTable.
///   ⚠️ La table doit être explicitement marquée IsConfigured : sinon la sortie
///      reste à 0 % et Configured reste FALSE.
///   ═══════════════════════════════════════════════════════════════════════════════
FUNCTION_BLOCK FB_WinchLoadEstimator
VAR_INPUT
	Enable: BOOL;
	Reset: BOOL;
	EmergencyStopOk: BOOL;
	Mode: E_Mode;
	///Palier commandé 0..5
	ActiveSpeedStep: INT;
	///Vitesse câble absolue
	MeasuredSpeedMps: REAL;
	///Plages vitesse mesurée
	SpeedConfig: ST_WinchSpeedConfig;
	///Table empirique 5x5
	LoadTable: ST_WinchLoadEstimateTable;
END_VAR
VAR_OUTPUT
	Ready: BOOL;
	Busy: BOOL;
	Done: BOOL;
	Error: BOOL;
	///bit0 : entrée/table invalide
	ErrorId: WORD;
	State: E_State;
	StateAtError: E_State;
	///Bande vitesse courante 0..5
	SpeedBand: INT;
	///Estimation informative 0..100 %
	EstimatedLoadPct: REAL;
	///TRUE si table explicitement validée
	Configured: BOOL;
END_VAR
VAR
	ResetEdge: R_TRIG;
	ErrorEdge: R_TRIG;
	PreviousSpeedBand: INT;
	HasPreviousBand: BOOL;
	SelectedLoadPct: REAL;
END_VAR
</Single>
