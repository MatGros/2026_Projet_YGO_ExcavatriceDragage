    ASSERT_FALSE(fb.STATUS.DIAG.ERROR, 'Reset doit effacer l affichage du defaut');
    ASSERT_EQ(fb.STATUS.STATE.STEP, 0, 'Reset seul ne relance jamais de sequence (pas de redemarrage auto)');
