TEST 'TC-P01-023 Etape invalide -> abandon trace et lockout'
    fb(ENABLE := TRUE, RESET := FALSE, ARMREQUEST := FALSE, POWERCUTOFFREQUEST := FALSE,
       BTNEMERGENCYCUTOFF := FALSE, EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE);
    fb(ENABLE := TRUE, RESET := FALSE, ARMREQUEST := FALSE, POWERCUTOFFREQUEST := FALSE,
       BTNEMERGENCYCUTOFF := FALSE, EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE);

    fb.ARMINGSEQSTEP := 7;
    ADVANCE_TIME(10000000);
    fb(ENABLE := TRUE, RESET := FALSE, ARMREQUEST := FALSE, POWERCUTOFFREQUEST := FALSE,
       BTNEMERGENCYCUTOFF := FALSE, EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE);
    fb(ENABLE := TRUE, RESET := FALSE, ARMREQUEST := FALSE, POWERCUTOFFREQUEST := FALSE,
       BTNEMERGENCYCUTOFF := FALSE, EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE);

    ASSERT_EQ(fb.STATUS.STATE.STEP, 0, 'etape inconnue -> IDLE');
    ASSERT_EQ(fb.STATUS.DIAG.LASTABORTSTEP, 7, 'etape inconnue tracee');
    ASSERT_EQ(fb.STATUS.DIAG.LASTABORTCAUSE, 256, 'cause = CST_ABORT_INVALID_STEP');
    ASSERT_TRUE(fb.STATUS.DIAG.LOCKOUTACTIVE, 'etape inconnue -> lockout');
    ASSERT_FALSE(fb.CMD.ARMPULSE_CMD, 'etape inconnue -> aucune impulsion');
    ASSERT_EQ(fb.STATUS.OPERATORMESSAGE, 'AU: etape sequence invalide - verifier puis Reset', 'etape inconnue -> message explicite');
END_TEST


