(* =======================================================================
   TC-P06-007 — Preflight passif machine arrêtée : masque ErrorId bit à bit.
   Fiche : DOC/AF/AF_Partie-06_Fonction_Acquisition_Qualification_IO/
           FB_Acquisition_Preflight_v1.3.md §2 (TC-P06-007).
   Chaque front Execute + MachineIsStill=TRUE agrège les 16 contrôles dans
   PreflightErrorId. On injecte chaque défaut un à un et on vérifie le bit
   correspondant (bit0..15). Tous à 0 -> PreflightOk=TRUE ; chaque bit posé
   -> PreflightOk=FALSE.
   ======================================================================= *)

TEST 'TC-P06-007 Preflight passif : masque ErrorId bit a bit (bits 0..15)'
    (* ── Etat sain de reference : tous les controles OK ── *)
    fb(EXECUTE := TRUE, MACHINEISSTILL := TRUE,
       M1BRAKEAPPLIED := TRUE, M2BRAKEAPPLIED := TRUE, M3BRAKEAPPLIED := TRUE,
       M1CONTACTORSRELEASED := TRUE, M2CONTACTORSRELEASED := TRUE,
       M1THERMALOK := TRUE, M2THERMALOK := TRUE, BRAKETHERMALOK := TRUE, PHASEROTATIONOK := TRUE,
       SLACKCABLETENSIONED := TRUE, M3SENSORWORDINCOHERENT := FALSE,
       EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE,
       ENCODERM1OPERATIONAL := TRUE, ENCODERM2OPERATIONAL := TRUE,
       HOMEDM1 := TRUE, HOMEDM2 := TRUE, M1POSITIONINBOUNDS := TRUE, M2POSITIONINBOUNDS := TRUE);
    ASSERT_TRUE(fb.PREFLIGHTOK, 'tous les controles sains -> PreflightOk=TRUE');
    ASSERT_EQ(fb.PREFLIGHTERRORID, 0, 'aucun defaut -> ErrorId=0');

    (* ── bit0 : frein M1 non serre ── *)
    fb(EXECUTE := FALSE, MACHINEISSTILL := TRUE,
       M1BRAKEAPPLIED := TRUE, M2BRAKEAPPLIED := TRUE, M3BRAKEAPPLIED := TRUE,
       M1CONTACTORSRELEASED := TRUE, M2CONTACTORSRELEASED := TRUE,
       M1THERMALOK := TRUE, M2THERMALOK := TRUE, BRAKETHERMALOK := TRUE, PHASEROTATIONOK := TRUE,
       SLACKCABLETENSIONED := TRUE, M3SENSORWORDINCOHERENT := FALSE,
       EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE,
       ENCODERM1OPERATIONAL := TRUE, ENCODERM2OPERATIONAL := TRUE,
       HOMEDM1 := TRUE, HOMEDM2 := TRUE, M1POSITIONINBOUNDS := TRUE, M2POSITIONINBOUNDS := TRUE);
    fb(EXECUTE := TRUE, MACHINEISSTILL := TRUE,
       M1BRAKEAPPLIED := FALSE, M2BRAKEAPPLIED := TRUE, M3BRAKEAPPLIED := TRUE,
       M1CONTACTORSRELEASED := TRUE, M2CONTACTORSRELEASED := TRUE,
       M1THERMALOK := TRUE, M2THERMALOK := TRUE, BRAKETHERMALOK := TRUE, PHASEROTATIONOK := TRUE,
       SLACKCABLETENSIONED := TRUE, M3SENSORWORDINCOHERENT := FALSE,
       EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE,
       ENCODERM1OPERATIONAL := TRUE, ENCODERM2OPERATIONAL := TRUE,
       HOMEDM1 := TRUE, HOMEDM2 := TRUE, M1POSITIONINBOUNDS := TRUE, M2POSITIONINBOUNDS := TRUE);
    ASSERT_EQ(fb.PREFLIGHTERRORID, 16#0001, 'bit0 : frein M1 desserre');
    ASSERT_FALSE(fb.PREFLIGHTOK, 'bit0 pose -> PreflightOk=FALSE');

    (* ── bit1 : frein M2 non serre ── *)
    fb(EXECUTE := FALSE, MACHINEISSTILL := TRUE,
       M1BRAKEAPPLIED := TRUE, M2BRAKEAPPLIED := TRUE, M3BRAKEAPPLIED := TRUE,
       M1CONTACTORSRELEASED := TRUE, M2CONTACTORSRELEASED := TRUE,
       M1THERMALOK := TRUE, M2THERMALOK := TRUE, BRAKETHERMALOK := TRUE, PHASEROTATIONOK := TRUE,
       SLACKCABLETENSIONED := TRUE, M3SENSORWORDINCOHERENT := FALSE,
       EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE,
       ENCODERM1OPERATIONAL := TRUE, ENCODERM2OPERATIONAL := TRUE,
       HOMEDM1 := TRUE, HOMEDM2 := TRUE, M1POSITIONINBOUNDS := TRUE, M2POSITIONINBOUNDS := TRUE);
    fb(EXECUTE := TRUE, MACHINEISSTILL := TRUE,
       M1BRAKEAPPLIED := TRUE, M2BRAKEAPPLIED := FALSE, M3BRAKEAPPLIED := TRUE,
       M1CONTACTORSRELEASED := TRUE, M2CONTACTORSRELEASED := TRUE,
       M1THERMALOK := TRUE, M2THERMALOK := TRUE, BRAKETHERMALOK := TRUE, PHASEROTATIONOK := TRUE,
       SLACKCABLETENSIONED := TRUE, M3SENSORWORDINCOHERENT := FALSE,
       EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE,
       ENCODERM1OPERATIONAL := TRUE, ENCODERM2OPERATIONAL := TRUE,
       HOMEDM1 := TRUE, HOMEDM2 := TRUE, M1POSITIONINBOUNDS := TRUE, M2POSITIONINBOUNDS := TRUE);
    ASSERT_EQ(fb.PREFLIGHTERRORID, 16#0002, 'bit1 : frein M2 desserre');

    (* ── bit2 : frein M3 non serre ── *)
