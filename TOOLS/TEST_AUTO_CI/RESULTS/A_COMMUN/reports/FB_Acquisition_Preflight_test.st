       HOMEDM1 := TRUE, HOMEDM2 := TRUE, M1POSITIONINBOUNDS := TRUE, M2POSITIONINBOUNDS := TRUE);
    ASSERT_TRUE(fb.PREFLIGHTOK, 'FB consomme des faits qualifies (interface explicite)');
