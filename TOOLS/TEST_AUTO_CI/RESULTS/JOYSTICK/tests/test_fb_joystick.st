TEST 'TC-P08-012 PreserveArmingAfterBucket protege l armement en fin de benne (exception CLOSING Extraction)'
    diagOk.ONLINE := TRUE; diagOk.OPERATIONAL := TRUE; diagOk.ERROR := FALSE;
