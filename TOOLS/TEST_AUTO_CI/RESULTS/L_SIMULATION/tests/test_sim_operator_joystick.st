bench.Enable := TRUE; bench.HwReal.Operator.JoyXRaw_ANA1 := 5000; bench.HwReal.Operator.JoyYRaw_ANA2 := 5000;
bench.OperatorSourceActive := FALSE; bench.SimJoystickRawX := 9999; bench.SimJoystickRawY := 1; bench.SimJoystickRawButton := TRUE;
bench.HwReal.Operator.JoyXRaw_ANA1 := 4321; bench.HwReal.Operator.JoyYRaw_ANA2 := 6789; bench.HwReal.Operator.JoyBtnRaw := FALSE; bench.HwReal.Operator.CanBusState := 0;
ADVANCE_TIME(10000000); bench(RawPosM1 := raw1, RawPosM2 := raw2);
ASSERT_EQ(bench.Operator.JoyXRaw_ANA1, 4321, 'X reel exact'); ASSERT_EQ(bench.Operator.JoyYRaw_ANA2, 6789, 'Y reel exact'); ASSERT_FALSE(bench.Operator.JoyBtnRaw, 'Bouton reel exact'); ASSERT_EQ(bench.Operator.CanBusState, 0, 'Diagnostic reel non remplace par RUNNING');
END_TEST
