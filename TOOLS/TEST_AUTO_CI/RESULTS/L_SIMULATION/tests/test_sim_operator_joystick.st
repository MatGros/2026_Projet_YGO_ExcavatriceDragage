SETUP
VAR
    bench : FB_SimBench;
    joy : FB_Joystick;
    home : FB_CycleMachineHoming;
    cfg : ST_fbJoystick_Cfg;
    diagOk : ST_Diag_Device;
    nx : INT := 5000;
    ny : INT := 5000;
    raw1 : UDINT;
    raw2 : UDINT;
    sourceSelected : BOOL;
    selectedX : INT;
    selectedY : INT;
    selectedButton : BOOL;
    previousButton : BOOL;
    buttonEdges : INT;
