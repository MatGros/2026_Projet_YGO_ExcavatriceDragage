END_SETUP
TEST 'TC-T418-INT-001 Geste complet avec vrai joystick'
nx := 5000; ny := 5000; raw1 := 0; raw2 := 0; previousButton := FALSE; buttonEdges := 0;
bench.Enable := TRUE; joy.Enable := TRUE; joy.ArmingPermit := TRUE; diagOk.Operational := TRUE;
joy.BusCanOpenOP := diagOk; joy.JoystickOP := diagOk; home.Enable := TRUE; home.BootReady := TRUE;
home.Mode := E_Mode.MAINT_N1; home.BucketOffsetValid := TRUE; home.WinchesMechanicallyStopped := TRUE;
