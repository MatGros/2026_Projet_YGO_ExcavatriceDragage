home(DeadmanArmed := joy.DeadmanArmed, JoystickDeflected := NOT joy.AtNeutralXY, JoystickPull := joy.AxisCmdY.DirectionPositive, JoystickPush := joy.AxisCmdY.DirectionNegative, BtnValidation := bench.Operator.JoyBtnRaw);
