    ASSERT_GE(loop.Overshoot_M, 0.15, 'Depassement apres P1 >= 0,15 m (ordre de grandeur T334 / trace)');
    ASSERT_LE(loop.Overshoot_M, 0.45, 'Depassement apres P1 <= 0,45 m (ordre de grandeur T334 / trace)');
END_TEST
