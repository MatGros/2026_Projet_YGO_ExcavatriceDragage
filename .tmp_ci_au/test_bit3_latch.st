SETUP
VAR
    fb : FB_SAFETY_EMERGENCYMANAGEMENT;
END_VAR
END_SETUP

TEST 'bit3 StartupFail latched via FB_FaultCore (correction bug)'
    fb(ENABLE := TRUE, RESET := FALSE, ARMREQUEST := FALSE, POWERCUTOFFREQUEST := FALSE,
       BTNEMERGENCYCUTOFF := FALSE, EMERGENCYCHAINCLOSED := FALSE, POWERCONTACTORENGAGED := FALSE);
    ASSERT_TRUE(fb.STATUS.DIAG.ERROR, 'StartupFail -> Error actif');
    ASSERT_TRUE((fb.STATUS.FAULT.LATCHEDID AND 16#0008) <> 16#0000, 'bit3 StartupFail latche');
    ADVANCE_TIME(10000000);
    fb(ENABLE := TRUE, RESET := FALSE, ARMREQUEST := FALSE, POWERCUTOFFREQUEST := FALSE,
       BTNEMERGENCYCUTOFF := FALSE, EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE);
    ASSERT_TRUE((fb.STATUS.FAULT.LATCHEDID AND 16#0008) <> 16#0000, 'bit3 reste latche sans Reset (correction bug bit3)');
    ADVANCE_TIME(10000000);
    fb(ENABLE := TRUE, RESET := TRUE, ARMREQUEST := FALSE, POWERCUTOFFREQUEST := FALSE,
       BTNEMERGENCYCUTOFF := FALSE, EMERGENCYCHAINCLOSED := TRUE, POWERCONTACTORENGAGED := FALSE);
    ASSERT_FALSE((fb.STATUS.FAULT.LATCHEDID AND 16#0008) <> 16#0000, 'Reset efface le latch bit3');
END_TEST
