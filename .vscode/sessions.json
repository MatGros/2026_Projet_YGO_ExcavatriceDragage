{
    "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v12/terminal-keeper.json",
    "theme": "tribe",
    "active": "AI",
    "activateOnStartup": true,
    "keepExistingTerminals": false,
    "sessions": {
        "AI": [
            {
                "name": "Task Manager",
                "autoExecuteCommands": true,
                "icon": "server",
                "color": "terminal.ansiBrightMagenta",
                "commands": [
                    "cmd /c TOOLS\\TASK_MANAGER\\LANCER_TASK_MANAGER.bat"
                ]
            },
            {
                "name": "🌐 OmniRoute Server",
                "autoExecuteCommands": true,
                "icon": "server",
                "color": "terminal.ansiBrightGreen",
                "commands": [
                    "cmd /c \"set OMNIROUTE_SERVER_HOST=127.0.0.1&& omniroute\""
                ]
            },
            {
                "name": "DSH (Ollama deepseek-v4.1-flash:cloud)",
                "autoExecuteCommands": true,
                "icon": "terminal",
                "color": "terminal.ansiBrightYellow",
                "commands": [
                    "ollama launch dsh --model deepseek-v4.1-flash:cloud"
                ]
            },
            {
                "name": "🚀 AGY Antigravity",
                "autoExecuteCommands": true,
                "icon": "rocket",
                "color": "terminal.ansiBlue",
                "commands": [
                    "agy"
                ]
            },
            {
                "name": "🧠 Claude Code",
                "autoExecuteCommands": true,
                "icon": "code",
                "color": "terminal.ansiRed",
                "commands": [
                    "claude"
                ]
            },
            {
                "name": "🤖 Codex (OpenAI)",
                "autoExecuteCommands": true,
                "icon": "symbol-class",
                "color": "terminal.ansiGreen",
                "commands": [
                    "codex"
                ]
            },
            {
                "name": "🐋 Claude Code Ollama (deepseek-v4.1-flash:cloud)",
                "autoExecuteCommands": true,
                "icon": "code",
                "color": "terminal.ansiBrightBlue",
                "commands": [
                    "ollama launch claude --model deepseek-v4.1-flash:cloud"
                ]
            },
            {
                "name": "♊ Claude Code OmniRoute AGY (Gemini 3.8)",
                "autoExecuteCommands": true,
                "icon": "code",
                "color": "terminal.ansiBrightYellow",
                "commands": [
                    "cmd /c \"set ANTHROPIC_BASE_URL=http://127.0.0.1:20128&& set ANTHROPIC_AUTH_TOKEN=local-dev&& set ANTHROPIC_API_KEY=&& set ANTHROPIC_MODEL=agy/gemini-3.8-flash-tiered&& claude --model agy/gemini-3.8-flash-tiered\""
                ]
            },
            {
                "name": "⚡ Claude Code Ollama (glm-5.3-flash:cloud)",
                "autoExecuteCommands": true,
                "icon": "code",
                "color": "terminal.ansiBrightMagenta",
                "commands": [
                    "ollama launch claude --model glm-5.3-flash:cloud"
                ]
            },
            {
                "name": "🚀 Claude Code Ollama (minimax-m3.1-flash:cloud)",
                "autoExecuteCommands": true,
                "icon": "code",
                "color": "terminal.ansiBrightCyan",
                "commands": [
                    "ollama launch claude --model minimax-m3.1-flash:cloud"
                ]
            }
        ],
        "disabled_terminals": [
            {
                "name": "OpenCode (desactive)",
                "autoExecuteCommands": true,
                "icon": "organization",
                "color": "terminal.ansiBrightBlue",
                "commands": [
                    "opencode --agent orchestrateur"
                ]
            },
            {
                "name": "OmniRoute Server (ancienne commande archivée)",
                "autoExecuteCommands": true,
                "icon": "server",
                "color": "terminal.ansiBrightGreen",
                "commands": [
                    "omniroute"
                ]
            },
            {
                "name": "OpenCode-Go (glm-5.2) - desactive",
                "autoExecuteCommands": true,
                "icon": "zap",
                "color": "terminal.ansiBrightCyan",
                "commands": [
                    "opencode-go --provider opencode --model glm-5.2 --permission-mode default"
                ]
            },
            {
                "name": "🦙 Claude Code (Ollama)",
                "autoExecuteCommands": true,
                "icon": "cpu",
                "color": "terminal.ansiBrightMagenta",
                "commands": [
                    "ollama launch claude --model gemma4:e4b"
                ]
            },
            {
                "name": "🦙 OpenCode (Ollama)",
                "autoExecuteCommands": true,
                "icon": "cpu",
                "color": "terminal.ansiBrightCyan",
                "commands": [
                    "ollama launch opencode --model gemma4:e4b"
                ]
            },
            {
                "name": "✅ Gates",
                "autoExecuteCommands": true,
                "icon": "check",
                "color": "terminal.ansiGreen",
                "commands": [
                    "python TOOLS/AGENT_WORKFLOW/scripts/run_all_gates.py --skip-codesys"
                ]
            },
            {
                "name": "🤠 Herdr",
                "autoExecuteCommands": true,
                "icon": "robot",
                "color": "terminal.ansiYellow",
                "commands": [
                    "herdr start-agent claude"
                ]
            }
        ]
    }
}
